n":18},{"ruleId":"complexity","severity":2,"message":"Method 'onKeyDown' has a complexity of 15. Maximum allowed is 10.","line":2056,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":2056,"endColumn":22},{"ruleId":"max-lines-per-function","severity":2,"message":"Method 'chooseColor' has too many lines (192). Maximum allowed is 50.","line":2184,"column":5,"nodeType":"MethodDefinition","messageId":"exceed","endLine":2400,"endColumn":6},{"ruleId":"max-lines-per-function","severity":2,"message":"Method 'onOpen' has too many lines (176). Maximum allowed is 50.","line":2196,"column":13,"nodeType":"MethodDefinition","messageId":"exceed","endLine":2395,"endColumn":14},{"ruleId":"complexity","severity":2,"message":"Method 'onOpen' has a complexity of 18. Maximum allowed is 10.","line":2196,"column":13,"nodeType":"FunctionExpression","messageId":"complex","endLine":2196,"endColumn":19},{"ruleId":"max-statements","severity":2,"message":"Method 'onOpen' has too many statements (52). Maximum allowed is 25.","line":2196,"column":19,"nodeType":"FunctionExpression","messageId":"exceed","endLine":2395,"endColumn":14},{"ruleId":"complexity","severity":2,"message":"Method 'setAlignSelected' has a complexity of 12. Maximum allowed is 10.","line":2459,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":2459,"endColumn":29},{"ruleId":"max-lines-per-function","severity":2,"message":"Method 'setCellBgColorSelected' has too many lines (63). Maximum allowed is 50.","line":2485,"column":5,"nodeType":"MethodDefinition","messageId":"exceed","endLine":2554,"endColumn":6},{"ruleId":"complexity","severity":2,"message":"Method 'setCellBgColorSelected' has a complexity of 17. Maximum allowed is 10.","line":2485,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":2485,"endColumn":35},{"ruleId":"max-statements","severity":2,"message":"Method 'setCellBgColorSelected' has too many statements (29). Maximum allowed is 25.","line":2485,