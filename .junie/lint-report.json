FontColorLight ?? '',\n      stickyNoteFontColorDark: defaults.stickyNoteFontColorDark ?? '',\n    };\n    // If there's an existing projectColors, preserve it (modern data takes precedence).\n    if (base.projectColors && typeof base.projectColors === 'object' && !Array.isArray(base.projectColors)) {\n      Object.assign(projectColors, base.projectColors);\n    }\n    result.projectColors = projectColors;\n  } else if (base.projectColors) {\n    // Legacy useProjectColors is false/absent, but existing file has projectColors — preserve it.\n    result.projectColors = base.projectColors;\n  }\n  return result;\n}\n\n/**\n * Merge legacy character data (characterAliases, ignoredCharacters).\n *\n * Returns null if the existing file is malformed — the merge should be deferred.\n */\nexport function mergeCharacterData(\n  legacyData: Record<string, unknown>,\n  existingContent: string | null,\n  defaults: Record<string, unknown>,\n): Record<string, unknown> | null {\n  const existing = parseExisting(existingContent);\n  if (existing === null && existingContent !== null) {\n    return null;\n  }\n  const base = existing ?? {};\n  return {\n    ...base,\n    characterAliases:\n      legacyData.characterAliases ?? base.characterAliases ?? defaults.characterAliases ?? {},\n    ignoredCharacters:\n      legacyData.ignoredCharacters ?? base.ignoredCharacters ?? defaults.ignoredCharacters ?? [],\n  };\n}\n\n/**\n * Merge legacy writing tracker data.\n *\n * Returns null if the existing file is malformed — the merge should be deferred.\n */\nexport function mergeStatsData(\n  legacyData: Record<string, unknown>,\n  existingContent: string | null,\n): Record<string, unknown> | null {\n  const existing = parseExisting(existingContent);\n  if (existing === null && existingContent !== null) {\n    return null;\n  }\n  const base = existing ?? {};\n  const writingTrackerData =\n    legacyData.writingTrackerData ?? base.writingTrackerData ?? null;\n  if (!writingTrackerData) {\n    if (Object.keys(base).length > 0) return base;\n    return null;\n  }\n  return { ...base, writingTrackerData };\n}\n\n/**\n * Merge legacy custom sections data into System/custom-sections.json.\n * Uses a data-driven approach to keep complexity low.\n *\n * Returns null if the existing file is malformed — the merge should be deferred.\n */\nexport function mergeCustomSectionsData(\n  legacyData: Record<string, unknown>,\n  existingContent: string | null,\n): Record<string, unknown> | null {\n  const existing = parseExisting(existingContent);\n  if (existing === null && existingContent !== null) {\n    return null;\n  }\n  const base = existing ?? {};\n  const fields: Array<{ key: string; type: 'array' | 'object'; default: unknown }> = [\n    { key: 'characterCustomSections', type: 'array', default: [] },\n    { key: 'locationCustomSections', type: 'array', default: [] },\n    { key: 'codexCategoryCustomSections', type: 'object', default: {} },\n    { key: 'codexVisualGroups', type: 'object', default: {} },\n    { key: 'customLocationTypes', type: 'array', default: [] },\n    { key: 'codexCustomCategories', type: 'array', default: [] },\n    { key: 'codexEnabledCategories', type: 'array', default: [] },\n  ];\n  const result: Record<string, unknown> = { ...base };\n  for (const field of fields) {\n    const legacy = legacyData[field.key];\n    const isValid = field.type === 'array'\n      ? Array.isArray(legacy)\n      : legacy && typeof legacy === 'object';\n    result[field.key] = isValid\n      ? legacy\n      : (base[field.key] ?? field.default);\n  }\n  return result;\n}\n\n/**\n * Parse existing JSON content, returning null if the content is malformed.\n * Callers must handle null as a signal that the existing file cannot be\n * safely overwritten — the original bytes must be preserved.\n */\nexport function parseExisting(content: string | null): Record<string, unknown> | null {\n  if (!content) return null;\n  try {\n    const parsed = JSON.parse(content) as Record<string, unknown>;\n    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return null;\n    return parsed;\n  } catch {\n    return null;\n  }\n}\n\n/**\n * Derive the System/ folder path from a project's scene folder.\n */\nexport function deriveSystemFolder(sceneFolder: string): string {\n  const base = sceneFolder.replace(/\\\\/g, '/').replace(/\\/Scenes\\/?$/, '');\n  return `${base}/System`;\n}\n\n/**\n * Derive the System/ folder path from an activeProjectFile setting.\n */\nexport function deriveSystemFolderFromProjectFile(projectFile: string): string | null {\n  const base = String(projectFile).replace(/\\/[^/]+\\.md$/i, '');\n  if (!base) return null;\n  return `${base}/System`;\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/services/legacyMigration.ts","messages":[],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since the receiver accepts the original type of the expression.","line":162,"column":33,"nodeType":"TSAsExpression","messageId":"contextuallyUnnecessary","endLine":162,"endColumn":89,"fix":{"range":[5152,5208],"text":"presets"},"suppressions":[{"kind":"directive","justification":"Record<string, unknown> accepts any array"}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/services/projectCreation.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/services/projectDiscovery.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Platform' is defined but never used.","line":13,"column":15,"nodeType":"Identifier","messageId":"unusedVar","endLine":13,"endColumn":23,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"Platform"},"fix":{"range":[499,541],"text":""},"desc":"Remove unused import declaration."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Discovers and restores StoryLine projects on plugin startup.\n *\n * Handles the case where Obsidian's vault metadata cache has not finished\n * indexing, which is common on mobile and after laptop wake. Retries project\n * scanning with exponential backoff before prompting for a new project.\n *\n * On mobile platforms, auto-opening the New Project modal is suppressed to\n * prevent duplicate project creation when sync is still running.\n */\n\nimport type { SceneManager } from './SceneManager';\nimport type { Platform } from 'obsidian';\nimport type { StoryLineProject } from '../models/StoryLineProject';\n\n/**\n * Narrow interface for the plugin settings required during project discovery.\n */\ninterface DiscoverySettings {\n    /** Previously saved active project file path, or empty string. */\n    activeProjectFile: string;\n}\n\n/**\n * Narrow interface for the vault adapter required during project discovery.\n */\ninterface DiscoveryVault {\n    /** Low-level file adapter for existence checks. */\n    adapter: {\n        /** Check if a path exists in the vault. */\n        exists: (path: string) => Promise<boolean>;\n    };\n}\n\n/**\n * Narrow interface for platform detection.\n */\ninterface DiscoveryPlatform {\n    /** True when running on iOS, iPadOS, or Android. */\n    isMobile: boolean;\n}\n\n/**\n * Narrow interface for showing notices to the user.\n */\ninterface DiscoveryNotice {\n    /** Show a notice message. */\n    (message: string, timeout?: number): void;\n}\n\n/**\n * Dependencies required for project discovery.\n */\ninterface ProjectDiscoveryDeps {\n    /** Scene manager for scanning projects. */\n    sceneManager: SceneManager;\n    /** Plugin settings subset. */\n    settings: DiscoverySettings;\n    /** Vault adapter for existence checks. */\n    vault: DiscoveryVault;\n    /** Platform detection. */\n    platform: DiscoveryPlatform;\n    /** Notice helper. */\n    notice: DiscoveryNotice;\n}\n\n/**\n * Scan for existing StoryLine projects, retrying if the metadata cache\n * appears not to have finished indexing.\n *\n * When {@link settings.activeProjectFile} is set but no projects are found,\n * the function retries up to 3 times with increasing delays (1s, 2s, 3s).\n * If the expected project file exists on disk but scanProjects still returns\n * nothing, a final 5-second delay retry is performed.\n *\n * @param deps - Dependencies for project discovery.\n * @returns Array of discovered projects, possibly empty.\n */\nexport async function discoverProjects(deps: ProjectDiscoveryDeps): Promise<StoryLineProject[]> {\n    let projects = await deps.sceneManager.scanProjects();\n\n    // If nothing found but we expect a project, retry after short delays\n    // to let the vault / metadata cache finish indexing.\n    if (projects.length === 0 && deps.settings.activeProjectFile) {\n        for (let attempt = 1; attempt <= 3; attempt++) {\n            await delay(attempt * 1000);\n            projects = await deps.sceneManager.scanProjects();\n            if (projects.length > 0) break;\n        }\n    }\n\n    if (projects.length === 0 && deps.settings.activeProjectFile) {\n        // The file exists but wasn't found by scanProjects — retry once more\n        // with a longer delay to give the metadata cache time to catch up.\n        const exists = await deps.vault.adapter.exists(deps.settings.activeProjectFile);\n        if (exists) {\n            await delay(5000);\n            projects = await deps.sceneManager.scanProjects();\n            if (projects.length > 0) return projects;\n        }\n    }\n\n    return projects;\n}\n\n/**\n * Determine whether to suppress the New Project modal on startup.\n *\n * On mobile platforms, the vault file system can take a long time to populate,\n * especially with cloud sync. Auto-opening the modal risks duplicate creation.\n *\n * @param platform - Platform detection interface.\n * @returns True if the modal should be suppressed.\n */\nexport function shouldSuppressNewProjectModal(platform: DiscoveryPlatform): boolean {\n    return platform.isMobile;\n}\n\n/**\n * Show a mobile notice explaining that no projects were found yet.\n *\n * @param notice - Notice helper interface.\n */\nexport function showMobileProjectNotice(notice: DiscoveryNotice): void {\n    notice(\n        'StoryLine: no projects found yet. If sync is still running, give it a moment. ' +\n        'Otherwise use the command palette → \"StoryLine: Create new project\".',\n        8000,\n    );\n}\n\n/**\n * Delay execution for the specified number of milliseconds.\n *\n * @param ms - Milliseconds to delay.\n */\nfunction delay(ms: number): Promise<void> {\n    return new Promise(resolve => window.setTimeout(resolve, ms));\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/services/startup.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/settings.ts","messages":[{"ruleId":"max-lines","severity":2,"message":"File has too many lines (3119). Maximum allowed is 200.","line":223,"column":1,"nodeType":null,"messageId":"exceed","endLine":3856,"endColumn":1},{"ruleId":"max-params","severity":2,"message":"Function 'resolveTagColor' has too many parameters (5). Maximum allowed is 4.","line":566,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":566,"endColumn":32},{"ruleId":"max-lines-per-function","severity":2,"message":"Method 'renderSettingsTab' has too many lines (1374). Maximum allowed is 50.","line":1169,"column":5,"nodeType":"MethodDefinition","messageId":"exceed","endLine":2733,"endColumn":6},{"ruleId":"complexity","severity":2,"message":"Method 'renderSettingsTab' has a complexity of 22. Maximum allowed is 10.","line":1169,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":1169,"endColumn":30},{"ruleId":"max-statements","severity":2,"mes