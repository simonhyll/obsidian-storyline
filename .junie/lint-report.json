:"Identifier","messageId":"unsafeMemberExpression","endLine":46,"endColumn":45,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .ownerId on an `any` value.","line":46,"column":66,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":46,"endColumn":73,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":47,"column":17,"nodeType":"Property","messageId":"anyAssignment","endLine":47,"endColumn":42,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .bookOrder on an `any` value.","line":47,"column":33,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":47,"endColumn":42,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":48,"column":17,"nodeType":"Property","messageId":"anyAssignment","endLine":48,"endColumn":80,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .bookIds on an `any` value.","line":48,"column":45,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":48,"endColumn":52,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .bookIds on an `any` value.","line":48,"column":61,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":48,"endColumn":68,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":49,"column":17,"nodeType":"Property","messageId":"anyAssignment","endLine":49,"endColumn":44,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .created on an `any` value.","line":49,"column":31,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":49,"endColumn":38,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]}],"errorCount":18,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/* eslint-disable @typescript-eslint/no-unsafe-member-access, @typescript-eslint/no-unsafe-assignment -- Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file */\nimport { App, Notice, normalizePath } from 'obsidian';\nimport type SceneCardsPlugin from '../main';\nimport { SeriesMetadata, deriveProjectFoldersFromFilePath } from '../models/StoryLineProject';\n\n/**\n * Manages series — groups of book projects sharing a common codex.\n *\n * Series folder layout:\n *   MySeriesFolder/\n *     series.json        ← SeriesMetadata\n *     Codex/\n *       Characters/\n *       Locations/\n *       [other codex categories]\n *     Book1/             ← StoryLine project (scenes, .storyline)\n *     Book2/\n */\nexport class SeriesManager {\n    private app: App;\n    private plugin: SceneCardsPlugin;\n\n    constructor(app: App, plugin: SceneCardsPlugin) {\n        this.app = app;\n        this.plugin = plugin;\n    }\n\n    // ── Read ───────────────────────────────────────────\n\n    /**\n     * Load series.json from a series folder.\n     * Returns null if the file doesn't exist or is invalid.\n     */\n    async loadSeriesMetadata(seriesFolder: string): Promise<SeriesMetadata | null> {\n        const adapter = this.app.vault.adapter;\n        const metaPath = normalizePath(`${seriesFolder}/series.json`);\n        if (!await adapter.exists(metaPath)) return null;\n        try {\n            const raw = await adapter.read(metaPath);\n            const data = JSON.parse(raw);\n            if (!data.name || !Array.isArray(data.bookOrder)) return null;\n            return {\n                name: data.name,\n                seriesUuid: typeof data.seriesUuid === 'string' ? data.seriesUuid : undefined,\n                universeId: typeof data.universeId === 'string' ? data.universeId : undefined,\n                ownerId: typeof data.ownerId === 'string' ? data.ownerId : undefined,\n                bookOrder: data.bookOrder,\n                bookIds: Array.isArray(data.bookIds) ? data.bookIds : undefined,\n                created: data.created || '',\n            };\n        } catch {\n            return null;\n        }\n    }\n\n    /**\n     * Save series.json to the series folder.\n     */\n    async saveSeriesMetadata(seriesFolder: string, meta: SeriesMetadata): Promise<void> {\n        const adapter = this.app.vault.adapter;\n        const metaPath = normalizePath(`${seriesFolder}/series.json`);\n        await adapter.write(metaPath, JSON.stringify(meta, null, 2));\n    }\n\n    /**\n     * Get the series folder for the active project (if it belongs to a series).\n     */\n    getActiveSeriesFolder(): string | null {\n        return this.plugin.sceneManager.getSeriesFolder();\n    }\n\n    /**\n     * Get the series metadata for the active project.\n     */\n    async getActiveSeriesMetadata(): Promise<SeriesMetadata | null> {\n        const folder = this.getActiveSeriesFolder();\n        if (!folder) return null;\n        return this.loadSeriesMetadata(folder);\n    }\n\n    /**\n     * Idempotently upgrade an existing series while a project is scanned.\n     * Legacy folder-name fields remain populated for the old plugin contract.\n     */\n    async ensureProjectSeriesIdentity(project: import('../models/StoryLineProject').StoryLineProject): Promise<void> {\n        if (!project.seriesId && !project.seriesUuid) return;\n        const baseFolder = deriveProjectFoldersFromFilePath(project.filePath).baseFolder;\n        const seriesFolder = baseFolder.substring(0, baseFolder.lastIndexOf('/'));\n        const meta = await this.loadSeriesMetadata(seriesFolder);\n        if (!meta || !project.bookId) return;\n\n        let metadataChanged = false;\n        if (!meta.seriesUuid) {\n            meta.seriesUuid = crypto.randomUUID();\n            metadataChanged = true;\n        }\n        if (!meta.bookIds) meta.bookIds = [];\n        if (!meta.bookIds.includes(project.bookId)) {\n            meta.bookIds.push(project.bookId);\n            metadataChanged = true;\n        }\n        if (metadataChanged) await this.saveSeriesMetadata(seriesFolder, meta);\n\n        let projectChanged = false;\n        if (project.seriesUuid !== meta.seriesUuid) {\n            project.seriesUuid = meta.seriesUuid;\n            projectChanged = true;\n        }\n        if (!project.seriesId) {\n            project.seriesId = seriesFolder.split('/').pop() ?? '';\n            projectChanged = true;\n        }\n        if (projectChanged) await this.plugin.sceneManager.saveProjectFrontmatter(project);\n    }\n\n    /**\n     * Recover series membership for pre-UUID projects whose frontmatter did\n     * not contain seriesId. The old series layout records the book folder in\n     * series.json, so require that explicit bookOrder match before inferring.\n     */\n    async inferLegacyProjectSeries(project: import('../models/StoryLineProject').StoryLineProject): Promise<void> {\n        if (project.seriesId || project.seriesUuid) return;\n\n        const baseFolder = deriveProjectFoldersFromFilePath(project.filePath).baseFolder;\n        const separator = baseFolder.lastIndexOf('/');\n        if (separator < 0) return;\n\n        const seriesFolder = baseFolder.substring(0, separator);\n        const bookFolderName = baseFolder.substring(separator + 1);\n        const meta = await this.loadSeriesMetadata(seriesFolder);\n        if (!meta || !meta.bookOrder.some(book => book.toLowerCase() === bookFolderName.toLowerCase())) return;\n\n        project.seriesId = seriesFolder.split('/').pop() ?? '';\n    }\n\n    // ── Create ─────────────────────────────────────────\n\n    /**\n     * Create a new series from the currently active project.\n     *\n     * Steps:\n     * 1. Create series folder (parent-level) inside StoryLine root\n     * 2. Move the current book project folder into the series folder\n     * 3. Move the book's codex to the shared series codex folder\n     * 4. Write series.json\n     * 5. Update the project's seriesId\n     */\n    async createSeriesFromProject(seriesName: string): Promise<string> {\n        // Pre-flight: check Obsidian link settings\n        this.checkLinkSettings();\n\n        const project = this.plugin.sceneManager.activeProject;\n        if (!project) throw new Error('No active project');\n\n        const safeName = seriesName.replace(/[\\\\/:*?\"<>|]/g, '-');\n        const root = this.plugin.settings.storyLineRoot;\n        const seriesFolder = normalizePath(`${root}/${safeName}`);\n        const adapter = this.app.vault.adapter;\n\n        // Determine current book base folder\n        const bookFolders = deriveProjectFoldersFromFilePath(project.filePath);\n        const bookBaseName = bookFolders.baseFolder.split('/').pop() ?? '';\n\n        // Issue #82: Refuse to create a series whose folder name collides\n        // with the active book's folder name. Otherwise the book's base\n        // folder == the series folder, and moving it into a same-named\n        // subfolder triggers an infinite recursive move.\n        if (safeName.toLowerCase() === bookBaseName.toLowerCase()) {\n            throw new Error(\n                `Series name \"${seriesName}\" matches the current book's folder name. ` +\n                `Please choose a different series name (e.g. \"${seriesName} Series\").`\n            );\n        }\n\n        // Ensure series folder exists\n        await this.ensureFolder(seriesFolder);\n\n        // If the book is not already inside the series folder, move it\n        const targetBookFolder = normalizePath(`${seriesFolder}/${bookBaseName}`);\n        if (normalizePath(bookFolders.baseFolder) !== targetBookFolder) {\n            await this.moveFolderRecursive(bookFolders.baseFolder, targetBookFolder);\n            // Also move the project .md file if it's at root level\n            const oldProjectFile = project.filePath;\n            const newProjectFile = normalizePath(`${targetBookFolder}/${bookBaseName}.md`);\n            if (normalizePath(oldProjectFile) !== newProjectFile) {\n                // The project file should already be inside the book folder after move\n                // but handle root-level project files (legacy layout)\n                if (await adapter.exists(oldProjectFile)) {\n                    await this.app.fileManager.renameFile(\n                        this.app.vault.getAbstractFileByPath(oldProjectFile)!,\n                        newProjectFile\n                    );\n                }\n            }\n\n            // Issue #270 follow-up: keep a cleanup pass for legacy root folders\n            // that remain behind after the move, especially when the original\n            // folder was just a duplicate of the migrated project.\n            await this.removeDuplicateLegacyFolder(bookFolders.baseFolder, targetBookFolder);\n            await this.removeFolderIfEmpty(bookFolders.baseFolder);\n        }\n\n        // Create shared Codex folder structure at series level\n        const seriesCodexFolder = normalizePath(`${seriesFolder}/Codex`);\n        await this.ensureFolder(seriesCodexFolder);\n        await this.ensureFolder(normalizePath(`${seriesCodexFolder}/Characters`));\n        await this.ensureFolder(normalizePath(`${seriesCodexFolder}/Locations`));\n\n        // Move book's codex entries to the shared series codex\n        const bookCodexFolder = normalizePath(`${targetBookFolder}/Codex`);\n        if (await adapter.exists(bookCodexFolder)) {\n            await this.migrateCodexFolder(bookCodexFolder, seriesCodexFolder);\n        }\n\n        // Write series.json\n        const now = new Date().toISOString().split('T')[0];\n        const seriesUuid = crypto.randomUUID();\n        const bookId = project.bookId ?? crypto.randomUUID();\n        project.bookId = bookId;\n        const meta: SeriesMetadata = {\n            name: seriesName,\n            seriesUuid,\n            bookOrder: [bookBaseName],\n            bookIds: [bookId],\n            created: now,\n        };\n        await this.saveSeriesMetadata(seriesFolder, meta);\n\n        // Update project's seriesId and re-derive paths\n        const newProjectFile = normalizePath(`${targetBookFolder}/${bookBaseName}.md`);\n        await this.plugin.sceneManager.scanProjects();\n        const updatedProject = this.plugin.sceneManager.getProjects()\n            .find(p => normalizePath(p.filePath) === newProjectFile);\n        if (updatedProject) {\n            updatedProject.seriesId = safeName;\n            updatedProject.seriesUuid = seriesUuid;\n            updatedProject.bookId = bookId;\n            await this.plugin.sceneManager.setActiveProject(updatedProject);\n            await this.plugin.sceneManager.saveProjectFrontmatter(updatedProject);\n        }\n\n        new Notice(`Series \"${seriesName}\" created`);\n        return seriesFolder;\n    }\n\n    // ── Add existing project to series ─────────────────\n\n    /**\n     * Add the currently active project to an existing series.\n     *\n     * Steps:\n     * 1. Move book folder into the series folder\n     * 2. Migrate book's codex to the shared series codex (handling duplicates)\n     * 3. Update series.json bookOrder\n     * 4. Set seriesId on the project\n     */\n    async addProjectToSeries(seriesFolder: string): Promise<void> {\n        this.checkLinkSettings();\n\n        const project = this.plugin.sceneManager.activeProject;\n        if (!project) throw new Error('No active project');\n\n        const meta = await this.loadSeriesMetadata(seriesFolder);\n        if (!meta) throw new Error('Invalid series folder — no series.json found');\n\n        const adapter = this.app.vault.adapter;\n        const bookFolders = deriveProjectFoldersFromFilePath(project.filePath);\n        const bookBaseName = bookFolders.baseFolder.split('/').pop() ?? '';\n        const seriesFolderName = seriesFolder.split('/').pop() ?? '';\n\n        // Issue #82: refuse same-name collision between series folder and\n        // the book folder \\u2014 would attempt to move the book into itself.\n        if (seriesFolderName.toLowerCase() === bookBaseName.toLowerCase()) {\n            throw new Error(\n                `Series folder \"${seriesFolderName}\" has the same name as the book folder. ` +\n                `Rename the book or the series before adding.`\n            );\n        }\n\n        const targetBookFolder = normalizePath(`${seriesFolder}/${bookBaseName}`);\n\n        // Move the book folder into the series\n        if (normalizePath(bookFolders.baseFolder) !== targetBookFolder) {\n            await this.moveFolderRecursive(bookFolders.baseFolder, targetBookFolder);\n            await this.removeDuplicateLegacyFolder(bookFolders.baseFolder, targetBookFolder);\n        }\n\n        // Migrate codex\n        const seriesCodexFolder = normalizePath(`${seriesFolder}/Codex`);\n        await this.ensureFolder(seriesCodexFolder);\n        await this.ensureFolder(normalizePath(`${seriesCodexFolder}/Characters`));\n        await this.ensureFolder(normalizePath(`${seriesCodexFolder}/Locations`));\n\n        const bookCodexFolder = normalizePath(`${targetBookFolder}/Codex`);\n        if (await adapter.exists(bookCodexFolder)) {\n            await this.migrateCodexFolder(bookCodexFolder, seriesCodexFolder);\n        }\n\n        // Update series.json\n        const safeName = seriesFolder.split('/').pop() ?? '';\n        const seriesUuid = meta.seriesUuid ?? crypto.randomUUID();\n        meta.seriesUuid = seriesUuid;\n        const bookId = project.bookId ?? crypto.randomUUID();\n        project.bookId = bookId;\n        if (!meta.bookOrder.includes(bookBaseName)) {\n            meta.bookOrder.push(bookBaseName);\n        }\n        meta.bookIds = meta.bookIds ?? [];\n        if (!meta.bookIds.includes(bookId)) meta.bookIds.push(bookId);\n        await this.saveSeriesMetadata(seriesFolder, meta);\n\n        // Re-scan and set active with seriesId\n        const newProjectFile = normalizePath(`${targetBookFolder}/${bookBaseName}.md`);\n        await this.plugin.sceneManager.scanProjects();\n        const updatedProject = this.plugin.sceneManager.getProjects()\n            .find(p => normalizePath(p.filePath) === newProjectFile);\n        if (updatedProject) {\n            updatedProject.seriesId = safeName;\n            updatedProject.seriesUuid = seriesUuid;\n            updatedProject.bookId = bookId;\n            await this.plugin.sceneManager.setActiveProject(updatedProject);\n            await this.plugin.sceneManager.saveProjectFrontmatter(updatedProject);\n        }\n\n        new Notice(`Project added to series \"${meta.name}\"`);\n    }\n\n    // ── Remove from series ─────────────────────────────\n\n    /**\n     * Remove the active project from its series.\n     * Moves the book folder back out and copies its current shared codex entities locally.\n     */\n    async removeProjectFromSeries(): Promise<void> {\n        const project = this.plugin.sceneManager.activeProject;\n        if (!project?.seriesId && !project?.seriesUuid) throw new Error('Project is not in a series');\n\n        const seriesFolder = this.plugin.sceneManager.getSeriesFolder();\n        if (!seriesFolder) throw new Error('Cannot determine series folder');\n\n        const meta = await this.loadSeriesMetadata(seriesFolder);\n        if (!meta) throw new Error('Invalid series metadata');\n\n        const bookFolders = deriveProjectFoldersFromFilePath(project.filePath);\n        const bookBaseName = bookFolders.baseFolder.split('/').pop() ?? '';\n        const root = this.plugin.settings.storyLineRoot;\n        const targetBookFolder = normalizePath(`${root}/${bookBaseName}`);\n\n        // Copy shared codex entries into the book's local codex before moving\n        const seriesCodexFolder = normalizePath(`${seriesFolder}/Codex`);\n        const localCodexFolder = normalizePath(`${bookFolders.baseFolder}/Codex`);\n        await this.ensureFolder(localCodexFolder);\n        await this.copyFolderRecursive(seriesCodexFolder, localCodexFolder);\n\n        // Move book folder out of series folder\n        if (normalizePath(bookFolders.baseFolder) !== targetBookFolder) {\n            await this.moveFolderRecursive(bookFolders.baseFolder, targetBookFolder);\n        }\n\n        // Update series.json\n        meta.bookOrder = meta.bookOrder.filter(b => b !== bookBaseName);\n        if (project.bookId && meta.bookIds) {\n            meta.bookIds = meta.bookIds.filter(id => id !== project.bookId);\n        }\n        await this.saveSeriesMetadata(seriesFolder, meta);\n\n        // Re-scan and clear seriesId\n        const newProjectFile = normalizePath(`${targetBookFolder}/${bookBaseName}.md`);\n        await this.plugin.sceneManager.scanProjects();\n        const updatedProject = this.plugin.sceneManager.getProjects()\n            .find(p => normalizePath(p.filePath) === newProjectFile);\n        if (updatedProject) {\n            delete updatedProject.seriesId;\n            delete updatedProject.seriesUuid;\n            await this.plugin.sceneManager.setActiveProject(updatedProject);\n            await this.plugin.sceneManager.saveProjectFrontmatter(updatedProject);\n        }\n\n        new Notice(`Project removed from series \"${meta.name}\"`);\n    }\n\n    /** Rename only the display name in series.json; folder identity is unchanged. */\n    async renameSeriesName(seriesFolder: string, newName: string): Promise<void> {\n        const meta = await this.loadSeriesMetadata(seriesFolder);\n        if (!meta) throw new Error('Invalid series folder — no series.json found');\n        meta.name = newName.trim();\n        await this.saveSeriesMetadata(seriesFolder, meta);\n    }\n\n    // ── Scan for series folders ────────────────────────\n\n    /**\n     * Scan the StoryLine root for series folders (folders containing series.json).\n     */\n    async discoverSeries(): Promise<Array<{ folder: string; meta: SeriesMetadata }>> {\n        const root = this.plugin.settings.storyLineRoot;\n        const adapter = this.app.vault.adapter;\n        if (!await adapter.exists(root)) return [];\n\n        const listing = await adapter.list(root);\n        const results: Array<{ folder: string; meta: SeriesMetadata }> = [];\n\n        for (const folder of listing.folders) {\n            const meta = await this.loadSeriesMetadata(folder);\n            if (meta) {\n                results.push({ folder, meta });\n            }\n        }\n\n        return results;\n    }\n\n    // ── Convenience methods for hierarchy management ──\n\n    /**\n     * Create a new standalone series (not tied to an existing project).\n     */\n    async createSeries(name: string, basePath?: string): Promise<SeriesMetadata> {\n        const safeName = name.replace(/[\\\\/:*?\"<>|]/g, '-');\n        const root = basePath || this.plugin.settings.storyLineRoot;\n        const seriesFolder = normalizePath(`${root}/${safeName}`);\n        const adapter = this.app.vault.adapter;\n        if (await adapter.exists(seriesFolder)) {\n            throw new Error(`A folder named \"${safeName}\" already exists.`);\n        }\n        await this.ensureFolder(seriesFolder);\n        const seriesCodexFolder = normalizePath(`${seriesFolder}/Codex`);\n        await this.ensureFolder(seriesCodexFolder);\n        await this.ensureFolder(normalizePath(`${seriesCodexFolder}/Characters`));\n        await this.ensureFolder(normalizePath(`${seriesCodexFolder}/Locations`));\n        const now = new Date().toISOString().split('T')[0];\n        const seriesUuid = crypto.randomUUID();\n        const meta: SeriesMetadata = {\n            name: safeName,\n            seriesUuid,\n            bookOrder: [],\n            bookIds: [],\n            created: now,\n        };\n        await this.saveSeriesMetadata(seriesFolder, meta);\n        new Notice(`Series \"${safeName}\" created`);\n        return meta;\n    }\n\n    /** Look up a series by its UUID. */\n    async getSeriesByUuid(seriesUuid: string): Promise<({ folder: string; meta: SeriesMetadata }) | null> {\n        const all = await this.discoverSeries();\n        return all.find(s => s.meta.seriesUuid === seriesUuid) || null;\n    }\n\n    /** Add an existing book project to a series by series UUID. */\n    async addBookToSeries(seriesUuid: string, project: import('../models/StoryLineProject').StoryLineProject): Promise<void> {\n        const found = await this.getSeriesByUuid(seriesUuid);\n        if (!found) throw new Error(`Series with UUID \"${seriesUuid}\" not found.`);\n        const { folder: seriesFolder, meta } = found;\n        const adapter = this.app.vault.adapter;\n        const bookFolders = deriveProjectFoldersFromFilePath(project.filePath);\n        const bookBaseName = bookFolders.baseFolder.split('/').pop() ?? '';\n        const targetBookFolder = normalizePath(`${seriesFolder}/${bookBaseName}`);\n\n        // Preflight: check for destination collision\n        if (await adapter.exists(targetBookFolder)) {\n            if (normalizePath(bookFolders.baseFolder) === targetBookFolder) {\n                // Already in this series folder, just update metadata\n            } else {\n                throw new Error(`A folder named \"${bookBaseName}\" already exists in series \"${meta.name}\".`);\n            }\n        }\n\n        const oldFilePath = project.filePath;\n        const wasActive = this.plugin.sceneManager.activeProject === project;\n        if (normalizePath(bookFolders.baseFolder) !== targetBookFolder) {\n            await this.moveFolderRecursive(bookFolders.baseFolder, targetBookFolder);\n            await this.removeDuplicateLegacyFolder(bookFolders.baseFolder, targetBookFolder);\n            // CRITICAL: Update project.filePath to reflect the new location\n            const bookFileName = project.filePath.split('/').pop() ?? `${bookBaseName}.md`;\n            project.filePath = normalizePath(`${targetBookFolder}/${bookFileName}`);\n        }\n\n        const seriesCodexFolder = normalizePath(`${seriesFolder}/Codex`);\n        await this.ensureFolder(seriesCodexFolder);\n        await this.ensureFolder(normalizePath(`${seriesCodexFolder}/Characters`));\n        await this.ensureFolder(normalizePath(`${seriesCodexFolder}/Locations`));\n        const bookCodexFolder = normalizePath(`${targetBookFolder}/Codex`);\n        if (await adapter.exists(bookCodexFolder)) {\n            await this.migrateCodexFolder(bookCodexFolder, seriesCodexFolder);\n        }\n        const bookId = project.bookId ?? crypto.randomUUID();\n        project.bookId = bookId;\n        if (!meta.bookOrder.includes(bookBaseName)) meta.bookOrder.push(bookBaseName);\n        meta.bookIds = meta.bookIds ?? [];\n        if (!meta.bookIds.includes(bookId)) meta.bookIds.push(bookId);\n        await this.saveSeriesMetadata(seriesFolder, meta);\n        project.seriesId = meta.name;\n        project.seriesUuid = meta.seriesUuid;\n        project.bookId = bookId;\n\n        // Hierarchy invariant: books inside a series inherit the series' universe.\n        // Clear any stale universeId so the book doesn't claim membership in a\n        // different universe than the series belongs to.\n        if (meta.universeId) {\n            project.universeId = meta.universeId;\n        } else {\n            delete project.universeId;\n        }\n\n        // Save frontmatter using the UPDATED project.filePath\n        await this.plugin.sceneManager.saveProjectFrontmatter(project);\n\n        // CRITICAL: Update SceneManager project registry key if file path changed\n        if (oldFilePath !== project.filePath) {\n            this.plugin.sceneManager.updateProjectPath(oldFilePath, project.filePath, project);\n        }\n\n        // If the active project file changed, update settings and active reference\n        if (wasActive) {\n            this.plugin.settings.activeProjectFile = project.filePath;\n            await this.plugin.saveSettings();\n        }\n\n        new Notice(`Book \"${project.title}\" added to series \"${meta.name}\"`);\n    }\n\n    /**\n     * Remove a book from its series by series UUID.\n     *\n     * IMPORTANT: This method does NOT copy the shared Series Codex to the\n     * detached book. Doing so would duplicate canonical entities with\n     * persisted UUIDs, creating identity conflicts. Instead, the detached\n     * book simply loses the series membership and can still access inherited\n     * Codex through Universe-level inheritance if applicable.\n     */\n    async removeBookFromSeries(seriesUuid: string, project: import('../models/StoryLineProject').StoryLineProject): Promise<void> {\n        const found = await this.getSeriesByUuid(seriesUuid);\n        if (!found) throw new Error(`Series with UUID \"${seriesUuid}\" not found.`);\n        const { folder: seriesFolder, meta } = found;\n        const bookFolders = deriveProjectFoldersFromFilePath(project.filePath);\n        const bookBaseName = bookFolders.baseFolder.split('/').pop() ?? '';\n        const root = this.plugin.settings.storyLineRoot;\n        const targetBookFolder = normalizePath(`${root}/${bookBaseName}`);\n\n        // Preflight: check for destination collision before moving anything\n        if (normalizePath(bookFolders.baseFolder) !== targetBookFolder) {\n            if (await this.app.vault.adapter.exists(targetBookFolder)) {\n                throw new Error(`A folder named \"${bookBaseName}\" already exists in the StoryLine root.`);\n            }\n        }\n\n        const oldFilePath = project.filePath;\n        const wasActive = this.plugin.sceneManager.activeProject === project;\n        if (normalizePath(bookFolders.baseFolder) !== targetBookFolder) {\n            await this.moveFolderRecursive(bookFolders.baseFolder, targetBookFolder);\n            // CRITICAL: Update project.filePath to reflect the new location\n            const bookFileName = project.filePath.split('/').pop() ?? `${bookBaseName}.md`;\n            project.filePath = normalizePath(`${targetBookFolder}/${bookFileName}`);\n        }\n\n        // DO NOT copy the shared Series Codex to the detached book.\n        // This would duplicate canonical entities and create UUID conflicts.\n        // The detached book remains standalone; if it belongs to a Universe,\n        // it can still access Universe-level Codex through inheritance.\n\n        meta.bookOrder = meta.bookOrder.filter(b => b !== bookBaseName);\n        if (project.bookId && meta.bookIds) {\n            meta.bookIds = meta.bookIds.filter(id => id !== project.bookId);\n        }\n        await this.saveSeriesMetadata(seriesFolder, meta);\n        delete project.seriesId;\n        delete project.seriesUuid;\n\n        // Save frontmatter using the UPDATED project.filePath\n        await this.plugin.sceneManager.saveProjectFrontmatter(project);\n\n        // CRITICAL: Update SceneManager project registry key if file path changed\n        if (oldFilePath !== project.filePath) {\n            this.plugin.sceneManager.updateProjectPath(oldFilePath, project.filePath, project);\n        }\n\n        // If the active project file changed, update settings and active reference\n        if (wasActive) {\n            this.plugin.settings.activeProjectFile = project.filePath;\n            await this.plugin.saveSettings();\n        }\n\n        new Notice(`Book \"${project.title}\" removed from series \"${meta.name}\"`);\n    }\n\n    // ── Pre-flight ─────────────────────────────────────\n\n    /**\n     * Verify that Obsidian's link settings are safe for migration.\n     * Throws if \"Automatically update internal links\" is OFF.\n     * Shows a notice if link format is not \"shortest path\".\n     */\n    checkLinkSettings(): void {\n        const vaultConfig = ((this.app.vault as unknown as { config?: Record<string, unknown> }).config) ?? {};\n\n        // Obsidian stores the \"Automatically update internal links\" toggle\n        // under the internal key `alwaysUpdateLinks`. When it is `true`,\n        // auto-update is enabled (links are silently updated when files move).\n        // Default (undefined / false) = auto-update is OFF — Obsidian prompts\n        // or leaves stale links.\n        // Note: older Obsidian versions used `promptDelete` for a different\n        // setting (\"Confirm before deleting\"), so we check both keys for\n        // maximum compatibility, but `alwaysUpdateLinks` is the correct one.\n        const alwaysUpdate = vaultConfig.alwaysUpdateLinks === true;\n        if (!alwaysUpdate) {\n            throw new Error(\n                'Series migration requires \"Automatically update internal links\" to be ON.\\n\\n' +\n                'Go to Settings → Files & Links and enable it, then try again.'\n            );\n        }\n\n        const newLinkFormat = vaultConfig.newLinkFormat;\n        if (newLinkFormat && newLinkFormat !== 'shortest') {\n            new Notice(\n                'Tip: Setting \"New link format\" to \"Shortest path when possible\" ' +\n                'is recommended before migrating to a series.',\n                8000\n            );\n        }\n    }\n\n    // ── File operations ────────────────────────────────\n\n    /**\n     * Migrate all files from a book's Codex folder to the series Codex folder.\n     * Skips files that already exist in the destination (no overwrite).\n     * Removes the source codex folder when done (if empty).\n     */\n    private async migrateCodexFolder(sourceCodex: string, destCodex: string): Promise<void> {\n        const adapter = this.app.vault.adapter;\n        if (!await adapter.exists(sourceCodex)) return;\n\n        const listing = await adapter.list(sourceCodex);\n\n        // Migrate files at this level\n        for (const filePath of listing.files) {\n            const fileName = filePath.split('/').pop() ?? '';\n            const destFile = normalizePath(`${destCodex}/${fileName}`);\n            if (await adapter.exists(destFile)) {\n                // If the entries are identical, the series copy is already\n                // authoritative and the source duplicate can be removed so\n                // the migrated book does not look like a second copy. Keep\n                // differing files for manual review rather than losing data.\n                try {\n                    const sourceContent = await adapter.read(filePath);\n                    const destContent = await adapter.read(destFile);\n                    if (sourceContent === destContent) {\n                        const sourceFile = this.app.vault.getAbstractFileByPath(filePath);\n                        if (sourceFile) await this.app.fileManager.trashFile(sourceFile);\n                    }\n                } catch { /* keep an unreadable duplicate */ }\n                continue;\n            }\n            // Use fileManager.renameFile for safe link updates\n            const file = this.app.vault.getAbstractFileByPath(filePath);\n            if (file) {\n                await this.app.fileManager.renameFile(file, destFile);\n            }\n        }\n\n        // Recursively migrate subfolders\n        for (const subFolder of listing.folders) {\n            const subName = subFolder.split('/').pop() ?? '';\n            const destSub = normalizePath(`${destCodex}/${subName}`);\n            await this.ensureFolder(destSub);\n            await this.migrateCodexFolder(subFolder, destSub);\n        }\n\n        await this.removeFolderIfEmpty(sourceCodex);\n    }\n\n    /**\n     * Move an entire folder tree from source to destination.\n     * Uses fileManager.renameFile for each file to preserve links.\n     */\n    private async moveFolderRecursive(source: string, dest: string): Promise<void> {\n        const adapter = this.app.vault.adapter;\n        if (!await adapter.exists(source)) return;\n\n        const normSource = normalizePath(source);\n        const normDest = normalizePath(dest);\n        // Defensive guard against pathological inputs (e.g. dest inside source\n        // due to a same-name collision between series and book — issue #82).\n        // Without this we would recurse forever moving the destination subtree\n        // back into itself.\n        if (normSource === normDest) return;\n        if (normDest.startsWith(`${normSource}/`)) {\n            throw new Error(\n                `Cannot move \"${normSource}\" into its own subfolder \"${normDest}\". ` +\n                `Choose a different destination name.`\n            );\n        }\n\n        await this.ensureFolder(dest);\n        const listing = await adapter.list(source);\n\n        for (const filePath of listing.files) {\n            const fileName = filePath.split('/').pop() ?? '';\n            const destFile = normalizePath(`${dest}/${fileName}`);\n            const file = this.app.vault.getAbstractFileByPath(filePath);\n            if (file) {\n                await this.app.fileManager.renameFile(file, destFile);\n            }\n        }\n\n        for (const subFolder of listing.folders) {\n            const subName = subFolder.split('/').pop() ?? '';\n            const destSub = normalizePath(`${dest}/${subName}`);\n            await this.moveFolderRecursive(subFolder, destSub);\n        }\n\n        await this.removeFolderIfEmpty(source);\n    }\n\n    private async removeFolderIfEmpty(folder: string): Promise<void> {\n        const adapter = this.app.vault.adapter;\n        try {\n            if (!await adapter.exists(folder)) return;\n            const remaining = await adapter.list(folder);\n            if (remaining.files.length === 0 && remaining.folders.length === 0) {\n                await adapter.rmdir(folder, false);\n            }\n        } catch { /* non-fatal */ }\n    }\n\n    /**\n     * Remove a stale legacy book folder once its contents were already moved\n     * into the new series location. This catches the follow-up cleanup for\n     * duplicated folders left behind after a book is migrated into a series.\n     */\n    private async removeDuplicateLegacyFolder(legacyFolder: string, migratedFolder: string): Promise<void> {\n        const adapter = this.app.vault.adapter;\n        if (!legacyFolder || !migratedFolder) return;\n        if (normalizePath(legacyFolder) === normalizePath(migratedFolder)) return;\n        if (!await adapter.exists(legacyFolder) || !await adapter.exists(migratedFolder)) return;\n\n        const equivalent = await this.isFolderTreeEquivalent(legacyFolder, migratedFolder);\n        if (!equivalent) {\n            await this.removeFolderIfEmpty(legacyFolder);\n            return;\n        }\n\n        await this.deleteFolderTree(legacyFolder);\n    }\n\n    /**\n     * True when both folders contain the same file tree, so a stale duplicate\n     * can be safely removed after a successful migration.\n     */\n    private async isFolderTreeEquivalent(folderA: string, folderB: string): Promise<boolean> {\n        const adapter = this.app.vault.adapter;\n        try {\n            const aList = await adapter.list(folderA);\n            const bList = await adapter.list(folderB);\n\n            if (aList.files.length !== bList.files.length || aList.folders.length !== bList.folders.length) {\n                return false;\n            }\n\n            const aFiles = [...aList.files].map(f => f.split('/').pop() ?? '').sort();\n            const bFiles = [...bList.files].map(f => f.split('/').pop() ?? '').sort();\n            if (aFiles.length !== bFiles.length || aFiles.some((f, i) => f !== bFiles[i])) {\n                return false;\n            }\n\n            for (const filePath of aList.files) {\n                const base = filePath.split('/').pop() ?? '';\n                const aContent = await adapter.read(filePath);\n                const bContent = await adapter.read(normalizePath(`${folderB}/${base}`));\n                if (aContent !== bContent) return false;\n            }\n\n            for (const folderPath of aList.folders) {\n                const name = folderPath.split('/').pop() ?? '';\n                if (!await this.isFolderTreeEquivalent(folderPath, normalizePath(`${folderB}/${name}`))) {\n                    return false;\n                }\n            }\n\n            return true;\n        } catch {\n            return false;\n        }\n    }\n\n    private async deleteFolderTree(folder: string): Promise<void> {\n        const adapter = this.app.vault.adapter;\n        try {\n            if (!await adapter.exists(folder)) return;\n            const listing = await adapter.list(folder);\n            for (const filePath of listing.files) {\n                const file = this.app.vault.getAbstractFileByPath(filePath);\n                if (file) await this.app.fileManager.trashFile(file);\n                else await adapter.remove(filePath);\n            }\n            for (const childFolder of listing.folders) {\n                await this.deleteFolderTree(childFolder);\n            }\n            await this.removeFolderIfEmpty(folder);\n        } catch { /* non-fatal */ }\n    }\n\n    /**\n     * Copy folder contents (non-destructive, for restore when leaving a series).\n     */\n    private async copyFolderRecursive(source: string, dest: string): Promise<void> {\n        const adapter = this.app.vault.adapter;\n        if (!await adapter.exists(source)) return;\n\n        await this.ensureFolder(dest);\n        const listing = await adapter.list(source);\n\n        for (const filePath of listing.files) {\n            const fileName = filePath.split('/').pop() ?? '';\n            const destFile = normalizePath(`${dest}/${fileName}`);\n            if (await adapter.exists(destFile)) continue;\n            try {\n                const content = await adapter.read(filePath);\n                await adapter.write(destFile, content);\n            } catch { /* skip unreadable */ }\n        }\n\n        for (const subFolder of listing.folders) {\n            const subName = subFolder.split('/').pop() ?? '';\n            await this.copyFolderRecursive(subFolder, normalizePath(`${dest}/${subName}`));\n        }\n    }\n\n    private async ensureFolder(folderPath: string): Promise<void> {\n        const adapter = this.app.vault.adapter;\n        if (!await adapter.exists(folderPath)) {\n            await adapter.mkdir(folderPath);\n        }\n    }\n}\n/* eslint-enable @typescript-eslint/no-unsafe-member-access, @typescript-eslint/no-unsafe-assignment -- end of file-wide suppression block opened at line 1 */\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/services/ServiceInterfaces.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Timestamp' is defined but never used.","line":7,"column":25,"nodeType":"Identifier","messageId":"unusedVar","endLine":7,"endColumn":34,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Timestamp"},"fix":{"range":[202,213],"text":""},"desc":"Remove unused variable \"Timestamp\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'TemporalFactIndex' is defined but never used.","line":9,"column":29,"nodeType":"Identifier","messageId":"unusedVar","endLine":9,"endColumn":46,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"TemporalFactIndex"},"fix":{"range":[409,428],"text":""},"desc":"Remove unused variable \"TemporalFactIndex\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Shared Service Interfaces\n *\n * Interface definitions for services that will be implemented in later phases.\n * Phase 0 defines the contracts; Phase 1+ implements them.\n */\nimport type { TimeSpan, Timestamp, CalendarAdapter } from '../models/TimeSpan';\nimport type { EntityNode, EntityEdge, EntityGraphIndex, GraphQueryFilter, GraphQueryResult } from '../models/EntityGraph';\nimport type { TemporalFact, TemporalFactIndex } from '../models/TemporalFact';\n\n// ============================================================================\n// TimeSpanService Interface (implemented in Phase 2)\n// ============================================================================\n\n/**\n * Service for parsing, comparing, and formatting TimeSpan values.\n */\nexport interface TimeSpanService {\n    /** Parse a string into a TimeSpan */\n    parse(input: string): TimeSpan | null;\n    /** Format a TimeSpan to a display string */\n    format(timeSpan: TimeSpan): string;\n    /** Compare two TimeSpans; returns negative/zero/positive */\n    compare(a: TimeSpan, b: TimeSpan): number;\n    /** Check if two TimeSpans overlap */\n    overlaps(a: TimeSpan, b: TimeSpan): boolean;\n    /** Check if a TimeSpan contains another */\n    contains(container: TimeSpan, contained: TimeSpan): boolean;\n    /** Resolve a relative TimeSpan to an absolute one */\n    resolveRelative(timeSpan: TimeSpan, referenceResolver: (id: string) => TimeSpan | null): TimeSpan;\n    /** Register a calendar adapter */\n    registerCalendar(adapter: CalendarAdapter): void;\n    /** Get a calendar adapter by ID */\n    getCalendar(id: string): CalendarAdapter | null;\n}\n\n// ============================================================================\n// EntityGraphService Interface (implemented in Phase 4)\n// ============================================================================\n\n/**\n * Service for graph storage, derivation, queries, and temporal filtering.\n *\n * The derived graph index is stored in .storyline/system/entity-graph.json\n * to avoid Git churn. Temporal facts are persisted canonically in source file\n * frontmatter (YAML lists); the derived index at\n * .storyline/system/temporal-facts.json is reconstructible from source files\n * and is never the exclusive source of truth.\n */\nexport interface EntityGraphService {\n    /** Rebuild the graph index from frontmatter */\n    rebuildIndex(): Promise<void>;\n    /** Get all nodes */\n    getNodes(): EntityNode[];\n    /** Get a node by ID */\n    getNode(id: string): EntityNode | undefined;\n    /** Get all edges */\n    getEdges(): EntityEdge[];\n    /** Get edges connected to a node */\n    getEdgesForNode(nodeId: string): EntityEdge[];\n    /** Query the graph with filters */\n    query(filter: GraphQueryFilter): GraphQueryResult;\n    /** Get nodes valid at a specific time */\n    getNodesValidAt(timeSpan: TimeSpan): EntityNode[];\n    /** Get edges valid at a specific time */\n    getEdgesValidAt(timeSpan: TimeSpan): EntityEdge[];\n    /** Get the graph index */\n    getIndex(): EntityGraphIndex | null;\n    /** Get temporal facts for an entity */\n    getTemporalFacts(entityId: string): TemporalFact[];\n    /** Add a temporal fact */\n    addTemporalFact(fact: TemporalFact): void;\n    /** Save the temporal facts index */\n    saveTemporalFactIndex(): Promise<void>;\n}\n\n// ============================================================================\n// UniverseManager Interface (implemented in Phase 1)\n// ============================================================================\n\n/**\n * Universe metadata.\n */\nexport interface UniverseMetadata {\n    /** UUID of the universe */\n    id: string;\n    /** Display name */\n    name: string;\n    /** Series IDs contained in this universe */\n    seriesIds?: string[];\n    /** Created timestamp */\n    created: string;\n    /** Last modified timestamp */\n    modified?: string;\n}\n\n/**\n * Container entity abstraction shared by Universe and Series.\n */\nexport interface ContainerEntity {\n    /** UUID */\n    id: string;\n    /** Container type */\n    type: 'universe' | 'series';\n    /** Display name */\n    name: string;\n    /** Parent container ID (Universe ID for Series) */\n    parentId?: string;\n    /** Child container IDs (Series IDs for Universe, Book IDs for Series) */\n    childIds?: string[];\n    /** Created timestamp */\n    created: string;\n}\n\n/**\n * Service for Universe/Series/Book hierarchy management.\n */\nexport interface UniverseManager {\n    /** Create a new universe */\n    createUniverse(name: string): Promise<UniverseMetadata>;\n    /** Get a universe by ID */\n    getUniverse(id: string): UniverseMetadata | null;\n    /** Get all universes */\n    getAllUniverses(): UniverseMetadata[];\n    /** Delete a universe */\n    deleteUniverse(id: string): Promise<void>;\n    /** Add a series to a universe */\n    addSeriesToUniverse(universeId: string, seriesId: string): Promise<void>;\n    /** Remove a series from a universe */\n    removeSeriesFromUniverse(universeId: string, seriesId: string): Promise<void>;\n    /** Get series IDs for a universe */\n    getSeriesForUniverse(universeId: string): string[];\n    /** Get the universe ID for a series */\n    getUniverseForSeries(seriesId: string): string | null;\n    /** Resolve inherited collections (Characters, Locations, Codex, Events) for a book */\n    resolveInheritedCollections(bookId: string, collectionType: string): string[];\n    /** Get the owner ID for an entity */\n    getOwnerId(entityId: string): string | null;\n}","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/services/SnapshotManager.ts","messages":[{"ruleId":"complexity","severity":2,"message":"Async method 'renameSceneSnapshots' has a complexity of 13. Maximum allowed is 10.","line":191,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":191,"endColumn":31},{"ruleId":"complexity","severity":2,"message":"Async method 'migrateLegacySnapshotsFolder' has a complexity of 17. Maximum allowed is 10.","line":271,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":271,"endColumn":47},{"ruleId":"max-statements","severity":2,"message":"Async method 'migrateLegacySnapshotsFolder' has too many statements (26). Maximum allowed is 25.","line":271,"column":47,"nodeType":"FunctionExpression","messageId":"exceed","endLine":309,"endColumn":6},{"ruleId":"max-depth","severity":2,"message":"Blocks are nested too deeply (4). Maximum allowed is 3.","line":292,"column":21,"nodeType":"TryStatement","messageId":"tooDeeply","endLine":296,"endColumn":45},{"ruleId":"max-lines","severity":2,"message":"File has too many lines (213). Maximum allowed is 200.","line":318,"column":1,"nodeType":null,"messageId":"exceed","endLine":334,"endColumn":1}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":" \n/**\n * SnapshotManager — save, list, compare and restore named snapshots\n * of individual scene files.\n *\n * Snapshots are stored as sibling files in a `.snapshots/` sub-folder\n * next to each scene, or alternatively under the project's `.snapshots/`\n * directory. Each snapshot is a plain markdown file containing the full\n * scene content (frontmatter + body) at the moment of capture.\n *\n * Naming convention:\n *   <scene-basename>__<timestamp>__<label>.md\n */\n\nimport { App, TFile, TFolder, normalizePath, Notice, type DataAdapter } from 'obsidian';\nimport { tokenizeWords, DEFAULT_STORYLINE_LOCALE, type StoryLineLocale } from '../utils/locale';\n\nexport interface SceneSnapshot {\n    /** Vault-relative path of the snapshot file */\n    filePath: string;\n    /** Original scene file path */\n    sceneFilePath: string;\n    /** User-provided label */\n    label: string;\n    /** ISO timestamp of when the snapshot was taken */\n    timestamp: string;\n    /** Word count at snapshot time */\n    wordcount?: number;\n}\n\nexport class SnapshotManager {\n    private app: App;\n    private getLocale: () => StoryLineLocale;\n\n    constructor(app: App, getLocale: () => StoryLineLocale = () => DEFAULT_STORYLINE_LOCALE) {\n        this.app = app;\n        this.getLocale = getLocale;\n    }\n\n    /**\n     * Save a named snapshot of a scene.\n     */\n    async saveSnapshot(sceneFilePath: string, label: string): Promise<SceneSnapshot> {\n        // Issue #182 — guard against non-string inputs that would crash\n        // downstream `.replace()` calls when building the snapshot filename.\n        const safePath = typeof sceneFilePath === 'string' ? sceneFilePath : String(sceneFilePath ?? '');\n        const safeLabel = typeof label === 'string' ? label : String(label ?? 'Snapshot');\n        const file = this.app.vault.getAbstractFileByPath(safePath);\n        if (!(file instanceof TFile)) {\n            throw new Error(`Scene file not found: ${safePath}`);\n        }\n\n        // Migrate any legacy snapshots from the (vault-invisible) `.snapshots`\n        // folder into the current snapshot folder before saving.\n        await this.migrateLegacySnapshotsFolder(safePath);\n\n        const content = await this.app.vault.read(file);\n        const timestamp = new Date().toISOString().replace(/[:.]/g, '-');\n        const safeName = file.basename.replace(/[\\\\/:*?\"<>|]/g, '-');\n        const safeLabelPart = safeLabel.replace(/[\\\\/:*?\"<>|]/g, '-').substring(0, 40);\n\n        const snapshotDir = this.getSnapshotDir(safePath);\n        await this.ensureFolder(snapshotDir);\n\n        const snapshotFileName = `${safeName}__${timestamp}__${safeLabelPart}.md`;\n        const snapshotPath = normalizePath(`${snapshotDir}/${snapshotFileName}`);\n\n        // Write the snapshot as an exact copy of the scene file so it opens\n        // identically in Obsidian (frontmatter on line 1 is recognized as\n        // Properties and collapsed away). Metadata (label, timestamp,\n        // wordcount) is recovered from the filename + body on listing.\n        const wordcount = this.countWords(content);\n        await this.app.vault.create(snapshotPath, content);\n\n        new Notice(`Snapshot \"${safeLabel}\" saved`);\n\n        return {\n            filePath: snapshotPath,\n            sceneFilePath: safePath,\n            label: safeLabel,\n            timestamp: new Date().toISOString(),\n            wordcount,\n        };\n    }\n\n    /**\n     * List all snapshots for a given scene, newest first.\n     */\n    async listSnapshots(sceneFilePath: string): Promise<SceneSnapshot[]> {\n        const file = this.app.vault.getAbstractFileByPath(sceneFilePath);\n        if (!(file instanceof TFile)) return [];\n\n        // Migrate any legacy snapshots from `.snapshots` (hidden from Obsidian's\n        // vault index) into the visible snapshot folder.\n        await this.migrateLegacySnapshotsFolder(sceneFilePath);\n\n        const snapshotDir = this.getSnapshotDir(sceneFilePath);\n        const folder = this.app.vault.getAbstractFileByPath(snapshotDir);\n        if (!(folder instanceof TFolder)) return [];\n\n        const baseName = file.basename;\n        const snapshots: SceneSnapshot[] = [];\n\n        for (const child of folder.children) {\n            if (!(child instanceof TFile) || !child.name.startsWith(baseName + '__')) continue;\n\n            // Parse filename: basename__timestamp__label.md\n            const parts = child.basename.split('__');\n            if (parts.length < 3) continue;\n\n            const content = await this.app.vault.read(child);\n            // Legacy snapshots carried a `<!-- StoryLine Snapshot ... -->`\n            // header with label/timestamp/wordcount; new ones are exact copies\n            // of the source and derive metadata from the filename + body.\n            const meta = this.parseSnapshotHeader(content);\n            const body = content.replace(/^<!--[\\s\\S]*?-->\\n?/, '');\n\n            snapshots.push({\n                filePath: child.path,\n                sceneFilePath,\n                label: meta.label || parts.slice(2).join('__'),\n                timestamp: meta.timestamp || parts[1].replace(/-/g, ':'),\n                wordcount: meta.wordcount ?? this.countWords(body),\n            });\n        }\n\n        // Sort newest first\n        snapshots.sort((a, b) => b.timestamp.localeCompare(a.timestamp));\n        return snapshots;\n    }\n\n    /** List snapshot milestones without reading snapshot body content. */\n    async listSnapshotMetadata(sceneFilePath: string): Promise<SceneSnapshot[]> {\n        const file = this.app.vault.getAbstractFileByPath(sceneFilePath);\n        if (!(file instanceof TFile)) return [];\n        await this.migrateLegacySnapshotsFolder(sceneFilePath);\n        const folder = this.app.vault.getAbstractFileByPath(this.getSnapshotDir(sceneFilePath));\n        if (!(folder instanceof TFolder)) return [];\n\n        return folder.children\n            .filter((child): child is TFile => child instanceof TFile && child.name.startsWith(`${file.basename}__`))\n            .map(child => {\n                const parts = child.basename.split('__');\n                return {\n                    filePath: child.path,\n                    sceneFilePath,\n                    label: parts.slice(2).join('__') || 'Snapshot',\n                    timestamp: new Date(child.stat.mtime).toISOString(),\n                };\n            })\n            .sort((a, b) => b.timestamp.localeCompare(a.timestamp));\n    }\n\n    /**\n     * Read the content of a snapshot. Legacy snapshots had a leading HTML\n     * comment header that is stripped here; modern snapshots are exact copies\n     * of the source file and are returned unchanged.\n     */\n    async readSnapshotContent(snapshotPath: string): Promise<string> {\n        const file = this.app.vault.getAbstractFileByPath(snapshotPath);\n        if (!(file instanceof TFile)) throw new Error(`Snapshot not found: ${snapshotPath}`);\n\n        const content = await this.app.vault.read(file);\n        // Strip the legacy StoryLine header comment if present.\n        return content.replace(/^<!--\\s*StoryLine Snapshot[\\s\\S]*?-->\\n?/, '');\n    }\n\n    /**\n     * Restore a snapshot — replaces the scene file content with the snapshot.\n     */\n    async restoreSnapshot(snapshotPath: string, sceneFilePath: string): Promise<void> {\n        const sceneFile = this.app.vault.getAbstractFileByPath(sceneFilePath);\n        if (!(sceneFile instanceof TFile)) throw new Error(`Scene not found: ${sceneFilePath}`);\n\n        const snapshotContent = await this.readSnapshotContent(snapshotPath);\n        await this.app.vault.modify(sceneFile, snapshotContent);\n        new Notice('Snapshot restored');\n    }\n\n    /**\n     * Delete a snapshot file.\n     */\n    async deleteSnapshot(snapshotPath: string): Promise<void> {\n        const file = this.app.vault.getAbstractFileByPath(snapshotPath);\n        if (file instanceof TFile) {\n            await this.app.fileManager.trashFile(file);\n        }\n    }\n\n    /** Keep snapshot filenames aligned with a renamed scene file. */\n    async renameSceneSnapshots(oldSceneFilePath: string, newSceneFilePath: string): Promise<void> {\n        const oldBase = oldSceneFilePath.split('/').pop()?.replace(/\\.md$/, '');\n        const newBase = newSceneFilePath.split('/').pop()?.replace(/\\.md$/, '');\n        if (!oldBase || !newBase || oldBase === newBase) return;\n\n        await this.migrateLegacySnapshotsFolder(oldSceneFilePath);\n\n        const oldDir = this.getSnapshotDir(oldSceneFilePath);\n        const newDir = this.getSnapshotDir(newSceneFilePath);\n        const oldFolder = this.app.vault.getAbstractFileByPath(oldDir);\n        if (!(oldFolder instanceof TFolder)) return;\n        if (oldDir !== newDir) await this.ensureFolder(newDir);\n\n        for (const child of [...oldFolder.children]) {\n            if (!(child instanceof TFile) || !child.name.startsWith(`${oldBase}__`)) continue;\n            const newName = `${newBase}${child.name.slice(oldBase.length)}`;\n            const destination = normalizePath(`${newDir}/${newName}`);\n            if (this.app.vault.getAbstractFileByPath(destination)) continue;\n            try {\n                await this.app.fileManager.renameFile(child, destination);\n            } catch {\n                // A snapshot rename should never block the scene rename.\n            }\n        }\n    }\n\n    /**\n     * Simple diff: returns lines that differ between snapshot and current scene.\n     */\n    async compareSnapshot(snapshotPath: string, sceneFilePath: string): Promise<{ added: string[]; removed: string[] }> {\n        const sceneFile = this.app.vault.getAbstractFileByPath(sceneFilePath);\n        if (!(sceneFile instanceof TFile)) return { added: [], removed: [] };\n\n        const currentContent = await this.app.vault.read(sceneFile);\n        const snapshotContent = await this.readSnapshotContent(snapshotPath);\n\n        const currentLines = currentContent.split('\\n');\n        const snapshotLines = snapshotContent.split('\\n');\n\n        const currentSet = new Set(currentLines);\n        const snapshotSet = new Set(snapshotLines);\n\n        const added = currentLines.filter(l => !snapshotSet.has(l) && l.trim());\n        const removed = snapshotLines.filter(l => !currentSet.has(l) && l.trim());\n\n        return { added, removed };\n    }\n\n    // ── Helpers ────────────────────────────────────────\n\n    private getSnapshotDir(sceneFilePath: string): string {\n        // Place snapshots folder next to the scene. Use an underscore prefix\n        // (not a dot) so the folder is visible to Obsidian's vault index —\n        // dot-prefixed folders are treated as hidden/system files and are\n        // skipped by `vault.getAbstractFileByPath`, which made snapshots\n        // appear to vanish even though the file was written to disk.\n        const parts = sceneFilePath.split('/');\n        parts.pop(); // remove filename\n        const dir = parts.join('/');\n        return normalizePath((dir ? dir + '/' : '') + '_snapshots');\n    }\n\n    private getLegacySnapshotDir(sceneFilePath: string): string {\n        const parts = sceneFilePath.split('/');\n        parts.pop();\n        const dir = parts.join('/');\n        return normalizePath((dir ? dir + '/' : '') + '.snapshots');\n    }\n\n    private async ensureFolder(path: string): Promise<void> {\n        if (!this.app.vault.getAbstractFileByPath(path)) {\n            await this.app.vault.createFolder(path);\n        }\n    }\n\n    /**\n     * One-shot migration: move any snapshots from the legacy `.snapshots`\n     * folder (invisible to Obsidian) into the new `_snapshots` folder so\n     * existing files written under the old scheme appear in the UI again.\n     */\n    private async migrateLegacySnapshotsFolder(sceneFilePath: string): Promise<void> {\n        const legacyDir = this.getLegacySnapshotDir(sceneFilePath);\n        const newDir = this.getSnapshotDir(sceneFilePath);\n        const adapter: DataAdapter = this.app.vault.adapter;\n        try {\n            const exists = await adapter.exists(legacyDir);\n            if (!exists) return;\n            const listing = await adapter.list(legacyDir);\n            const files: string[] = (listing && listing.files) || [];\n            if (files.length === 0) return;\n            await this.ensureFolder(newDir);\n            for (const src of files) {\n                const name = src.split('/').pop();\n                if (!name) continue;\n                const dst = normalizePath(`${newDir}/${name}`);\n                const dstExists = await adapter.exists(dst);\n                if (dstExists) continue;\n                try {\n                    await adapter.rename(src, dst);\n                } catch {\n                    // Fall back to copy + remove if rename fails\n                    try {\n                        const data = await adapter.read(src);\n                        await adapter.write(dst, data);\n                        await adapter.remove(src);\n                    } catch { /* ignore */ }\n                }\n            }\n            // Try to remove the now-empty legacy folder (best-effort)\n            try {\n                const after = await adapter.list(legacyDir);\n                if (after && (after.files || []).length === 0 && (after.folders || []).length === 0) {\n                    await adapter.rmdir(legacyDir, false);\n                }\n            } catch { /* ignore */ }\n        } catch {\n            /* migration is best-effort */\n        }\n    }\n\n    private countWords(content: string): number {\n        // Strip frontmatter\n        const body = content.replace(/^---[\\s\\S]*?---\\n?/, '');\n        return tokenizeWords(body.trim(), this.getLocale()).length;\n    }\n\n    private parseSnapshotHeader(content: string): { label?: string; timestamp?: string; wordcount?: number } {\n        const match = content.match(/^<!--[\\s\\S]*?-->/);\n        if (!match) return {};\n\n        const header = match[0];\n        const label = header.match(/label:\\s*(.+)/)?.[1]?.trim();\n        const timestamp = header.match(/timestamp:\\s*(.+)/)?.[1]?.trim();\n        const wc = header.match(/wordcount:\\s*(\\d+)/)?.[1];\n\n        return {\n            label,\n            timestamp,\n            wordcount: wc ? Number(wc) : undefined,\n        };\n    }\n}\n \n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/services/TimeSpanService.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'InstantTimeSpan' is defined but never used.","line":17,"column":5,"nodeType":"Identifier","messageId":"unusedVar","endLine":17,"endColumn":20,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"InstantTimeSpan"},"fix":{"range":[465,486],"text":""},"desc":"Remove unused variable \"InstantTimeSpan\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'IntervalTimeSpan' is defined but never used.","line":18,"column":5,"nodeType":"Identifier","messageId":"unusedVar","endLine":18,"endColumn":21,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"IntervalTimeSpan"},"fix":{"range":[486,508],"text":""},"desc":"Remove unused variable \"IntervalTimeSpan\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'OpenEndedTimeSpan' is defined but never used.","line":19,"column":5,"nodeType":"Identifier","messageId":"unusedVar","endLine":19,"endColumn":22,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"OpenEndedTimeSpan"},"fix":{"range":[508,531],"text":""},"desc":"Remove unused variable \"OpenEndedTimeSpan\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'UncertainTimeSpan' is defined but never used.","line":20,"column":5,"nodeType":"Identifier","messageId":"unusedVar","endLine":20,"endColumn":22,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"UncertainTimeSpan"},"fix":{"range":[531,554],"text":""},"desc":"Remove unused variable \"UncertainTimeSpan\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'UnknownTimeSpan' is defined but never used.","line":21,"column":5,"nodeType":"Identifier","messageId":"unusedVar","endLine":21,"endColumn":20,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"UnknownTimeSpan"},"fix":{"range":[554,575],"text":""},"desc":"Remove unused variable \"UnknownTimeSpan\"."}]},{"ruleId":"max-depth","severity":2,"message":"Blocks are nested too deeply (4). Maximum allowed is 3.","line":47,"column":21,"nodeType":"IfStatement","messageId":"tooDeeply","endLine":51,"endColumn":22},{"ruleId":"complexity","severity":2,"message":"Method 'compare' has a complexity of 14. Maximum allowed is 10.","line":106,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":106,"endColumn":12},{"ruleId":"complexity","severity":2,"message":"Method 'validateTimestamp' has a complexity of 17. Maximum allowed is 10.","line":165,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":165,"endColumn":22},{"ruleId":"complexity","severity":2,"message":"Method 'validateTimeSpan' has a complexity of 18. Maximum allowed is 10.","line":204,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":204,"endColumn":21},{"ruleId":"max-depth","severity":2,"message":"Blocks are nested too deeply (4). Maximum allowed is 3.","line":218,"column":25,"nodeType":"IfStatement","messageId":"tooDeeply","endLine":218,"endColumn":76},{"ruleId":"max-lines-per-function","severity":2,"message":"Method 'parse' has too many lines (69). Maximum allowed is 50.","line":256,"column":5,"nodeType":"MethodDefinition","messageId":"exceed","endLine":341,"endColumn":6},{"ruleId":"complexity","severity":2,"message":"Method 'parse' has a complexity of 12. Maximum allowed is 10.","line":256,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":256,"endColumn":10},{"ruleId":"max-statements","severity":2,"message":"Method 'parse' has too many statements (31). Maximum allowed is 25.","line":256,"column":10,"nodeType":"FunctionExpression","messageId":"exceed","endLine":341,"endColumn":6},{"ruleId":"max-lines","severity":2,"message":"File has too many lines (674). Maximum allowed is 200.","line":281,"column":1,"nodeType":null,"messageId":"exceed","endLine":943,"endColumn":1},{"ruleId":"complexity","severity":2,"message":"Method 'shiftTimestamp' has a complexity of 12. Maximum allowed is 10.","line":606,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":606,"endColumn":19},{"ruleId":"max-lines-per-function","severity":2,"message":"Method 'deserializeFromYaml' has too many lines (72). Maximum allowed is 50.","line":795,"column":5,"nodeType":"MethodDefinition","messageId":"exceed","endLine":868,"endColumn":6},{"ruleId":"complexity","severity":2,"message":"Method 'deserializeFromYaml' has a complexity of 31. Maximum allowed is 10.","line":795,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":795,"endColumn":24},{"ruleId":"complexity","severity":2,"message":"Method 'deserializeTimestamp' has a complexity of 14. Maximum allowed is 10.","line":873,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":873,"endColumn":33},{"ruleId":"complexity","severity":2,"message":"Method 'convertLegacyToTimeSpan' has a complexity of 11. Maximum allowed is 10.","line":904,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":904,"endColumn":28},{"ruleId":"max-depth","severity":2,"message":"Blocks are nested too deeply (4). Maximum allowed is 3.","line":917,"column":21,"nodeType":"IfStatement","messageId":"tooDeeply","endLine":929,"endColumn":22}],"suppressedMessages":[],"errorCount":15,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * TimeSpanService — Parsing, comparison, overlap detection, and display formatting.\n *\n * Implements the TimeSpanService interface from Phase 0. Provides:\n * - Gregorian calendar as the default calendar adapter\n * - String parsing for common date formats\n * - Comparison and overlap detection across all TimeSpan kinds\n * - Relative date resolution\n * - Display formatting\n */\n\nimport type {\n    TimeSpan,\n    Timestamp,\n    TemporalOffset,\n    CalendarAdapter,\n    InstantTimeSpan,\n    IntervalTimeSpan,\n    OpenEndedTimeSpan,\n    UncertainTimeSpan,\n    UnknownTimeSpan,\n    RelativeTimeSpan,\n    DatePrecision,\n} from '../models/TimeSpan';\nimport { DEFAULT_CALENDAR } from '../models/TimeSpan';\n\n// ============================================================================\n// Gregorian Calendar Adapter\n// ============================================================================\n\n/**\n * Default Gregorian calendar adapter.\n */\nclass GregorianCalendarAdapter implements CalendarAdapter {\n    id = DEFAULT_CALENDAR;\n    name = 'Gregorian';\n\n    format(timestamp: Timestamp): string {\n        const { year, month, day, hour, minute } = timestamp;\n        let result = String(year);\n        if (month !== undefined) {\n            result += `-${String(month).padStart(2, '0')}`;\n            if (day !== undefined) {\n                result += `-${String(day).padStart(2, '0')}`;\n                if (hour !== undefined) {\n                    result += ` ${String(hour).padStart(2, '0')}`;\n                    if (minute !== undefined) {\n                        result += `:${String(minute).padStart(2, '0')}`;\n                    } else {\n                        result += ':00';\n                    }\n                }\n            }\n        }\n        return result;\n    }\n\n    parse(input: string): Timestamp | null {\n        const trimmed = input.trim();\n        if (!trimmed) return null;\n\n        // ISO 8601 date: YYYY-MM-DD\n        const isoDate = trimmed.match(/^(\\d{4})-(\\d{1,2})-(\\d{1,2})(?:\\s+(\\d{1,2}):(\\d{1,2}))?$/);\n        if (isoDate) {\n            const [, year, month, day, hour, minute] = isoDate;\n            const ts: Timestamp = {\n                calendar: DEFAULT_CALENDAR,\n                year: parseInt(year, 10),\n                month: parseInt(month, 10),\n                day: parseInt(day, 10),\n                precision: 'day',\n            };\n            if (hour !== undefined) {\n                ts.hour = parseInt(hour, 10);\n                ts.minute = minute !== undefined ? parseInt(minute, 10) : 0;\n                ts.precision = minute !== undefined ? 'minute' : 'hour';\n            }\n            return ts;\n        }\n\n        // Year-month: YYYY-MM\n        const isoYearMonth = trimmed.match(/^(\\d{4})-(\\d{1,2})$/);\n        if (isoYearMonth) {\n            const [, year, month] = isoYearMonth;\n            return {\n                calendar: DEFAULT_CALENDAR,\n                year: parseInt(year, 10),\n                month: parseInt(month, 10),\n                precision: 'month',\n            };\n        }\n\n        // Year only: YYYY\n        const isoYear = trimmed.match(/^(\\d{4})$/);\n        if (isoYear) {\n            return {\n                calendar: DEFAULT_CALENDAR,\n                year: parseInt(isoYear[1], 10),\n                precision: 'year',\n            };\n        }\n\n        return null;\n    }\n\n    compare(a: Timestamp, b: Timestamp): number {\n        // Compare year\n        if (a.year !== b.year) return a.year - b.year;\n        // Compare month (undefined treated as 0 for comparison)\n        const aMonth = a.month ?? 0;\n        const bMonth = b.month ?? 0;\n        if (aMonth !== bMonth) return aMonth - bMonth;\n        // Compare day\n        const aDay = a.day ?? 0;\n        const bDay = b.day ?? 0;\n        if (aDay !== bDay) return aDay - bDay;\n        // Compare hour\n        const aHour = a.hour ?? 0;\n        const bHour = b.hour ?? 0;\n        if (aHour !== bHour) return aHour - bHour;\n        // Compare minute\n        const aMinute = a.minute ?? 0;\n        const bMinute = b.minute ?? 0;\n        if (aMinute !== bMinute) return aMinute - bMinute;\n        return 0;\n    }\n\n    equals(a: Timestamp, b: Timestamp): boolean {\n        return this.compare(a, b) === 0;\n    }\n}\n\n// ============================================================================\n// TimeSpanService Implementation\n// ============================================================================\n\nexport class TimeSpanService {\n    private calendars = new Map<string, CalendarAdapter>();\n\n    constructor() {\n        // Register default Gregorian calendar\n        this.calendars.set(DEFAULT_CALENDAR, new GregorianCalendarAdapter());\n    }\n\n    // ── Calendar Management ──\n\n    registerCalendar(adapter: CalendarAdapter): void {\n        this.calendars.set(adapter.id, adapter);\n    }\n\n    getCalendar(id: string): CalendarAdapter | null {\n        return this.calendars.get(id) ?? null;\n    }\n\n    private getAdapterForTimestamp(ts: Timestamp): CalendarAdapter | null {\n        return this.calendars.get(ts.calendar) ?? null;\n    }\n\n    // ── Validation ──\n\n    /**\n     * Validate a Gregorian timestamp. Returns an error message or null if valid.\n     * Checks month range, day range (including leap years), and time values.\n     */\n    validateTimestamp(ts: Timestamp): string | null {\n        if (ts.calendar !== DEFAULT_CALENDAR) {\n            const adapter = this.getAdapterForTimestamp(ts);\n            if (!adapter) return `Unknown calendar: ${ts.calendar}`;\n            // Delegate to calendar adapter if it supports validation\n            if ('validate' in adapter && typeof adapter.validate === 'function') {\n                return (adapter as { validate: (ts: Timestamp) => string | null }).validate(ts);\n            }\n            return null;\n        }\n\n        // Gregorian validation\n        if (ts.month !== undefined) {\n            if (ts.month < 1 || ts.month > 12) {\n                return `Invalid month: ${ts.month} (must be 1-12)`;\n            }\n            if (ts.day !== undefined) {\n                const maxDay = this.getDaysInMonth(ts.year, ts.month);\n                if (ts.day < 1 || ts.day > maxDay) {\n                    return `Invalid day: ${ts.day} for ${ts.month}/${ts.year} (max ${maxDay})`;\n                }\n            }\n        }\n        if (ts.hour !== undefined) {\n            if (ts.hour < 0 || ts.hour > 23) {\n                return `Invalid hour: ${ts.hour} (must be 0-23)`;\n            }\n        }\n        if (ts.minute !== undefined) {\n            if (ts.minute < 0 || ts.minute > 59) {\n                return `Invalid minute: ${ts.minute} (must be 0-59)`;\n            }\n        }\n        return null;\n    }\n\n    /**\n     * Validate a TimeSpan. Returns an error message or null if valid.\n     */\n    validateTimeSpan(timeSpan: TimeSpan): string | null {\n        switch (timeSpan.kind) {\n            case 'instant':\n                return this.validateTimestamp(timeSpan.instant);\n            case 'interval': {\n                const startErr = this.validateTimestamp(timeSpan.start);\n                if (startErr) return `Start: ${startErr}`;\n                const endErr = this.validateTimestamp(timeSpan.end);\n                if (endErr) return `End: ${endErr}`;\n                // Check that start <= end (same calendar only)\n                if (timeSpan.start.calendar === timeSpan.end.calendar) {\n                    const adapter = this.getAdapterForTimestamp(timeSpan.start);\n                    if (adapter) {\n                        const cmp = adapter.compare(timeSpan.start, timeSpan.end);\n                        if (cmp > 0) return 'Start date is after end date';\n                    }\n                }\n                return null;\n            }\n            case 'open-ended':\n                return this.validateTimestamp(timeSpan.start);\n            case 'uncertain': {\n                const rangeStartErr = this.validateTimestamp(timeSpan.range.start);\n                if (rangeStartErr) return `Range start: ${rangeStartErr}`;\n                const rangeEndErr = this.validateTimestamp(timeSpan.range.end);\n                if (rangeEndErr) return `Range end: ${rangeEndErr}`;\n                if (timeSpan.confidence !== undefined && (timeSpan.confidence < 0 || timeSpan.confidence > 1)) {\n                    return `Confidence must be 0-1, got ${timeSpan.confidence}`;\n                }\n                return null;\n            }\n            case 'unknown':\n                return null;\n            case 'relative':\n                if (!timeSpan.relativeTo) return 'Relative TimeSpan requires a reference ID';\n                return null;\n        }\n    }\n\n    // ── Parsing ──\n\n    /**\n     * Parse a string into a TimeSpan.\n     *\n     * Supported formats:\n     * - \"2024-01-15\" → instant\n     * - \"2024-01-15 to 2024-03-20\" → interval\n     * - \"2024-01-15 to ?\" → open-ended\n     * - \"circa 2024\" / \"~2024\" → uncertain (year-level)\n     * - \"unknown\" → unknown\n     * - \"3 days before event:abc-123\" → relative\n     */\n    parse(input: string): TimeSpan | null {\n        const trimmed = input.trim();\n        if (!trimmed) return null;\n\n        // Unknown\n        if (trimmed.toLowerCase() === 'unknown') {\n            return { kind: 'unknown', display: trimmed };\n        }\n\n        // Relative: \"N units direction event:ID\" or \"N units direction scene:ID\"\n        const relativeMatch = trimmed.match(\n            /^(\\d+)\\s+(day|week|month|year|season)s?\\s+(before|after)\\s+(event|scene):(.+)$/i\n        );\n        if (relativeMatch) {\n            const [, amount, unit, direction, , refId] = relativeMatch;\n            return {\n                kind: 'relative',\n                relativeTo: refId.trim(),\n                offset: {\n                    amount: parseInt(amount, 10),\n                    unit: unit as TemporalOffset['unit'],\n                    direction: direction.toLowerCase() as 'before' | 'after',\n                },\n                display: trimmed,\n            };\n        }\n\n        // Uncertain: \"circa YYYY\" or \"~YYYY\" or \"circa YYYY-MM-DD\"\n        const uncertainMatch = trimmed.match(/^(?:circa|~)\\s*(.+)$/i);\n        if (uncertainMatch) {\n            const inner = uncertainMatch[1].trim();\n            const ts = this.parseTimestamp(inner);\n            if (ts) {\n                // Create a range around the timestamp\n                const rangeStart = this.shiftTimestamp(ts, -1, 'year');\n                const rangeEnd = this.shiftTimestamp(ts, 1, 'year');\n                return {\n                    kind: 'uncertain',\n                    range: { start: rangeStart, end: rangeEnd },\n                    confidence: 0.5,\n                    display: trimmed,\n                };\n            }\n        }\n\n        // Interval: \"YYYY-MM-DD to YYYY-MM-DD\" or \"YYYY to YYYY\"\n        const intervalMatch = trimmed.match(/^(.+?)\\s+to\\s+(.+)$/i);\n        if (intervalMatch) {\n            const startStr = intervalMatch[1].trim();\n            const endStr = intervalMatch[2].trim();\n\n            const startTs = this.parseTimestamp(startStr);\n            if (!startTs) return null;\n\n            // Open-ended: \"YYYY-MM-DD to ?\"\n            if (endStr.toLowerCase() === '?' || endStr.toLowerCase() === 'unknown') {\n                return {\n                    kind: 'open-ended',\n                    start: startTs,\n                    display: trimmed,\n                };\n            }\n\n            const endTs = this.parseTimestamp(endStr);\n            if (!endTs) return null;\n\n            return {\n                kind: 'interval',\n                start: startTs,\n                end: endTs,\n                display: trimmed,\n            };\n        }\n\n        // Instant: single date\n        const ts = this.parseTimestamp(trimmed);\n        if (ts) {\n            return {\n                kind: 'instant',\n                instant: ts,\n                display: trimmed,\n            };\n        }\n\n        return null;\n    }\n\n    /**\n     * Parse a timestamp string using the appropriate calendar adapter.\n     */\n    parseTimestamp(input: string): Timestamp | null {\n        const gregorian = this.getCalendar(DEFAULT_CALENDAR);\n        if (gregorian) {\n            const result = gregorian.parse(input);\n            if (result) return result;\n        }\n        // Try other registered calendars\n        for (const adapter of this.calendars.values()) {\n            if (adapter.id !== DEFAULT_CALENDAR) {\n                const result = adapter.parse(input);\n                if (result) return result;\n            }\n        }\n        return null;\n    }\n\n    // ── Formatting ──\n\n    /**\n     * Format a TimeSpan to a display string.\n     */\n    format(timeSpan: TimeSpan): string {\n        switch (timeSpan.kind) {\n            case 'instant':\n                return this.formatTimestamp(timeSpan.instant);\n            case 'interval':\n                return `${this.formatTimestamp(timeSpan.start)} to ${this.formatTimestamp(timeSpan.end)}`;\n            case 'open-ended':\n                return `${this.formatTimestamp(timeSpan.start)} to ?`;\n            case 'uncertain':\n                return `circa ${this.formatTimestamp(timeSpan.range.start)} to ${this.formatTimestamp(timeSpan.range.end)}`;\n            case 'unknown':\n                return timeSpan.display || 'Unknown';\n            case 'relative':\n                return this.formatRelative(timeSpan);\n        }\n    }\n\n    /**\n     * Format a single timestamp.\n     */\n    formatTimestamp(ts: Timestamp): string {\n        const adapter = this.getAdapterForTimestamp(ts);\n        if (adapter) return adapter.format(ts);\n        // Fallback: simple year format\n        return String(ts.year);\n    }\n\n    /**\n     * Format a relative TimeSpan.\n     */\n    formatRelative(ts: RelativeTimeSpan): string {\n        const { amount, unit, direction } = ts.offset;\n        const unitLabel = unit === 'season' ? 'seasons' : `${unit}s`;\n        return `${amount} ${unitLabel} ${direction} ${ts.relativeTo}`;\n    }\n\n    // ── Comparison ──\n\n    /**\n     * Compare two TimeSpans for sorting purposes.\n     * Returns negative if a < b, zero if equal, positive if a > b.\n     * Uses the earliest point of each TimeSpan for comparison.\n     */\n    compare(a: TimeSpan, b: TimeSpan): number {\n        const aStart = this.getEarliestPoint(a);\n        const bStart = this.getEarliestPoint(b);\n\n        if (!aStart || !bStart) {\n            // Unknown/relative without resolution sort last\n            if (!aStart && !bStart) return 0;\n            if (!aStart) return 1;\n            return -1;\n        }\n\n        return this.compareTimestamps(aStart, bStart);\n    }\n\n    /**\n     * Get the earliest comparable point from a TimeSpan.\n     * Public for use by EventManager and TimelineView.\n     */\n    getEarliestPoint(ts: TimeSpan): Timestamp | null {\n        switch (ts.kind) {\n            case 'instant':\n                return ts.instant;\n            case 'interval':\n                return ts.start;\n            case 'open-ended':\n                return ts.start;\n            case 'uncertain':\n                return ts.range.start;\n            case 'unknown':\n                return null;\n            case 'relative':\n                // Cannot resolve without a reference resolver\n                return null;\n        }\n    }\n\n    /**\n     * Compare two timestamps using their calendar adapter.\n     * Public for use by TimelineView.\n     */\n    compareTimestamps(a: Timestamp, b: Timestamp): number {\n        // If same calendar, use that adapter\n        if (a.calendar === b.calendar) {\n            const adapter = this.getAdapterForTimestamp(a);\n            if (adapter) return adapter.compare(a, b);\n        }\n        // Cross-calendar fallback: compare by year only\n        if (a.year !== b.year) return a.year - b.year;\n        return 0;\n    }\n\n    // ── Overlap Detection ──\n\n    /**\n     * Check if two TimeSpans overlap.\n     */\n    overlaps(a: TimeSpan, b: TimeSpan): boolean {\n        // Unknown never overlaps with anything specific\n        if (a.kind === 'unknown' || b.kind === 'unknown') return false;\n\n        // Relative dates need resolution\n        if (a.kind === 'relative' || b.kind === 'relative') {\n            // Cannot determine overlap without resolving references\n            return false;\n        }\n\n        const aRange = this.toRange(a);\n        const bRange = this.toRange(b);\n\n        if (!aRange || !bRange) return false;\n\n        // Two ranges overlap if one starts before the other ends and vice versa\n        const aStartsBeforeBEnds = this.compareTimestamps(aRange.start, bRange.end) <= 0;\n        const bStartsBeforeAEnds = this.compareTimestamps(bRange.start, aRange.end) <= 0;\n\n        return aStartsBeforeBEnds && bStartsBeforeAEnds;\n    }\n\n    /**\n     * Convert a TimeSpan to a start/end range for overlap comparison.\n     * Open-ended intervals use a very large year as the end.\n     */\n    private toRange(ts: TimeSpan): { start: Timestamp; end: Timestamp } | null {\n        switch (ts.kind) {\n            case 'instant': {\n                const t = ts.instant;\n                return { start: t, end: t };\n            }\n            case 'interval':\n                return { start: ts.start, end: ts.end };\n            case 'open-ended':\n                return {\n                    start: ts.start,\n                    end: { ...ts.start, year: 999999, precision: 'year' },\n                };\n            case 'uncertain':\n                return { start: ts.range.start, end: ts.range.end };\n            case 'unknown':\n            case 'relative':\n                return null;\n        }\n    }\n\n    // ── Contains ──\n\n    /**\n     * Check if one TimeSpan fully contains another.\n     */\n    contains(container: TimeSpan, contained: TimeSpan): boolean {\n        if (container.kind === 'unknown' || contained.kind === 'unknown') return false;\n        if (container.kind === 'relative' || contained.kind === 'relative') return false;\n\n        const cRange = this.toRange(container);\n        const dRange = this.toRange(contained);\n\n        if (!cRange || !dRange) return false;\n\n        // Container contains contained if container starts before or at contained's start\n        // and container ends after or at contained's end\n        const startsBefore = this.compareTimestamps(cRange.start, dRange.start) <= 0;\n        const endsAfter = this.compareTimestamps(cRange.end, dRange.end) >= 0;\n\n        return startsBefore && endsAfter;\n    }\n\n    // ── Relative Date Resolution ──\n\n    /**\n     * Resolve a relative TimeSpan to an absolute one.\n     * If the reference cannot be resolved, returns the original TimeSpan unchanged.\n     */\n    resolveRelative(\n        timeSpan: TimeSpan,\n        referenceResolver: (id: string) => TimeSpan | null\n    ): TimeSpan {\n        if (timeSpan.kind !== 'relative') return timeSpan;\n\n        // Resolve the reference, applying offsets bottom-up\n        const resolved = this.resolveRelativeChain(timeSpan, referenceResolver, 0);\n        return resolved;\n    }\n\n    /**\n     * Recursively resolve a chain of relative TimeSpans, accumulating offsets.\n     * Returns the final absolute timestamp as an instant, or unknown if unresolvable.\n     */\n    private resolveRelativeChain(\n        timeSpan: TimeSpan,\n        referenceResolver: (id: string) => TimeSpan | null,\n        depth: number\n    ): TimeSpan {\n        if (depth > 10) return { kind: 'unknown', display: 'Resolution depth exceeded' };\n\n        if (timeSpan.kind !== 'relative') {\n            // Base case: non-relative TimeSpan\n            const point = this.getEarliestPoint(timeSpan);\n            if (!point) return { kind: 'unknown', display: 'Cannot extract timestamp' };\n            return { kind: 'instant', instant: point };\n        }\n\n        // Get the reference\n        const reference = referenceResolver(timeSpan.relativeTo);\n        if (!reference) {\n            return { kind: 'unknown', display: timeSpan.display || `Unresolved: ${timeSpan.relativeTo}` };\n        }\n\n        // Recursively resolve the reference first\n        const resolvedRef = this.resolveRelativeChain(reference, referenceResolver, depth + 1);\n\n        // If the reference resolved to unknown, propagate\n        if (resolvedRef.kind === 'unknown') {\n            return resolvedRef;\n        }\n\n        // Get the concrete timestamp from the resolved reference\n        const refPoint = this.getEarliestPoint(resolvedRef);\n        if (!refPoint) {\n            return { kind: 'unknown', display: timeSpan.display || `Unresolved: ${timeSpan.relativeTo}` };\n        }\n\n        // Apply this level's offset\n        const { amount, unit, direction } = timeSpan.offset;\n        const shift = direction === 'before' ? -amount : amount;\n        const result = this.shiftTimestamp(refPoint, shift, unit);\n\n        return {\n            kind: 'instant',\n            instant: result,\n            display: timeSpan.display,\n        };\n    }\n\n    /**\n     * Shift a timestamp by a given amount and unit.\n     * Handles month/year boundaries correctly, including leap years.\n     */\n    shiftTimestamp(ts: Timestamp, amount: number, unit: TemporalOffset['unit']): Timestamp {\n        const result: Timestamp = { ...ts };\n\n        switch (unit) {\n            case 'day':\n            case 'week': {\n                const days = unit === 'week' ? amount * 7 : amount;\n                if (result.day !== undefined && result.month !== undefined) {\n                    const shifted = this.addDays(result.year, result.month, result.day, days);\n                    result.year = shifted.year;\n                    result.month = shifted.month;\n                    result.day = shifted.day;\n                }\n                break;\n            }\n            case 'month':\n            case 'season': {\n                const months = unit === 'season' ? amount * 3 : amount;\n                if (result.month !== undefined) {\n                    const shifted = this.addMonths(result.year, result.month, result.day, months);\n                    result.year = shifted.year;\n                    result.month = shifted.month;\n                    if (shifted.day !== undefined) result.day = shifted.day;\n                }\n                break;\n            }\n            case 'year':\n                result.year += amount;\n                break;\n        }\n\n        return result;\n    }\n\n    /**\n     * Add days to a date, handling month/year boundaries and leap years.\n     */\n    private addDays(year: number, month: number, day: number, days: number): { year: number; month: number; day: number } {\n        let y = year;\n        let m = month;\n        let d = day + days;\n\n        // Handle negative days by normalizing\n        while (d < 1) {\n            m -= 1;\n            if (m < 1) {\n                m = 12;\n                y -= 1;\n            }\n            d += this.getDaysInMonth(y, m);\n        }\n\n        // Handle overflow\n        while (true) {\n            const maxDay = this.getDaysInMonth(y, m);\n            if (d <= maxDay) break;\n            d -= maxDay;\n            m += 1;\n            if (m > 12) {\n                m = 1;\n                y += 1;\n            }\n        }\n\n        return { year: y, month: m, day: d };\n    }\n\n    /**\n     * Add months to a date, clamping the day to the target month's max.\n     * E.g., Jan 31 + 1 month = Feb 28 (or Feb 29 in leap year).\n     */\n    private addMonths(year: number, month: number, day: number | undefined, months: number): { year: number; month: number; day?: number } {\n        let y = year;\n        let m = month + months;\n\n        // Normalize month\n        while (m > 12) {\n            m -= 12;\n            y += 1;\n        }\n        while (m < 1) {\n            m += 12;\n            y -= 1;\n        }\n\n        // Clamp day to target month's max\n        let d = day;\n        if (d !== undefined) {\n            const maxDay = this.getDaysInMonth(y, m);\n            d = Math.min(d, maxDay);\n        }\n\n        return { year: y, month: m, day: d };\n    }\n\n    /**\n     * Get the number of days in a month, accounting for leap years.\n     */\n    getDaysInMonth(year: number, month: number): number {\n        if (month === 2) {\n            return this.isLeapYear(year) ? 29 : 28;\n        }\n        const daysInMonth = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n        return daysInMonth[month] || 30;\n    }\n\n    /**\n     * Check if a year is a leap year in the Gregorian calendar.\n     */\n    isLeapYear(year: number): boolean {\n        return (year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0);\n    }\n\n    // ── YAML Serialization/Deserialization ──\n\n    /**\n     * Serialize a TimeSpan to a plain object suitable for YAML serialization.\n     * The format is lossless and can be round-tripped back to a TimeSpan.\n     */\n    serializeToYaml(timeSpan: TimeSpan): Record<string, unknown> {\n        switch (timeSpan.kind) {\n            case 'instant':\n                return {\n                    kind: 'instant',\n                    instant: this.serializeTimestamp(timeSpan.instant),\n                    display: timeSpan.display,\n                };\n            case 'interval':\n                return {\n                    kind: 'interval',\n                    start: this.serializeTimestamp(timeSpan.start),\n                    end: this.serializeTimestamp(timeSpan.end),\n                    display: timeSpan.display,\n                };\n            case 'open-ended':\n                return {\n                    kind: 'open-ended',\n                    start: this.serializeTimestamp(timeSpan.start),\n                    display: timeSpan.display,\n                };\n            case 'uncertain':\n                return {\n                    kind: 'uncertain',\n                    range: {\n                        start: this.serializeTimestamp(timeSpan.range.start),\n                        end: this.serializeTimestamp(timeSpan.range.end),\n                    },\n                    confidence: timeSpan.confidence,\n                    display: timeSpan.display,\n                };\n            case 'unknown':\n                return {\n                    kind: 'unknown',\n                    display: timeSpan.display,\n                };\n            case 'relative':\n                return {\n                    kind: 'relative',\n                    relativeTo: timeSpan.relativeTo,\n                    offset: {\n                        amount: timeSpan.offset.amount,\n                        unit: timeSpan.offset.unit,\n                        direction: timeSpan.offset.direction,\n                    },\n                    display: timeSpan.display,\n                };\n        }\n    }\n\n    /**\n     * Serialize a Timestamp to a plain object for YAML.\n     */\n    private serializeTimestamp(ts: Timestamp): Record<string, unknown> {\n        const result: Record<string, unknown> = {\n            calendar: ts.calendar,\n            year: ts.year,\n        };\n        if (ts.month !== undefined) result.month = ts.month;\n        if (ts.day !== undefined) result.day = ts.day;\n        if (ts.hour !== undefined) result.hour = ts.hour;\n        if (ts.minute !== undefined) result.minute = ts.minute;\n        if (ts.precision !== undefined) result.precision = ts.precision;\n        return result;\n    }\n\n    /**\n     * Deserialize a TimeSpan from a plain object (parsed from YAML).\n     * Returns null if the object is not a valid TimeSpan.\n     */\n    deserializeFromYaml(obj: unknown): TimeSpan | null {\n        if (!obj || typeof obj !== 'object') return null;\n        const data = obj as Record<string, unknown>;\n        const kind = data.kind;\n\n        if (typeof kind !== 'string') return null;\n\n        switch (kind) {\n            case 'instant': {\n                const instant = this.deserializeTimestamp(data.instant);\n                if (!instant) return null;\n                return {\n                    kind: 'instant',\n                    instant,\n                    display: typeof data.display === 'string' ? data.display : undefined,\n                };\n            }\n            case 'interval': {\n                const start = this.deserializeTimestamp(data.start);\n                const end = this.deserializeTimestamp(data.end);\n                if (!start || !end) return null;\n                return {\n                    kind: 'interval',\n                    start,\n                    end,\n                    display: typeof data.display === 'string' ? data.display : undefined,\n                };\n            }\n            case 'open-ended': {\n                const start = this.deserializeTimestamp(data.start);\n                if (!start) return null;\n                return {\n                    kind: 'open-ended',\n                    start,\n                    display: typeof data.display === 'string' ? data.display : undefined,\n                };\n            }\n            case 'uncertain': {\n                const rangeData = data.range;\n                if (!rangeData || typeof rangeData !== 'object') return null;\n                const rangeStart = this.deserializeTimestamp((rangeData as Record<string, unknown>).start);\n                const rangeEnd = this.deserializeTimestamp((rangeData as Record<string, unknown>).end);\n                if (!rangeStart || !rangeEnd) return null;\n                return {\n                    kind: 'uncertain',\n                    range: { start: rangeStart, end: rangeEnd },\n                    confidence: typeof data.confidence === 'number' ? data.confidence : 0.5,\n                    display: typeof data.display === 'string' ? data.display : undefined,\n                };\n            }\n            case 'unknown':\n                return {\n                    kind: 'unknown',\n                    display: typeof data.display === 'string' ? data.display : undefined,\n                };\n            case 'relative': {\n                const offsetData = data.offset;\n                if (!offsetData || typeof offsetData !== 'object') return null;\n                const offset = offsetData as Record<string, unknown>;\n                return {\n                    kind: 'relative',\n                    relativeTo: typeof data.relativeTo === 'string' ? data.relativeTo : '',\n                    offset: {\n                        amount: typeof offset.amount === 'number' ? offset.amount : 0,\n                        unit: (typeof offset.unit === 'string' ? offset.unit : 'day') as TemporalOffset['unit'],\n                        direction: (typeof offset.direction === 'string' ? offset.direction : 'after') as 'before' | 'after',\n                    },\n                    display: typeof data.display === 'string' ? data.display : undefined,\n                };\n            }\n            default:\n                return null;\n        }\n    }\n\n    /**\n     * Deserialize a Timestamp from a plain object.\n     */\n    private deserializeTimestamp(obj: unknown): Timestamp | null {\n        if (!obj || typeof obj !== 'object') return null;\n        const data = obj as Record<string, unknown>;\n        if (typeof data.year !== 'number') return null;\n\n        const ts: Timestamp = {\n            calendar: typeof data.calendar === 'string' ? data.calendar : DEFAULT_CALENDAR,\n            year: data.year,\n        };\n        if (typeof data.month === 'number') ts.month = data.month;\n        if (typeof data.day === 'number') ts.day = data.day;\n        if (typeof data.hour === 'number') ts.hour = data.hour;\n        if (typeof data.minute === 'number') ts.minute = data.minute;\n        if (typeof data.precision === 'string') ts.precision = data.precision as DatePrecision;\n        else {\n            // Infer precision from available fields\n            if (ts.minute !== undefined) ts.precision = 'minute';\n            else if (ts.hour !== undefined) ts.precision = 'hour';\n            else if (ts.day !== undefined) ts.precision = 'day';\n            else if (ts.month !== undefined) ts.precision = 'month';\n            else ts.precision = 'year';\n        }\n        return ts;\n    }\n\n    // ── Legacy StoryDate/StoryTime Migration ──\n\n    /**\n     * Convert legacy storyDate and storyTime fields to a TimeSpan.\n     * This allows gradual migration without breaking existing scenes.\n     */\n    convertLegacyToTimeSpan(storyDate?: string, storyTime?: string): TimeSpan | null {\n        if (!storyDate && !storyTime) return null;\n\n        const date = storyDate?.trim();\n        const time = storyTime?.trim();\n\n        if (date) {\n            const parsed = this.parse(date);\n            if (parsed) {\n                // If we have a time component and the parsed result is an instant,\n                // try to merge the time\n                if (time && parsed.kind === 'instant') {\n                    const timeMatch = time.match(/^(\\d{1,2}):(\\d{1,2})$/);\n                    if (timeMatch) {\n                        const [, hour, minute] = timeMatch;\n                        return {\n                            kind: 'instant',\n                            instant: {\n                                ...parsed.instant,\n                                hour: parseInt(hour, 10),\n                                minute: parseInt(minute, 10),\n                                precision: 'minute',\n                            },\n                            display: `${date} ${time}`,\n                        };\n                    }\n                }\n                return parsed;\n            }\n        }\n\n        // If date parsing fails but we have a time-only value, return unknown with display\n        if (time) {\n            return { kind: 'unknown', display: time };\n        }\n\n        return null;\n    }\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/services/TimelineNavigationService.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'TimeSpan' is defined but never used.","line":12,"column":15,"nodeType":"Identifier","messageId":"unusedVar","endLine":12,"endColumn":23,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"TimeSpan"},"fix":{"range":[370,379],"text":""},"desc":"Remove unused variable \"TimeSpan\"."}]},{"ruleId":"max-lines-per-function","severity":2,"message":"Method 'getTimeMarkers' has too many lines (94). Maximum allowed is 50.","line":283,"column":5,"nodeType":"MethodDefinition","messageId":"exceed","endLine":394,"endColumn":6},{"ruleId":"complexity","severity":2,"message":"Method 'getTimeMarkers' has a complexity of 32. Maximum allowed is 10.","line":283,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":283,"endColumn":19},{"ruleId":"max-statements","severity":2,"message":"Method 'getTimeMarkers' has too many statements (42). Maximum allowed is 25.","line":283,"column":19,"nodeType":"FunctionExpression","messageId":"exceed","endLine":394,"endColumn":6},{"ruleId":"max-lines","severity":2,"message":"File has too many lines (374). Maximum allowed is 200.","line":332,"column":1,"nodeType":null,"messageId":"exceed","endLine":580,"endColumn":1},{"ruleId":"max-depth","severity":2,"message":"Blocks are nested too deeply (4). Maximum allowed is 3.","line":385,"column":21,"nodeType":"IfStatement","messageId":"tooDeeply","endLine":388,"endColumn":22},{"ruleId":"complexity","severity":2,"message":"Method 'getTimestampAtPosition' has a complexity of 12. Maximum allowed is 10.","line":401,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":401,"endColumn":27},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'daysInYear' is assigned a value but never used.","line":422,"column":19,"nodeType":"Identifier","messageId":"unusedVar","endLine":422,"endColumn":29}],"suppressedMessages":[],"errorCount":6,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * TimelineNavigationService — Time navigation and temporal axis generation.\n *\n * Provides:\n * - Jump to date/year navigation\n * - Previous/next chronological item navigation\n * - Adaptive time marker generation (year/month/day based on scale)\n * - Visible time window tracking\n * - Integration with TimeSpanService for calendar-aware operations\n */\n\nimport type { TimeSpan, Timestamp } from '../models/TimeSpan';\nimport type { Scene } from '../models/Scene';\nimport type { Event } from '../models/Event';\nimport type { TimeSpanService } from './TimeSpanService';\n\n/**\n * Navigation state for the timeline view.\n */\nexport interface TimelineNavigationState {\n    /** The currently selected/focused date (null = no selection) */\n    selectedDate: Timestamp | null;\n    /** The visible time range (start, end) */\n    visibleRange: { start: Timestamp; end: Timestamp } | null;\n    /** Temporal zoom level: 'year' | 'month' | 'day' | 'hour' */\n    zoomLevel: 'year' | 'month' | 'day' | 'hour';\n}\n\n/**\n * A time marker for the temporal axis/ruler.\n */\nexport interface TimeMarker {\n    /** The timestamp this marker represents */\n    timestamp: Timestamp;\n    /** Display label (e.g., \"2000\", \"January\", \"15\") */\n    label: string;\n    /** Granularity of this marker */\n    granularity: 'year' | 'month' | 'day' | 'hour';\n    /** Whether this is a major marker (always shown) or minor (shown at higher zoom) */\n    isMajor: boolean;\n}\n\n/**\n * A chronological timeline item for navigation.\n */\nexport interface TimelineNavItem {\n    /** The scene (if this is a scene) */\n    scene?: Scene;\n    /** The event (if this is an event) */\n    event?: Event;\n    /** The earliest timestamp for sorting/navigation */\n    timestamp: Timestamp | null;\n    /** Calendar system */\n    calendar: string | undefined;\n}\n\n/**\n * TimelineNavigationService handles time navigation and temporal axis generation.\n */\nexport class TimelineNavigationService {\n    private timeSpanService: TimeSpanService;\n    private state: TimelineNavigationState;\n    private items: TimelineNavItem[] = [];\n    /** Stable identity so next/previous visits every item sharing a timestamp. */\n    private focusedItemKey: string | null = null;\n\n    constructor(timeSpanService: TimeSpanService) {\n        this.timeSpanService = timeSpanService;\n        this.state = {\n            selectedDate: null,\n            visibleRange: null,\n            zoomLevel: 'year',\n        };\n    }\n\n    // ── State Management ──\n\n    /** Get the current navigation state. */\n    getState(): TimelineNavigationState {\n        return { ...this.state };\n    }\n\n    /** Set the selected date. */\n    setSelectedDate(date: Timestamp | null) {\n        this.state.selectedDate = date;\n        this.focusedItemKey = null;\n    }\n\n    /** Get the selected date. */\n    getSelectedDate(): Timestamp | null {\n        return this.state.selectedDate;\n    }\n\n    /** Get the current zoom level. */\n    getZoomLevel(): 'year' | 'month' | 'day' | 'hour' {\n        return this.state.zoomLevel;\n    }\n\n    /** Set the zoom level. */\n    setZoomLevel(level: 'year' | 'month' | 'day' | 'hour') {\n        this.state.zoomLevel = level;\n    }\n\n    // ── Item Management ──\n\n    /**\n     * Update the list of chronological items for navigation.\n     * This should be called whenever the timeline projection changes.\n     */\n    updateItems(scenes: Scene[], events: Event[]) {\n        this.items = [];\n\n        // Add scenes\n        for (const scene of scenes) {\n            const ts = this.getSceneTimestamp(scene);\n            this.items.push({\n                scene,\n                timestamp: ts,\n                calendar: ts?.calendar,\n            });\n        }\n\n        // Add events\n        for (const event of events) {\n            const ts = event.timeSpan\n                ? this.timeSpanService.getEarliestPoint(event.timeSpan)\n                : null;\n            this.items.push({\n                event,\n                timestamp: ts,\n                calendar: ts?.calendar,\n            });\n        }\n\n        // Sort items by timestamp\n        this.items.sort((a, b) => this.compareItems(a, b));\n        if (this.focusedItemKey &&\n            !this.items.some(item => this.getItemKey(item) === this.focusedItemKey)) {\n            this.focusedItemKey = null;\n        }\n\n        // Calculate visible range\n        this.calculateVisibleRange();\n    }\n\n    /** Get the sorted list of navigation items. */\n    getItems(): TimelineNavItem[] {\n        return this.items;\n    }\n\n    /** Get the number of items. */\n    getItemCount(): number {\n        return this.items.length;\n    }\n\n    // ── Navigation ──\n\n    /**\n     * Jump to a specific date.\n     * @param year The year to jump to.\n     * @param month Optional month (1-12).\n     * @param day Optional day (1-31).\n     */\n    jumpToDate(year: number, month?: number, day?: number) {\n        const timestamp: Timestamp = {\n            calendar: 'gregorian',\n            year,\n            precision: day ? 'day' : month ? 'month' : 'year',\n        };\n        if (month) timestamp.month = month;\n        if (day) timestamp.day = day;\n\n        this.state.selectedDate = timestamp;\n        this.focusedItemKey = null;\n        this.centerVisibleRangeOn(timestamp);\n    }\n\n    /**\n     * Navigate to the previous chronological item.\n     * @returns The previous item, or null if already at the beginning.\n     */\n    navigatePrevious(): TimelineNavItem | null {\n        if (this.items.length === 0) return null;\n\n        // Find current position\n        let currentIndex = this.getFocusedIndex();\n\n        if (currentIndex > 0) {\n            currentIndex--;\n            const item = this.items[currentIndex];\n            this.focusedItemKey = this.getItemKey(item);\n            if (item.timestamp) {\n                this.state.selectedDate = item.timestamp;\n            }\n            return item;\n        }\n\n        return null;\n    }\n\n    /**\n     * Navigate to the next chronological item.\n     * @returns The next item, or null if already at the end.\n     */\n    navigateNext(): TimelineNavItem | null {\n        if (this.items.length === 0) return null;\n\n        // Find current position\n        let currentIndex = this.getFocusedIndex();\n\n        if (currentIndex < this.items.length - 1) {\n            currentIndex++;\n            const item = this.items[currentIndex];\n            this.focusedItemKey = this.getItemKey(item);\n            if (item.timestamp) {\n                this.state.selectedDate = item.timestamp;\n            }\n            return item;\n        }\n\n        return null;\n    }\n\n    /**\n     * Find the index of the item closest to the selected date.\n     */\n    findCurrentIndex(): number {\n        if (!this.state.selectedDate || this.items.length === 0) {\n            return 0;\n        }\n\n        // Binary search for the closest item\n        let low = 0;\n        let high = this.items.length - 1;\n\n        while (low <= high) {\n            const mid = (low + high) >> 1;\n            const item = this.items[mid];\n            if (!item.timestamp) {\n                low = mid + 1;\n                continue;\n            }\n\n            const cmp = this.timeSpanService.compareTimestamps(\n                item.timestamp,\n                this.state.selectedDate\n            );\n\n            if (cmp < 0) {\n                low = mid + 1;\n            } else if (cmp > 0) {\n                high = mid - 1;\n            } else {\n                return mid; // Exact match\n            }\n        }\n\n        // Return the closest index\n        return Math.max(0, high);\n    }\n\n    /** Resolve an item by stable source identity rather than its timestamp. */\n    private getItemKey(item: TimelineNavItem): string | null {\n        if (item.scene) return `scene:${item.scene.filePath}`;\n        if (item.event) return `event:${item.event.id}`;\n        return null;\n    }\n\n    private getFocusedIndex(): number {\n        if (this.focusedItemKey) {\n            const index = this.items.findIndex(item => this.getItemKey(item) === this.focusedItemKey);\n            if (index !== -1) return index;\n        }\n        return this.findCurrentIndex();\n    }\n\n    // ── Time Markers ──\n\n    /**\n     * Generate adaptive time markers for the temporal axis.\n     * The granularity is determined by the time range and zoom level.\n     */\n    getTimeMarkers(): TimeMarker[] {\n        if (!this.state.visibleRange) return [];\n\n        const { start, end } = this.state.visibleRange;\n        const markers: TimeMarker[] = [];\n\n        // Calculate the time span in years\n        const yearSpan = end.year - start.year;\n\n        // Determine granularity based on zoom level and time span\n        let granularity: 'year' | 'month' | 'day' = this.state.zoomLevel as 'year' | 'month' | 'day';\n\n        // Auto-adjust granularity if the time span is too large/small for the current zoom\n        if (granularity === 'year' && yearSpan > 100) {\n            // Show decade markers\n            const decadeStart = Math.floor(start.year / 10) * 10;\n            for (let year = decadeStart; year <= end.year; year += 10) {\n                markers.push({\n                    timestamp: { calendar: 'gregorian', year, precision: 'year' },\n                    label: String(year),\n                    granularity: 'year',\n                    isMajor: true,\n                });\n            }\n        } else if (granularity === 'year' && yearSpan > 20) {\n            // Show 5-year markers\n            const fiveYearStart = Math.floor(start.year / 5) * 5;\n            for (let year = fiveYearStart; year <= end.year; year += 5) {\n                markers.push({\n                    timestamp: { calendar: 'gregorian', year, precision: 'year' },\n                    label: String(year),\n                    granularity: 'year',\n                    isMajor: true,\n                });\n            }\n        } else if (granularity === 'year') {\n            // Show yearly markers\n            for (let year = start.year; year <= end.year; year++) {\n                markers.push({\n                    timestamp: { calendar: 'gregorian', year, precision: 'year' },\n                    label: String(year),\n                    granularity: 'year',\n                    isMajor: true,\n                });\n            }\n        } else if (granularity === 'month' && yearSpan <= 2) {\n            // Show monthly markers\n            let year = start.year;\n            let month = start.month ?? 1;\n            const endYear = end.year;\n            const endMonth = end.month ?? 12;\n\n            while (year < endYear || (year === endYear && month <= endMonth)) {\n                const label = this.formatMonth(year, month);\n                markers.push({\n                    timestamp: {\n                        calendar: 'gregorian',\n                        year,\n                        month,\n                        precision: 'month',\n                    },\n                    label,\n                    granularity: 'month',\n                    isMajor: month === 1, // January is major\n                });\n\n                month++;\n                if (month > 12) {\n                    month = 1;\n                    year++;\n                }\n            }\n        } else if (granularity === 'day' && yearSpan <= 1) {\n            // Show daily markers (only for short ranges) — calendar-safe, no JavaScript Date\n            let curYear = start.year;\n            let curMonth = start.month ?? 1;\n            let curDay = start.day ?? 1;\n            const endYear = end.year;\n            const endMonth = end.month ?? 12;\n            const endDay = end.day ?? 28;\n\n            while (curYear < endYear || (curYear === endYear && curMonth < endMonth) ||\n                (curYear === endYear && curMonth === endMonth && curDay <= endDay)) {\n                markers.push({\n                    timestamp: {\n                        calendar: 'gregorian',\n                        year: curYear,\n                        month: curMonth,\n                        day: curDay,\n                        precision: 'day',\n                    },\n                    label: String(curDay),\n                    granularity: 'day',\n                    isMajor: curDay === 1, // First of month is major\n                });\n\n                // Advance one day using pure integer arithmetic\n                const daysInMonth = this.daysInMonth(curYear, curMonth);\n                curDay++;\n                if (curDay > daysInMonth) {\n                    curDay = 1;\n                    curMonth++;\n                    if (curMonth > 12) {\n                        curMonth = 1;\n                        curYear++;\n                    }\n                }\n            }\n        }\n\n        return markers;\n    }\n\n    /**\n     * Get a time marker at a specific position (for click handling).\n     * @param fraction The fraction along the timeline (0.0 = start, 1.0 = end).\n     * @returns The timestamp at that position, or null if out of range.\n     */\n    getTimestampAtPosition(fraction: number): Timestamp | null {\n        if (!this.state.visibleRange) return null;\n        if (fraction < 0 || fraction > 1) return null;\n\n        const { start, end } = this.state.visibleRange;\n\n        // Calculate the year at this position\n        const yearSpan = end.year - start.year;\n        const year = Math.round(start.year + fraction * yearSpan);\n\n        // Calculate the month at this position (if we have month precision)\n        let month: number | undefined;\n        if (start.month && end.month && yearSpan < 2) {\n            const monthSpan = (end.year - start.year) * 12 + (end.month - start.month);\n            const monthAtPos = start.month + Math.round(fraction * monthSpan);\n            month = Math.max(1, Math.min(12, monthAtPos));\n        }\n\n        // Calculate the day at this position (if we have day precision)\n        let day: number | undefined;\n        if (start.day && end.day && yearSpan < 1) {\n            const daysInYear = 365;\n            const dayOfYearStart = this.getDayOfYear(start.year, start.month, start.day);\n            const dayOfYearEnd = this.getDayOfYear(end.year, end.month, end.day);\n            const daySpan = dayOfYearEnd - dayOfYearStart;\n            const dayAtPos = dayOfYearStart + Math.round(fraction * daySpan);\n            const { month: m, day: d } = this.getDateFromDayOfYear(year, dayAtPos);\n            month = m;\n            day = d;\n        }\n\n        return {\n            calendar: 'gregorian',\n            year,\n            month,\n            day,\n            precision: day ? 'day' : month ? 'month' : 'year',\n        };\n    }\n\n    // ── Visible Range ──\n\n    /**\n     * Calculate the visible time range based on items.\n     */\n    private calculateVisibleRange() {\n        const datedItems = this.items.filter(item => item.timestamp !== null);\n\n        if (datedItems.length === 0) {\n            this.state.visibleRange = null;\n            return;\n        }\n\n        // Find the earliest and latest timestamps\n        let earliest = datedItems[0].timestamp!;\n        let latest = datedItems[0].timestamp!;\n\n        for (const item of datedItems) {\n            if (!item.timestamp) continue;\n            if (this.timeSpanService.compareTimestamps(item.timestamp, earliest) < 0) {\n                earliest = item.timestamp;\n            }\n            if (this.timeSpanService.compareTimestamps(item.timestamp, latest) > 0) {\n                latest = item.timestamp;\n            }\n        }\n\n        // Add padding (10% on each side)\n        const padding = Math.max(1, Math.round((latest.year - earliest.year) * 0.1));\n        this.state.visibleRange = {\n            start: { ...earliest, year: earliest.year - padding },\n            end: { ...latest, year: latest.year + padding },\n        };\n    }\n\n    /**\n     * Center the visible range on a specific timestamp.\n     */\n    private centerVisibleRangeOn(timestamp: Timestamp) {\n        if (!this.state.visibleRange) {\n            this.state.visibleRange = {\n                start: { ...timestamp, year: timestamp.year - 5 },\n                end: { ...timestamp, year: timestamp.year + 5 },\n            };\n            return;\n        }\n\n        const rangeSpan = this.state.visibleRange.end.year - this.state.visibleRange.start.year;\n        this.state.visibleRange = {\n            start: { ...timestamp, year: timestamp.year - Math.floor(rangeSpan / 2) },\n            end: { ...timestamp, year: timestamp.year + Math.floor(rangeSpan / 2) },\n        };\n    }\n\n    // ── Helpers ──\n\n    /**\n     * Get the timestamp for a scene (from TimeSpan or legacy storyDate).\n     */\n    private getSceneTimestamp(scene: Scene): Timestamp | null {\n        // Try TimeSpan first\n        if (scene.timeSpan) {\n            return this.timeSpanService.getEarliestPoint(scene.timeSpan);\n        }\n\n        // Fall back to legacy storyDate\n        if (scene.storyDate) {\n            const ts = this.timeSpanService.convertLegacyToTimeSpan(scene.storyDate, scene.storyTime || '');\n            return ts ? this.timeSpanService.getEarliestPoint(ts) : null;\n        }\n\n        return null;\n    }\n\n    /**\n     * Compare two timeline items for sorting.\n     */\n    private compareItems(a: TimelineNavItem, b: TimelineNavItem): number {\n        if (!a.timestamp && !b.timestamp) return 0;\n        if (!a.timestamp) return 1;\n        if (!b.timestamp) return -1;\n\n        return this.timeSpanService.compareTimestamps(a.timestamp, b.timestamp);\n    }\n\n    /**\n     * Format a month for display.\n     */\n    private formatMonth(year: number, month: number): string {\n        const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',\n                        'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\n        return months[month - 1] || '';\n    }\n\n    /**\n     * Days in a month (calendar-safe, handles leap years).\n     */\n    private daysInMonth(year: number, month: number): number {\n        const daysInMonthArray = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n        if (month === 2 && this.isLeapYear(year)) return 29;\n        return daysInMonthArray[month - 1] ?? 30;\n    }\n\n    /**\n     * Check if a year is a leap year (Gregorian calendar).\n     */\n    private isLeapYear(year: number): boolean {\n        // Handle year 0 and negative years correctly\n        const y = year <= 0 ? year - 1 : year;\n        return (y % 4 === 0 && y % 100 !== 0) || (y % 400 === 0);\n    }\n\n    /**\n     * Get the day of year for a date (calendar-safe).\n     */\n    private getDayOfYear(year: number, month: number | undefined, day: number | undefined): number {\n        if (!month || !day) return 1;\n        let dayOfYear = 0;\n        for (let m = 1; m < month; m++) {\n            dayOfYear += this.daysInMonth(year, m);\n        }\n        return dayOfYear + day;\n    }\n\n    /**\n     * Get month and day from day of year (calendar-safe).\n     */\n    private getDateFromDayOfYear(year: number, dayOfYear: number): { month: number; day: number } {\n        let remaining = Math.max(1, dayOfYear);\n        for (let m = 1; m <= 12; m++) {\n            const dim = this.daysInMonth(year, m);\n            if (remaining <= dim) {\n                return { month: m, day: remaining };\n            }\n            remaining -= dim;\n        }\n        return { month: 12, day: 31 };\n    }\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/services/UndoManager.ts","messages":[{"ruleId":"max-params","severity":2,"message":"Method 'recordUpdate' has too many parameters (5). Maximum allowed is 4.","line":69,"column":5,"nodeType":"FunctionExpression","messageId":"exceed","endLine":69,"endColumn":17}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since the receiver accepts the original type of the expression.","line":203,"column":72,"nodeType":"TSAsExpression","messageId":"contextuallyUnnecessary","endLine":203,"endColumn":107,"fix":{"range":[6792,6810],"text":""},"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since the receiver accepts the original type of the expression.","line":232,"column":72,"nodeType":"TSAsExpression","messageId":"contextuallyUnnecessary","endLine":232,"endColumn":107,"fix":{"range":[7996,8014],"text":""},"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]}],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/* eslint-disable @typescript-eslint/no-unnecessary-type-assertion -- Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file */\nimport { App, TFile, Notice } from 'obsidian';\nimport { Scene } from '../models/Scene';\nimport { MetadataParser } from './MetadataParser';\n\n/**\n * Types of undoable actions\n */\ntype UndoActionType = 'update' | 'create' | 'delete';\n\n/**\n * Domain that the action belongs to — drives which manager re-applies changes.\n */\ntype UndoDomain = 'scene' | 'character' | 'location';\n\n/**\n * A single undoable action.\n */\ninterface UndoAction {\n    type: UndoActionType;\n    /** Which domain this action belongs to */\n    domain: UndoDomain;\n    /** Human-readable description (e.g. \"Update status of 'The Red Door'\") */\n    label: string;\n    filePath: string;\n    /** For 'update': the field values *before* the change */\n    oldValues?: Record<string, unknown>;\n    /** For 'update': the field values *after* the change */\n    newValues?: Record<string, unknown>;\n    /** For 'delete': full file content so we can re-create the file */\n    fileContent?: string;\n    /** For 'create': we store the content so undo can delete, redo can re-create */\n    createdContent?: string;\n}\n\nconst MAX_STACK = 50;\n\n/**\n * Manages an undo/redo stack for scene operations.\n *\n * Usage:\n *  - Before an update:  `undoManager.recordUpdate(filePath, oldSnap, newUpdates, label)`\n *  - Before a delete:   `undoManager.recordDelete(filePath, fileContent, label)`\n *  - After a create:    `undoManager.recordCreate(filePath, fileContent, label)`\n *  - Undo:              `await undoManager.undo()`\n *  - Redo:              `await undoManager.redo()`\n */\nexport class UndoManager {\n    private app: App;\n    private undoStack: UndoAction[] = [];\n    private redoStack: UndoAction[] = [];\n    /** Callback fired after undo/redo so views can refresh */\n    onAfterUndoRedo: (() => void) | null = null;\n\n    constructor(app: App) {\n        this.app = app;\n    }\n\n    // ─── Recording ──────────────────────────────────────────────\n\n    /**\n     * Record a scene update (field changes).\n     * @param filePath  Scene file path\n     * @param oldSnap   Snapshot of the scene **before** the update\n     * @param newUpdates The partial updates being applied\n     * @param label     Human-readable description\n     * @param domain    Which domain ('scene' | 'character' | 'location')\n     */\n    recordUpdate(\n        filePath: string,\n        oldSnap: Record<string, unknown>,\n        newUpdates: Record<string, unknown>,\n        label?: string,\n        domain: UndoDomain = 'scene'\n    ): void {\n        // Only store the fields that are actually changing\n        const oldValues: Record<string, unknown> = {};\n        for (const key of Object.keys(newUpdates)) {\n            oldValues[key] = oldSnap[key];\n        }\n\n        this.push({\n            type: 'update',\n            domain,\n            label: label || `Update ${domain}`,\n            filePath,\n            oldValues,\n            newValues: { ...newUpdates },\n        });\n    }\n\n    /**\n     * Record a deletion.\n     * @param filePath     File path\n     * @param fileContent  Full markdown content of the file (so it can be restored)\n     * @param label        Human-readable description\n     * @param domain       Which domain ('scene' | 'character' | 'location')\n     */\n    recordDelete(filePath: string, fileContent: string, label?: string, domain: UndoDomain = 'scene'): void {\n        this.push({\n            type: 'delete',\n            domain,\n            label: label || `Delete ${domain}`,\n            filePath,\n            fileContent,\n        });\n    }\n\n    /**\n     * Record a creation.\n     * @param filePath       Newly-created file path\n     * @param fileContent    Content that was written\n     * @param label          Human-readable description\n     * @param domain         Which domain ('scene' | 'character' | 'location')\n     */\n    recordCreate(filePath: string, fileContent: string, label?: string, domain: UndoDomain = 'scene'): void {\n        this.push({\n            type: 'create',\n            domain,\n            label: label || `Create ${domain}`,\n            filePath,\n            createdContent: fileContent,\n        });\n    }\n\n    // ─── Undo / Redo ────────────────────────────────────────────\n\n    get canUndo(): boolean {\n        return this.undoStack.length > 0;\n    }\n\n    get canRedo(): boolean {\n        return this.redoStack.length > 0;\n    }\n\n    async undo(): Promise<boolean> {\n        const action = this.undoStack.pop();\n        if (!action) {\n            new Notice('Nothing to undo');\n            return false;\n        }\n\n        try {\n            await this.applyReverse(action);\n            this.redoStack.push(action);\n            if (this.redoStack.length > MAX_STACK) this.redoStack.shift();\n            new Notice(`Undo: ${action.label}`);\n            this.onAfterUndoRedo?.();\n            return true;\n        } catch (e) {\n            console.error('StoryLine: undo failed', e);\n            new Notice(`Undo failed: ${(e as Error).message}`);\n            return false;\n        }\n    }\n\n    async redo(): Promise<boolean> {\n        const action = this.redoStack.pop();\n        if (!action) {\n            new Notice('Nothing to redo');\n            return false;\n        }\n\n        try {\n            await this.applyForward(action);\n            this.undoStack.push(action);\n            if (this.undoStack.length > MAX_STACK) this.undoStack.shift();\n            new Notice(`Redo: ${action.label}`);\n            this.onAfterUndoRedo?.();\n            return true;\n        } catch (e) {\n            console.error('StoryLine: redo failed', e);\n            new Notice(`Redo failed: ${(e as Error).message}`);\n            return false;\n        }\n    }\n\n    /**\n     * Clear all history (e.g. on project switch)\n     */\n    clear(): void {\n        this.undoStack = [];\n        this.redoStack = [];\n    }\n\n    // ─── Internal ───────────────────────────────────────────────\n\n    private push(action: UndoAction): void {\n        this.undoStack.push(action);\n        if (this.undoStack.length > MAX_STACK) this.undoStack.shift();\n        // A new action always clears the redo stack\n        this.redoStack = [];\n    }\n\n    /**\n     * Apply the *reverse* of an action (for undo).\n     */\n    private async applyReverse(action: UndoAction): Promise<void> {\n        switch (action.type) {\n            case 'update': {\n                const file = this.app.vault.getAbstractFileByPath(action.filePath);\n                if (!file || !(file instanceof TFile)) throw new Error('File not found');\n                await MetadataParser.updateFrontmatter(this.app, file, action.oldValues! as Partial<Scene>);\n                break;\n            }\n            case 'delete': {\n                // Re-create the deleted file\n                if (!action.fileContent) throw new Error('No saved content for undo-delete');\n                await this.ensureParentFolder(action.filePath);\n                await this.app.vault.create(action.filePath, action.fileContent);\n                break;\n            }\n            case 'create': {\n                // Delete the created file\n                const file = this.app.vault.getAbstractFileByPath(action.filePath);\n                if (file && file instanceof TFile) {\n                    await this.app.fileManager.trashFile(file);\n                }\n                break;\n            }\n        }\n    }\n\n    /**\n     * Apply an action forward (for redo).\n     */\n    private async applyForward(action: UndoAction): Promise<void> {\n        switch (action.type) {\n            case 'update': {\n                const file = this.app.vault.getAbstractFileByPath(action.filePath);\n                if (!file || !(file instanceof TFile)) throw new Error('File not found');\n                await MetadataParser.updateFrontmatter(this.app, file, action.newValues! as Partial<Scene>);\n                break;\n            }\n            case 'delete': {\n                // Delete the file again\n                const file = this.app.vault.getAbstractFileByPath(action.filePath);\n                if (file && file instanceof TFile) {\n                    await this.app.fileManager.trashFile(file);\n                }\n                break;\n            }\n            case 'create': {\n                // Re-create the file\n                if (!action.createdContent) throw new Error('No saved content for redo-create');\n                await this.ensureParentFolder(action.filePath);\n                await this.app.vault.create(action.filePath, action.createdContent);\n                break;\n            }\n        }\n    }\n\n    private async ensureParentFolder(filePath: string): Promise<void> {\n        const parts = filePath.split('/');\n        parts.pop(); // remove filename\n        if (parts.length === 0) return;\n        const folder = parts.join('/');\n        const existing = this.app.vault.getAbstractFileByPath(folder);\n        if (!existing) {\n            await this.app.vault.createFolder(folder);\n        }\n    }\n}\n/* eslint-enable @typescript-eslint/no-unnecessary-type-assertion -- end of file-wide suppression block opened at line 1 */\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/services/UniverseManager.ts","messages":[{"ruleId":"eslint-comments/disable-enable-pair","severity":2,"message":"Requires 'eslint-enable' directive for '@typescript-eslint/no-unsafe-member-access'.","line":1,"column":19,"nodeType":null,"messageId":"missingRulePair","endLine":1,"endColumn":61},{"ruleId":"eslint-comments/disable-enable-pair","severity":2,"message":"Requires 'eslint-enable' directive for '@typescript-eslint/no-unsafe-assignment'.","line":1,"column":63,"nodeType":null,"messageId":"missingRulePair","endLine":1,"endColumn":102},{"ruleId":"complexity","severity":2,"message":"Async method 'loadUniverseMetadata' has a complexity of 11. Maximum allowed is 10.","line":91,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":91,"endColumn":31},{"ruleId":"max-lines","severity":2,"message":"File has too many lines (515). Maximum allowed is 200.","line":339,"column":1,"nodeType":null,"messageId":"exceed","endLine":791,"endColumn":1},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'folder' is assigned a value but never used.","line":372,"column":26,"nodeType":"Identifier","messageId":"unusedVar","endLine":372,"endColumn":32},{"ruleId":"complexity","severity":2,"message":"Async method 'resolveInheritedCollections' has a complexity of 11. Maximum allowed is 10.","line":434,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":434,"endColumn":38}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":102,"column":19,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":102,"endColumn":41,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .id on an `any` value.","line":103,"column":23,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":103,"endColumn":25,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .name on an `any` value.","line":103,"column":35,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":103,"endColumn":39,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":105,"column":17,"nodeType":"Property","messageId":"anyAssignment","endLine":105,"endColumn":28,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .id on an `any` value.","line":105,"column":26,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":105,"endColumn":28,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":106,"column":17,"nodeType":"Property","messageId":"anyAssignment","endLine":106,"endColumn":32,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .name on an `any` value.","line":106,"column":28,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":106,"endColumn":32,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":107,"column":17,"nodeType":"Property","messageId":"anyAssignment","endLine":107,"endColumn":59,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .description on an `any` value.","line":107,"column":35,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":107,"endColumn":46,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":108,"column":17,"nodeType":"Property","messageId":"anyAssignment","endLine":108,"endColumn":79,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .seriesIds on an `any` value.","line":108,"column":47,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":108,"endColumn":56,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .seriesIds on an `any` value.","line":108,"column":65,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":108,"endColumn":74,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":109,"column":17,"nodeType":"Property","messageId":"anyAssignment","endLine":109,"endColumn":44,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .created on an `any` value.","line":109,"column":31,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":109,"endColumn":38,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":110,"column":17,"nodeType":"Property","messageId":"anyAssignment","endLine":110,"endColumn":53,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .modified on an `any` value.","line":110,"column":32,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":110,"endColumn":40,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":111,"column":17,"nodeType":"Property","messageId":"anyAssignment","endLine":111,"endColumn":57,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .coverImage on an `any` value.","line":111,"column":34,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":111,"endColumn":44,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]}],"errorCount":5,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/* eslint-disable @typescript-eslint/no-unsafe-member-access, @typescript-eslint/no-unsafe-assignment -- Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file */\nimport { App, Notice, normalizePath } from 'obsidian';\nimport type SceneCardsPlugin from '../main';\nimport type { SeriesMetadata, StoryLineProject } from '../models/StoryLineProject';\nimport {\n    UniverseMetadata,\n    ContainerEntity,\n    HierarchyPath,\n    InheritedCollectionResult,\n    UNIVERSE_JSON,\n    UNIVERSE_CODEX_FOLDER,\n    buildHierarchyPath,\n} from '../models/Universe';\n\n/**\n * Manages the Universe → Series → Book hierarchy.\n *\n * Responsibilities:\n * - Create, load, save, and delete Universes (universe.json)\n * - Add/remove Series from Universes\n * - Resolve inherited collections (Characters, Locations, Codex, Events)\n * - Navigate the hierarchy (parent/child lookups)\n * - Discover existing universes in the vault\n *\n * Backward compatibility:\n * - All new fields are optional\n * - Existing series continue to work without a Universe\n * - Standalone books (no series, no universe) remain fully supported\n * - Creating a Universe does NOT automatically reorganize or move existing directories\n */\nexport class UniverseManager {\n    private app: App;\n    private plugin: SceneCardsPlugin;\n\n    // Cache: folder path → UniverseMetadata\n    private universeCache = new Map<string, UniverseMetadata>();\n\n    constructor(app: App, plugin: SceneCardsPlugin) {\n        this.app = app;\n        this.plugin = plugin;\n    }\n\n    // ── Universe CRUD ──────────────────────────────────\n\n    /**\n     * Create a new Universe. This creates the folder structure and universe.json.\n     * Does NOT move existing series or books — the hierarchy is a logical overlay.\n     */\n    async createUniverse(name: string): Promise<UniverseMetadata> {\n        const root = this.plugin.settings.storyLineRoot;\n        const safeName = name.replace(/[\\\\/:*?\"<>|]/g, '-');\n        const universeFolder = normalizePath(`${root}/${safeName}`);\n        const adapter = this.app.vault.adapter;\n\n        // Check for name collision\n        if (await adapter.exists(universeFolder)) {\n            throw new Error(`A folder named \"${safeName}\" already exists.`);\n        }\n\n        // Create the Universe folder\n        await this.ensureFolder(universeFolder);\n\n        // Create shared Codex folder structure\n        const codexFolder = normalizePath(`${universeFolder}/${UNIVERSE_CODEX_FOLDER}`);\n        await this.ensureFolder(codexFolder);\n        await this.ensureFolder(normalizePath(`${codexFolder}/Characters`));\n        await this.ensureFolder(normalizePath(`${codexFolder}/Locations`));\n\n        // Create and save universe.json\n        const now = new Date().toISOString().split('T')[0];\n        const universe: UniverseMetadata = {\n            id: crypto.randomUUID(),\n            name: safeName,\n            seriesIds: [],\n            created: now,\n            modified: now,\n        };\n        await this.saveUniverseMetadata(universeFolder, universe);\n\n        // Cache it\n        this.universeCache.set(universeFolder, universe);\n\n        new Notice(`Universe \"${safeName}\" created`);\n        return universe;\n    }\n\n    /**\n     * Load universe.json from a universe folder.\n     * Returns null if the file doesn't exist or is invalid.\n     */\n    async loadUniverseMetadata(universeFolder: string): Promise<UniverseMetadata | null> {\n        // Check cache first\n        const cached = this.universeCache.get(universeFolder);\n        if (cached) return cached;\n\n        const adapter = this.app.vault.adapter;\n        const metaPath = normalizePath(`${universeFolder}/${UNIVERSE_JSON}`);\n        if (!await adapter.exists(metaPath)) return null;\n\n        try {\n            const raw = await adapter.read(metaPath);\n            const data = JSON.parse(raw);\n            if (!data.id || !data.name) return null;\n            const universe: UniverseMetadata = {\n                id: data.id,\n                name: data.name,\n                description: data.description || undefined,\n                seriesIds: Array.isArray(data.seriesIds) ? data.seriesIds : [],\n                created: data.created || '',\n                modified: data.modified || undefined,\n                coverImage: data.coverImage || undefined,\n            };\n            this.universeCache.set(universeFolder, universe);\n            return universe;\n        } catch {\n            return null;\n        }\n    }\n\n    /**\n     * Save universe.json to the universe folder.\n     */\n    async saveUniverseMetadata(universeFolder: string, meta: UniverseMetadata): Promise<void> {\n        const adapter = this.app.vault.adapter;\n        const metaPath = normalizePath(`${universeFolder}/${UNIVERSE_JSON}`);\n        meta.modified = new Date().toISOString().split('T')[0];\n        await adapter.write(metaPath, JSON.stringify(meta, null, 2));\n        this.universeCache.set(universeFolder, meta);\n    }\n\n    /**\n     * Get a universe by ID. Searches all known universes.\n     */\n    async getUniverse(id: string): Promise<UniverseMetadata | null> {\n        const universes = await this.getAllUniverses();\n        return universes.find(u => u.id === id) || null;\n    }\n\n    /**\n     * Get all universes by scanning the StoryLine root.\n     */\n    async getAllUniverses(): Promise<UniverseMetadata[]> {\n        const root = this.plugin.settings.storyLineRoot;\n        const adapter = this.app.vault.adapter;\n        if (!await adapter.exists(root)) return [];\n\n        // Clear stale cache entries\n        this.universeCache.clear();\n\n        const listing = await adapter.list(root);\n        const results: UniverseMetadata[] = [];\n\n        for (const folder of listing.folders) {\n            const meta = await this.loadUniverseMetadata(folder);\n            if (meta) {\n                results.push(meta);\n            }\n        }\n\n        return results;\n    }\n\n    /**\n     * Delete a universe. Removes universe.json and shared Codex folder.\n     * Does NOT delete series or books — they become standalone.\n     */\n    async deleteUniverse(id: string): Promise<void> {\n        const universe = await this.getUniverse(id);\n        if (!universe) throw new Error('Universe not found');\n\n        // Find the universe folder\n        const root = this.plugin.settings.storyLineRoot;\n        const adapter = this.app.vault.adapter;\n        const listing = await adapter.list(root);\n        let universeFolder: string | null = null;\n\n        for (const folder of listing.folders) {\n            const meta = await this.loadUniverseMetadata(folder);\n            if (meta && meta.id === id) {\n                universeFolder = folder;\n                break;\n            }\n        }\n\n        if (!universeFolder) throw new Error('Universe folder not found');\n\n        // Remove universe.json\n        const metaPath = normalizePath(`${universeFolder}/${UNIVERSE_JSON}`);\n        if (await adapter.exists(metaPath)) {\n            await adapter.remove(metaPath);\n        }\n\n        // Remove shared Codex folder if empty\n        const codexFolder = normalizePath(`${universeFolder}/${UNIVERSE_CODEX_FOLDER}`);\n        await this.removeFolderIfEmpty(codexFolder);\n\n        // Clear series universeId references\n        for (const seriesId of universe.seriesIds || []) {\n            await this.removeSeriesFromUniverseInternal(universe.id, seriesId);\n        }\n\n        // Clear cache\n        this.universeCache.delete(universeFolder);\n\n        new Notice(`Universe \"${universe.name}\" deleted`);\n    }\n\n    // ── Series ↔ Universe membership ──────────────────\n\n    /**\n     * Add an existing series to a universe.\n     * If the series already belongs to another universe, it is removed from that universe first.\n     * A series can belong to at most one universe (exclusive membership).\n     */\n    async addSeriesToUniverse(universeId: string, seriesFolder: string): Promise<void> {\n        const universe = await this.getUniverse(universeId);\n        if (!universe) throw new Error('Universe not found');\n\n        const seriesMeta = await this.plugin.seriesManager.loadSeriesMetadata(seriesFolder);\n        if (!seriesMeta) throw new Error('Invalid series folder — no series.json found');\n\n        const seriesUuid = seriesMeta.seriesUuid;\n        if (!seriesUuid) {\n            throw new Error('Series must have a UUID. Ensure the series was created via StoryLine.');\n        }\n\n        // If the series already belongs to this universe, nothing to do\n        if (seriesMeta.universeId === universeId) return;\n\n        // Remove from old universe if it belongs to one\n        if (seriesMeta.universeId && seriesMeta.universeId !== universeId) {\n            const oldUniverseId = seriesMeta.universeId;\n            await this.removeSeriesFromUniverseInternal(oldUniverseId, seriesUuid);\n        }\n\n        // Add series to new universe\n        if (!universe.seriesIds) universe.seriesIds = [];\n        if (!universe.seriesIds.includes(seriesUuid)) {\n            universe.seriesIds.push(seriesUuid);\n        }\n        await this.saveUniverseMetadata(\n            this.findUniverseFolder(universeId)!,\n            universe\n        );\n\n        // Update series metadata with universe reference\n        seriesMeta.universeId = universeId;\n        seriesMeta.ownerId = universeId;\n        await this.plugin.seriesManager.saveSeriesMetadata(seriesFolder, seriesMeta);\n\n        new Notice(`Series \"${seriesMeta.name}\" added to universe \"${universe.name}\"`);\n    }\n\n    /**\n     * Remove a series from its universe.\n     * The series becomes standalone but retains its data.\n     * Rejects if the series does not belong to the specified universe.\n     */\n    async removeSeriesFromUniverse(universeId: string, seriesUuid: string): Promise<void> {\n        const universe = await this.getUniverse(universeId);\n        if (!universe) throw new Error('Universe not found');\n\n        // Validate that the series actually belongs to this universe\n        if (!(universe.seriesIds || []).includes(seriesUuid)) {\n            throw new Error(`Series \"${seriesUuid}\" does not belong to universe \"${universe.name}\"`);\n        }\n\n        const universeFolder = this.findUniverseFolder(universeId)!;\n\n        // Remove series from universe\n        universe.seriesIds = (universe.seriesIds || []).filter(id => id !== seriesUuid);\n        await this.saveUniverseMetadata(universeFolder, universe);\n\n        // Clear series universe reference\n        await this.removeSeriesFromUniverseInternal(universeId, seriesUuid);\n\n        new Notice(`Series removed from universe \"${universe.name}\"`);\n    }\n\n    /**\n     * Internal: remove a series from a specific universe and clear its metadata.\n     * @param universeId The universe to remove from (must match the series' current universeId).\n     * @param seriesUuid The series UUID to remove.\n     */\n    private async removeSeriesFromUniverseInternal(universeId: string, seriesUuid: string): Promise<void> {\n        // Remove the series UUID from the universe's seriesIds\n        const oldUniverse = await this.getUniverse(universeId);\n        if (oldUniverse) {\n            oldUniverse.seriesIds = (oldUniverse.seriesIds || []).filter(id => id !== seriesUuid);\n            const oldUniverseFolder = this.findUniverseFolder(universeId);\n            if (oldUniverseFolder) {\n                await this.saveUniverseMetadata(oldUniverseFolder, oldUniverse);\n            }\n        }\n\n        // Find the series folder by UUID and clear its universe reference\n        const seriesList = await this.plugin.seriesManager.discoverSeries();\n        for (const { folder, meta } of seriesList) {\n            if (meta.seriesUuid === seriesUuid) {\n                meta.universeId = undefined;\n                meta.ownerId = undefined;\n                await this.plugin.seriesManager.saveSeriesMetadata(folder, meta);\n                break;\n            }\n        }\n    }\n\n    /**\n     * Get series IDs for a universe.\n     */\n    async getSeriesForUniverse(universeId: string): Promise<string[]> {\n        const universe = await this.getUniverse(universeId);\n        return universe?.seriesIds || [];\n    }\n\n    /**\n     * Get the universe ID for a series.\n     */\n    async getUniverseForSeries(seriesId: string): Promise<string | null> {\n        const seriesList = await this.plugin.seriesManager.discoverSeries();\n        for (const { meta } of seriesList) {\n            if (meta.seriesUuid === seriesId || meta.name === seriesId) {\n                return meta.universeId || null;\n            }\n        }\n        return null;\n    }\n\n    // ── Hierarchy navigation ───────────────────────────\n\n    /**\n     * Build a ContainerEntity from a Universe.\n     */\n    universeToContainer(universe: UniverseMetadata, folderPath: string): ContainerEntity {\n        return {\n            id: universe.id,\n            type: 'universe' as const,\n            name: universe.name,\n            childIds: universe.seriesIds,\n            folderPath,\n            created: universe.created,\n        };\n    }\n\n    /**\n     * Build a ContainerEntity from a Series.\n     */\n    seriesToContainer(series: SeriesMetadata, folderPath: string): ContainerEntity {\n        return {\n            id: series.seriesUuid || series.name,\n            type: 'series' as const,\n            name: series.name,\n            parentId: series.universeId,\n            childIds: series.bookIds,\n            folderPath,\n            created: series.created,\n        };\n    }\n\n    /**\n     * Resolve the full hierarchy path for a book.\n     * Returns Universe → Series → Book chain, with missing parts as undefined.\n     * Uses the supplied project, not the active project.\n     */\n    async resolveHierarchyPath(project: StoryLineProject): Promise<HierarchyPath> {\n        let series: SeriesMetadata | null = null;\n        let universe: UniverseMetadata | null = null;\n\n        // Resolve Series — find the series that contains this specific project\n        if (project.seriesUuid || project.seriesId) {\n            const allSeries = await this.plugin.seriesManager.discoverSeries();\n            for (const { folder, meta } of allSeries) {\n                if (meta.seriesUuid === project.seriesUuid || meta.name === project.seriesId) {\n                    series = meta;\n                    break;\n                }\n            }\n        }\n\n        // Resolve Universe\n        if (project.universeId) {\n            universe = await this.getUniverse(project.universeId);\n        } else if (series?.universeId) {\n            universe = await this.getUniverse(series.universeId);\n        }\n\n        return buildHierarchyPath(project, series, universe);\n    }\n\n    /**\n     * Get all books (projects) belonging to a universe, directly or via series.\n     */\n    async getBooksInUniverse(universeId: string): Promise<StoryLineProject[]> {\n        const universe = await this.getUniverse(universeId);\n        if (!universe) return [];\n\n        const projects = this.plugin.sceneManager.getProjects();\n        const result: StoryLineProject[] = [];\n\n        for (const project of projects) {\n            // Direct universe membership\n            if (project.universeId === universeId) {\n                result.push(project);\n                continue;\n            }\n\n            // Via series\n            if (project.seriesUuid && universe.seriesIds?.includes(project.seriesUuid)) {\n                result.push(project);\n                continue;\n            }\n\n            // Via series universeId\n            if (project.seriesUuid) {\n                const seriesUniverse = await this.getUniverseForSeries(project.seriesUuid);\n                if (seriesUniverse === universeId) {\n                    result.push(project);\n                }\n            }\n        }\n\n        return result;\n    }\n\n    // ── Inherited collection resolution ────────────────\n\n    /**\n     * Resolve inherited collections for a book.\n     * Returns merged entity file paths from Universe ∪ Series ∪ Book scopes.\n     * Uses the supplied project's series, not the active project.\n     * @param collectionType A specific category subfolder (e.g., 'Characters', 'Locations').\n     *   Do NOT pass 'all' — use getInheritedCodexFolders() instead.\n     */\n    async resolveInheritedCollections(\n        project: StoryLineProject,\n        collectionType: string\n    ): Promise<InheritedCollectionResult> {\n        const hierarchy = await this.resolveHierarchyPath(project);\n        const bookId = project.bookId || project.filePath;\n\n        const universeEntities: string[] = [];\n        const seriesEntities: string[] = [];\n        const bookEntities: string[] = [];\n\n        // Universe-level entities\n        if (hierarchy.universe) {\n            const universeFolder = this.findUniverseFolder(hierarchy.universe.id);\n            if (universeFolder) {\n                const collectionFolder = normalizePath(`${universeFolder}/${UNIVERSE_CODEX_FOLDER}/${collectionType}`);\n                universeEntities.push(...await this.listMarkdownFiles(collectionFolder));\n            }\n        }\n\n        // Series-level entities — find the series folder for this specific project\n        if (hierarchy.series && (hierarchy.series.seriesUuid || hierarchy.series.name)) {\n            let seriesFolder: string | null = null;\n            const allSeries = await this.plugin.seriesManager.discoverSeries();\n            for (const { folder, meta } of allSeries) {\n                if (meta.seriesUuid === hierarchy.series.seriesUuid || meta.name === hierarchy.series.name) {\n                    seriesFolder = folder;\n                    break;\n                }\n            }\n            if (seriesFolder) {\n                const collectionFolder = normalizePath(`${seriesFolder}/${UNIVERSE_CODEX_FOLDER}/${collectionType}`);\n                seriesEntities.push(...await this.listMarkdownFiles(collectionFolder));\n            }\n        }\n\n        // Book-level entities\n        const bookFolders = this.deriveProjectFolders(project.filePath);\n        const bookCollectionFolder = this.getCollectionFolder(bookFolders, collectionType);\n        bookEntities.push(...await this.listMarkdownFiles(bookCollectionFolder));\n\n        // Merge and deduplicate by file path\n        const allEntities = Array.from(new Set([...universeEntities, ...seriesEntities, ...bookEntities]));\n\n        return {\n            collectionType,\n            bookId,\n            universeEntities,\n            seriesEntities,\n            bookEntities,\n            allEntities,\n        };\n    }\n\n    /**\n     * Get the parent Codex folder paths from Universe and Series scopes.\n     * Returns an ordered array: [universeCodexFolder?, seriesCodexFolder?].\n     * These are the root Codex folders (e.g., \"StoryLine/My Universe/Codex\"),\n     * NOT category-specific subfolders. The caller (CodexManager) is responsible\n     * for scanning the category subfolders within each parent.\n     */\n    async getInheritedCodexFolders(project: StoryLineProject): Promise<string[]> {\n        const hierarchy = await this.resolveHierarchyPath(project);\n        const folders: string[] = [];\n\n        // Universe-level Codex folder\n        if (hierarchy.universe) {\n            const universeFolder = this.findUniverseFolder(hierarchy.universe.id);\n            if (universeFolder) {\n                const universeCodex = normalizePath(`${universeFolder}/${UNIVERSE_CODEX_FOLDER}`);\n                folders.push(universeCodex);\n            }\n        }\n\n        // Series-level Codex folder\n        if (hierarchy.series && (hierarchy.series.seriesUuid || hierarchy.series.name)) {\n            let seriesFolder: string | null = null;\n            const allSeries = await this.plugin.seriesManager.discoverSeries();\n            for (const { folder, meta } of allSeries) {\n                if (meta.seriesUuid === hierarchy.series.seriesUuid || meta.name === hierarchy.series.name) {\n                    seriesFolder = folder;\n                    break;\n                }\n            }\n            if (seriesFolder) {\n                const seriesCodex = normalizePath(`${seriesFolder}/${UNIVERSE_CODEX_FOLDER}`);\n                folders.push(seriesCodex);\n            }\n        }\n\n        return folders;\n    }\n\n    /**\n     * Get the parent Events folder paths from Universe and Series scopes.\n     * Returns an ordered array: [universeEventsFolder?, seriesEventsFolder?].\n     */\n    async getInheritedEventFolders(project: StoryLineProject): Promise<string[]> {\n        const hierarchy = await this.resolveHierarchyPath(project);\n        const folders: string[] = [];\n\n        // Universe-level Events folder\n        if (hierarchy.universe) {\n            const universeFolder = this.findUniverseFolder(hierarchy.universe.id);\n            if (universeFolder) {\n                const universeEvents = normalizePath(`${universeFolder}/Events`);\n                folders.push(universeEvents);\n            }\n        }\n\n        // Series-level Events folder\n        if (hierarchy.series && (hierarchy.series.seriesUuid || hierarchy.series.name)) {\n            let seriesFolder: string | null = null;\n            const allSeries = await this.plugin.seriesManager.discoverSeries();\n            for (const { folder, meta } of allSeries) {\n                if (meta.seriesUuid === hierarchy.series.seriesUuid || meta.name === hierarchy.series.name) {\n                    seriesFolder = folder;\n                    break;\n                }\n            }\n            if (seriesFolder) {\n                const seriesEvents = normalizePath(`${seriesFolder}/Events`);\n                folders.push(seriesEvents);\n            }\n        }\n\n        return folders;\n    }\n\n    /**\n     * Get ALL Events folder paths belonging to a universe.\n     * This includes:\n     * - Universe-level Events folder\n     * - All Series-level Events folders within the universe\n     * - All Book-level Events folders for books in the universe\n     *\n     * Used by TimelineView to display universe-wide canonical Events\n     * regardless of which book is currently active.\n     */\n    async getAllUniverseEventFolders(universeId: string): Promise<string[]> {\n        const folders: string[] = [];\n        const universe = await this.getUniverse(universeId);\n        if (!universe) return folders;\n\n        // Universe-level Events folder\n        const universeFolder = this.findUniverseFolder(universeId);\n        if (universeFolder) {\n            folders.push(normalizePath(`${universeFolder}/Events`));\n        }\n\n        // All series-level Events folders\n        const allSeries = await this.plugin.seriesManager.discoverSeries();\n        for (const { folder, meta } of allSeries) {\n            if (meta.universeId === universeId || universe.seriesIds?.includes(meta.seriesUuid || '')) {\n                folders.push(normalizePath(`${folder}/Events`));\n            }\n        }\n\n        // All book-level Events folders\n        const books = await this.getBooksInUniverse(universeId);\n        for (const book of books) {\n            const bookFolders = this.deriveProjectFolders(book.filePath);\n            const bookEvents = normalizePath(`${bookFolders.baseFolder}/Events`);\n            folders.push(bookEvents);\n        }\n\n        return folders;\n    }\n\n    /**\n     * Get the owner ID for an entity based on its file path.\n     * Determines which Universe, Series, or Book owns the entity.\n     */\n    async getOwnerId(entityFilePath: string): Promise<string | null> {\n        const projects = this.plugin.sceneManager.getProjects();\n\n        // Check if it's in a book's codex\n        for (const project of projects) {\n            const bookFolders = this.deriveProjectFolders(project.filePath);\n            const bookCodex = bookFolders.codexFolder;\n            if (entityFilePath.startsWith(bookCodex)) {\n                return project.bookId || project.filePath;\n            }\n        }\n\n        // Check if it's in a series' codex\n        const seriesList = await this.plugin.seriesManager.discoverSeries();\n        for (const { folder, meta } of seriesList) {\n            const seriesCodex = normalizePath(`${folder}/${UNIVERSE_CODEX_FOLDER}`);\n            if (entityFilePath.startsWith(seriesCodex)) {\n                return meta.seriesUuid || meta.name;\n            }\n        }\n\n        // Check if it's in a universe's codex\n        const universes = await this.getAllUniverses();\n        for (const universe of universes) {\n            const universeFolder = this.findUniverseFolder(universe.id);\n            if (universeFolder) {\n                const universeCodex = normalizePath(`${universeFolder}/${UNIVERSE_CODEX_FOLDER}`);\n                if (entityFilePath.startsWith(universeCodex)) {\n                    return universe.id;\n                }\n            }\n        }\n\n        return null;\n    }\n\n    // ── Discovery ──────────────────────────────────────\n\n    /**\n     * Discover all universes and their series/books in the vault.\n     * Returns a tree structure for navigation.\n     * Includes books that belong directly to a Universe (without a Series).\n     */\n    async discoverHierarchy(): Promise<Array<{\n        universe: UniverseMetadata;\n        folder: string;\n        series: Array<{\n            meta: SeriesMetadata;\n            folder: string;\n            books: StoryLineProject[];\n        }>;\n        directBooks: StoryLineProject[];\n    }>> {\n        const universes = await this.getAllUniverses();\n        const result: Array<{\n            universe: UniverseMetadata;\n            folder: string;\n            series: Array<{\n                meta: SeriesMetadata;\n                folder: string;\n                books: StoryLineProject[];\n            }>;\n            directBooks: StoryLineProject[];\n        }> = [];\n\n        for (const universe of universes) {\n            const universeFolder = this.findUniverseFolder(universe.id);\n            if (!universeFolder) continue;\n\n            const seriesList: Array<{\n                meta: SeriesMetadata;\n                folder: string;\n                books: StoryLineProject[];\n            }> = [];\n\n            // Find series in this universe\n            const allSeries = await this.plugin.seriesManager.discoverSeries();\n            for (const { folder, meta } of allSeries) {\n                if (meta.universeId === universe.id || universe.seriesIds?.includes(meta.seriesUuid || '')) {\n                    const projects = this.plugin.sceneManager.getProjects();\n                    const books = projects.filter(p =>\n                        p.seriesUuid === meta.seriesUuid || p.seriesId === meta.name\n                    );\n                    seriesList.push({ meta, folder, books });\n                }\n            }\n\n            // Find books that belong directly to this universe (no series)\n            const projects = this.plugin.sceneManager.getProjects();\n            const directBooks = projects.filter(p =>\n                p.universeId === universe.id && !p.seriesUuid\n            );\n\n            result.push({ universe, folder: universeFolder, series: seriesList, directBooks });\n        }\n\n        return result;\n    }\n\n    // ── Helpers ────────────────────────────────────────\n\n    /** Find the folder path for a universe by ID. */\n    private findUniverseFolder(universeId: string): string | null {\n        for (const [folder, meta] of this.universeCache) {\n            if (meta.id === universeId) return folder;\n        }\n        return null;\n    }\n\n    /** Derive project folder paths from a file path (mirrors StoryLineProject.ts). */\n    private deriveProjectFolders(\n        filePath: string\n    ): { baseFolder: string; codexFolder: string } {\n        const lastSlash = filePath.lastIndexOf('/');\n        const parentDir = lastSlash >= 0 ? filePath.substring(0, lastSlash) : '';\n        const basename = (filePath.split('/').pop() ?? '').replace(/\\.md$/i, '');\n        const parentName = parentDir.split('/').pop() ?? '';\n        const baseFolder = (parentName === basename) ? parentDir : `${parentDir}/${basename}`;\n        return {\n            baseFolder,\n            codexFolder: `${baseFolder}/Codex`,\n        };\n    }\n\n    /** Get the collection folder path for a given type. */\n    private getCollectionFolder(\n        folders: { baseFolder: string; codexFolder: string },\n        collectionType: string\n    ): string {\n        // Map collection types to folder paths\n        if (collectionType === 'Characters') {\n            return `${folders.codexFolder}/Characters`;\n        }\n        if (collectionType === 'Locations') {\n            return `${folders.codexFolder}/Locations`;\n        }\n        // Generic codex category\n        return `${folders.codexFolder}/${collectionType}`;\n    }\n\n    /** List all .md files in a folder recursively. */\n    private async listMarkdownFiles(folder: string): Promise<string[]> {\n        const adapter = this.app.vault.adapter;\n        if (!await adapter.exists(folder)) return [];\n\n        const results: string[] = [];\n        await this.listMarkdownFilesRecursive(folder, results);\n        return results;\n    }\n\n    private async listMarkdownFilesRecursive(folder: string, results: string[]): Promise<void> {\n        const adapter = this.app.vault.adapter;\n        const listing = await adapter.list(folder);\n\n        for (const file of listing.files) {\n            if (file.toLowerCase().endsWith('.md')) {\n                results.push(file);\n            }\n        }\n\n        for (const subfolder of listing.folders) {\n            await this.listMarkdownFilesRecursive(subfolder, results);\n        }\n    }\n\n    /** Ensure a folder exists, creating it if necessary. */\n    private async ensureFolder(folder: string): Promise<void> {\n        const adapter = this.app.vault.adapter;\n        if (!await adapter.exists(folder)) {\n            await adapter.mkdir(folder);\n        }\n    }\n\n    /** Remove a folder only if it's empty. */\n    private async removeFolderIfEmpty(folder: string): Promise<void> {\n        const adapter = this.app.vault.adapter;\n        if (!await adapter.exists(folder)) return;\n\n        const listing = await adapter.list(folder);\n        if (listing.files.length === 0 && listing.folders.length === 0) {\n            await adapter.rmdir(folder, false);\n        }\n    }\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/services/Validator.ts","messages":[{"ruleId":"max-lines-per-function","severity":2,"message":"Static method 'checkTimeline' has too many lines (53). Maximum allowed is 50.","line":69,"column":5,"nodeType":"MethodDefinition","messageId":"exceed","endLine":134,"endColumn":6},{"ruleId":"complexity","severity":2,"message":"Static method 'checkTimeline' has a complexity of 18. Maximum allowed is 10.","line":69,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":69,"endColumn":33},{"ruleId":"max-statements","severity":2,"message":"Static method 'checkTimeline' has too many statements (29). Maximum allowed is 25.","line":69,"column":33,"nodeType":"FunctionExpression","messageId":"exceed","endLine":134,"endColumn":6},{"ruleId":"max-lines-per-function","severity":2,"message":"Static method 'checkCharacters' has too many lines (57). Maximum allowed is 50.","line":172,"column":5,"nodeType":"MethodDefinition","messageId":"exceed","endLine":237,"endColumn":6},{"ruleId":"complexity","severity":2,"message":"Static method 'checkCharacters' has a complexity of 25. Maximum allowed is 10.","line":172,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":172,"endColumn":35},{"ruleId":"max-statements","severity":2,"message":"Static method 'checkCharacters' has too many statements (27). Maximum allowed is 25.","line":172,"column":35,"nodeType":"FunctionExpression","messageId":"exceed","endLine":237,"endColumn":6},{"ruleId":"complexity","severity":2,"message":"Static method 'checkPlotlines' has a complexity of 14. Maximum allowed is 10.","line":241,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":241,