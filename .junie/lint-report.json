e":238,"column":1,"nodeType":null,"messageId":"exceed","endLine":428,"endColumn":1},{"ruleId":"max-lines-per-function","severity":2,"message":"Method 'setValue' has too many lines (56). Maximum allowed is 50.","line":298,"column":5,"nodeType":"MethodDefinition","messageId":"exceed","endLine":358,"endColumn":6},{"ruleId":"complexity","severity":2,"message":"Method 'setValue' has a complexity of 21. Maximum allowed is 10.","line":298,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":298,"endColumn":13},{"ruleId":"max-lines-per-function","severity":2,"message":"Method 'getCurrentTimeSpan' has too many lines (57). Maximum allowed is 50.","line":370,"column":5,"nodeType":"MethodDefinition","messageId":"exceed","endLine":426,"endColumn":6},{"ruleId":"complexity","severity":2,"message":"Method 'getCurrentTimeSpan' has a complexity of 42. Maximum allowed is 10.","line":370,"column":5,"nodeType":"FunctionExpression","messageId":"complex","endLine":370,"endColumn":31},{"ruleId":"max-statements","severity":2,"message":"Method 'getCurrentTimeSpan' has too many statements (30). Maximum allowed is 25.","line":370,"column":31,"nodeType":"FunctionExpression","messageId":"exceed","endLine":426,"endColumn":6}],"suppressedMessages":[],"errorCount":15,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * TimeSpanPicker — UI for selecting TimeSpan values.\n *\n * Supports selecting instants, intervals, uncertain ranges, and unknown dates.\n * Uses the TimeSpanService for parsing and formatting.\n */\n\nimport { Setting, moment } from 'obsidian';\nimport type { TimeSpan, Timestamp } from '../models/TimeSpan';\nimport type { TimeSpanService } from '../services/TimeSpanService';\n\n/**\n * UI component for selecting TimeSpan values.\n */\nexport class TimeSpanPicker {\n    private container: HTMLElement;\n    private service: TimeSpanService;\n    private onChange: (timeSpan: TimeSpan) => void;\n\n    private kindSelect: HTMLSelectElement | null = null;\n    private instantInput: HTMLInputElement | null = null;\n    private startInput: HTMLInputElement | null = null;\n    private endInput: HTMLInputElement | null = null;\n    private confidenceInput: HTMLInputElement | null = null;\n    private relativeToInput: HTMLInputElement | null = null;\n    private offsetAmountInput: HTMLInputElement | null = null;\n    private offsetUnitSelect: HTMLSelectElement | null = null;\n    private offsetDirectionSelect: HTMLSelectElement | null = null;\n\n    constructor(\n        container: HTMLElement,\n        service: TimeSpanService,\n        onChange: (timeSpan: TimeSpan) => void\n    ) {\n        this.container = container;\n        this.service = service;\n        this.onChange = onChange;\n    }\n\n    /**\n     * Render the picker UI.\n     */\n    render(): void {\n        this.container.empty();\n        this.container.addClass('storyline-timespan-picker');\n\n        // Kind selector\n        const kindSetting = new Setting(this.container)\n            .setName('Time type')\n            .addDropdown(dd => {\n                dd.addOptions({\n                    'instant': 'Exact date',\n                    'interval': 'Date range',\n                    'open-ended': 'Open-ended range',\n                    'uncertain': 'Uncertain date',\n                    'unknown': 'Unknown date',\n                    'relative': 'Relative to event',\n                });\n                dd.onChange(async (value: string) => {\n                    this.kind = value as TimeSpan['kind'];\n                    this.renderFields();\n                });\n                this.kindSelect = dd.selectEl;\n            });\n\n        this.renderFields();\n    }\n\n    private kind: TimeSpan['kind'] = 'instant';\n\n    /**\n     * Render fields based on the selected kind.\n     */\n    private renderFields(): void {\n        // Remove old fields but keep kind selector and display\n        const oldFields = this.container.querySelectorAll('.timespan-fields');\n        oldFields.forEach(el => el.remove());\n\n        const fieldsContainer = this.container.createDiv('timespan-fields');\n\n        switch (this.kind) {\n            case 'instant':\n                this.renderInstantField(fieldsContainer);\n                break;\n            case 'interval':\n                this.renderIntervalFields(fieldsContainer);\n                break;\n            case 'open-ended':\n                this.renderOpenEndedField(fieldsContainer);\n                break;\n            case 'uncertain':\n                this.renderUncertainFields(fieldsContainer);\n                break;\n            case 'unknown':\n                // No fields needed for unknown\n                break;\n            case 'relative':\n                this.renderRelativeFields(fieldsContainer);\n                break;\n        }\n    }\n\n    private renderInstantField(container: HTMLElement): void {\n        new Setting(container)\n            .setName('Date')\n            .addText(text => {\n                text.setPlaceholder('YYYY-MM-DD');\n                text.onChange(async (value) => {\n                    const ts = this.service.parse(value);\n                    if (ts && ts.kind === 'instant') {\n                        this.onChange(ts);\n                    }\n                });\n                this.instantInput = text.inputEl;\n            });\n    }\n\n    private renderIntervalFields(container: HTMLElement): void {\n        new Setting(container)\n            .setName('Start date')\n            .addText(text => {\n                text.setPlaceholder('YYYY-MM-DD');\n                text.onChange(async (value) => {\n                    const ts = this.service.parse(value);\n                    if (ts && ts.kind === 'instant') {\n                        const current = this.getCurrentTimeSpan();\n                        if (current && current.kind === 'interval') {\n                            current.start = ts.instant;\n                            this.onChange(current);\n                        }\n                    }\n                });\n                this.startInput = text.inputEl;\n            });\n\n        new Setting(container)\n            .setName('End date')\n            .addText(text => {\n                text.setPlaceholder('YYYY-MM-DD');\n                text.onChange(async (value) => {\n                    const ts = this.service.parse(value);\n                    if (ts && ts.kind === 'instant') {\n                        const current = this.getCurrentTimeSpan();\n                        if (current && current.kind === 'interval') {\n                            current.end = ts.instant;\n                            this.onChange(current);\n                        }\n                    }\n                });\n                this.endInput = text.inputEl;\n            });\n    }\n\n    private renderOpenEndedField(container: HTMLElement): void {\n        new Setting(container)\n            .setName('Start date')\n            .addText(text => {\n                text.setPlaceholder('YYYY-MM-DD');\n                text.onChange(async (value) => {\n                    const ts = this.service.parse(value);\n                    if (ts && ts.kind === 'instant') {\n                        const open: TimeSpan = {\n                            kind: 'open-ended',\n                            start: ts.instant,\n                        };\n                        this.onChange(open);\n                    }\n                });\n                this.startInput = text.inputEl;\n            });\n    }\n\n    private renderUncertainFields(container: HTMLElement): void {\n        new Setting(container)\n            .setName('Start of range')\n            .addText(text => {\n                text.setPlaceholder('YYYY-MM-DD');\n                text.onChange(async (value) => {\n                    const ts = this.service.parse(value);\n                    if (ts && ts.kind === 'instant') {\n                        const current = this.getCurrentTimeSpan();\n                        if (current && current.kind === 'uncertain') {\n                            current.range.start = ts.instant;\n                            this.onChange(current);\n                        }\n                    }\n                });\n                this.startInput = text.inputEl;\n            });\n\n        new Setting(container)\n            .setName('End of range')\n            .addText(text => {\n                text.setPlaceholder('YYYY-MM-DD');\n                text.onChange(async (value) => {\n                    const ts = this.service.parse(value);\n                    if (ts && ts.kind === 'instant') {\n                        const current = this.getCurrentTimeSpan();\n                        if (current && current.kind === 'uncertain') {\n                            current.range.end = ts.instant;\n                            this.onChange(current);\n                        }\n                    }\n                });\n                this.endInput = text.inputEl;\n            });\n\n        new Setting(container)\n            .setName('Confidence')\n            .addText(text => {\n                text.setPlaceholder('0.0 - 1.0');\n                text.inputEl.type = 'number';\n                text.inputEl.step = '0.1';\n                text.inputEl.min = '0';\n                text.inputEl.max = '1';\n                text.onChange(async (value) => {\n                    const current = this.getCurrentTimeSpan();\n                    if (current && current.kind === 'uncertain') {\n                        current.confidence = parseFloat(value) || 0.5;\n                        this.onChange(current);\n                    }\n                });\n                this.confidenceInput = text.inputEl;\n            });\n    }\n\n    private renderRelativeFields(container: HTMLElement): void {\n        new Setting(container)\n            .setName('Reference ID')\n            .addText(text => {\n                text.setPlaceholder('Event or Scene UUID');\n                text.onChange(async (value) => {\n                    const current = this.getCurrentTimeSpan();\n                    if (current && current.kind === 'relative') {\n                        current.relativeTo = value;\n                        this.onChange(current);\n                    }\n                });\n                this.relativeToInput = text.inputEl;\n            });\n\n        new Setting(container)\n            .setName('Offset amount')\n            .addText(text => {\n                text.setPlaceholder('3');\n                text.inputEl.type = 'number';\n                text.onChange(async (value) => {\n                    const current = this.getCurrentTimeSpan();\n                    if (current && current.kind === 'relative') {\n                        current.offset.amount = parseInt(value, 10) || 0;\n                        this.onChange(current);\n                    }\n                });\n                this.offsetAmountInput = text.inputEl;\n            });\n\n        new Setting(container)\n            .setName('Offset unit')\n            .addDropdown(dd => {\n                dd.addOptions({\n                    'day': 'Days',\n                    'week': 'Weeks',\n                    'month': 'Months',\n                    'year': 'Years',\n                    'season': 'Seasons',\n                });\n                dd.onChange(async (value: string) => {\n                    const current = this.getCurrentTimeSpan();\n                    if (current && current.kind === 'relative') {\n                        current.offset.unit = value as 'day' | 'week' | 'month' | 'year' | 'season';\n                        this.onChange(current);\n                    }\n                });\n                this.offsetUnitSelect = dd.selectEl;\n            });\n\n        new Setting(container)\n            .setName('Direction')\n            .addDropdown(dd => {\n                dd.addOptions({\n                    'before': 'Before',\n                    'after': 'After',\n                });\n                dd.onChange(async (value: string) => {\n                    const current = this.getCurrentTimeSpan();\n                    if (current && current.kind === 'relative') {\n                        current.offset.direction = value as 'before' | 'after';\n                        this.onChange(current);\n                    }\n                });\n                this.offsetDirectionSelect = dd.selectEl;\n            });\n    }\n\n    /**\n     * Set the current TimeSpan value.\n     */\n    setValue(timeSpan: TimeSpan | null): void {\n        if (!timeSpan) {\n            this.kind = 'unknown';\n            if (this.kindSelect) this.kindSelect.value = 'unknown';\n            this.renderFields();\n            return;\n        }\n\n        this.kind = timeSpan.kind;\n        if (this.kindSelect) this.kindSelect.value = timeSpan.kind;\n\n\n        this.renderFields();\n\n        // Populate fields based on kind\n        switch (timeSpan.kind) {\n            case 'instant':\n                if (this.instantInput) {\n                    this.instantInput.value = this.service.format(timeSpan);\n                }\n                break;\n            case 'interval':\n                if (this.startInput) {\n                    this.startInput.value = this.service.formatTimestamp(timeSpan.start);\n                }\n                if (this.endInput) {\n                    this.endInput.value = this.service.formatTimestamp(timeSpan.end);\n                }\n                break;\n            case 'open-ended':\n                if (this.startInput) {\n                    this.startInput.value = this.service.formatTimestamp(timeSpan.start);\n                }\n                break;\n            case 'uncertain':\n                if (this.startInput) {\n                    this.startInput.value = this.service.formatTimestamp(timeSpan.range.start);\n                }\n                if (this.endInput) {\n                    this.endInput.value = this.service.formatTimestamp(timeSpan.range.end);\n                }\n                if (this.confidenceInput) {\n                    this.confidenceInput.value = String(timeSpan.confidence ?? 0.5);\n                }\n                break;\n            case 'relative':\n                if (this.relativeToInput) {\n                    this.relativeToInput.value = timeSpan.relativeTo;\n                }\n                if (this.offsetAmountInput) {\n                    this.offsetAmountInput.value = String(timeSpan.offset.amount);\n                }\n                if (this.offsetUnitSelect) {\n                    this.offsetUnitSelect.value = timeSpan.offset.unit;\n                }\n                if (this.offsetDirectionSelect) {\n                    this.offsetDirectionSelect.value = timeSpan.offset.direction;\n                }\n                break;\n        }\n    }\n\n    /**\n     * Get the current TimeSpan value.\n     */\n    getValue(): TimeSpan | null {\n        return this.getCurrentTimeSpan();\n    }\n\n    /**\n     * Get the current TimeSpan based on the selected kind.\n     */\n    private getCurrentTimeSpan(): TimeSpan | null {\n        switch (this.kind) {\n            case 'instant': {\n                const value = this.instantInput?.value || '';\n                return this.service.parse(value) ?? { kind: 'unknown' };\n            }\n            case 'interval': {\n                const start = this.startInput?.value || '';\n                const end = this.endInput?.value || '';\n                const startTs = this.service.parse(start);\n                const endTs = this.service.parse(end);\n                if (startTs && startTs.kind === 'instant' && endTs && endTs.kind === 'instant') {\n                    return { kind: 'interval', start: startTs.instant, end: endTs.instant };\n                }\n                return { kind: 'unknown' };\n            }\n            case 'open-ended': {\n                const start = this.startInput?.value || '';\n                const startTs = this.service.parse(start);\n                if (startTs && startTs.kind === 'instant') {\n                    return { kind: 'open-ended', start: startTs.instant };\n                }\n                return { kind: 'unknown' };\n            }\n            case 'uncertain': {\n                const start = this.startInput?.value || '';\n                const end = this.endInput?.value || '';\n                const confidence = parseFloat(this.confidenceInput?.value || '0.5');\n                const startTs = this.service.parse(start);\n                const endTs = this.service.parse(end);\n                if (startTs && startTs.kind === 'instant' && endTs && endTs.kind === 'instant') {\n                    return {\n                        kind: 'uncertain',\n                        range: { start: startTs.instant, end: endTs.instant },\n                        confidence: isNaN(confidence) ? 0.5 : confidence,\n                    };\n                }\n                return { kind: 'unknown' };\n            }\n            case 'unknown':\n                return { kind: 'unknown' };\n            case 'relative': {\n                const relativeTo = this.relativeToInput?.value || '';\n                const amount = parseInt(this.offsetAmountInput?.value || '0', 10);\n                const unit = (this.offsetUnitSelect?.value || 'day') as 'day' | 'week' | 'month' | 'year' | 'season';\n                const direction = (this.offsetDirectionSelect?.value || 'before') as 'before' | 'after';\n                if (relativeTo) {\n                    return {\n                        kind: 'relative',\n                        relativeTo,\n                        offset: { amount, unit, direction },\n                    };\n                }\n                return { kind: 'unknown' };\n            }\n        }\n    }\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/components/Tooltip.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/components/UniverseSelector.ts","messages":[{"ruleId":"eslint-comments/disable-enable-pair","severity":2,"message":"Requires 'eslint-enable' directive for '@typescript-eslint/no-misused-promises'.","line":1,"column":19,"nodeType":null,"messageId":"missingRulePair","endLine":1,"endColumn":57},{"ruleId":"obsidianmd/ui/sentence-case","severity":2,"message":"Use sentence case for UI text. Expected: '+ new project'","line":32,"column":15,"nodeType":"Literal","messageId":"useSentenceCase","endLine":32,"endColumn":30},{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'createExpandableHeader' has too many lines (51). Maximum allowed is 50.","line":51,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":103,"endColumn":2},{"ruleId":"max-params","severity":2,"message":"Function 'createExpandableHeader' has too many parameters (5). Maximum allowed is 4.","line":51,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":51,"endColumn":32},{"ruleId":"max-lines-per-function","severity":2,"message":"Async function 'refreshUniverseSelector' has too many lines (102). Maximum allowed is 50.","line":138,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":280,"endColumn":2},{"ruleId":"max-statements","severity":2,"message":"Async function 'refreshUniverseSelector' has too many statements (76). Maximum allowed is 25.","line":138,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":280,"endColumn":2},{"ruleId":"complexity","severity":2,"message":"Async function 'refreshUniverseSelector' has a complexity of 25. Maximum allowed is 10.","line":138,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":138,"endColumn":46},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'universeBooks' is assigned a value but never used.","line":203,"column":17,"nodeType":"Identifier","messageId":"unusedVar","endLine":203,"endColumn":30},{"ruleId":"max-params","severity":2,"message":"Function 'setupDropTarget' has too many parameters (5). Maximum allowed is 4.","line":286,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":286,"endColumn":25},{"ruleId":"max-lines","severity":2,"message":"File has too many lines (416). Maximum allowed is 200.","line":290,"column":1,"nodeType":null,"messageId":"exceed","endLine":554,"endColumn":1},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":307,"column":19,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":307,"endColumn":83},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .type on an `any` value.","line":308,"column":22,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":308,"endColumn":26},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `string`.","line":309,"column":46,"nodeType":"MemberExpression","messageId":"unsafeArgument","endLine":309,"endColumn":59},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .filePath on an `any` value.","line":309,"column":51,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":309,"endColumn":59},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .type on an `any` value.","line":310,"column":29,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":310,"endColumn":33},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `string`.","line":311,"column":48,"nodeType":"MemberExpression","messageId":"unsafeArgument","endLine":311,"endColumn":63},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .seriesUuid on an `any` value.","line":311,"column":53,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":311,"endColumn":63},{"ruleId":"max-params","severity":2,"message":"Async function 'handleDropBook' has too many parameters (5). Maximum allowed is 4.","line":322,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":322,"endColumn":30},{"ruleId":"complexity","severity":2,"message":"Async function 'handleDropBook' has a complexity of 11. Maximum allowed is 10.","line":322,"column":1,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":322,"endColumn":30},{"ruleId":"max-params","severity":2,"message":"Async function 'handleDropSeries' has too many parameters (5). Maximum allowed is 4.","line":359,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":359,"endColumn":32},{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'renderBookCard' has too many lines (101). Maximum allowed is 50.","line":386,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":512,"endColumn":2},{"ruleId":"max-params","severity":2,"message":"Function 'renderBookCard' has too many parameters (5). Maximum allowed is 4.","line":386,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":386,"endColumn":24},{"ruleId":"max-statements","severity":2,"message":"Function 'renderBookCard' has too many statements (33). Maximum allowed is 25.","line":386,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":512,"endColumn":2},{"ruleId":"obsidianmd/prefer-create-el","severity":1,"message":"Use 'info.createDiv({\n        cls: 'universe-selector-card-title',\n        text: book.title,\n    })' instead of 'info.createEl('div', {\n        cls: 'universe-selector-card-title',\n        text: book.title,\n    })'.","line":446,"column":5,"nodeType":"CallExpression","messageId":"preferCreateEl","endLine":449,"endColumn":7,"fix":{"range":[17522,17622],"text":"info.createDiv({\n        cls: 'universe-selector-card-title',\n        text: book.title,\n    })"}},{"ruleId":"obsidianmd/prefer-create-el","severity":1,"message":"Use 'info.createDiv({\n            cls: 'universe-selector-card-series',\n            text: book.seriesId,\n        })' instead of 'info.createEl('div', {\n            cls: 'universe-selector-card-series',\n            text: book.seriesId,\n        })'.","line":452,"column":9,"nodeType":"CallExpression","messageId":"preferCreateEl","endLine":455,"endColumn":11,"fix":{"range":[17658,17774],"text":"info.createDiv({\n            cls: 'universe-selector-card-series',\n            text: book.seriesId,\n        })"}},{"ruleId":"@typescript-eslint/no-unsafe-assignment","severity":2,"message":"Unsafe assignment of an `any` value.","line":490,"column":19,"nodeType":"VariableDeclarator","messageId":"anyAssignment","endLine":490,"endColumn":83},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .type on an `any` value.","line":491,"column":22,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":491,"endColumn":26},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .filePath on an `any` value.","line":491,"column":46,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":491,"endColumn":54},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `string`.","line":493,"column":49,"nodeType":"MemberExpression","messageId":"unsafeArgument","endLine":493,"endColumn":62},{"ruleId":"@typescript-eslint/no-unsafe-member-access","severity":2,"message":"Unsafe member access .filePath on an `any` value.","line":493,"column":54,"nodeType":"Identifier","messageId":"unsafeMemberExpression","endLine":493,"endColumn":62},{"ruleId":"complexity","severity":2,"message":"Async function 'handleBookReorder' has a complexity of 12. Maximum allowed is 10.","line":517,"column":1,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":517,"endColumn":33}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-misused-promises","severity":2,"message":"Promise returned in function argument where a void return was expected.","line":303,"column":38,"nodeType":"ArrowFunctionExpression","messageId":"voidReturnArgument","endLine":316,"endColumn":6,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-misused-promises","severity":2,"message":"Promise returned in function argument where a void return was expected.","line":431,"column":44,"nodeType":"ArrowFunctionExpression","messageId":"voidReturnArgument","endLine":442,"endColumn":6,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-misused-promises","severity":2,"message":"Promise returned in function argument where a void return was expected.","line":486,"column":35,"nodeType":"ArrowFunctionExpression","messageId":"voidReturnArgument","endLine":498,"endColumn":6,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-misused-promises","severity":2,"message":"Promise returned in function argument where a void return was expected.","line":503,"column":36,"nodeType":"ArrowFunctionExpression","messageId":"voidReturnArgument","endLine":509,"endColumn":6,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]}],"errorCount":28,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":2,"source":"/* eslint-disable @typescript-eslint/no-misused-promises -- Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file */\nimport * as obsidian from 'obsidian';\nimport type SceneCardsPlugin from '../main';\nimport type { StoryLineProject } from '../models/StoryLineProject';\nimport { attachTooltip } from './Tooltip';\n\n/**\n * UniverseSelector — a hierarchy-aware project library that displays\n * Universe → Series → Book as polished book cards.\n *\n * Features:\n * - Portrait-oriented book cards (2:3 aspect ratio) with fallback covers\n * - Expandable Universe and Series groupings\n * - Active project highlighting\n * - Sensible empty states\n * - Responsive layout for dark/light themes\n */\nexport function renderUniverseSelector(\n    container: HTMLElement,\n    plugin: SceneCardsPlugin,\n    onSwitch: () => void\n): HTMLElement {\n    const wrapper = container.createDiv('story-line-universe-selector');\n\n    // ── Loading state ──\n    const loadingEl = wrapper.createDiv({ cls: 'universe-selector-loading' });\n    loadingEl.createSpan({ text: 'Loading library...' });\n\n    // ── New project button ──\n    const newBtn = wrapper.createEl('button', {\n        cls: 'universe-selector-new-btn',\n        text: '+ New Project',\n    });\n    newBtn.addEventListener('click', () => {\n        (plugin.app as unknown as { commands: { executeCommandById: (id: string) => void } }).commands.executeCommandById('storyline:create-new-project');\n    });\n\n    // Build the async tree immediately\n    refreshUniverseSelector(wrapper, plugin, onSwitch).catch(() => {\n        // If refresh fails, loadingEl is still visible\n    });\n\n    return wrapper;\n}\n\n/**\n * Create an expandable section header with toggle functionality.\n * The header is inserted BEFORE the childrenEl in the DOM.\n * If seriesUuid is provided, the header becomes draggable for hierarchy management.\n */\nfunction createExpandableHeader(\n    parent: HTMLElement,\n    label: string,\n    icon: string,\n    childrenEl: HTMLElement,\n    seriesUuid?: string\n): HTMLElement {\n    const header = parent.createDiv({ cls: 'universe-selector-header' });\n    header.insertAdjacentElement('afterend', childrenEl);\n    const toggle = header.createSpan({ cls: 'universe-selector-toggle' });\n    obsidian.setIcon(toggle, 'chevron-right');\n    const iconEl = header.createSpan({ cls: 'universe-selector-icon' });\n    obsidian.setIcon(iconEl, icon);\n    header.createSpan({ cls: 'universe-selector-label', text: label });\n\n    if (seriesUuid) {\n        const dragHandle = header.createEl('button', {\n            cls: 'universe-selector-drag-handle',\n            attr: { 'aria-label': `Drag to move \"${label}\"` },\n        });\n        obsidian.setIcon(dragHandle, 'grip-vertical');\n        header.setAttribute('draggable', 'true');\n        let isDragging = false;\n        dragHandle.addEventListener('mousedown', (e) => { e.stopPropagation(); isDragging = true; });\n        header.addEventListener('dragstart', (e: DragEvent) => {\n            if (!e.dataTransfer) return;\n            e.dataTransfer.setData('text/plain', JSON.stringify({ type: 'series', seriesUuid }));\n            header.addClass('dragging');\n        });\n        header.addEventListener('dragend', () => { header.removeClass('dragging'); });\n        header.addEventListener('click', (e) => {\n            if (isDragging) { isDragging = false; return; }\n            toggleExpand();\n        });\n    }\n\n    let expanded = false;\n    childrenEl.addClass('universe-selector-children-collapsed');\n    const toggleExpand = () => {\n        expanded = !expanded;\n        if (expanded) {\n            childrenEl.removeClass('universe-selector-children-collapsed');\n            obsidian.setIcon(toggle, 'chevron-down');\n        } else {\n            childrenEl.addClass('universe-selector-children-collapsed');\n            obsidian.setIcon(toggle, 'chevron-right');\n        }\n    };\n    if (!seriesUuid) {\n        header.addEventListener('click', toggleExpand);\n    }\n    return header;\n}\n\n/**\n * Generate a deterministic fallback cover color from a title string.\n */\nfunction getFallbackCoverColor(title: string): string {\n    // Simple hash to pick from a palette of pleasant colors\n    const colors = [\n        '#4A90D9', '#50B0A0', '#D97A4A', '#9B59B6',\n        '#E74C3C', '#2ECC71', '#F39C12', '#1ABC9C',\n        '#8E44AD', '#3498DB', '#E67E22', '#16A085',\n    ];\n    let hash = 0;\n    for (let i = 0; i < title.length; i++) {\n        hash = ((hash << 5) - hash) + title.charCodeAt(i);\n        hash |= 0;\n    }\n    return colors[Math.abs(hash) % colors.length];\n}\n\n/**\n * Generate the first letter or two for the fallback cover.\n */\nfunction getFallbackInitials(title: string): string {\n    const words = title.trim().split(/\\s+/);\n    if (words.length >= 2) {\n        return (words[0][0] + words[1][0]).toUpperCase();\n    }\n    return title.substring(0, 2).toUpperCase();\n}\n\n/**\n * Async version that builds the full library with discovered hierarchy.\n * Call this after initial render to populate with universe/series data.\n */\nexport async function refreshUniverseSelector(\n    wrapper: HTMLElement,\n    plugin: SceneCardsPlugin,\n    onSwitch: () => void\n): Promise<void> {\n    // Remove loading state\n    const loadingEl = wrapper.querySelector<HTMLElement>('.universe-selector-loading');\n    if (loadingEl) loadingEl.remove();\n\n    // Clear previous content except the new project button\n    const newBtn = wrapper.querySelector<HTMLElement>('.universe-selector-new-btn');\n    wrapper.empty();\n    if (newBtn) wrapper.appendChild(newBtn);\n\n    const active = plugin.sceneManager.activeProject;\n    const projects = plugin.sceneManager.getProjects();\n\n    // Container for all groups\n    const groupsContainer = wrapper.createDiv({ cls: 'universe-selector-groups' });\n\n    // Discover hierarchy\n    const hierarchy = await plugin.universeManager.discoverHierarchy();\n\n    // Track which projects are in the hierarchy\n    const hierarchyProjectPaths = new Set<string>();\n    let totalBooks = 0;\n\n    // Render universes\n    for (const { universe, series: seriesList, directBooks } of hierarchy) {\n        const universeSection = groupsContainer.createDiv({ cls: 'universe-selector-section' });\n        universeSection.dataset.universeId = universe.id;\n\n        const childrenEl = universeSection.createDiv({ cls: 'universe-selector-children' });\n        const header = createExpandableHeader(universeSection, universe.name, 'globe', childrenEl);\n\n        // Universe header is a drop target for Series and Books\n        setupDropTarget(header, 'universe', universe.id, plugin, onSwitch);\n\n        let universeBooks = 0;\n\n        // Render direct books (books that belong to universe without a series)\n        if (directBooks.length > 0) {\n            const directGrid = childrenEl.createDiv({ cls: 'universe-selector-cards' });\n            for (const book of directBooks) {\n                hierarchyProjectPaths.add(book.filePath);\n                universeBooks++;\n                totalBooks++;\n                renderBookCard(directGrid, book, active, plugin, onSwitch);\n            }\n        }\n\n        // Render series\n        for (const { meta, books } of seriesList) {\n            const seriesSection = childrenEl.createDiv({ cls: 'universe-selector-section' });\n            seriesSection.dataset.seriesUuid = meta.seriesUuid || '';\n            const seriesChildren = seriesSection.createDiv({ cls: 'universe-selector-children' });\n            const seriesHeader = createExpandableHeader(seriesSection, meta.name, 'library', seriesChildren, meta.seriesUuid || undefined);\n\n            // Series header is a drop target for Books\n            setupDropTarget(seriesHeader, 'series', meta.seriesUuid || '', plugin, onSwitch);\n\n            // Book cards grid\n            const cardsGrid = seriesChildren.createDiv({ cls: 'universe-selector-cards' });\n            for (const book of books) {\n                hierarchyProjectPaths.add(book.filePath);\n                universeBooks++;\n                totalBooks++;\n                renderBookCard(cardsGrid, book, active, plugin, onSwitch);\n            }\n        }\n\n        // If universe has no series, show empty state with drop target\n        if (seriesList.length === 0) {\n            const emptyEl = childrenEl.createDiv({ cls: 'universe-selector-empty' });\n            emptyEl.createSpan({\n                text: 'No series in this universe yet.',\n            });\n            setupDropTarget(emptyEl, 'universe', universe.id, plugin, onSwitch);\n        }\n    }\n\n    // Render standalone series (not in any universe)\n    const allSeries = await plugin.seriesManager.discoverSeries();\n    const universeSeriesUuids = new Set<string>();\n    for (const { series: seriesList } of hierarchy) {\n        for (const { meta } of seriesList) {\n            if (meta.seriesUuid) {\n                universeSeriesUuids.add(meta.seriesUuid);\n            }\n        }\n    }\n\n    for (const { meta } of allSeries) {\n        if (universeSeriesUuids.has(meta.seriesUuid || '')) continue;\n\n        const seriesSection = groupsContainer.createDiv({ cls: 'universe-selector-section' });\n        seriesSection.dataset.seriesUuid = meta.seriesUuid || '';\n        const seriesChildren = seriesSection.createDiv({ cls: 'universe-selector-children' });\n        const seriesHeader = createExpandableHeader(seriesSection, meta.name, 'library', seriesChildren, meta.seriesUuid || undefined);\n\n        // Standalone series can receive books via drag\n        setupDropTarget(seriesHeader, 'series', meta.seriesUuid || '', plugin, onSwitch);\n\n        const books = projects.filter(p =>\n            p.seriesUuid === meta.seriesUuid || p.seriesId === meta.name\n        );\n\n        const cardsGrid = seriesChildren.createDiv({ cls: 'universe-selector-cards' });\n        for (const book of books) {\n            hierarchyProjectPaths.add(book.filePath);\n            totalBooks++;\n            renderBookCard(cardsGrid, book, active, plugin, onSwitch);\n        }\n    }\n\n    // Render standalone books section with drop target for detaching\n    const standaloneBooks = projects.filter(p => !hierarchyProjectPaths.has(p.filePath));\n    if (standaloneBooks.length > 0) {\n        const standaloneSection = groupsContainer.createDiv({ cls: 'universe-selector-section' });\n        const standaloneChildren = standaloneSection.createDiv({ cls: 'universe-selector-children' });\n        createExpandableHeader(standaloneSection, 'Standalone Books', 'book', standaloneChildren);\n\n        const cardsGrid = standaloneChildren.createDiv({ cls: 'universe-selector-cards' });\n        for (const book of standaloneBooks) {\n            totalBooks++;\n            renderBookCard(cardsGrid, book, active, plugin, onSwitch);\n        }\n    }\n\n    // Standalone drop zone — for detaching books/series\n    const standaloneZone = groupsContainer.createDiv({ cls: 'universe-selector-standalone-zone' });\n    standaloneZone.createSpan({ text: 'Drag here to detach from Universe/Series' });\n    setupDropTarget(standaloneZone, 'standalone', '', plugin, onSwitch);\n\n    // Empty state — no projects at all\n    if (totalBooks === 0) {\n        const emptyState = wrapper.createDiv({ cls: 'universe-selector-empty-state' });\n        emptyState.createEl('h3', { text: 'Your library is empty' });\n        emptyState.createEl('p', {\n            text: 'Create your first StoryLine project to get started.',\n        });\n    }\n}\n\n/**\n * Set up a drop target element for drag-and-drop hierarchy management.\n * Supports dropping books onto universes, series, or standalone zones.\n */\nfunction setupDropTarget(\n    element: HTMLElement,\n    targetType: 'universe' | 'series' | 'standalone',\n    targetId: string,\n    plugin: SceneCardsPlugin,\n    onSwitch: () => void\n): void {\n    element.addEventListener('dragover', (e: DragEvent) => {\n        e.preventDefault();\n        e.dataTransfer!.dropEffect = 'move';\n        element.addClass('drag-over');\n    });\n\n    element.addEventListener('dragleave', () => {\n        element.removeClass('drag-over');\n    });\n\n    element.addEventListener('drop', async (e: DragEvent) => {\n        e.preventDefault();\n        element.removeClass('drag-over');\n        try {\n            const data = JSON.parse(e.dataTransfer?.getData('text/plain') || '{}');\n            if (data.type === 'book') {\n                await handleDropBook(plugin, data.filePath, targetType, targetId, onSwitch);\n            } else if (data.type === 'series') {\n                await handleDropSeries(plugin, data.seriesUuid, targetType, targetId, onSwitch);\n            }\n        } catch (err) {\n            new obsidian.Notice((err instanceof Error ? err.message : String(err)), 10000);\n        }\n    });\n}\n\n/**\n * Handle dropping a book onto a universe, series, or standalone zone.\n */\nasync function handleDropBook(\n    plugin: SceneCardsPlugin,\n    bookPath: string,\n    targetType: 'universe' | 'series' | 'standalone',\n    targetId: string,\n    onSwitch: () => void\n): Promise<void> {\n    const book = plugin.sceneManager.getProjects().find(p => p.filePath === bookPath);\n    if (!book) return;\n\n    if (targetType === 'standalone') {\n        if (book.seriesUuid) {\n            await plugin.seriesManager.removeBookFromSeries(book.seriesUuid, book);\n        }\n        book.seriesUuid = undefined;\n        book.seriesId = undefined;\n        book.universeId = undefined;\n        await plugin.sceneManager.saveProjectFrontmatter(book);\n        onSwitch();\n    } else if (targetType === 'series' && targetId) {\n        if (book.seriesUuid && book.seriesUuid !== targetId) {\n            await plugin.seriesManager.removeBookFromSeries(book.seriesUuid, book);\n        }\n        await plugin.seriesManager.addBookToSeries(targetId, book);\n        onSwitch();\n    } else if (targetType === 'universe' && targetId) {\n        if (book.seriesUuid) {\n            await plugin.seriesManager.removeBookFromSeries(book.seriesUuid, book);\n        }\n        book.universeId = targetId;\n        book.seriesUuid = undefined;\n        book.seriesId = undefined;\n        await plugin.sceneManager.saveProjectFrontmatter(book);\n        onSwitch();\n    }\n}\n\nasync function handleDropSeries(\n    plugin: SceneCardsPlugin,\n    seriesUuid: string,\n    targetType: 'universe' | 'series' | 'standalone',\n    targetId: string,\n    onSwitch: () => void\n): Promise<void> {\n    if (targetType === 'universe' && targetId) {\n        const found = await plugin.seriesManager.getSeriesByUuid(seriesUuid);\n        if (!found) throw new Error('Series not found');\n        await plugin.universeManager.addSeriesToUniverse(targetId, found.folder);\n        onSwitch();\n    } else if (targetType === 'standalone') {\n        const found = await plugin.seriesManager.getSeriesByUuid(seriesUuid);\n        if (!found) throw new Error('Series not found');\n        const meta = found.meta;\n        if (meta.universeId) {\n            await plugin.universeManager.removeSeriesFromUniverse(meta.universeId, seriesUuid);\n            onSwitch();\n        }\n    }\n}\n\n/**\n * Render a book card with portrait-oriented cover and title.\n * Supports drag-and-drop for hierarchy management.\n */\nfunction renderBookCard(\n    parent: HTMLElement,\n    book: StoryLineProject,\n    activeProject: StoryLineProject | null,\n    plugin: SceneCardsPlugin,\n    onSwitch: () => void\n): HTMLElement {\n    const isActive = activeProject && book.filePath === activeProject.filePath;\n\n    const card = parent.createDiv({ cls: 'universe-selector-card' });\n    if (isActive) {\n        card.addClass('universe-selector-card-active');\n    }\n    card.dataset.bookId = book.bookId || '';\n    card.dataset.bookPath = book.filePath;\n\n    // Drag handle\n    const dragHandle = card.createEl('button', {\n        cls: 'universe-selector-drag-handle',\n        attr: { 'aria-label': `Drag to move \"${book.title}\"` },\n    });\n    obsidian.setIcon(dragHandle, 'grip-vertical');\n\n    // Cover area (portrait 2:3 aspect ratio)\n    const cover = card.createDiv({ cls: 'universe-selector-cover' });\n\n    if (book.coverImage) {\n        const resourcePath = plugin.app.vault.adapter.getResourcePath(book.coverImage);\n        if (resourcePath) {\n            cover.createEl('img', {\n                cls: 'universe-selector-cover-img',\n                attr: { src: resourcePath, alt: book.title },\n            });\n        } else {\n            renderFallbackCover(cover, book.title);\n        }\n    } else {\n        renderFallbackCover(cover, book.title);\n    }\n\n    // Cover edit button (small pencil icon, top-right corner)\n    const coverEditBtn = cover.createEl('button', {\n        cls: 'universe-selector-cover-edit',\n    });\n    obsidian.setIcon(coverEditBtn, 'pencil');\n    coverEditBtn.addEventListener('click', async (e) => {\n        e.stopPropagation(); // Don't trigger card click (open book)\n        const { pickImage } = await import('./ImagePicker');\n        const sceneFolder = plugin.sceneManager.getSceneFolder() || '';\n        const result = await pickImage(plugin.app, sceneFolder, book.coverImage);\n        if (result === undefined) return; // cancelled\n        // Update the project's coverImage and persist\n        book.coverImage = result || undefined;\n        await plugin.sceneManager.saveProjectFrontmatter(book);\n        // Refresh the library to show the new cover\n        onSwitch();\n    });\n\n    // Title and series info\n    const info = card.createDiv({ cls: 'universe-selector-card-info' });\n    info.createEl('div', {\n        cls: 'universe-selector-card-title',\n        text: book.title,\n    });\n\n    if (book.seriesId) {\n        info.createEl('div', {\n            cls: 'universe-selector-card-series',\n            text: book.seriesId,\n        });\n    }\n\n    attachTooltip(card, isActive ? 'Active project' : `Switch to ${book.title}`);\n\n    // ── Drag and Drop ──\n    card.setAttribute('draggable', 'true');\n\n    card.addEventListener('dragstart', (e: DragEvent) => {\n        if (!e.dataTransfer) return;\n        e.dataTransfer.setData('text/plain', JSON.stringify({\n            type: 'book',\n            bookId: book.bookId,\n            filePath: book.filePath,\n        }));\n        card.addClass('dragging');\n    });\n\n    card.addEventListener('dragend', () => {\n        card.removeClass('dragging');\n    });\n\n    card.addEventListener('dragover', (e: DragEvent) => {\n        e.preventDefault();\n        e.dataTransfer?.dropEffect === 'move' && card.addClass('drag-over');\n    });\n\n    card.addEventListener('dragleave', () => {\n        card.removeClass('drag-over');\n    });\n\n    card.addEventListener('drop', async (e: DragEvent) => {\n        e.preventDefault();\n        card.removeClass('drag-over');\n        try {\n            const data = JSON.parse(e.dataTransfer?.getData('text/plain') || '{}');\n            if (data.type === 'book' && data.filePath !== book.filePath) {\n                // Drop book on book — reorder within same series\n                await handleBookReorder(plugin, data.filePath, book.filePath, onSwitch);\n            }\n        } catch {\n            // Ignore invalid drag data\n        }\n    });\n\n    // Click to open book — but not when dragging\n    let isDragging = false;\n    dragHandle.addEventListener('mousedown', () => { isDragging = true; });\n    card.addEventListener('click', async (e) => {\n        if (isDragging) {\n            isDragging = false;\n            return;\n        }\n        await plugin.navigateToBook(book);\n    });\n\n    return card;\n}\n\n/**\n * Handle reordering a book when dropped on another book in the same series.\n */\nasync function handleBookReorder(\n    plugin: SceneCardsPlugin,\n    sourcePath: string,\n    targetPath: string,\n    onSwitch: () => void\n): Promise<void> {\n    const source = plugin.sceneManager.getProjects().find(p => p.filePath === sourcePath);\n    const target = plugin.sceneManager.getProjects().find(p => p.filePath === targetPath);\n    if (!source || !target || source.seriesUuid !== target.seriesUuid || !source.seriesUuid) {\n        return;\n    }\n    const found = await plugin.seriesManager.getSeriesByUuid(source.seriesUuid);\n    if (!found || !found.meta.bookIds) return;\n    const meta = found.meta;\n    const bookIds = meta.bookIds!;\n    const sourceIdx = bookIds.indexOf(source.bookId || '');\n    const targetIdx = bookIds.indexOf(target.bookId || '');\n    if (sourceIdx === -1 || targetIdx === -1) return;\n    bookIds.splice(sourceIdx, 1);\n    bookIds.splice(targetIdx, 0, source.bookId || '');\n    await plugin.seriesManager.saveSeriesMetadata(found.folder, meta);\n    onSwitch();\n}\n\n/**\n * Render a fallback cover with deterministic color and initials.\n */\nfunction renderFallbackCover(coverEl: HTMLElement, title: string): void {\n    const color = getFallbackCoverColor(title);\n    const initials = getFallbackInitials(title);\n\n    const fallbackEl = coverEl.createDiv({\n        cls: 'universe-selector-cover-fallback',\n        text: initials,\n    });\n    fallbackEl.style.backgroundColor = color;\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/components/ViewSnapshotModal.ts","messages":[],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-misused-promises","severity":2,"message":"Promise returned in function argument where a void return was expected.","line":35,"column":42,"nodeType":"ArrowFunctionExpression","messageId":"voidReturnArgument","endLine":39,"endColumn":10,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"no-empty","severity":2,"message":"Empty block statement.","line":71,"column":23,"nodeType":"BlockStatement","messageId":"unexpected","endLine":7