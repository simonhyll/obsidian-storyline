","endLine":326,"endColumn":27,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-misused-promises","severity":2,"message":"Promise-returning function provided to property where a void return was expected.","line":328,"column":17,"nodeType":null,"messageId":"voidReturnProperty","endLine":328,"endColumn":39,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'savedScroll' is assigned a value but never used.","line":491,"column":19,"nodeType":"Identifier","messageId":"unusedVar","endLine":491,"endColumn":30,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since the receiver accepts the original type of the expression.","line":502,"column":25,"nodeType":"TSAsExpression","messageId":"contextuallyUnnecessary","endLine":502,"endColumn":72,"fix":{"range":[23393,23411],"text":""},"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"The type arguments for this generic call may be inferred from the assertion. Specify them explicitly instead.","line":841,"column":24,"nodeType":"TSAsExpression","messageId":"contextuallyInferredTypeArguments","endLine":841,"endColumn":91,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"The type arguments for this generic call may be inferred from the assertion. Specify them explicitly instead.","line":842,"column":27,"nodeType":"TSAsExpression","messageId":"contextuallyInferredTypeArguments","endLine":842,"endColumn":98,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-misused-promises","severity":2,"message":"Promise returned in function argument where a void return was expected.","line":976,"column":13,"nodeType":"ArrowFunctionExpression","messageId":"voidReturnArgument","endLine":996,"endColumn":14,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-floating-promises","severity":2,"message":"Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator.","line":1203,"column":13,"nodeType":"ExpressionStatement","messageId":"floatingVoid","endLine":1203,"endColumn":39,"suggestions":[{"messageId":"floatingFixVoid","fix":{"range":[55699,55699],"text":"void "},"desc":"Add void operator to ignore."},{"messageId":"floatingFixAwait","fix":{"range":[55699,55699],"text":"await "},"desc":"Add await operator."}],"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-floating-promises","severity":2,"message":"Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator.","line":1274,"column":13,"nodeType":"ExpressionStatement","messageId":"floatingVoid","endLine":1274,"endColumn":35,"suggestions":[{"messageId":"floatingFixVoid","fix":{"range":[59034,59034],"text":"void "},"desc":"Add void operator to ignore."},{"messageId":"floatingFixAwait","fix":{"range":[59034,59034],"text":"await "},"desc":"Add await operator."}],"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-misused-promises","severity":2,"message":"Promise returned in function argument where a void return was expected.","line":1347,"column":40,"nodeType":"ArrowFunctionExpression","messageId":"voidReturnArgument","endLine":1358,"endColumn":10,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'bookBadge' is assigned a value but never used.","line":1407,"column":19,"nodeType":"Identifier","messageId":"unusedVar","endLine":1407,"endColumn":28,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-floating-promises","severity":2,"message":"Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator.","line":1493,"column":13,"nodeType":"ExpressionStatement","messageId":"floatingVoid","endLine":1493,"endColumn":35,"suggestions":[{"messageId":"floatingFixVoid","fix":{"range":[68531,68531],"text":"void "},"desc":"Add void operator to ignore."},{"messageId":"floatingFixAwait","fix":{"range":[68531,68531],"text":"await "},"desc":"Add await operator."}],"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'dot' is assigned a value but never used.","line":1554,"column":15,"nodeType":"Identifier","messageId":"unusedVar","endLine":1554,"endColumn":18,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'titleSpan' is assigned a value but never used.","line":1562,"column":15,"nodeType":"Identifier","messageId":"unusedVar","endLine":1562,"endColumn":24,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-floating-promises","severity":2,"message":"Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator.","line