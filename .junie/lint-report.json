lint/no-misused-promises","severity":2,"message":"Promise returned in function argument where a void return was expected.","line":2221,"column":56,"nodeType":"Identifier","messageId":"voidReturnArgument","endLine":2221,"endColumn":66,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-misused-promises","severity":2,"message":"Promise returned in function argument where a void return was expected.","line":2233,"column":53,"nodeType":"ArrowFunctionExpression","messageId":"voidReturnArgument","endLine":2237,"endColumn":18,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-misused-promises","severity":2,"message":"Promise returned in function argument where a void return was expected.","line":2251,"column":57,"nodeType":"ArrowFunctionExpression","messageId":"voidReturnArgument","endLine":2253,"endColumn":22,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since the receiver accepts the original type of the expression.","line":2305,"column":41,"nodeType":"TSAsExpression","messageId":"contextuallyUnnecessary","endLine":2305,"endColumn":62,"fix":{"range":[104480,104495],"text":""},"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-floating-promises","severity":2,"message":"Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator.","line":2605,"column":9,"nodeType":"ExpressionStatement","messageId":"floatingVoid","endLine":2605,"endColumn":103,"suggestions":[{"messageId":"floatingFixVoid","fix":{"range":[116560,116560],"text":"void "},"desc":"Add void operator to ignore."},{"messageId":"floatingFixAwait","fix":{"range":[116560,116560],"text":"await "},"desc":"Add await operator."}],"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'allSeries' is assigned a value but never used.","line":2617,"column":19,"nodeType":"Identifier","messageId":"unusedVar","endLine":2617,"endColumn":28,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'uniHeader' is assigned a value but never used.","line":2761,"column":19,"nodeType":"Identifier","messageId":"unusedVar","endLine":2761,"endColumn":28,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'serHeader' is assigned a value but never used.","line":2764,"column":27,"nodeType":"Identifier","messageId":"unusedVar","endLine":2764,"endColumn":36,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'serHeader' is assigned a value but never used.","line":2772,"column":19,"nodeType":"Identifier","messageId":"unusedVar","endLine":2772,"endColumn":28,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'label' is assigned a value but never used.","line":2778,"column":19,"nodeType":"Identifier","messageId":"unusedVar","endLine":2778,"endColumn":24,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]}],"errorCount":61,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":1,"source":"/* eslint-disable @typescript-eslint/no-floating-promises, @typescript-eslint/no-misused-promises, @typescript-eslint/no-unnecessary-type-assertion, @typescript-eslint/no-unused-vars -- Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file */\nimport { openConfirmModal } from '../components/ConfirmModal';\nimport { SceneManager } from '../services/SceneManager';\nimport { SceneCardComponent } from '../components/SceneCard';\nimport { InspectorComponent } from '../components/Inspector';\nimport { QuickAddModal } from '../components/QuickAddModal';\nimport { ShiftDatesModal } from '../components/ShiftDatesModal';\nimport { renderViewSwitcher } from '../components/ViewSwitcher';\nimport { enableDragToPan } from '../components/DragToPan';\nimport type SceneCardsPlugin from '../main';\n\nimport { TIMELINE_VIEW_TYPE } from '../constants';\nimport { applyMobileClass } from '../components/MobileAdapter';\nimport { attachTooltip } from '../components/Tooltip';\nimport { ButtonComponent, DropdownComponent, ItemView, Menu, Modal, Notice, Setting, TFile, TextComponent, WorkspaceLeaf } from 'obsidian';\nimport * as obsidian from 'obsidian';\nimport { BUILTIN_BEAT_SHEETS, Scene, SceneStatus, TIMELINE_MODES, TIMELINE_MODE_ICONS, TIMELINE_MODE_LABELS, TimelineMode, formatSceneLength, getStatusOrder, resolveStatusCfg } from '../models/Scene';\nimport { getActDisplayLabel } from '../utils/actChapter';\nimport { parseSceneLocations } from '../services/MetadataParser';\nimport { deriveProjectFoldersFromFilePath, type StoryLineProject } from '../models/StoryLineProject';\nimport type { Event } from '../models/Event';\nimport type { TimeSpan, Timestamp } from '../models/TimeSpan';\nimport { TimelineNavigationService } from '../services/TimelineNavigationService';\n\n/**\n * Timeline ordering mode\n */\ntype TimelineOrder = 'reading' | 'chronological';\n\n/**\n * Swimlane grouping options\n */\ntype SwimlaneGroupBy = 'pov' | 'character' | 'location' | 'plotline' | 'tag';\n\n/**\n * Timeline View - shows scenes in chronological order with optional swimlanes\n */\nexport class TimelineView extends ItemView {\n    private plugin: SceneCardsPlugin;\n    private sceneManager: SceneManager;\n    private inspectorComponent: InspectorComponent | null = null;\n    private selectedScene: Scene | null = null;\n    /**\n     * Issue #237 — multi-selection in Timeline view. Stores file paths of\n     * scenes the user has ctrl/cmd-clicked. Drives the \"Shift dates\"\n     * context-menu action and the bulk action bar.\n     */\n    private selectedScenes: Set<string> = new Set();\n    private zoomLevel = 1;\n    private rootContainer: HTMLElement | null = null;\n    private _pendingRefresh: number | null = null;\n    private cardComponent: SceneCardComponent;\n    private _lastCacheVersion = -1;\n    /** When true, display multi-lane swimlane view instead of single-column */\n    private swimlaneMode = false;\n    /** How to group lanes in swimlane mode */\n    private swimlaneGroupBy: SwimlaneGroupBy = 'pov';\n    /** Whether to sort by reading order (sequence) or chronological order */\n    private timelineOrder: TimelineOrder = 'reading';\n    /** Book IDs selected for multi-book timeline. Empty means \"active book only\". */\n    private selectedBookIds: Set<string> = new Set();\n    /** Timeline navigation state is owned by this leaf, never shared across tabs. */\n    private readonly timelineNavigationService: TimelineNavigationService;\n    /** Selected book IDs belong to this active project's context. */\n    private selectionOwnerBookId: string | null = null;\n    /** Render generation counter for async cancellation */\n    private renderGeneration = 0;\n    /** Popover element for the book selector dropdown */\n    private bookSelectorPopover: HTMLElement | null = null;\n    private bookSelectorButton: HTMLElement | null = null;\n    /** One document listener per view, removed when the view closes. */\n    private readonly onBookSelectorDocumentClick = (e: MouseEvent): void => {\n        const popover = this.bookSelectorPopover;\n        if (popover && !popover.contains(e.target as Node) &&\n            !this.bookSelectorButton?.contains(e.target as Node)) {\n            this.closeBookSelectorPopover();\n        }\n    };\n\n    constructor(leaf: WorkspaceLeaf, plugin: SceneCardsPlugin, sceneManager: SceneManager) {\n        super(leaf);\n        this.plugin = plugin;\n        this.sceneManager = sceneManager;\n        this.timelineNavigationService = new TimelineNavigationService(plugin.timeSpanService);\n        this.cardComponent = new SceneCardComponent(plugin);\n        // Restore persisted filter states from settings\n        this.timelineOrder = plugin.settings.timelineOrder === 'chronological' ? 'chronological' : 'reading';\n        this.swimlaneMode = plugin.settings.timelineSwimlaneMode ?? false;\n        this.swimlaneGroupBy = (plugin.settings.timelineSwimlaneGroupBy as SwimlaneGroupBy) ?? 'pov';\n    }\n\n    getViewType(): string {\n        return TIMELINE_VIEW_TYPE;\n    }\n\n    getDisplayText(): string {\n        const title = this.plugin?.sceneManager?.activeProject?.title;\n        return title ? `StoryLine - ${title}` : 'StoryLine';\n    }\n\n    getIcon(): string {\n        return 'clock';\n    }\n\n    async onOpen(): Promise<void> {\n        this.plugin.storyLeaf = this.leaf;\n        this.timelineOrder = this.plugin.settings.timelineOrder === 'chronological' ? 'chronological' : 'reading';\n        const container = this.containerEl.children[1] as HTMLElement;\n        container.empty();\n        container.addClass('story-line-timeline-container');\n        applyMobileClass(container);\n        this.rootContainer = container;\n\n        await this.sceneManager.initialize();\n        document.removeEventListener('click', this.onBookSelectorDocumentClick);\n        document.addEventListener('click', this.onBookSelectorDocumentClick);\n        this.renderView(container);\n    }\n\n    async onClose(): Promise<void> {\n        // The popover lives under document.body, outside the Obsidian leaf.\n        this.closeBookSelectorPopover();\n        this.bookSelectorButton = null;\n        document.removeEventListener('click', this.onBookSelectorDocumentClick);\n        this.renderGeneration++;\n    }\n\n    private isNoteScene(scene: Scene): boolean {\n        const value: unknown = (scene as Scene & { corkboardNote?: unknown }).corkboardNote;\n        if (value === true) return true;\n        if (value === false || value === undefined || value === null) return false;\n        if (typeof value === 'string') return (value as string).trim().toLowerCase() === 'true';\n        if (typeof value === 'number') return value === 1;\n        return false;\n    }\n\n    private renderView(container: HTMLElement): void {\n        // A new active Book starts a new Universe selection context. Never\n        // retain old selected Book IDs across project switches.\n        const activeBookId = this.sceneManager.activeProject?.bookId ?? null;\n        if (this.selectionOwnerBookId !== activeBookId) {\n            this.selectedBookIds.clear();\n            this.selectionOwnerBookId = activeBookId;\n        }\n        // Drop deleted/moved-away Book IDs from the selection on refresh.\n        const validBookIds = new Set(this.sceneManager.getProjects().map(p => p.bookId).filter((id): id is string => !!id));\n        for (const bookId of this.selectedBookIds) {\n            if (!validBookIds.has(bookId)) this.selectedBookIds.delete(bookId);\n        }\n\n        // Refresh destroys the old toolbar but not its document.body popover.\n        this.closeBookSelectorPopover();\n        this.bookSelectorButton = null;\n        container.empty();\n\n        // Toolbar\n        const toolbar = container.createDiv('story-line-toolbar');\n        const titleRow = toolbar.createDiv('story-line-title-row');\n        titleRow.createEl('h3', { cls: 'story-line-view-title', text: 'StoryLine' });\n        // project name shown in top-center only; no inline project selector here\n\n        // View switcher tabs\n        renderViewSwitcher(toolbar, TIMELINE_VIEW_TYPE, this.plugin, this.leaf);\n\n        const controls = toolbar.createDiv('story-line-toolbar-controls');\n\n        // Add scene button\n        const addBtn = controls.createEl('button', {\n            cls: 'mod-cta story-line-add-btn',\n            text: '+ new scene'\n        });\n        addBtn.addEventListener('click', () => this.openQuickAdd());\n\n        // Add Event button (next to New Scene)\n        const addEventBtn = controls.createEl('button', {\n            cls: 'story-line-add-btn',\n            text: '+ New Event'\n        });\n        addEventBtn.addEventListener('click', async () => {\n            const eventsFolder = this.sceneManager.getBookEventsFolder();\n            if (!eventsFolder) {\n                new Notice('No events folder found for the active project.');\n                return;\n            }\n            try {\n                await this.plugin.openCreateEventModal(eventsFolder);\n                // Refresh timeline after creating an event\n                this.refresh();\n            } catch {\n                // ignore\n            }\n        });\n\n        // Book selector for multi-book timeline\n        this.renderBookSelector(controls);\n\n        // Add acts/chapters button\n        const structBtn = controls.createEl('button', {\n            cls: 'clickable-icon',\n        });\n        obsidian.setIcon(structBtn, 'columns-3');\n        attachTooltip(structBtn, 'Add acts or chapters');\n        structBtn.addEventListener('click', () => this.openStructureModal());\n\n        // Swimlane toggle\n        const swimToggle = controls.createEl('button', {\n            cls: `clickable-icon${this.swimlaneMode ? ' is-active' : ''}`,\n        });\n        obsidian.setIcon(swimToggle, 'columns-2');\n        attachTooltip(swimToggle, this.swimlaneMode ? 'Switch to linear' : 'Switch to swimlanes');\n        swimToggle.addEventListener('click', () => {\n            this.swimlaneMode = !this.swimlaneMode;\n            this.plugin.settings.timelineSwimlaneMode = this.swimlaneMode;\n            void this.plugin.saveSettings();\n            this.refresh();\n        });\n\n        // Reading order / Chronological order toggle\n        const orderSelect = controls.createEl('select', {\n            cls: 'dropdown story-line-order-select',\n            attr: { 'aria-label': 'Scene ordering' },\n        });\n        orderSelect.addEventListener('keydown', (e: KeyboardEvent) => e.stopPropagation());\n        const orderOptions: { value: TimelineOrder; label: string }[] = [\n            { value: 'reading', label: 'Reading Order' },\n            { value: 'chronological', label: 'Chronological Order' },\n        ];\n        for (const opt of orderOptions) {\n            const el = orderSelect.createEl('option', { text: opt.label });\n            el.value = opt.value;\n            if (opt.value === this.timelineOrder) el.selected = true;\n        }\n        orderSelect.addEventListener('change', () => {\n            this.timelineOrder = orderSelect.value as TimelineOrder;\n            this.plugin.settings.timelineOrder = this.timelineOrder;\n            void this.plugin.saveSettings();\n            this.refresh();\n        });\n\n        // Swimlane group-by dropdown (only visible in swimlane mode)\n        if (this.swimlaneMode) {\n            const groupSelect = controls.createEl('select', {\n                cls: 'dropdown story-line-swimlane-group-select',\n                attr: { 'aria-label': 'Group lanes by' },\n            });\n            groupSelect.addEventListener('keydown', (e: KeyboardEvent) => e.stopPropagation());\n            const options: { value: SwimlaneGroupBy; label: string }[] = [\n                { value: 'pov', label: 'By POV' },\n                { value: 'character', label: 'By Character' },\n                { value: 'location', label: 'By Location' },\n                { value: 'plotline', label: 'By Plotline' },\n                { value: 'tag', label: 'By Tag' },\n            ];\n            for (const opt of options) {\n                const el = groupSelect.createEl('option', { text: opt.label });\n                el.value = opt.value;\n                if (opt.value === this.swimlaneGroupBy) el.selected = true;\n            }\n            groupSelect.addEventListener('change', () => {\n                this.swimlaneGroupBy = groupSelect.value as SwimlaneGroupBy;\n                this.plugin.settings.timelineSwimlaneGroupBy = this.swimlaneGroupBy;\n                void this.plugin.saveSettings();\n                this.refresh();\n            });\n        }\n\n        // Zoom controls\n        const zoomOut = controls.createEl('button', {\n            cls: 'clickable-icon',\n            text: '−'\n        });\n        attachTooltip(zoomOut, 'Zoom out');\n        zoomOut.addEventListener('click', () => {\n            this.zoomLevel = Math.max(0.5, this.zoomLevel - 0.25);\n            this.refreshTimeline(container);\n        });\n\n        controls.createSpan({\n            cls: 'story-line-zoom-level',\n            text: `${Math.round(this.zoomLevel * 100)}%`\n        });\n\n        const zoomIn = controls.createEl('button', {\n            cls: 'clickable-icon',\n            text: '+'\n        });\n        attachTooltip(zoomIn, 'Zoom in');\n        zoomIn.addEventListener('click', () => {\n            this.zoomLevel = Math.min(3, this.zoomLevel + 0.25);\n            this.refreshTimeline(container);\n        });\n\n        // Time navigation controls\n        this.renderTimeNavigation(controls);\n\n        // Refresh button\n        const refreshBtn = controls.createEl('button', {\n            cls: 'clickable-icon',\n        });\n        obsidian.setIcon(refreshBtn, 'refresh-cw');\n        attachTooltip(refreshBtn, 'Refresh');\n        refreshBtn.addEventListener('click', async () => {\n            await this.sceneManager.initialize();\n            this.refresh();\n        });\n\n        // Main content area (timeline + inspector)\n        const mainArea = container.createDiv('story-line-main-area');\n\n        // Timeline content (async for multi-book support)\n        if (this.swimlaneMode) {\n            void this.renderSwimlaneTimeline(mainArea);\n        } else {\n            void this.renderTimelineAsync(mainArea);\n        }\n\n        // Inspector sidebar\n        const inspectorEl = mainArea.createDiv('story-line-inspector-panel');\n        inspectorEl.setCssStyles({ display: 'none' });\n        this.inspectorComponent = new InspectorComponent(\n            inspectorEl,\n            this.plugin,\n            this.sceneManager,\n            {\n                onEdit: (scene) => this.openScene(scene),\n                onDelete: (scene) => this.deleteScene(scene),\n                onRefresh: () => this.refresh(),\n                onStatusChange: async (scene, status) => {\n                    await this.sceneManager.updateScene(scene.filePath, { status });\n                    this.refresh();\n                },\n            }\n        );\n    }\n\n    private async renderTimelineAsync(container: HTMLElement): Promise<void> {\n        // Render generation token — increment to cancel stale renders\n        const generation = ++this.renderGeneration;\n\n        // Remove old timeline if exists\n        const existing = container.querySelector('.story-line-timeline');\n        if (existing) existing.remove();\n\n        const timelineEl = container.createDiv('story-line-timeline');\n\n        // Load scenes (single or multi-book)\n        const scenes = await this.getTimelineScenes();\n\n        // Load Events — universe-wide for multi-book, cached for single-book\n        const events = await this.getTimelineEvents();\n\n        // Cancel if a newer render started while we were loading\n        if (this.renderGeneration !== generation) return;\n\n        // Update navigation service with current items\n        this.timelineNavigationService.updateItems(scenes, events);\n        this.updateTimeNavigationDisplay();\n\n        // In multi-book reading order, force chronological\n        const effectiveOrder = this.isMultiBookMode() ? 'chronological' : this.timelineOrder;\n\n        // Precompute date/time validation flags for each scene index so rendering is consistent\n        // Scenes with non-linear timeline modes (flashback, dream, mythic, etc.) are exempt from\n        // date-order warnings — but are still rendered with their mode badge.\n        const EXEMPT_FROM_DATE_ORDER_SET = new Set<string | undefined>([\n            'flashback', 'flash_forward', 'dream', 'mythic', 'circular', 'simultaneous',\n        ]);\n        const dateTs = scenes.map(s => this.parseSceneDateTimestamp(s));\n        const timeTs = scenes.map(s => this.parseSceneTimeTimestamp(s));\n        const dateInvalidFlags = scenes.map((s, idx) => {\n            if (EXEMPT_FROM_DATE_ORDER_SET.has(s.timeline_mode)) return false;\n            const prev = idx > 0 ? dateTs[idx - 1] : null;\n            const curr = dateTs[idx];\n            const next = idx < scenes.length - 1 ? dateTs[idx + 1] : null;\n            // Also exempt if the adjacent scene is exempt\n            if (prev !== null && curr !== null && prev > curr) {\n                if (!EXEMPT_FROM_DATE_ORDER_SET.has(scenes[idx - 1]?.timeline_mode)) return true;\n            }\n            if (next !== null && curr !== null && curr > next) {\n                if (!EXEMPT_FROM_DATE_ORDER_SET.has(scenes[idx + 1]?.timeline_mode)) return true;\n            }\n            return false;\n        });\n        const timeInvalidFlags = scenes.map((s, idx) => {\n            if (EXEMPT_FROM_DATE_ORDER_SET.has(s.timeline_mode)) return false;\n            const prevDate = idx > 0 ? dateTs[idx - 1] : null;\n            const nextDate = idx < scenes.length - 1 ? dateTs[idx + 1] : null;\n            const prevTime = idx > 0 ? timeTs[idx - 1] : null;\n            const currTime = timeTs[idx];\n            const nextTime = idx < scenes.length - 1 ? timeTs[idx + 1] : null;\n\n            let invalid = false;\n            if (prevTime !== null && currTime !== null) {\n                if (!EXEMPT_FROM_DATE_ORDER_SET.has(scenes[idx - 1]?.timeline_mode)) {\n                    const datesEqual = (prevDate === null && dateTs[idx] === null) || (prevDate !== null && dateTs[idx] !== null && prevDate === dateTs[idx]);\n                    if (datesEqual && prevTime > currTime) invalid = true;\n                }\n            }\n            if (nextTime !== null && currTime !== null) {\n                if (!EXEMPT_FROM_DATE_ORDER_SET.has(scenes[idx + 1]?.timeline_mode)) {\n                    const datesEqual = (nextDate === null && dateTs[idx] === null) || (nextDate !== null && dateTs[idx] !== null && nextDate === dateTs[idx]);\n                    if (datesEqual && currTime > nextTime) invalid = true;\n                }\n            }\n            return invalid;\n        });\n\n        // Also get defined acts so we can show empty act dividers\n        const definedActs = this.sceneManager.getDefinedActs();\n        const actsWithScenes = new Set<number>();\n        for (const s of scenes) {\n            if (s.act !== undefined) actsWithScenes.add(Number(s.act));\n        }\n\n        if (scenes.length === 0 && definedActs.length === 0 && events.length === 0) {\n            const empty = timelineEl.createDiv('story-line-empty');\n            empty.createEl('p', { text: 'No scenes or events found.' });\n            empty.createEl('p', { text: 'Click \"+ new scene\" to create your first scene, or \"+ New Event\" to add a canonical event.' });\n            return;\n        }\n\n        // Multi-book mode indicator\n        const isMultiBook = this.isMultiBookMode();\n\n        // ── Temporal ruler (horizontal time axis) ──\n        this.renderTemporalRuler(timelineEl, scenes, events);\n\n        // ── Vertical timeline with scene cards ──\n        const track = timelineEl.createDiv('timeline-track');\n\n\n        // For drag & drop\n        let dragIndex: number | null = null;\n        let dropIndex: number | null = null;\n        let autoScrollRAF: number | null = null;\n        let lastDragClientY = 0;\n\n        // Auto-scroll when dragging near viewport edges\n        const AUTO_SCROLL_ZONE = this.plugin.settings.timelineDragScrollZone ?? 60; // px from edge\n        const AUTO_SCROLL_SPEED = this.plugin.settings.timelineDragScrollSpeed ?? 8; // px per frame\n        const startAutoScroll = (clientY: number) => {\n            lastDragClientY = clientY;\n            if (autoScrollRAF) return; // already running\n            const scrollEl = track.closest('.story-line-main-area') || track.parentElement;\n            if (!scrollEl) return;\n            const loop = () => {\n                const rect = scrollEl.getBoundingClientRect();\n                if (lastDragClientY < rect.top + AUTO_SCROLL_ZONE) {\n                    scrollEl.scrollTop -= AUTO_SCROLL_SPEED;\n                } else if (lastDragClientY > rect.bottom - AUTO_SCROLL_ZONE) {\n                    scrollEl.scrollTop += AUTO_SCROLL_SPEED;\n                } else {\n                    autoScrollRAF = null;\n                    return;\n                }\n                autoScrollRAF = window.requestAnimationFrame(loop);\n            };\n            autoScrollRAF = window.requestAnimationFrame(loop);\n        };\n        const stopAutoScroll = () => {\n            if (autoScrollRAF) { cancelAnimationFrame(autoScrollRAF); autoScrollRAF = null; }\n        };\n\n        // Attach auto-scroll helpers to the main-area element so entries can call them\n        const mainArea = track.closest('.story-line-main-area');\n        if (mainArea) {\n            (mainArea as unknown as Record<string, unknown>)._slAutoScroll = startAutoScroll;\n            (mainArea as unknown as Record<string, unknown>)._slStopAutoScroll = stopAutoScroll;\n        }\n\n        // Store dropIndex on the track so drop handlers in child entries can read it\n        (track as unknown as Record<string, unknown>)._slDropIndex = null;\n\n        const refreshDropIndicators = () => {\n            const entries = track.querySelectorAll('.timeline-entry');\n            entries.forEach((el, idx) => {\n                el.classList.toggle('drop-above', dropIndex === idx);\n                el.classList.toggle('drop-below', dropIndex === idx + 1);\n            });\n        };\n\n        const handleDrop = async (fromIdx: number, toIdx: number) => {\n            // Multi-book scenes have different owning projects. The existing\n            // reorder operation writes global sequence values through the\n            // active book manager; never apply it across book boundaries.\n            if (this.isMultiBookMode()) return;\n            if (fromIdx === toIdx || fromIdx === toIdx - 1) return;\n\n            // Save scroll position to restore after refresh\n            const scrollEl = track.closest('.story-line-main-area') || track.parentElement;\n            const savedScroll = scrollEl ? scrollEl.scrollTop : 0;\n\n            const moved = scenes.splice(fromIdx, 1)[0];\n            const insertAt = toIdx > fromIdx ? toIdx - 1 : toIdx;\n            scenes.splice(insertAt, 0, moved);\n\n            if (this.timelineOrder === 'chronological') {\n                // Chronological order is a single global counter — flat 1..N is correct.\n                for (let i = 0; i < scenes.length; i++) {\n                    await this.sceneManager.updateScene(\n                        scenes[i].filePath,\n                        { chronologicalOrder: i + 1 } as Partial<Scene>,\n                    );\n                }\n            } else {\n                // #118: sequence is a single global counter. Adopt the\n                // neighbour's act/chapter for the moved scene so it lands\n                // in the right group, then assign a fractional sequence\n                // that positions it next to a neighbour, and finally run\n                // a global flat resequence 1..N. `chapter`/`act` of other\n                // scenes are preserved.\n                const neighbour = scenes[insertAt - 1] ?? scenes[insertAt + 1] ?? null;\n                const sceneUpdates: Partial<Scene> = {};\n                if (neighbour) {\n                    if (moved.act !== neighbour.act) sceneUpdates.act = neighbour.act;\n                    if (moved.chapter !== neighbour.chapter) sceneUpdates.chapter = neighbour.chapter;\n                }\n                const target = scenes[insertAt + 1] ?? scenes[insertAt - 1] ?? null;\n                if (target && target !== moved) {\n                    const targetSeq = target.sequence ?? 0;\n                    const movedFirst = scenes.indexOf(moved) < scenes.indexOf(target);\n                    sceneUpdates.sequence = movedFirst ? targetSeq - 0.5 : targetSeq + 0.5;\n                }\n                if (Object.keys(sceneUpdates).length > 0) {\n                    await this.sceneManager.updateScene(moved.filePath, sceneUpdates);\n                }\n                await this.sceneManager.globalResequence();\n            }\n            // refresh() handles scroll save/restore — no need for a\n            // competing rAF here (the duplicate rAF caused a race that\n            // left scroll at 0 for large lists, issue: drag-drop scroll).\n            this.refresh();\n        };\n\n        // Build a combined list: scenes + empty act placeholders\n        // Group scenes by act for interleaving empty acts\n        const scenesByAct = new Map<number, Scene[]>();\n        const noActScenes: Scene[] = [];\n        for (const s of scenes) {\n            if (s.act !== undefined) {\n                const actNum = Number(s.act);\n                if (!scenesByAct.has(actNum)) scenesByAct.set(actNum, []);\n                scenesByAct.get(actNum)!.push(s);\n            } else {\n                noActScenes.push(s);\n            }\n        }\n\n        // Merge all act numbers (from scenes + defined)\n        const allActs = new Set([...definedActs, ...actsWithScenes]);\n        const sortedActs = Array.from(allActs).sort((a, b) => a - b);\n\n        // Render scenes in sequence order and insert act dividers when act changes.\n        // For large projects (40+ scenes), use progressive/chunked rendering to avoid\n        // blocking the main thread with 1500+ DOM nodes in a single frame.\n        type TLItem =\n            | { kind: 'divider'; actLabel: string; actNum: number | undefined }\n            | { kind: 'scene'; scene: Scene; globalIdx: number; dateInvalid: boolean; timeInvalid: boolean }\n            | { kind: 'event'; event: Event }\n            | { kind: 'empty-act'; actLabel: string; actNum: number };\n\n        const tlItems: TLItem[] = [];\n        if (effectiveOrder === 'chronological') {\n            // Chronologically sort Scenes even when the timeline contains no Events.\n            this.buildChronologicalTimelineItems(tlItems, scenes, events, dateInvalidFlags, timeInvalidFlags, definedActs, actsWithScenes, sortedActs);\n        } else {\n            // Reading order mode: scenes first, then events at the end\n            // In multi-book mode, reading order is not meaningful — show warning\n            if (isMultiBook) {\n                const warning = track.createDiv('timeline-multi-book-warning');\n                warning.createEl('p', { text: 'Multiple books selected — showing in Chronological Order. Reading Order is meaningful for a single book only.' });\n            }\n            let lastRenderedAct: number | undefined = undefined;\n            for (let globalIdx = 0; globalIdx < scenes.length; globalIdx++) {\n                const scene = scenes[globalIdx];\n                const currentAct = scene.act !== undefined ? Number(scene.act) : undefined;\n                if (currentAct !== lastRenderedAct) {\n                    const beatLabel = currentAct !== undefined ? this.sceneManager.getActLabel(currentAct) : undefined;\n                    const cleanBeat = beatLabel?.replace(/^(Act|Prologue|Epilogue)\\s*\\d*\\s*[—:]\\s*/i, '');\n                    const actDisplay = getActDisplayLabel(currentAct);\n                    const actLabel = currentAct !== undefined\n                        ? (cleanBeat ? `${actDisplay} — ${cleanBeat}` : actDisplay)\n                        : 'No Act';\n                    tlItems.push({ kind: 'divider', actLabel, actNum: currentAct });\n                    lastRenderedAct = currentAct;\n                }\n                tlItems.push({ kind: 'scene', scene, globalIdx, dateInvalid: dateInvalidFlags[globalIdx], timeInvalid: timeInvalidFlags[globalIdx] });\n            }\n\n            // Add empty-act placeholders for defined acts with no scenes\n            for (const actNum of sortedActs) {\n                if (!actsWithScenes.has(Number(actNum))) {\n                    const beatLabel = this.sceneManager.getActLabel(actNum);\n                    const cleanBeat = beatLabel?.replace(/^(Act|Prologue|Epilogue)\\s*\\d*\\s*[—:]\\s*/i, '');\n                    const actDisplay = getActDisplayLabel(actNum);\n                    const actLabel = cleanBeat ? `${actDisplay} — ${cleanBeat}` : actDisplay;\n                    tlItems.push({ kind: 'empty-act', actLabel, actNum });\n                }\n            }\n\n            // In reading order, show Events as contextual markers after scenes.\n            // They appear as a reference rail, not as a separate appended section.\n            if (events.length > 0) {\n                // Sort events by time for the reference rail\n                const sortedEvents = this.sortEventsByTime(events);\n                for (const event of sortedEvents) {\n                    tlItems.push({ kind: 'event', event });\n                }\n            }\n        }\n\n        const renderTLItem = (item: TLItem) => {\n            if (item.kind === 'divider') {\n                const divider = track.createDiv('timeline-act-divider');\n                divider.createSpan({ cls: 'timeline-act-label', text: item.actLabel });\n                if (item.actNum !== undefined) {\n                    const addInAct = divider.createEl('button', {\n                        cls: 'timeline-act-add-btn clickable-icon',\n                        attr: { 'aria-label': `Add scene to ${item.actLabel}` }\n                    });\n                    obsidian.setIcon(addInAct, 'plus');\n                    const actForClosure = item.actNum;\n                    addInAct.addEventListener('click', (e) => {\n                        e.stopPropagation();\n                        this.openQuickAdd(actForClosure);\n                    });\n                }\n            } else if (item.kind === 'event') {\n                this.renderTimelineEvent(track, item.event);\n            } else if (item.kind === 'scene') {\n                const bookTitle = isMultiBook ? this.getSceneBookTitle(item.scene) : null;\n                this.renderTimelineEntry(track, item.scene, item.globalIdx, scenes, dragIndex, dropIndex, refreshDropIndicators, handleDrop, (di) => { dragIndex = di; }, (di) => { dropIndex = di; (track as unknown as Record<string, unknown>)._slDropIndex = di; }, item.dateInvalid, item.timeInvalid, bookTitle);\n            } else {\n                // empty-act placeholder\n                const divider = track.createDiv('timeline-act-divider');\n                divider.createSpan({ cls: 'timeline-act-label', text: item.actLabel });\n                const addInAct = divider.createEl('button', {\n                    cls: 'timeline-act-add-btn clickable-icon',\n                    attr: { 'aria-label': `Add scene to ${item.actLabel}` }\n                });\n                obsidian.setIcon(addInAct, 'plus');\n                const actForClosure = item.actNum;\n                addInAct.addEventListener('click', (e) => {\n                    e.stopPropagation();\n                    this.openQuickAdd(actForClosure);\n                });\n                const emptyEntry = track.createDiv('timeline-entry timeline-entry-empty');\n                const emptyCard = emptyEntry.createDiv('timeline-entry-card');\n                const card = emptyCard.createDiv('timeline-card timeline-card-empty');\n                card.createDiv({ cls: 'timeline-card-title', text: `No scenes in ${item.actLabel}` });\n                card.createEl('p', { cls: 'timeline-card-hint', text: 'Click + to add a scene' });\n                card.addEventListener('click', () => this.openQuickAdd(actForClosure));\n            }\n        };\n\n        // Progressive rendering: render first batch immediately, schedule rest\n        const INITIAL_BATCH = 20;\n        const CHUNK_SIZE = 10;\n        const total = tlItems.length;\n\n        if (total <= INITIAL_BATCH) {\n            // Small project — render everything synchronously\n            for (const item of tlItems) renderTLItem(item);\n        } else {\n            // Large project — chunked rendering\n            for (let i = 0; i < INITIAL_BATCH; i++) renderTLItem(tlItems[i]);\n\n            let cursor = INITIAL_BATCH;\n            const scheduleChunk = () => {\n                if (cursor >= total || !track.isConnected) return;\n                window.requestAnimationFrame(() => {\n                    if (!track.isConnected) return;\n                    const end = Math.min(cursor + CHUNK_SIZE, total);\n                    for (let i = cursor; i < end; i++) renderTLItem(tlItems[i]);\n                    cursor = end;\n                    if (cursor < total) scheduleChunk();\n                });\n            };\n            scheduleChunk();\n        }\n    }\n\n    // ────────────────────────────────────────────────────────────\n    //  Swimlane (multi-lane) renderer\n    // ────────────────────────────────────────────────────────────\n\n    /**\n     * Render the swimlane timeline: multiple vertical lanes side-by-side,\n     * each with the same dot-line-card look as the linear mode.\n     */\n    private async renderSwimlaneTimeline(container: HTMLElement): Promise<void> {\n        // Render generation token — increment to cancel stale renders\n        const generation = ++this.renderGeneration;\n\n        // Remove old timeline if exists\n        const existing = container.querySelector('.story-line-timeline');\n        if (existing) existing.remove();\n\n        const timelineEl = container.createDiv('story-line-timeline swimlane-timeline');\n        enableDragToPan(timelineEl);\n\n        // Use multi-book scene/event projection, same as linear mode\n        const scenes = await this.getTimelineScenes();\n        const events = await this.getTimelineEvents();\n\n        // Cancel if a newer render started while we were loading\n        if (this.renderGeneration !== generation) return;\n\n        // Navigation must work in swimlane mode as well as linear mode.\n        this.timelineNavigationService.updateItems(scenes, events);\n        this.updateTimeNavigationDisplay();\n\n        if (scenes.length === 0 && events.length === 0) {\n            const empty = timelineEl.createDiv('story-line-empty');\n            empty.createEl('p', { text: 'No scenes or events found.' });\n            empty.createEl('p', { text: 'Click \"+ new scene\" to create your first scene, or \"+ New Event\" to add a canonical event.' });\n            return;\n        }\n\n        // ── Build shared chronological projection ──\n        // Combine scenes and events into one timeline sorted by TimeSpan.\n        // This is the same projection used by the linear timeline mode.\n        const projection = this.buildChronologicalProjection(scenes, events);\n\n        // ── Determine lane keys ──\n        const isMultiBook = this.isMultiBookMode();\n        let laneKeys: string[];\n\n        if (isMultiBook) {\n            // Lane identity must be the stable book UUID, not a Scene file path\n            // or Book title (different Books may share the same title).\n            // Include selected Books with no Scenes so their lanes stay visible.\n            laneKeys = Array.from(this.selectedBookIds).filter(\n                bookId => this.sceneManager.getProjectById(bookId) !== null,\n            );\n        } else {\n            // Single-book mode: use POV/Character/Location grouping\n            const laneKeysSet = new Set<string>();\n            for (const scene of scenes) {\n                const keys = this.getSceneLaneKeys(scene);\n                for (const k of keys) laneKeysSet.add(k);\n            }\n            laneKeys = Array.from(laneKeysSet).sort();\n            if (laneKeys.length === 0) laneKeys.push('(none)');\n        }\n\n        // ── Build the grid container ──\n        const grid = timelineEl.createDiv('swimlane-grid');\n        const colTemplate = `80px repeat(${laneKeys.length}, minmax(180px, 1fr))`;\n        grid.setCssStyles({ gridTemplateColumns: colTemplate });\n\n        // ── Sticky header row ──\n        const corner = grid.createDiv('swimlane-corner');\n        corner.textContent = '#';\n        for (const lane of laneKeys) {\n            const header = grid.createDiv('swimlane-lane-header');\n            const laneLabel = isMultiBook\n                ? (this.sceneManager.getProjectById(lane)?.title || lane)\n                : lane;\n            header.textContent = laneLabel;\n            header.setAttribute('title', laneLabel);\n        }\n\n        // ── Render each item in chronological order ──\n        for (const item of projection) {\n            if (item.kind === 'scene') {\n                this.renderSwimlaneSceneRow(grid, item.scene, laneKeys, isMultiBook);\n            } else if (item.kind === 'event') {\n                this.renderSwimlaneEventRow(grid, item.event, laneKeys);\n            }\n        }\n    }\n\n    /**\n     * Render time navigation controls in the toolbar.\n     */\n    private renderTimeNavigation(controls: HTMLElement): void {\n        const navContainer = controls.createDiv('story-line-time-nav');\n\n        // Previous item button\n        const prevBtn = navContainer.createEl('button', {\n            cls: 'clickable-icon',\n        });\n        obsidian.setIcon(prevBtn, 'chevron-left');\n        attachTooltip(prevBtn, 'Previous item');\n        prevBtn.addEventListener('click', () => {\n            const item = this.timelineNavigationService.navigatePrevious();\n            if (item) {\n                this.scrollToNavigationItem(item);\n                this.updateTimeNavigationDisplay();\n            }\n        });\n\n        // Jump to date input\n        const jumpContainer = navContainer.createDiv('story-line-jump-to-date');\n        const yearInput = jumpContainer.createEl('input', {\n            type: 'number',\n            attr: { placeholder: 'Year', 'aria-label': 'Jump to year' },\n            cls: 'story-line-year-input',\n        });\n        yearInput.addEventListener('keydown', (e: KeyboardEvent) => {\n            if (e.key === 'Enter') {\n                e.preventDefault();\n                const year = parseInt(yearInput.value, 10);\n                if (Number.isSafeInteger(year)) {\n                    this.timelineNavigationService.jumpToDate(year);\n                    this.updateTimeNavigationDisplay();\n                    // An empty year has no precise DOM position until the\n                    // temporal ruler exists. Do not fake an exact jump.\n                }\n            }\n        });\n\n        // Next item button\n        const nextBtn = navContainer.createEl('button', {\n            cls: 'clickable-icon',\n        });\n        obsidian.setIcon(nextBtn, 'chevron-right');\n        attachTooltip(nextBtn, 'Next item');\n        nextBtn.addEventListener('click', () => {\n            const item = this.timelineNavigationService.navigateNext();\n            if (item) {\n                this.scrollToNavigationItem(item);\n                this.updateTimeNavigationDisplay();\n            }\n        });\n\n        // Current time period display\n        const periodDisplay = navContainer.createSpan({\n            cls: 'story-line-time-period',\n            text: '',\n        });\n        periodDisplay.setAttr('title', 'Indexed time range and selected year');\n        this.updateTimeNavigationDisplay();\n    }\n\n    /** Update navigation labels after async content is loaded or a date changes. */\n    private updateTimeNavigationDisplay(): void {\n        const root = this.rootContainer;\n        if (!root) return;\n        const period = root.querySelector('.story-line-time-period') as HTMLElement | null;\n        const yearInput = root.querySelector('.story-line-year-input') as HTMLInputElement | null;\n        const state = this.timelineNavigationService.getState();\n        if (period) {\n            const range = state.visibleRange;\n            const rangeText = range ? `Items: ${range.start.year}–${range.end.year}` : 'No dated items';\n            period.setText(state.selectedDate\n                ? `Selected: ${state.selectedDate.year} · ${rangeText}`\n                : rangeText);\n        }\n        if (yearInput && state.selectedDate) {\n            yearInput.value = String(state.selectedDate.year);\n        }\n    }\n\n    /**\n     * Scroll to a rendered Scene or Event without reloading the whole view,\n     * changing the active Book or resetting the scroll position.\n     */\n    private scrollToNavigationItem(item: { scene?: Scene; event?: Event }): void {\n        if (!this.rootContainer) return;\n        const target = item.scene\n            ? this.rootContainer.querySelector(`[data-path=\"${CSS.escape(item.scene.filePath)}\"]`)\n            : item.event\n                ? this.rootContainer.querySelector(`[data-event-id=\"${CSS.escape(item.event.id)}\"]`)\n                : null;\n        if (target instanceof HTMLElement) {\n            target.scrollIntoView({ block: 'center', behavior: 'smooth' });\n        }\n    }\n\n    /**\n     * Render the horizontal temporal ruler above the timeline track.\n     * Clicking a marker jumps to that year; clicking between markers opens\n     * the creation menu with the date prefilled.\n     */\n    private renderTemporalRuler(timelineEl: HTMLElement, scenes: Scene[], events: Event[]): void {\n        const markers = this.timelineNavigationService.getTimeMarkers();\n        if (markers.length === 0) return;\n\n        const visibleRange = this.timelineNavigationService.getState().visibleRange;\n        if (!visibleRange) return;\n\n        const ruler = timelineEl.createDiv('timeline-temporal-ruler');\n\n        const rangeStart = visibleRange.start.year;\n        const rangeEnd = visibleRange.end.year;\n        const rangeSpan = rangeEnd - rangeStart;\n\n        for (const marker of markers) {\n            // Calculate position as fraction of the visible range\n            const fraction = rangeSpan > 0 ? (marker.timestamp.year - rangeStart) / rangeSpan : 0.5;\n            const percent = Math.max(0, Math.min(100, fraction * 100));\n\n            const markerEl = ruler.createDiv('timeline-ruler-marker');\n            markerEl.setCssStyles({ left: `${percent}%` });\n            if (marker.isMajor) markerEl.addClass('is-major');\n\n            const label = markerEl.createSpan('timeline-ruler-label');\n            label.setText(marker.label);\n\n            // Click handler: jump to the marker's date\n            markerEl.addEventListener('click', (e) => {\n                e.stopPropagation();\n                this.timelineNavigationService.jumpToDate(\n                    marker.timestamp.year,\n                    marker.timestamp.month,\n                    marker.timestamp.day\n                );\n                this.updateTimeNavigationDisplay();\n            });\n        }\n\n        // Click on empty space in the ruler to create Scene/Event at that date\n        ruler.addEventListener('click', (e: MouseEvent) => {\n            const rulerRect = ruler.getBoundingClientRect();\n            const fraction = (e.clientX - rulerRect.left) / rulerRect.width;\n            const timestamp = this.timelineNavigationService.getTimestampAtPosition(fraction);\n            if (timestamp) {\n                this.showTemporalCreationMenu(e, timestamp);\n            }\n        });\n    }\n\n    /**\n     * Show a context menu for creating a Scene or Event at the clicked date.\n     */\n    private showTemporalCreationMenu(e: MouseEvent, timestamp: Timestamp): void {\n        const menu = new Menu();\n        // Creation must use THIS click's timestamp, not a previously selected year.\n        const selectedDate = timestamp;\n        this.timelineNavigationService.setSelectedDate(selectedDate);\n\n        menu.addItem(item => {\n            item.setTitle(`Create scene in active Book on ${selectedDate.year}`)\n                .setIcon('file')\n                .onClick(() => {\n                    // Cross-book creation needs explicit ownership selection.\n                    if (this.isMultiBookMode()) {\n                        new Notice('To create a Scene, switch to Active Book only first.');\n                        return;\n                    }\n                    this.openQuickAddWithDate(selectedDate);\n                });\n        });\n\n        menu.addItem(item => {\n            item.setTitle(`Create Book-level Event on ${selectedDate.year}`)\n                .setIcon('calendar')\n                .onClick(async () => {\n                    const eventsFolder = this.sceneManager.getBookEventsFolder();\n                    if (eventsFolder) {\n                        await this.plugin.openCreateEventModal(eventsFolder, selectedDate);\n                        this.refresh();\n                    }\n                });\n        });\n\n        menu.showAtMouseEvent(e);\n    }\n\n    /**\n     * Open the Quick Add modal with the date prefilled from the temporal ruler.\n     */\n    private openQuickAddWithDate(timestamp: Timestamp): void {\n        // Preserve year/month precision and the original calendar. Never\n        // invent January 1 for a year-only timestamp.\n        const timeSpan: TimeSpan = { kind: 'instant', instant: { ...timestamp } };\n        const storyDate = timestamp.calendar === 'gregorian' && timestamp.month !== undefined && timestamp.day !== undefined\n            ? `${timestamp.year}-${String(timestamp.month).padStart(2, '0')}-${String(timestamp.day).padStart(2, '0')}`\n            : undefined;\n        const modal = new QuickAddModal(\n            this.app,\n            this.plugin,\n            this.sceneManager,\n            async (sceneData, openAfter) => {\n                // Prefill the date from the temporal ruler\n                sceneData.timeSpan = timeSpan;\n                if (storyDate) sceneData.storyDate = storyDate;\n                else delete sceneData.storyDate;\n                const file = await this.sceneManager.createScene(sceneData);\n                this.refresh();\n                const scrollToNew = () => {\n                    const newEntry = this.rootContainer?.querySelector(\n                        `[data-path=\"${CSS.escape(file.path)}\"]`\n                    );\n                    if (newEntry) {\n                        newEntry.scrollIntoView({ behavior: 'smooth', block: 'center' });\n                    }\n                };\n                window.requestAnimationFrame(scrollToNew);\n                window.setTimeout(scrollToNew, 50);\n                if (openAfter) {\n                    void this.app.workspace.getLeaf('tab').openFile(file, { state: { mode: 'source', source: false } });\n                }\n            },\n            { storyDate, timeSpan }\n        );\n        modal.open();\n    }\n\n    /**\n     * Build a shared chronological projection of scenes and events.\n     * Returns items sorted by TimeSpan, with unknown/undated items at the end.\n     * This is the canonical projection used by both linear and swimlane modes.\n     */\n    private buildChronologicalProjection(scenes: Scene[], events: Event[]): Array<\n        | { kind: 'scene'; scene: Scene }\n        | { kind: 'event'; event: Event }\n    > {\n        interface SortableItem {\n            timestamp: Timestamp | null;\n            calendar: string | undefined;\n            scene?: Scene;\n            event?: Event;\n        }\n        const sortable: SortableItem[] = [];\n\n        // Add scenes — normalize legacy dates via TimeSpanService\n        for (const scene of scenes) {\n            const ts = this.getSceneSortTimestamp(scene);\n            sortable.push({ timestamp: ts, calendar: ts?.calendar, scene });\n        }\n\n        // Add events — use TimeSpan directly\n        for (const event of events) {\n            const ts = event.timeSpan\n                ? this.plugin.timeSpanService.getEarliestPoint(event.timeSpan)\n                : null;\n            sortable.push({ timestamp: ts, calendar: ts?.calendar, event });\n        }\n\n        // Sort using unified TimeSpan-based comparison\n        sortable.sort((a, b) => {\n            const cmp = this.compareTimelineItems(a.timestamp, a.calendar, b.timestamp, b.calendar);\n            if (cmp !== 0) return cmp;\n            // Same date — scenes before events for stability\n            if (a.scene && b.event) return -1;\n            if (a.event && b.scene) return 1;\n            return 0;\n        });\n\n        // Convert to projection items\n        const projection: Array<{ kind: 'scene'; scene: Scene } | { kind: 'event'; event: Event }> = [];\n        for (const item of sortable) {\n            if (item.scene) {\n                projection.push({ kind: 'scene', scene: item.scene });\n            }\n            if (item.event) {\n                projection.push({ kind: 'event', event: item.event });\n            }\n        }\n\n        return projection;\n    }\n\n    /**\n     * Render a single scene row in the swimlane grid.\n     */\n    private renderSwimlaneSceneRow(grid: HTMLElement, scene: Scene, laneKeys: string[], isMultiBook: boolean): void {\n        const act = scene.act !== undefined ? String(scene.act).padStart(2, '0') : '??';\n        const seq = scene.sequence !== undefined ? String(scene.sequence).padStart(2, '0') : '??';\n        const chronoSeq = scene.chronologicalOrder !== undefined ? String(scene.chronologicalOrder).padStart(2, '0') : null;\n\n        // Sequence axis cell\n        const seqCell = grid.createDiv('swimlane-seq-cell');\n        seqCell.classList.add('timeline-seq-clickable');\n        seqCell.createSpan({ cls: 'timeline-seq-badge', text: `${act}-${seq}` });\n        if (chronoSeq !== null && scene.chronologicalOrder !== scene.sequence) {\n            const chronoBadge = seqCell.createSpan({ cls: 'timeline-chrono-badge', text: `C${chronoSeq}` });\n            chronoBadge.setAttribute('title', `Chronological order: ${chronoSeq}`);\n        }\n        const timeSpan = this.getSceneTimeSpan(scene);\n        if (timeSpan) {\n            seqCell.createSpan({ cls: 'timeline-date-badge', text: this.plugin.timeSpanService.format(timeSpan) });\n        } else if (scene.storyDate) {\n            seqCell.createSpan({ cls: 'timeline-date-badge', text: scene.storyDate });\n        }\n        if (scene.storyTime) {\n            seqCell.createSpan({ cls: 'timeline-time-badge', text: scene.storyTime });\n        }\n        seqCell.setAttribute('title', 'Click to edit date/time');\n        seqCell.addEventListener('click', (e) => {\n            e.stopPropagation();\n            this.openTimeEditModal(scene);\n        });\n\n        // Determine which lane(s) this scene belongs to\n        const sceneLaneKeys = isMultiBook\n            ? [this.getSceneBookProject(scene)?.bookId || '(unknown)']\n            : this.getSceneLaneKeys(scene);\n        const sceneKeySet = new Set(sceneLaneKeys);\n\n        // Render one cell per lane\n        for (const lane of laneKeys) {\n            const cell = grid.createDiv('swimlane-lane-cell');\n            if (sceneKeySet.has(lane)) {\n                this.renderSwimlaneCard(cell, scene);\n            }\n            // else: empty cell — visual gap\n        }\n    }\n\n    /**\n     * Render a single event row in the swimlane grid.\n     * Events appear as shared reference markers across all lanes.\n     */\n    private renderSwimlaneEventRow(grid: HTMLElement, event: Event, laneKeys: string[]): void {\n        // Sequence axis cell with event date\n        const seqCell = grid.createDiv('swimlane-seq-cell');\n        seqCell.classList.add('swimlane-event-seq');\n        if (event.timeSpan) {\n            const badge = seqCell.createSpan({ cls: 'timeline-date-badge' });\n            badge.setText(this.plugin.timeSpanService.format(event.timeSpan));\n            if (event.timeSpan.kind === 'uncertain') badge.addClass('timeline-date-uncertain');\n            else if (event.timeSpan.kind === 'unknown') badge.addClass('timeline-date-unknown');\n        } else {\n            seqCell.createSpan({ cls: 'timeline-date-badge timeline-date-unknown', text: 'Undated' });\n        }\n\n        // One event marker spans every Book lane; no duplicate cards.\n        const cell = grid.createDiv('swimlane-lane-cell swimlane-event-shared');\n        cell.setCssStyles({ gridColumn: '2 / -1' });\n        this.renderSwimlaneEventCard(cell, event);\n    }\n\n    /**\n     * Get the lane key(s) this scene belongs to, based on current swimlaneGroupBy.\n     */\n    private getSceneLaneKeys(scene: Scene): string[] {\n        switch (this.swimlaneGroupBy) {\n            case 'pov':\n                return [scene.pov || '(no POV)'];\n            case 'character':\n                if (scene.characters && scene.characters.length > 0) return this.cleanLaneKeys(scene.characters);\n                return ['(no character)'];\n            case 'location':\n                return parseSceneLocations(scene.location).length > 0\n                    ? parseSceneLocations(scene.location)\n                    : ['(no location)'];\n            case 'plotline':\n            case 'tag':\n                if (scene.tags && scene.tags.length > 0) return this.cleanLaneKeys(scene.tags);\n                return [this.swimlaneGroupBy === 'tag' ? '(no tag)' : '(no plotline)'];\n            default:\n                return ['(none)'];\n        }\n    }\n\n    private cleanLaneKeys(values: string[]): string[] {\n        const seen = new Set<string>();\n        for (const value of values) {\n            const trimmed = String(value || '').trim();\n            if (trimmed) seen.add(trimmed);\n        }\n        return Array.from(seen);\n    }\n\n    /**\n     * Sort Events by TimeSpan for chronological display.\n     * Events without temporal info are placed at the end.\n     */\n    private sortEventsByTime(events: Event[]): Event[] {\n        const tsService = this.plugin.timeSpanService;\n        return [...events].sort((a, b) => {\n            const aPoint = a.timeSpan ? tsService.getEarliestPoint?.(a.timeSpan) : null;\n            const bPoint = b.timeSpan ? tsService.getEarliestPoint?.(b.timeSpan) : null;\n            if (!aPoint && !bPoint) return 0;\n            if (!aPoint) return 1;\n            if (!bPoint) return -1;\n            return tsService.compareTimestamps?.(aPoint, bPoint) ?? 0;\n        });\n    }\n\n    /**\n     * Render a compact Event marker inside a swimlane cell.\n     */\n    private renderSwimlaneEventCard(cell: HTMLElement, event: Event): void {\n        const card = cell.createDiv('timeline-card swimlane-card swimlane-event-card');\n        card.dataset.eventId = event.id;\n\n        // Event icon\n        const iconSpan = card.createSpan({ cls: 'timeline-event-icon' });\n        obsidian.setIcon(iconSpan, 'calendar');\n\n        card.createDiv({ cls: 'timeline-card-title', text: event.name || 'Untitled Event' });\n\n        // TimeSpan\n        if (event.timeSpan) {\n            const timeBadge = card.createDiv({ cls: 'timeline-card-meta' });\n            const timeText = timeBadge.createSpan({ cls: 'timeline-date-badge' });\n            timeText.setText(this.plugin.timeSpanService.format(event.timeSpan));\n            if (event.timeSpan.kind === 'uncertain') {\n                timeText.addClass('timeline-date-uncertain');\n            } else if (event.timeSpan.kind === 'unknown') {\n                timeText.addClass('timeline-date-unknown');\n            }\n        }\n\n        // Click to edit\n        card.addEventListener('click', (e) => {\n            e.stopPropagation();\n            this.openEditEvent(event);\n        });\n    }\n\n    /**\n     * Render a compact scene card inside a swimlane cell.\n     * Uses the same visual language as the linear timeline cards.\n     */\n    private renderSwimlaneCard(cell: HTMLElement, scene: Scene): void {\n        // Dot (status indicator)\n        const dotWrap = cell.createDiv('swimlane-dot-wrap');\n        const dot = dotWrap.createDiv('timeline-dot');\n        dot.setAttribute('data-status', scene.status || 'idea');\n\n        // Card\n        const card = cell.createDiv('timeline-card swimlane-card');\n        if (this.selectedScene?.filePath === scene.filePath) {\n            card.addClass('selected');\n        }\n        card.dataset.path = scene.filePath;\n\n        card.createDiv({ cls: 'timeline-card-title', text: scene.title || 'Untitled' });\n\n        // Timeline mode badge (for non-linear scenes)\n        const slMode = scene.timeline_mode || 'linear';\n        if (slMode !== 'linear') {\n            const modeBadge = card.createDiv({ cls: `timeline-mode-badge timeline-mode-${slMode}` });\n            const modeIcon = modeBadge.createSpan();\n            obsidian.setIcon(modeIcon, TIMELINE_MODE_ICONS[slMode] || 'clock');\n            modeBadge.createSpan({ text: ` ${TIMELINE_MODE_LABELS[slMode]}` });\n            if (scene.timeline_strand) {\n                modeBadge.createSpan({ cls: 'timeline-strand-label', text: ` · ${scene.timeline_strand}` });\n            }\n        }\n\n        const meta = card.createDiv('timeline-card-meta');\n        // Show the field that is NOT the grouping field (avoid redundancy)\n        if (this.swimlaneGroupBy !== 'pov' && scene.pov) {\n            meta.createSpan({ cls: 'timeline-card-pov', text: `POV: ${scene.pov}` });\n        }\n        if (this.swimlaneGroupBy !== 'character' && scene.characters?.length) {\n            meta.createSpan({ cls: 'timeline-card-pov', text: scene.characters.join(', ') });\n        }\n        const sceneLocations = parseSceneLocations(scene.location);\n        if (this.swimlaneGroupBy !== 'location' && sceneLocations.length > 0) {\n            const locSpan = meta.createSpan({ cls: 'timeline-card-location' });\n            obsidian.setIcon(locSpan, 'map-pin');\n            locSpan.appendText(' ' + sceneLocations.join(', '));\n        }\n        if (this.swimlaneGroupBy !== 'plotline' && this.swimlaneGroupBy !== 'tag' && scene.tags?.length) {\n            meta.createSpan({ cls: 'timeline-card-pov', text: scene.tags.join(', ') });\n        }\n\n        // Status + word count footer\n        const footer = card.createDiv('timeline-card-footer');\n        const statusCfg = resolveStatusCfg(scene.status || 'idea');\n        const statusBadge = footer.createSpan({ cls: 'timeline-card-status', text: statusCfg.label });\n        statusBadge.setCssStyles({ color: statusCfg.color });\n\n        if (scene.wordcount || scene.charcount) {\n            const unit = this.plugin.settings.countUnit === 'chars' ? 'chars' : 'words';\n            footer.createSpan({ cls: 'timeline-card-wc', text: formatSceneLength(scene, unit) });\n        }\n\n        // Click / double-click / context menu\n        card.addEventListener('click', (e) => {\n            e.stopPropagation();\n            this.selectScene(scene, e);\n        });\n        card.addEventListener('dblclick', (e) => {\n            e.stopPropagation();\n            this.openScene(scene);\n        });\n        card.addEventListener('contextmenu', (e) => {\n            e.preventDefault();\n            e.stopPropagation();\n            this.showContextMenu(scene, e);\n        });\n\n        card.setCssStyles({\n            transform: `scale(${this.zoomLevel})`,\n            transformOrigin: 'left top',\n        });\n    }\n\n    /**\n     * Render a single timeline entry (scene card on the timeline)\n     */\n    private renderTimelineEntry(\n        track: HTMLElement,\n        scene: Scene,\n        i: number,\n        _scenes: Scene[],\n        _dragIndex: number | null,\n        _dropIndex: number | null,\n        refreshDropIndicators: () => void,\n        handleDrop: (from: number, to: number) => Promise<void>,\n        setDragIndex: (v: number | null) => void,\n        setDropIndex: (v: number | null) => void,\n        dateInvalid: boolean,\n        timeInvalid: boolean,\n        bookTitle?: string | null,\n    ): void {\n        const entry = track.createDiv('timeline-entry');\n        // Reordering is only supported for the active book. Multi-book\n        // timelines are chronological references, not a shared manuscript.\n        entry.setAttr('draggable', !this.isMultiBookMode() ? 'true' : 'false');\n        entry.dataset.idx = String(i);\n        entry.dataset.path = scene.filePath;\n\n        // Highlight if selected\n        if (this.selectedScene?.filePath === scene.filePath) {\n            entry.addClass('selected');\n        }\n\n        // Drag events\n        entry.addEventListener('dragstart', (e) => {\n            setDragIndex(i);\n            entry.classList.add('dragging');\n            e.dataTransfer?.setData('text/plain', String(i));\n            e.dataTransfer?.setDragImage(entry, 20, 20);\n        });\n        entry.addEventListener('dragend', () => {\n            setDragIndex(null);\n            setDropIndex(null);\n            entry.classList.remove('dragging');\n            refreshDropIndicators();\n            // Stop auto-scroll on drag end\n            (entry.closest('.story-line-main-area') as unknown as { _slStopAutoScroll?: () => void } | null)?._slStopAutoScroll?.();\n        });\n        entry.addEventListener('dragover', (e) => {\n            e.preventDefault();\n            const rect = entry.getBoundingClientRect();\n            const midY = rect.top + rect.height / 2;\n            const computed = (e.clientY < midY) ? i : i + 1;\n            setDropIndex(computed);\n            refreshDropIndicators();\n            // Auto-scroll near edges\n            (entry.closest('.story-line-main-area') as unknown as { _slAutoScroll?: (y: number) => void } | null)?._slAutoScroll?.(e.clientY);\n        });\n        entry.addEventListener('dragleave', () => {\n            setDropIndex(null);\n            refreshDropIndicators();\n        });\n        entry.addEventListener('drop', async (e) => {\n            e.preventDefault();\n            // Stop auto-scroll\n            (entry.closest('.story-line-main-area') as unknown as { _slStopAutoScroll?: () => void } | null)?._slStopAutoScroll?.();\n            const fromStr = e.dataTransfer?.getData('text/plain');\n            if (fromStr !== undefined && fromStr !== null) {\n                const from = Number(fromStr);\n                // Use the computed dropIndex (midpoint-aware) instead of entry index\n                const actualDrop = ((entry.closest('.timeline-track') as unknown as { _slDropIndex?: number } | null)?._slDropIndex) ?? i;\n                await handleDrop(from, actualDrop);\n            }\n        });\n\n        // Left column: sequence badge + date/time (clickable to edit)\n        const seqCol = entry.createDiv('timeline-entry-seq');\n        seqCol.classList.add('timeline-seq-clickable');\n        const act = scene.act !== undefined ? String(scene.act).padStart(2, '0') : '??';\n        const seq = scene.sequence !== undefined ? String(scene.sequence).padStart(2, '0') : '??';\n        const chronoSeq = scene.chronologicalOrder !== undefined ? String(scene.chronologicalOrder).padStart(2, '0') : null;\n\n        seqCol.createSpan({ cls: 'timeline-seq-badge', text: `${act}-${seq}` });\n\n        // Show chronological order badge when it differs from reading order\n        if (chronoSeq !== null && scene.chronologicalOrder !== scene.sequence) {\n            const chronoBadge = seqCol.createSpan({ cls: 'timeline-chrono-badge', text: `C${chronoSeq}` });\n            chronoBadge.setAttribute('title', `Chronological order: ${chronoSeq}`);\n        }\n\n        const dateBadge = scene.storyDate ? seqCol.createSpan({ cls: 'timeline-date-badge', text: scene.storyDate }) : null;\n        const timeBadge = scene.storyTime ? seqCol.createSpan({ cls: 'timeline-time-badge', text: scene.storyTime }) : null;\n        if (!scene.storyDate && !scene.storyTime) {\n            const addHint = seqCol.createSpan({ cls: 'timeline-add-time-hint' });\n            obsidian.setIcon(addHint, 'clock');\n        }\n\n        seqCol.setAttribute('title', 'Click to edit date/time');\n        seqCol.addEventListener('click', (e) => {\n            e.stopPropagation();\n            this.openTimeEditModal(scene);\n        });\n\n        // Center: dot + line\n        const dotCol = entry.createDiv('timeline-entry-dot-col');\n        const dot = dotCol.createDiv('timeline-dot');\n        dot.setAttribute('data-status', scene.status || 'idea');\n\n        // Right column: card\n        const cardCol = entry.createDiv('timeline-entry-card');\n        const card = cardCol.createDiv('timeline-card');\n\n        // Apply custom scene color as background tint\n        if (scene.color && /^#[0-9a-fA-F]{6}$/.test(scene.color)) {\n            card.addClass('sl-scene-colored');\n            card.style.setProperty('--sl-scene-bg', scene.color);\n        }\n\n        card.createDiv({ cls: 'timeline-card-title', text: scene.title || 'Untitled' });\n\n        // Book title badge in multi-book mode\n        if (bookTitle) {\n            const bookBadge = card.createDiv({ cls: 'timeline-card-book-badge', text: bookTitle });\n        }\n\n        // Timeline mode badge (for non-linear scenes)\n        const tlMode = scene.timeline_mode || 'linear';\n        if (tlMode !== 'linear') {\n            const modeBadge = card.createDiv({ cls: `timeline-mode-badge timeline-mode-${tlMode}` });\n            const modeIcon = modeBadge.createSpan();\n            obsidian.setIcon(modeIcon, TIMELINE_MODE_ICONS[tlMode] || 'clock');\n            modeBadge.createSpan({ text: ` ${TIMELINE_MODE_LABELS[tlMode]}` });\n            if (scene.timeline_strand) {\n                modeBadge.createSpan({ cls: 'timeline-strand-label', text: ` · ${scene.timeline_strand}` });\n            }\n        }\n\n        const meta = card.createDiv('timeline-card-meta');\n        if (scene.pov) {\n            meta.createSpan({ cls: 'timeline-card-pov', text: `POV: ${scene.pov}` });\n        }\n        const sceneLocations = parseSceneLocations(scene.location);\n        if (sceneLocations.length > 0) {\n            const locSpan = meta.createSpan({ cls: 'timeline-card-location' });\n            obsidian.setIcon(locSpan, 'map-pin');\n            locSpan.appendText(' ' + sceneLocations.join(', '));\n        }\n        if (scene.timeline) {\n            const timeSpan = meta.createSpan({ cls: 'timeline-card-time' });\n            obsidian.setIcon(timeSpan, 'calendar-days');\n            timeSpan.appendText(' ' + scene.timeline);\n        }\n        if (scene.storyDate || scene.storyTime) {\n            const dateSpan = meta.createSpan({ cls: 'timeline-card-time' });\n            obsidian.setIcon(dateSpan, 'calendar-days');\n            dateSpan.appendText(' ' + `${scene.storyDate || ''} ${scene.storyTime || ''}`.trim());\n        }\n\n        if (dateInvalid && dateBadge) {\n            dateBadge.addClass('timeline-date-invalid');\n            dateBadge.setAttr('title', 'Date out of order');\n        }\n        if (timeInvalid && timeBadge) {\n            timeBadge.addClass('timeline-time-invalid');\n            timeBadge.setAttr('title', 'Time out of order');\n        }\n\n        if (scene.conflict) {\n            card.createDiv({\n                cls: 'timeline-card-conflict',\n                text: scene.conflict.length > 100\n                    ? scene.conflict.substring(0, 100) + '...'\n                    : scene.conflict\n            });\n        }\n\n        // Status + word count footer\n        const footer = card.createDiv('timeline-card-footer');\n        const statusCfg = resolveStatusCfg(scene.status || 'idea');\n        const statusBadge = footer.createSpan({\n            cls: 'timeline-card-status',\n            text: statusCfg.label,\n        });\n        statusBadge.setCssStyles({ color: statusCfg.color });\n\n        if (scene.wordcount || scene.charcount) {\n            const unit = this.plugin.settings.countUnit === 'chars' ? 'chars' : 'words';\n            footer.createSpan({\n                cls: 'timeline-card-wc',\n                text: formatSceneLength(scene, unit),\n            });\n        }\n\n        // Characters\n        if (scene.characters?.length) {\n            const chars = card.createDiv('timeline-card-chars');\n            scene.characters.forEach(c => {\n                chars.createSpan({ cls: 'timeline-char-tag', text: c });\n            });\n        }\n\n        // Click to select (show inspector), double-click to open\n        card.addEventListener('click', (e) => {\n            e.stopPropagation();\n            this.selectScene(scene, e);\n        });\n        card.addEventListener('dblclick', (e) => {\n            e.stopPropagation();\n            this.openScene(scene);\n        });\n\n        // Right-click context menu\n        card.addEventListener('contextmenu', (e) => {\n            e.preventDefault();\n            e.stopPropagation();\n            this.showContextMenu(scene, e);\n        });\n\n        card.setCssStyles({\n            transform: `scale(${this.zoomLevel})`,\n            transformOrigin: 'left center',\n        });\n    }\n\n    // ────────────────────────────────────────────────────────────\n    //  Event rendering helpers\n    // ────────────────────────────────────────────────────────────\n\n    /**\n     * Render a single Event as a horizontal timeline marker.\n     * Format:\n     *   DATE  Event Title\n     *   ─────────────────────\n     *   Description...\n     * Events are non-draggable and visually distinct from Scene cards.\n     *\n     * IMPORTANT: .timeline-entry uses display:flex (row). To keep the Event\n     * marker vertically stacked, we insert the three required flex children\n     * (.timeline-entry-seq, .timeline-entry-dot-col, .timeline-entry-card)\n     * so the entry participates in the same layout as Scenes, with all Event\n     * content inside a single vertical column (.timeline-event-content).\n     */\n    private renderTimelineEvent(track: HTMLElement, event: Event): void {\n        const entry = track.createDiv('timeline-entry timeline-entry-event-marker');\n        entry.dataset.path = event.filePath;\n        entry.dataset.eventId = event.id;\n\n        // Left column (required by .timeline-entry flex layout)\n        const seqCol = entry.createDiv('timeline-entry-seq');\n        // Format the date for the left column badge\n        const dateText = event.timeSpan\n            ? this.plugin.timeSpanService.format(event.timeSpan)\n            : '?';\n        const dateBadge = seqCol.createSpan({\n            cls: 'timeline-date-badge',\n            text: dateText\n        });\n        if (event.timeSpan) {\n            if (event.timeSpan.kind === 'uncertain') {\n                dateBadge.addClass('timeline-date-uncertain');\n                dateBadge.setAttr('title', 'Uncertain date');\n            } else if (event.timeSpan.kind === 'unknown') {\n                dateBadge.addClass('timeline-date-unknown');\n                dateBadge.setAttr('title', 'Unknown date');\n            }\n        }\n\n        // Center dot column (required by .timeline-entry flex layout)\n        const dotCol = entry.createDiv('timeline-entry-dot-col');\n        const dot = dotCol.createDiv('timeline-dot timeline-dot-event');\n\n        // Right column: vertical Event content\n        const cardCol = entry.createDiv('timeline-entry-card');\n        const content = cardCol.createDiv('timeline-event-content');\n\n        // Top row: event title\n        const topRow = content.createDiv('timeline-event-top');\n        const titleSpan = topRow.createSpan({\n            cls: 'timeline-event-title',\n            text: event.name || 'Untitled Event'\n        });\n\n        // Horizontal marker line\n        content.createDiv('timeline-event-marker-line');\n\n        // Bottom: description\n        if (event.description) {\n            const desc = content.createDiv('timeline-event-description');\n            desc.setText(event.description);\n        }\n\n        // Click to edit the event\n        entry.addEventListener('click', (e) => {\n            e.stopPropagation();\n            this.openEditEvent(event);\n        });\n\n        entry.setCssStyles({\n            transform: `scale(${this.zoomLevel})`,\n            transformOrigin: 'left center',\n        });\n    }\n\n    /**\n     * Open the Event editor modal for an existing Event.\n     */\n    private async openEditEvent(event: Event): Promise<void> {\n        try {\n            await this.plugin.openEditEventModal(event);\n            // Refresh timeline after editing\n            this.refresh();\n        } catch {\n            // ignore\n        }\n    }\n\n    /**\n     * Build chronologically sorted timeline items for linear mode.\n     * Delegates temporal ordering to the shared buildChronologicalProjection()\n     * so linear and swimlane modes use identical sorting.\n     * Adds act dividers and empty-act placeholders on top of the projection.\n     */\n    private buildChronologicalTimelineItems(\n        tlItems: Array<\n            | { kind: 'divider'; actLabel: string; actNum: number | undefined }\n            | { kind: 'scene'; scene: Scene; globalIdx: number; dateInvalid: boolean; timeInvalid: boolean }\n            | { kind: 'event'; event: Event }\n            | { kind: 'empty-act'; actLabel: string; actNum: number }\n        >,\n        scenes: Scene[],\n        events: Event[],\n        dateInvalidFlags: boolean[],\n        timeInvalidFlags: boolean[],\n        definedActs: number[],\n        actsWithScenes: Set<number>,\n        sortedActs: number[]\n    ): void {\n        // Use the shared chronological projection for sorting\n        const projection = this.buildChronologicalProjection(scenes, events);\n\n        // Map scenes to their original indices for dateInvalid/timeInvalid flags\n        const sceneIdxMap = new Map<Scene, number>();\n        for (let i = 0; i < scenes.length; i++) {\n            sceneIdxMap.set(scenes[i], i);\n        }\n\n        // Render items on the shared axis with act dividers\n        let lastRenderedAct: number | undefined = undefined;\n\n        for (const item of projection) {\n            if (item.kind === 'scene') {\n                const scene = item.scene;\n                const currentAct = scene.act !== undefined ? Number(scene.act) : undefined;\n                if (currentAct !== lastRenderedAct) {\n                    const beatLabel = currentAct !== undefined ? this.sceneManager.getActLabel(currentAct) : undefined;\n                    const cleanBeat = beatLabel?.replace(/^(Act|Prologue|Epilogue)\\s*\\d*\\s*[—:]\\s*/i, '');\n                    const actDisplay = getActDisplayLabel(currentAct);\n                    const actLabel = currentAct !== undefined\n                        ? (cleanBeat ? `${actDisplay} — ${cleanBeat}` : actDisplay)\n                        : 'No Act';\n                    tlItems.push({ kind: 'divider', actLabel, actNum: currentAct });\n                    lastRenderedAct = currentAct;\n                }\n                const globalIdx = sceneIdxMap.get(scene) ?? 0;\n                tlItems.push({\n                    kind: 'scene',\n                    scene,\n                    globalIdx,\n                    dateInvalid: dateInvalidFlags[globalIdx] ?? false,\n                    timeInvalid: timeInvalidFlags[globalIdx] ?? false,\n                });\n            } else if (item.kind === 'event') {\n                tlItems.push({ kind: 'event', event: item.event });\n            }\n        }\n\n        // Add empty-act placeholders\n        for (const actNum of sortedActs) {\n            if (!actsWithScenes.has(Number(actNum))) {\n                const beatLabel = this.sceneManager.getActLabel(actNum);\n                const cleanBeat = beatLabel?.replace(/^(Act|Prologue|Epilogue)\\s*\\d*\\s*[—:]\\s*/i, '');\n                const actDisplay = getActDisplayLabel(actNum);\n                const actLabel = cleanBeat ? `${actDisplay} — ${cleanBeat}` : actDisplay;\n                tlItems.push({ kind: 'empty-act', actLabel, actNum });\n            }\n        }\n    }\n\n    /**\n     * Convert a Timestamp to a sortable numeric value.\n     * Uses a simple year/month/day linearization for comparison.\n     * Supports negative years (BC dates) and very large year values.\n     */\n    private timestampToSortable(ts: Timestamp): number {\n        const y = ts.year ?? 0;\n        const m = ts.month ?? 1;\n        const d = ts.day ?? 1;\n        const h = ts.hour ?? 0;\n        const min = ts.minute ?? 0;\n        // Linearize: year * 100000000 + month * 1000000 + day * 10000 + hour * 100 + minute\n        return y * 100000000 + m * 1000000 + d * 10000 + h * 100 + min;\n    }\n\n    /**\n     * Get a TimeSpan for a Scene, normalizing legacy storyDate/storyTime in-memory.\n     * Does NOT modify the Scene's source file.\n     */\n    private getSceneTimeSpan(scene: Scene): TimeSpan | null {\n        // Prefer TimeSpan if available\n        if (scene.timeSpan) return scene.timeSpan;\n        // Fall back to legacy storyDate/storyTime\n        return this.plugin.timeSpanService.convertLegacyToTimeSpan(scene.storyDate, scene.storyTime);\n    }\n\n    /**\n     * Get a sortable Timestamp for a Scene, using TimeSpanService for unified comparison.\n     * Returns null if the Scene has no temporal information.\n     */\n    private getSceneSortTimestamp(scene: Scene): Timestamp | null {\n        const ts = this.getSceneTimeSpan(scene);\n        if (!ts) return null;\n        return this.plugin.timeSpanService.getEarliestPoint(ts);\n    }\n\n    /**\n     * Compare two Timeline items (Scene or Event) by their temporal placement.\n     * Uses TimeSpanService for calendar-aware comparison.\n     * Items without temporal info sort last.\n     */\n    private compareTimelineItems(\n        aTime: Timestamp | null,\n        aCalendar: string | undefined,\n        bTime: Timestamp | null,\n        bCalendar: string | undefined,\n    ): number {\n        // Both null → stable order\n        if (!aTime && !bTime) return 0;\n        // Null sorts last\n        if (!aTime) return 1;\n        if (!bTime) return -1;\n        // Different calendars → cannot compare, sort by calendar name for stability\n        if (aCalendar && bCalendar && aCalendar !== bCalendar) {\n            return aCalendar.localeCompare(bCalendar);\n        }\n        // Same calendar (or both Gregorian) → compare timestamps\n        return this.plugin.timeSpanService.compareTimestamps(aTime, bTime);\n    }\n\n    /**\n     * Parse date-only component into a Timestamp for date validation flags.\n     * Returns null if unavailable. Used only for date-order warning flags.\n     */\n    private parseSceneDateTimestamp(scene: Scene): number | null {\n        try {\n            const datePart = scene.storyDate?.trim();\n            if (datePart) {\n                const parsed = Date.parse(datePart);\n                if (!isNaN(parsed)) return new Date(new Date(parsed).toDateString()).getTime();\n                const dayMatch = datePart.match(/dag\\s*(\\d+)/i) || (scene.timeline || '').match(/dag\\s*(\\d+)/i);\n                if (dayMatch) {\n                    const dayNum = parseInt(dayMatch[1], 10);\n                    if (!isNaN(dayNum)) return dayNum * 24 * 60 * 60 * 1000;\n                }\n            }\n        } catch (e) {\n            // ignore\n        }\n        return null;\n    }\n\n    /**\n     * Parse time-only component into milliseconds-since-midnight. Returns null if unavailable.\n     */\n    private parseSceneTimeTimestamp(scene: Scene): number | null {\n        try {\n            let timePart = scene.storyTime?.trim();\n            if (timePart) {\n                // Normalize common separators (accept '11:20' and '11.20')\n                timePart = timePart.replace(/\\./g, ':');\n                // Accept HH:MM or HH:MM:SS\n                const m = timePart.match(/(\\d{1,2}):(\\d{2})(?::(\\d{2}))?/);\n                if (m) {\n                    const h = parseInt(m[1], 10);\n                    const mm = parseInt(m[2], 10);\n                    const ss = m[3] ? parseInt(m[3], 10) : 0;\n                    if (!isNaN(h) && !isNaN(mm)) {\n                        const val = (h * 3600 + mm * 60 + ss) * 1000;\n                        \n                        return val;\n                    }\n                }\n                // Try parsing as Date on epoch day\n                const parsed = Date.parse('1970-01-01 ' + timePart);\n                if (!isNaN(parsed)) {\n                    \n                    return parsed;\n                }\n            }\n        } catch (e) {\n            // ignore\n        }\n        return null;\n    }\n    /**\n     * Select a scene and show it in the inspector\n     */\n    private selectScene(scene: Scene, event?: MouseEvent): void {\n        const isMultiSelect = event && (event.ctrlKey || event.metaKey);\n\n        if (isMultiSelect) {\n            // Toggle this scene in multi-selection\n            if (this.selectedScenes.has(scene.filePath)) {\n                this.selectedScenes.delete(scene.filePath);\n                const entry = this.rootContainer?.querySelector(`[data-path=\"${CSS.escape(scene.filePath)}\"]`);\n                if (entry) entry.removeClass('selected');\n            } else {\n                this.selectedScenes.add(scene.filePath);\n                const entry = this.rootContainer?.querySelector(`[data-path=\"${CSS.escape(scene.filePath)}\"]`);\n                if (entry) entry.addClass('selected');\n            }\n            this.selectedScene = scene;\n        } else {\n            // Single select — clear multi-selection\n            this.selectedScenes.clear();\n            this.rootContainer?.querySelectorAll('.timeline-entry.selected').forEach(el => {\n                el.removeClass('selected');\n            });\n\n            this.selectedScene = scene;\n            this.selectedScenes.add(scene.filePath);\n\n            // Highlight selected entry\n            const entry = this.rootContainer?.querySelector(`[data-path=\"${CSS.escape(scene.filePath)}\"]`);\n            if (entry) entry.addClass('selected');\n        }\n\n        // Show inspector for last clicked scene\n        if (this.plugin.isSceneInspectorOpen()) {\n            this.inspectorComponent?.hide();\n            this.app.workspace.trigger('storyline:scene-focus', scene.filePath);\n        } else {\n            this.inspectorComponent?.show(scene);\n        }\n    }\n\n    /**\n     * Show context menu for a scene\n     */\n    private showContextMenu(scene: Scene, event: MouseEvent): void {\n        // Issue #237 — ensure the right-clicked scene is part of the\n        // multi-selection so the \"Shift dates\" action always includes it.\n        // If the user right-clicks a scene that isn't selected, we treat\n        // the right-click as a fresh single selection (mirroring Kanban).\n        if (!this.selectedScenes.has(scene.filePath)) {\n            this.selectScene(scene);\n        }\n\n        const menu = new Menu();\n\n        menu.addItem(item => {\n            item.setTitle('Edit scene')\n                .setIcon('pencil')\n                .onClick(() => this.openScene(scene));\n        });\n\n        menu.addItem(item => {\n            item.setTitle('Edit date/time')\n                .setIcon('clock')\n                .onClick(() => this.openTimeEditModal(scene));\n        });\n\n        // Issue #237 — bulk date/time shift across multiple selected scenes.\n        // Only shown when more than one scene is selected (ctrl/cmd-click).\n        // The right-clicked scene is implicitly included in the selection\n        // if it isn't already, so the action always has a sensible anchor.\n        // In multi-book mode, shift dates is disabled: selected scenes may\n        // belong to different books with different act/chapter structures.\n        if (this.selectedScenes.size > 1 && !this.isMultiBookMode()) {\n            menu.addItem(item => {\n                item.setTitle(`Shift dates (${this.selectedScenes.size} scenes)…`)\n                    .setIcon('calendar-range')\n                    .onClick(() => this.openShiftDatesModal());\n            });\n        }\n\n        // Scene color picker\n        menu.addItem(item => {\n            item.setTitle(scene.color ? 'Change Color' : 'Set Color')\n                .setIcon('palette')\n                .onClick(() => {\n                    SceneCardComponent.openColorPicker(this.app, scene, this.sceneManager, () => this.refresh());\n                });\n        });\n\n        // Duplicate is unsafe in multi-book mode: it uses the active book's\n        // scene folder, which may differ from the scene's owning book.\n        if (!this.isMultiBookMode()) {\n            menu.addItem(item => {\n                item.setTitle('Duplicate scene')\n                    .setIcon('copy')\n                    .onClick(async () => {\n                        await this.sceneManager.duplicateScene(scene.filePath);\n                        this.refresh();\n                    });\n            });\n        }\n\n        menu.addSeparator();\n\n        // Status submenu\n        const statuses = getStatusOrder();\n        statuses.forEach(status => {\n            menu.addItem(item => {\n                item.setTitle(`Status: ${resolveStatusCfg(status).label}`)\n                    .setChecked(scene.status === status)\n                    .onClick(async () => {\n                        await this.sceneManager.updateScene(scene.filePath, { status });\n                        this.refresh();\n                    });\n            });\n        });\n\n        menu.addSeparator();\n\n        menu.addItem(item => {\n            item.setTitle('Delete scene')\n                .setIcon('trash')\n                .onClick(async () => {\n                    openConfirmModal(this.app, {\n                        title: 'Delete Scene',\n                        message: `Delete scene \"${scene.title || 'Untitled'}\"?`,\n                        confirmLabel: 'Delete',\n                        onConfirm: () => this.deleteScene(scene),\n                    });\n                });\n        });\n\n        menu.showAtMouseEvent(event);\n    }\n\n    /**\n     * Delete a scene\n     */\n    private async deleteScene(scene: Scene): Promise<void> {\n        await this.sceneManager.deleteScene(scene.filePath);\n        if (this.selectedScene?.filePath === scene.filePath) {\n            this.selectedScene = null;\n            this.inspectorComponent?.hide();\n        }\n        this.refresh();\n    }\n\n    /**\n     * Open the Quick Add modal, optionally pre-setting the act\n     */\n    private openQuickAdd(presetAct?: number): void {\n        const modal = new QuickAddModal(\n            this.app,\n            this.plugin,\n            this.sceneManager,\n            async (sceneData, openAfter) => {\n                if (presetAct !== undefined) {\n                    sceneData.act = presetAct;\n                }\n                const file = await this.sceneManager.createScene(sceneData);\n                this.refresh();\n                // Scroll to the newly created scene card. With 100+ scenes\n                // the rebuilt DOM may not be laid out within a single frame,\n                // so retry after a short timeout as well.\n                const scrollToNew = () => {\n                    const newEntry = this.rootContainer?.querySelector(\n                        `[data-path=\"${CSS.escape(file.path)}\"]`\n                    );\n                    if (newEntry) {\n                        newEntry.scrollIntoView({ behavior: 'smooth', block: 'center' });\n                    }\n                };\n                window.requestAnimationFrame(scrollToNew);\n                window.setTimeout(scrollToNew, 50);\n                if (openAfter) {\n                    await this.app.workspace.getLeaf('tab').openFile(file, { state: { mode: 'source', source: false } });\n                }\n            }\n        );\n        modal.open();\n    }\n\n    /**\n     * Open the structure modal to add/remove acts, chapters, and apply beat sheet templates\n     */\n    private openStructureModal(): void {\n        const modal = new Modal(this.app);\n        modal.titleEl.setText('Manage story structure');\n\n        const { contentEl } = modal;\n\n        // ── Beat Sheet Templates section ──\n        contentEl.createEl('h3', { text: 'Beat sheet templates' });\n        contentEl.createEl('p', {\n            cls: 'setting-item-description',\n            text: 'Apply a template to pre-populate your act/chapter structure with named beats.'\n        });\n\n        const templateGrid = contentEl.createDiv('beat-sheet-list');\n        for (const template of BUILTIN_BEAT_SHEETS) {\n            const row = templateGrid.createDiv('beat-sheet-row');\n\n            const textWrap = row.createDiv('beat-sheet-row-text');\n            const headerLine = textWrap.createDiv('beat-sheet-row-header');\n            headerLine.createSpan({ cls: 'beat-sheet-row-name', text: template.name });\n            const info = headerLine.createSpan({ cls: 'beat-sheet-row-info' });\n            const parts = [`${template.beats.length} beats`, `${template.acts.length} acts`];\n            if (template.chapters.length > 0) parts.push(`${template.chapters.length} chapters`);\n            info.textContent = parts.join(' · ');\n            textWrap.createDiv({ cls: 'beat-sheet-row-summary', text: template.summary });\n\n            // Expandable beat preview\n            const beatList = row.createDiv('beat-sheet-beats-preview');\n            for (const beat of template.beats) {\n                const beatItem = beatList.createDiv('beat-sheet-beat-item');\n                beatItem.createSpan({ cls: 'beat-sheet-beat-act', text: `A${beat.act}` });\n                beatItem.createSpan({ cls: 'beat-sheet-beat-label', text: beat.label });\n                beatItem.createSpan({ cls: 'beat-sheet-beat-desc', text: beat.description });\n            }\n\n            const expandBtn = row.createEl('button', { cls: 'beat-sheet-expand-btn clickable-icon', attr: { 'aria-label': 'Show beats' } });\n            expandBtn.textContent = '▸';\n            expandBtn.addEventListener('click', (e) => {\n                e.stopPropagation();\n                const isOpen = row.hasClass('is-expanded');\n                // Close all others\n                templateGrid.querySelectorAll('.beat-sheet-row.is-expanded').forEach(r => {\n                    r.removeClass('is-expanded');\n                    (r.querySelector('.beat-sheet-expand-btn') as HTMLElement).textContent = '▸';\n                });\n                if (!isOpen) {\n                    row.addClass('is-expanded');\n                    expandBtn.textContent = '▾';\n                }\n            });\n\n            const applyBtn = row.createEl('button', { text: 'Apply', cls: 'mod-cta beat-sheet-apply-btn' });\n            applyBtn.addEventListener('click', async () => {\n                await this.sceneManager.applyBeatSheet(template);\n                renderActsList();\n                renderChaptersList();\n                new Notice(`Applied \"${template.name}\" template`);\n            });\n        }\n\n        // ── Acts section ──\n        contentEl.createEl('h3', { text: 'Acts' });\n        contentEl.createEl('p', {\n            cls: 'setting-item-description',\n            text: 'Define acts for your story. Empty acts appear on the timeline even without scenes.'\n        });\n\n        const actsList = contentEl.createDiv('structure-list');\n        const scenesPerAct = new Map<number, number>();\n        for (const scene of this.sceneManager.getAllScenes()) {\n            if (scene.act !== undefined) {\n                const n = Number(scene.act);\n                scenesPerAct.set(n, (scenesPerAct.get(n) || 0) + 1);\n            }\n        }\n\n        const renderActsList = () => {\n            actsList.empty();\n            const acts = this.sceneManager.getDefinedActs();\n            const actLabels = this.sceneManager.getActLabels();\n            const actDescriptions = this.sceneManager.getActDescriptions();\n            if (acts.length === 0) {\n                actsList.createEl('p', { cls: 'structure-empty', text: 'No acts defined yet.' });\n            }\n            for (const act of acts) {\n                const count = scenesPerAct.get(act) || 0;\n                const label = actLabels[act];\n                const desc = actDescriptions[act] || '';\n                const wrapper = actsList.createDiv('structure-item-wrapper');\n                const row = wrapper.createDiv('structure-row');\n                const cleanLabel = label?.replace(/^(Act|Prologue|Epilogue)\\s*\\d*\\s*[—:]\\s*/i, '');\n                const actDisplay = getActDisplayLabel(act);\n                const labelText = cleanLabel ? `${actDisplay} — ${cleanLabel}` : actDisplay;\n                row.createSpan({ cls: 'structure-label', text: labelText });\n                row.createSpan({ cls: 'structure-count', text: `${count} scene${count !== 1 ? 's' : ''}` });\n\n                // Edit label button\n                const editBtn = row.createEl('button', {\n                    cls: 'clickable-icon structure-edit',\n                    attr: { 'aria-label': `Edit label for ${actDisplay}` }\n                });\n                editBtn.textContent = '✎';\n                editBtn.addEventListener('click', () => {\n                    const input = row.querySelector('.structure-label-input') as HTMLInputElement;\n                    if (input) { input.focus(); return; }\n                    // Create inline edit on the row, then position with insertBefore.\n                    const labelSpan = row.querySelector('.structure-label') as HTMLElement;\n                    if (!labelSpan) return;\n                    labelSpan.setCssStyles({ display: 'none' });\n                    const editInput = row.createEl('input', { type: 'text', cls: 'structure-label-input' });\n                    editInput.value = label || '';\n                    editInput.placeholder = 'E.g. Setup, confrontation???';\n                    row.insertBefore(editInput, labelSpan.nextSibling);\n                    editInput.focus();\n                    const commitEdit = async () => {\n                        await this.sceneManager.setActLabel(act, editInput.value);\n                        renderActsList();\n                    };\n                    editInput.addEventListener('blur', commitEdit);\n                    editInput.addEventListener('keydown', (e: KeyboardEvent) => {\n                        if (e.key === 'Enter') { e.preventDefault(); editInput.blur(); }\n                        if (e.key === 'Escape') { labelSpan.setCssStyles({ display: '' }); editInput.remove(); }\n                    });\n                });\n\n                const removeBtn = row.createEl('button', {\n                    cls: 'clickable-icon structure-remove',\n                    attr: { 'aria-label': `Remove Act ${act}` }\n                });\n                removeBtn.textContent = '×';\n                removeBtn.addEventListener('click', async () => {\n                    await this.sceneManager.removeAct(act);\n                    renderActsList();\n                });\n\n                // Description textarea\n                const descArea = wrapper.createEl('textarea', {\n                    cls: 'structure-description',\n                    attr: { placeholder: 'Description / notes for this act…', rows: '2' }\n                });\n                descArea.value = desc;\n                let descCommitTimer: number | null = null;\n                descArea.addEventListener('input', () => {\n                    // Auto-grow\n                    descArea.setCssStyles({ height: \"auto\" });\n\n                    descArea.setCssStyles({ height: descArea.scrollHeight + 'px' });\n                    // Debounced save\n                    if (descCommitTimer) window.clearTimeout(descCommitTimer);\n                    descCommitTimer = window.setTimeout(async () => {\n                        await this.sceneManager.setActDescription(act, descArea.value);\n                    }, 600);\n                });\n                // Initial auto-grow\n                window.setTimeout(() => {\n                    descArea.setCssStyles({ height: \"auto\" });\n\n                    descArea.setCssStyles({ height: descArea.scrollHeight + 'px' });\n                }, 0);\n            }\n        };\n        renderActsList();\n\n        const addActRow = contentEl.createDiv('structure-add-row');\n        new Setting(addActRow)\n            .setName('Add acts')\n            .setDesc('Enter act numbers (e.g. \"1,2,3,4,5\")')\n            .addText(text => {\n                text.setPlaceholder('1,2,3,4,5');\n                text.inputEl.addClass('structure-input');\n            })\n            .addButton(btn => {\n                btn.setButtonText('Add').setCta().onClick(async () => {\n                    const input = addActRow.querySelector('.structure-input') as HTMLInputElement;\n                    if (!input?.value) return;\n                    const nums = input.value.split(',')\n                        .map(s => parseInt(s.trim()))\n                        .filter(n => !isNaN(n) && n > 0);\n                    if (nums.length === 0) {\n                        new Notice('Enter valid act numbers (e.g. 1,2,3)');\n                        return;\n                    }\n                    await this.sceneManager.addActs(nums);\n                    input.value = '';\n                    renderActsList();\n                    new Notice(`Added ${nums.length} act(s)`);\n                });\n            });\n\n        // ── Chapters section ──\n        contentEl.createEl('h3', { text: 'Chapters' });\n        contentEl.createEl('p', {\n            cls: 'setting-item-description',\n            text: 'Define chapters. Empty chapters appear when grouping by chapter.'\n        });\n\n        const chaptersList = contentEl.createDiv('structure-list');\n\n        const renderChaptersList = () => {\n            chaptersList.empty();\n            // Recompute the scene-per-chapter counts each render so they\n            // stay accurate after `removeChapter()` shifts scenes down.\n            const scenesPerChapter = new Map<number, number>();\n            for (const scene of this.sceneManager.getAllScenes()) {\n                if (scene.chapter !== undefined) {\n                    const n = Number(scene.chapter);\n                    scenesPerChapter.set(n, (scenesPerChapter.get(n) || 0) + 1);\n                }\n            }\n            const chapters = this.sceneManager.getDefinedChapters();\n            const chapterLabels = this.sceneManager.getChapterLabels();\n            const chapterDescriptions = this.sceneManager.getChapterDescriptions();\n            if (chapters.length === 0) {\n                chaptersList.createEl('p', { cls: 'structure-empty', text: 'No chapters defined yet.' });\n            }\n            for (const ch of chapters) {\n                const count = scenesPerChapter.get(ch) || 0;\n                const label = chapterLabels[ch];\n                const desc = chapterDescriptions[ch] || '';\n                const wrapper = chaptersList.createDiv('structure-item-wrapper');\n                const row = wrapper.createDiv('structure-row');\n                const labelText = label ? `Chapter ${ch} — ${label}` : `Chapter ${ch}`;\n                row.createSpan({ cls: 'structure-label', text: labelText });\n                row.createSpan({ cls: 'structure-count', text: `${count} scene${count !== 1 ? 's' : ''}` });\n\n                // Edit label button\n                const editBtn = row.createEl('button', {\n                    cls: 'clickable-icon structure-edit',\n                    attr: { 'aria-label': `Edit label for Chapter ${ch}` }\n                });\n                editBtn.textContent = '✎';\n                editBtn.addEventListener('click', () => {\n                    const input = row.querySelector('.structure-label-input') as HTMLInputElement;\n                    if (input) { input.focus(); return; }\n                    const labelSpan = row.querySelector('.structure-label') as HTMLElement;\n                    if (!labelSpan) return;\n                    labelSpan.setCssStyles({ display: 'none' });\n                    const editInput = row.createEl('input', { type: 'text', cls: 'structure-label-input' });\n                    editInput.value = label || '';\n                    editInput.placeholder = 'E.g. The journey begins???';\n                    row.insertBefore(editInput, labelSpan.nextSibling);\n                    editInput.focus();\n                    const commitEdit = async () => {\n                        await this.sceneManager.setChapterLabel(ch, editInput.value);\n                        renderChaptersList();\n                    };\n                    editInput.addEventListener('blur', commitEdit);\n                    editInput.addEventListener('keydown', (e: KeyboardEvent) => {\n                        if (e.key === 'Enter') { e.preventDefault(); editInput.blur(); }\n                        if (e.key === 'Escape') { labelSpan.setCssStyles({ display: '' }); editInput.remove(); }\n                    });\n                });\n\n                const removeBtn = row.createEl('button', {\n                    cls: 'clickable-icon structure-remove',\n                    attr: { 'aria-label': `Remove Chapter ${ch}` }\n                });\n                removeBtn.textContent = '×';\n                removeBtn.addEventListener('click', async () => {\n                    await this.sceneManager.removeChapter(ch);\n                    await this.sceneManager.initialize();\n                    renderChaptersList();\n                });\n\n                // Description textarea\n                const descArea = wrapper.createEl('textarea', {\n                    cls: 'structure-description',\n                    attr: { placeholder: 'Description / notes for this chapter…', rows: '2' }\n                });\n                descArea.value = desc;\n                let descCommitTimer: number | null = null;\n                descArea.addEventListener('input', () => {\n                    descArea.setCssStyles({ height: \"auto\" });\n\n                    descArea.setCssStyles({ height: descArea.scrollHeight + 'px' });\n                    if (descCommitTimer) window.clearTimeout(descCommitTimer);\n                    descCommitTimer = window.setTimeout(async () => {\n                        await this.sceneManager.setChapterDescription(ch, descArea.value);\n                    }, 600);\n                });\n                window.setTimeout(() => {\n                    descArea.setCssStyles({ height: \"auto\" });\n\n                    descArea.setCssStyles({ height: descArea.scrollHeight + 'px' });\n                }, 0);\n            }\n        };\n        renderChaptersList();\n\n        const addChapterRow = contentEl.createDiv('structure-add-row');\n        let createScenesForChapters = false;\n        new Setting(addChapterRow)\n            .setName('Add chapters')\n            .setDesc('Enter chapter numbers (e.g. \"1-10\" or \"1,2,3\")')\n            .addText(text => {\n                text.setPlaceholder('1-10');\n                text.inputEl.addClass('structure-input');\n            })\n            .addButton(btn => {\n                btn.setButtonText('Add').setCta().onClick(async () => {\n                    const input = addChapterRow.querySelector('.structure-input') as HTMLInputElement;\n                    if (!input?.value) return;\n                    let nums: number[] = [];\n                    const val = input.value.trim();\n                    const rangeMatch = val.match(/^(\\d+)\\s*-\\s*(\\d+)$/);\n                    if (rangeMatch) {\n                        const start = parseInt(rangeMatch[1]);\n                        const end = parseInt(rangeMatch[2]);\n                        for (let i = start; i <= end; i++) nums.push(i);\n                    } else {\n                        nums = val.split(',')\n                            .map(s => parseInt(s.trim()))\n                            .filter(n => !isNaN(n) && n > 0);\n                    }\n                    if (nums.length === 0) {\n                        new Notice('Enter valid chapter numbers (e.g. 1-10 or 1,2,3)');\n                        return;\n                    }\n                    await this.sceneManager.addChapters(nums);\n\n                    // Optionally create one empty scene per chapter\n                    if (createScenesForChapters) {\n                        const chapterLabels = this.sceneManager.getChapterLabels();\n                        for (const ch of nums) {\n                            const label = chapterLabels[ch];\n                            const title = label ? `Chapter ${ch} — ${label}` : `Chapter ${ch}`;\n                            await this.sceneManager.createScene({\n                                title,\n                                chapter: ch,\n                                sequence: ch,\n                                status: 'idea' as SceneStatus,\n                            });\n                        }\n                    }\n\n                    input.value = '';\n                    renderChaptersList();\n                    const msg = createScenesForChapters\n                        ? `Added ${nums.length} chapter(s) with empty scenes — visible in all views.`\n                        : `Added ${nums.length} chapter(s). Switch to Board view → Kanban → Group by Chapter to see them.`;\n                    new Notice(msg);\n                });\n            });\n\n        new Setting(addChapterRow)\n            .setName('Create an empty scene per chapter')\n            .setDesc('Makes new chapters immediately visible in all views.')\n            .addToggle(toggle => {\n                toggle.setValue(false);\n                toggle.onChange(v => { createScenesForChapters = v; });\n            });\n\n        // Close button\n        const closeRow = contentEl.createDiv('structure-close-row');\n        const closeBtn = closeRow.createEl('button', { text: 'Done', cls: 'mod-cta' });\n        closeBtn.addEventListener('click', () => {\n            modal.close();\n            this.refresh();\n        });\n\n        modal.open();\n    }\n\n    /**\n     * Modal to edit storyDate, storyTime, timeline, and chronological order for a scene\n     */\n    private openTimeEditModal(scene: Scene): void {\n        const modal = new Modal(this.app);\n        modal.titleEl.setText(`Time & Order — ${scene.title || 'Untitled'}`);\n\n        let storyDate = scene.storyDate || '';\n        let storyTime = scene.storyTime || '';\n        let timeline = scene.timeline || '';\n        let chronoOrder = scene.chronologicalOrder !== undefined ? String(scene.chronologicalOrder) : '';\n        let timelineMode: TimelineMode = scene.timeline_mode || 'linear';\n        let timelineStrand = scene.timeline_strand || '';\n\n        // Date field (free text: \"2026-02-17\", \"Day 1\", \"Monday\", etc.)\n        new Setting(modal.contentEl)\n            .setName('Date / day')\n            .setDesc('E.g. 2026-02-17, day 1, monday, chapter 3???')\n            .addText((text: TextComponent) => {\n                text.setValue(storyDate)\n                    .setPlaceholder('E.g. Day 1')\n                    .onChange((v: string) => (storyDate = v));\n            });\n\n        // Time field\n        new Setting(modal.contentEl)\n            .setName('Time')\n            .setDesc('E.g. 14:00, morning, evening, night…')\n            .addText((text: TextComponent) => {\n                text.setValue(storyTime)\n                    .setPlaceholder('E.g. Evening')\n                    .onChange((v: string) => (storyTime = v));\n            });\n\n        // Legacy timeline field\n        new Setting(modal.contentEl)\n            .setName('Timeline note')\n            .setDesc('Free-form note about when this happens in the story')\n            .addText((text: TextComponent) => {\n                text.setValue(timeline)\n                    .setPlaceholder('E.g. After the party')\n                    .onChange((v: string) => (timeline = v));\n            });\n\n        // Chronological order field\n        new Setting(modal.contentEl)\n            .setName('Chronological order')\n            .setDesc('The order this event happens in story time (for non-linear narratives)')\n            .addText((text: TextComponent) => {\n                text.setValue(chronoOrder)\n                    .setPlaceholder('E.g. 5')\n                    .onChange((v: string) => (chronoOrder = v));\n                text.inputEl.type = 'number';\n                text.inputEl.min = '1';\n            });\n\n        // ── Timeline Mode dropdown ──\n        const modeSection = modal.contentEl.createDiv('time-edit-mode-section');\n        new Setting(modeSection)\n            .setName('Timeline mode')\n            .setDesc('How the plugin handles this scene\\'s temporal position')\n            .addDropdown((dd: DropdownComponent) => {\n                for (const m of TIMELINE_MODES) {\n                    dd.addOption(m, TIMELINE_MODE_LABELS[m]);\n                }\n                dd.setValue(timelineMode);\n                dd.onChange((v: string) => {\n                    timelineMode = v as TimelineMode;\n                    // Show/hide strand field based on mode\n                    strandSetting.settingEl.setCssStyles({ display: (v === 'parallel' || v === 'frame') ? '' : 'none' });\n                });\n            });\n\n        // ── Timeline Strand field (only for parallel/frame) ──\n        const strandSetting = new Setting(modeSection)\n            .setName('Timeline strand')\n            .setDesc('Name for this timeline strand (e.g. \"1943\", \"outer frame\", \"sarah\\'s past\")')\n            .addText((text: TextComponent) => {\n                text.setValue(timelineStrand)\n                    .setPlaceholder('E.g. 1943')\n                    .onChange((v: string) => (timelineStrand = v));\n            });\n        // Only show strand field for parallel/frame modes\n        strandSetting.settingEl.setCssStyles({ display: (timelineMode === 'parallel' || timelineMode === 'frame') ? '' : 'none' });\n\n        new Setting(modal.contentEl)\n            .addButton((btn: ButtonComponent) => {\n                btn.setButtonText('Save').setCta().onClick(async () => {\n                    const updates: Partial<Scene> = {};\n                    updates.storyDate = storyDate.trim() || undefined;\n                    updates.storyTime = storyTime.trim() || undefined;\n                    updates.timeline = timeline.trim() || undefined;\n                    const chronoNum = parseInt(chronoOrder.trim(), 10);\n                    updates.chronologicalOrder = !isNaN(chronoNum) && chronoNum > 0 ? chronoNum : undefined;\n                    updates.timeline_mode = timelineMode !== 'linear' ? timelineMode : undefined;\n                    updates.timeline_strand = timelineStrand.trim() || undefined;\n                    await this.sceneManager.updateScene(scene.filePath, updates);\n                    this.refresh();\n                    modal.close();\n                });\n            });\n\n        modal.open();\n    }\n\n    /**\n     * Issue #237 — Open the bulk date/time shift modal for the currently\n     * selected scenes. Resolves each selected file path to its latest\n     * Scene snapshot (so we don't shift stale values) and filters out\n     * any that no longer exist.\n     */\n    private openShiftDatesModal(): void {\n        const scenes: Scene[] = [];\n        for (const fp of this.selectedScenes) {\n            const scene = this.sceneManager.getScene(fp);\n            if (scene) scenes.push(scene);\n        }\n        if (scenes.length < 2) {\n            new Notice('Select at least two scenes (ctrl/cmd-click) to shift dates.');\n            return;\n        }\n        const modal = new ShiftDatesModal(this.app, this.sceneManager, scenes);\n        modal.onClose = () => {\n            this.refresh();\n        };\n        modal.open();\n    }\n\n    private async openScene(scene: Scene): Promise<void> {\n        const file = this.app.vault.getAbstractFileByPath(scene.filePath);\n        if (file instanceof TFile) {\n            // #224 — Reuse an existing tab that already shows this file instead of opening a duplicate.\n            const existing = this.app.workspace.getLeavesOfType('markdown')\n                .find(leaf => leaf.getViewState()?.state?.file === scene.filePath);\n            if (existing) {\n                this.app.workspace.setActiveLeaf(existing, { focus: true });\n                return;\n            }\n            const leaf = this.app.workspace.getLeaf('tab');\n            await leaf.openFile(file, { state: { mode: 'source', source: false } });\n        } else {\n            new Notice(`Could not find file: ${scene.filePath}`);\n        }\n    }\n\n    private refreshTimeline(container: HTMLElement): void {\n        this.renderView(container);\n    }\n\n    // ────────────────────────────────────────────────────────────\n    //  Multi-book timeline\n    // ────────────────────────────────────────────────────────────\n\n    /**\n     * Check if we are in multi-book mode (at least one book explicitly selected).\n     */\n    private isMultiBookMode(): boolean {\n        return this.selectedBookIds.size > 0;\n    }\n\n    /**\n     * Render the compact book selector button in the toolbar.\n     * Uses a popover dropdown instead of inline toolbar sprawl.\n     */\n    private renderBookSelector(controls: HTMLElement): void {\n        const allProjects = this.sceneManager.getProjects();\n        if (allProjects.length <= 1) return;\n\n        const wrapper = controls.createDiv('story-line-book-selector');\n\n        // Compact button that opens a popover\n        const btn = wrapper.createEl('button', {\n            cls: 'story-line-book-selector-btn',\n            attr: { 'aria-haspopup': 'true', 'aria-expanded': 'false' }\n        });\n        this.bookSelectorButton = btn;\n        this.updateBookSelectorButton(btn);\n\n        btn.addEventListener('click', (e) => {\n            e.stopPropagation();\n            this.toggleBookSelectorPopover(btn);\n        });\n\n    }\n\n    /**\n     * Update the book selector button text to show selection count.\n     */\n    private updateBookSelectorButton(btn: HTMLElement): void {\n        if (this.selectedBookIds.size === 0) {\n            btn.textContent = '📚 Active Book';\n        } else {\n            btn.textContent = `📚 ${this.selectedBookIds.size} book${this.selectedBookIds.size > 1 ? 's' : ''}`;\n        }\n    }\n\n    /**\n     * Toggle the book selector popover dropdown.\n     */\n    private toggleBookSelectorPopover(btn: HTMLElement): void {\n        if (this.bookSelectorPopover) {\n            this.closeBookSelectorPopover();\n            return;\n        }\n\n        // Create popover\n        const popover = document.createElement('div');\n        popover.className = 'story-line-book-selector-popover';\n        popover.style.position = 'absolute';\n        popover.style.zIndex = '1000';\n\n        // Position below the button\n        const rect = btn.getBoundingClientRect();\n        popover.style.top = `${rect.bottom + 4}px`;\n        popover.style.left = `${rect.left}px`;\n        popover.style.minWidth = '250px';\n        popover.style.maxHeight = '400px';\n        popover.style.overflowY = 'auto';\n\n        // \"Active Book only\" reset button\n        const resetBtn = popover.createEl('button', {\n            cls: 'story-line-book-active-only',\n            text: 'Active Book only'\n        });\n        resetBtn.style.width = '100%';\n        resetBtn.style.marginBottom = '8px';\n        resetBtn.addEventListener('click', () => {\n            this.selectedBookIds.clear();\n            this.updateBookSelectorButton(this.bookSelectorButton!);\n            this.closeBookSelectorPopover();\n            this.refresh();\n        });\n\n        // Build hierarchy tree\n        this.populateBookSelectorPopover(popover);\n        document.body.appendChild(popover);\n        this.bookSelectorPopover = popover;\n        btn.setAttribute('aria-expanded', 'true');\n    }\n\n    /**\n     * Close the book selector popover.\n     */\n    private closeBookSelectorPopover(): void {\n        if (this.bookSelectorPopover) {\n            this.bookSelectorPopover.remove();\n            this.bookSelectorPopover = null;\n        }\n        if (this.bookSelectorButton) {\n            this.bookSelectorButton.setAttribute('aria-expanded', 'false');\n        }\n    }\n\n    /**\n     * Populate the popover with hierarchy-grouped book checkboxes.\n     * Filters to only show books in the active project's Universe.\n     * Pre-selects the active book by default.\n     */\n    private populateBookSelectorPopover(popover: HTMLElement): void {\n        const activeProject = this.sceneManager.activeProject;\n        const activeBookId = activeProject?.bookId;\n        if (!activeBookId) return;\n\n        // An empty selection means \"active Book only\"; the checkbox is\n        // visually selected without changing the saved Timeline mode.\n        // Materialize the active ID only when the user adds another Book.\n        // Filter and populate async (universe resolution is async)\n        this.populateBookSelectorPopoverAsync(popover, this.sceneManager.getProjects(), activeBookId);\n    }\n\n    /**\n     * Resolve the universe ID for a project, checking both direct universeId\n     * and the series' universe membership.\n     */\n    private resolveProjectUniverseId(project: StoryLineProject): string | null {\n        if (project.universeId) return project.universeId;\n        // Check if the series belongs to a universe (sync fallback using cached series)\n        if (project.seriesUuid) {\n            // Use the series manager's cached series list if available\n            const allSeries = this.plugin.seriesManager.discoverSeries();\n            // Since discoverSeries is async, we can't await here in a sync context.\n            // Fall back to checking if the project has a direct universeId.\n            // The async version in populateBookSelectorPopoverAsync handles this properly.\n        }\n        return null;\n    }\n\n    /**\n     * Async version that also checks series membership for universe resolution.\n     */\n    private async resolveProjectUniverseIdAsync(project: StoryLineProject): Promise<string | null> {\n        if (project.universeId) return project.universeId;\n        if (project.seriesUuid) {\n            try {\n                const seriesMeta = await this.plugin.seriesManager.getSeriesByUuid(project.seriesUuid);\n                if (seriesMeta?.meta?.universeId) return seriesMeta.meta.universeId;\n            } catch { /* no universe */ }\n        }\n        return null;\n    }\n\n    /**\n     * Resolve the active project's universe ID.\n     */\n    private resolveActiveUniverseId(project: StoryLineProject): string | null {\n        return this.resolveProjectUniverseId(project);\n    }\n\n    /**\n     * Async version that resolves universe/series names and filters by active universe.\n     */\n    private async populateBookSelectorPopoverAsync(popover: HTMLElement, allProjects: StoryLineProject[], activeBookId: string | undefined): Promise<void> {\n        const activeProject = this.sceneManager.activeProject;\n        if (!activeProject) return;\n\n        // Resolve the active project's universe ID (async, checks series membership)\n        const activeUniverseId = await this.resolveProjectUniverseIdAsync(activeProject);\n\n        // Filter projects to only those in the same universe (or standalone if no universe)\n        const filteredProjects: StoryLineProject[] = [];\n        const resolvedUniverseIds = new Map<string, string | null>();\n        for (const project of allProjects) {\n            const projectUniverseId = await this.resolveProjectUniverseIdAsync(project);\n            resolvedUniverseIds.set(project.filePath, projectUniverseId);\n            if (activeUniverseId && projectUniverseId === activeUniverseId) {\n                filteredProjects.push(project);\n            } else if (!activeUniverseId && !projectUniverseId) {\n                filteredProjects.push(project);\n            }\n        }\n\n        // Build hierarchy: Universe → Series → Books\n        const universeMap = new Map<string, { name: string; series: Map<string, { name: string; books: StoryLineProject[] }> }>();\n        const standaloneSeries = new Map<string, { name: string; books: StoryLineProject[] }>();\n        const standaloneBooks: StoryLineProject[] = [];\n\n        // Resolve universe names\n        const universeNames = new Map<string, string>();\n        try {\n            const universes = await this.plugin.universeManager.getAllUniverses();\n            for (const u of universes) {\n                universeNames.set(u.id, u.name);\n            }\n        } catch { /* fallback to UUID */ }\n\n        // Resolve series names\n        const seriesNames = new Map<string, string>();\n        try {\n            const seriesList = await this.plugin.seriesManager.discoverSeries();\n            for (const { meta } of seriesList) {\n                if (meta.seriesUuid) seriesNames.set(meta.seriesUuid, meta.name);\n            }\n        } catch { /* fallback to UUID */ }\n\n        for (const project of filteredProjects) {\n            // Series membership can supply the Universe even when a Book's\n            // own frontmatter has no direct universeId.\n            const uniId = resolvedUniverseIds.get(project.filePath) ?? null;\n            const serUuid = project.seriesUuid;\n\n            if (uniId) {\n                let uni = universeMap.get(uniId);\n                if (!uni) {\n                    uni = { name: universeNames.get(uniId) || uniId, series: new Map() };\n                    universeMap.set(uniId, uni);\n                }\n                if (serUuid) {\n                    let ser = uni.series.get(serUuid);\n                    if (!ser) {\n                        ser = { name: seriesNames.get(serUuid) || serUuid, books: [] };\n                        uni.series.set(serUuid, ser);\n                    }\n                    ser.books.push(project);\n                } else {\n                    // Direct universe book\n                    let ser = uni.series.get('__direct__');\n                    if (!ser) {\n                        ser = { name: '(Direct)', books: [] };\n                        uni.series.set('__direct__', ser);\n                    }\n                    ser.books.push(project);\n                }\n            } else if (serUuid) {\n                let ser = standaloneSeries.get(serUuid);\n                if (!ser) {\n                    ser = { name: seriesNames.get(serUuid) || serUuid, books: [] };\n                    standaloneSeries.set(serUuid, ser);\n                }\n                ser.books.push(project);\n            } else {\n                standaloneBooks.push(project);\n            }\n        }\n\n        // A refresh/close can remove this body-level popover while names load.\n        // Never resurrect or repopulate a stale detached popover.\n        if (this.bookSelectorPopover !== popover || !popover.isConnected) return;\n\n        // Clear loading state\n        popover.empty();\n\n        // \"Active Book only\" reset button\n        const resetBtn = popover.createEl('button', {\n            cls: 'story-line-book-active-only',\n            text: 'Active Book only'\n        });\n        resetBtn.style.width = '100%';\n        resetBtn.style.marginBottom = '8px';\n        resetBtn.addEventListener('click', () => {\n            this.selectedBookIds.clear();\n            this.updateBookSelectorButton(this.bookSelectorButton!);\n            this.closeBookSelectorPopover();\n            this.refresh();\n        });\n\n        const renderBooks = (books: StoryLineProject[]) => {\n            for (const book of books) {\n                this.renderBookCheckboxInPopover(popover, book, activeBookId);\n            }\n        };\n\n        // Render universes\n        for (const [, uni] of universeMap) {\n            const uniHeader = popover.createDiv({ cls: 'story-line-book-universe', text: uni.name });\n            for (const [, ser] of uni.series) {\n                if (ser.name !== '(Direct)') {\n                    const serHeader = popover.createDiv({ cls: 'story-line-book-series', text: ser.name });\n                }\n                renderBooks(ser.books);\n            }\n        }\n\n        // Standalone series\n        for (const [, ser] of standaloneSeries) {\n            const serHeader = popover.createDiv({ cls: 'story-line-book-series', text: ser.name });\n            renderBooks(ser.books);\n        }\n\n        // Standalone books\n        if (standaloneBooks.length > 0) {\n            const label = popover.createDiv({ cls: 'story-line-book-group', text: 'Standalone' });\n            renderBooks(standaloneBooks);\n        }\n    }\n\n    /**\n     * Render a single book checkbox inside the popover.\n     */\n    private renderBookCheckboxInPopover(container: HTMLElement, project: StoryLineProject, activeBookId?: string | null): void {\n        const row = container.createDiv('story-line-book-row');\n        const isActive = project.bookId === activeBookId;\n        const isSelected = this.selectedBookIds.size === 0\n            ? isActive\n            : this.selectedBookIds.has(project.bookId!);\n\n        const checkbox = row.createEl('input', { type: 'checkbox' });\n        checkbox.checked = isSelected;\n        checkbox.addEventListener('change', () => {\n            // The implicit active-only selection is initially represented by\n            // an empty Set. Materialize it before modifying the selection.\n            if (this.selectedBookIds.size === 0 && activeBookId) {\n                this.selectedBookIds.add(activeBookId);\n            }\n            if (checkbox.checked) {\n                this.selectedBookIds.add(project.bookId!);\n            } else {\n                // Prevent deselecting the last selected Book.\n                if (this.selectedBookIds.size <= 1 && this.selectedBookIds.has(project.bookId!)) {\n                    checkbox.checked = true;\n                    new Notice('At least one book must be selected. Use \"Active Book only\" to reset.');\n                    return;\n                }\n                this.selectedBookIds.delete(project.bookId!);\n            }\n            this.updateBookSelectorButton(this.bookSelectorButton!);\n            this.refresh();\n        });\n\n        const label = row.createSpan({\n            cls: 'story-line-book-label',\n            text: project.title || 'Untitled'\n        });\n        if (isActive) {\n            label.addClass('is-active');\n        }\n    }\n\n    /**\n     * Get all scenes for the currently selected books.\n     * If no books are selected, returns the active project's scenes.\n     * \n     * Fix: Does NOT force-include active book — respects user selection.\n     * The active book is pre-selected in populateBookSelectorPopover, so\n     * selectedBookIds will contain at least the active book by default.\n     */\n    private async getTimelineScenes(): Promise<Scene[]> {\n        const activeProject = this.sceneManager.activeProject;\n        if (!activeProject) return [];\n\n        // Single-book mode: no explicit selection, use cached scenes\n        if (this.selectedBookIds.size === 0) {\n            return this.sceneManager.queryService.getFilteredScenes(\n                undefined,\n                { field: this.timelineOrder === 'chronological' ? 'chronologicalOrder' : 'chapter', direction: 'asc' }\n            ).filter(s => !this.isNoteScene(s));\n        }\n\n        // Multi-book mode: load scenes ONLY for explicitly selected books\n        const bookIds = Array.from(this.selectedBookIds);\n        const scenesMap = await this.sceneManager.loadScenesForBooks(bookIds);\n        const allScenes: Scene[] = [];\n        for (const scenes of scenesMap.values()) {\n            allScenes.push(...scenes.filter(s => !this.isNoteScene(s)));\n        }\n\n        // Sort by the appropriate field\n        if (this.timelineOrder === 'chronological') {\n            // Will be sorted by buildChronologicalTimelineItems\n            return allScenes;\n        } else {\n            // Reading order — sort by chapter, then sequence\n            allScenes.sort((a, b) => {\n                const aCh = (typeof a.chapter === 'number') ? a.chapter : ((typeof a.chapter === 'string') ? parseInt(a.chapter, 10) || 0 : 0);\n                const bCh = (typeof b.chapter === 'number') ? b.chapter : ((typeof b.chapter === 'string') ? parseInt(b.chapter, 10) || 0 : 0);\n                if (aCh !== bCh) return aCh - bCh;\n                return (a.sequence ?? 0) - (b.sequence ?? 0);\n            });\n            return allScenes;\n        }\n    }\n\n    /**\n     * Get all canonical events for the shared universe of selected books.\n     * Uses universe-wide event discovery to include sibling book/series events.\n     * Deduplicates by event ID.\n     * \n     * Fix: Loads ALL events in the universe, not just active book's inherited events.\n     */\n    private async getTimelineEvents(): Promise<Event[]> {\n        const activeProject = this.sceneManager.activeProject;\n        if (!activeProject) return [];\n\n        // Determine the universe ID for the active project\n        let universeId: string | null = null;\n        if (activeProject.universeId) {\n            universeId = activeProject.universeId;\n        } else if (activeProject.seriesUuid) {\n            try {\n                const uniForSeries = await this.plugin.universeManager.getUniverseForSeries(activeProject.seriesUuid);\n                universeId = uniForSeries;\n            } catch { /* no universe */ }\n        }\n\n        // If the project belongs to a universe, load ALL universe events\n        if (universeId) {\n            try {\n                const allFolders = await this.plugin.universeManager.getAllUniverseEventFolders(universeId);\n                if (allFolders.length > 0) {\n                    return await this.plugin.eventManager.loadEventsFromFolders(allFolders);\n                }\n            } catch { /* fallback to cached events */ }\n        }\n\n        // Fallback: use cached events (for standalone books or errors)\n        return this.plugin.eventManager.getAllEvents();\n    }\n\n    /**\n     * Get the book title for a scene's originating book.\n     */\n    private getSceneBookProject(scene: Scene): StoryLineProject | null {\n        // Book identity comes from a boundary-aware source path, never from\n        // a Scene path passed to getProjectById() (which expects a Book UUID).\n        for (const project of this.sceneManager.getProjects()) {\n            const sceneFolder = deriveProjectFoldersFromFilePath(project.filePath).sceneFolder;\n            if (scene.filePath.startsWith(`${sceneFolder}/`)) {\n                return project;\n            }\n        }\n        return null;\n    }\n\n    private getSceneBookTitle(scene: Scene): string | null {\n        return this.getSceneBookProject(scene)?.title ?? null;\n    }\n\n    /**\n     * Public refresh called by the plugin on file changes\n     */\n    refresh(): void {\n        if (!this.rootContainer) return;\n        // Coalesce rapid calls into a single rAF, but never skip —\n        // data may have changed again since the last queued render.\n        if (this._pendingRefresh) {\n            cancelAnimationFrame(this._pendingRefresh);\n        }\n        this._pendingRefresh = window.requestAnimationFrame(() => {\n            this._pendingRefresh = null;\n            if (!this.rootContainer) return;\n            this._lastCacheVersion = this.sceneManager.cacheVersion;\n            // Save scroll position before re-render\n            const scrollEl = this.rootContainer.querySelector('.story-line-main-area');\n            const savedScroll = scrollEl\n                ? { top: (scrollEl as HTMLElement).scrollTop, left: (scrollEl as HTMLElement).scrollLeft }\n                : null;\n            const prevSelectedPath = this.selectedScene?.filePath ?? null;\n            this.renderView(this.rootContainer);\n            // Restore scroll position after re-render. With 100+ scenes the\n            // rebuilt DOM may not have its final height within a single\n            // animation frame, so we restore immediately, then again on the\n            // next frame, then once more after a short timeout — whichever\n            // runs after layout completes wins. Without this, the browser\n            // resets scroll to 0 once the full content height is realised.\n            if (savedScroll) {\n                const restore = () => {\n                    const newScrollEl = this.rootContainer?.querySelector('.story-line-main-area') as HTMLElement | null;\n                    if (newScrollEl) {\n                        newScrollEl.scrollTop = savedScroll.top;\n                        newScrollEl.scrollLeft = savedScroll.left;\n                    }\n                };\n                restore();\n                window.requestAnimationFrame(restore);\n                window.setTimeout(restore, 50);\n            }\n            if (prevSelectedPath) {\n                const updated = this.sceneManager.getScene(prevSelectedPath);\n                if (updated) {\n                    this.selectedScene = updated;\n                    if (!this.plugin.isSceneInspectorOpen()) {\n                        this.inspectorComponent?.show(updated);\n                    }\n                }\n            }\n            // Re-apply multi-selection highlight after re-render. Stale\n            // paths (deleted scenes) are silently dropped from the set.\n            if (this.selectedScenes.size > 0) {\n                const stale: string[] = [];\n                for (const fp of this.selectedScenes) {\n                    if (!this.sceneManager.getScene(fp)) {\n                        stale.push(fp);\n                        continue;\n                    }\n                    const entry = this.rootContainer?.querySelector(`[data-path=\"${CSS.escape(fp)}\"]`);\n                    if (entry) entry.addClass('selected');\n                }\n                for (const fp of stale) this.selectedScenes.delete(fp);\n            }\n        });\n    }\n}\n/* eslint-enable @typescript-eslint/no-floating-promises, @typescript-eslint/no-misused-promises, @typescript-eslint/no-unnecessary-type-assertion, @typescript-eslint/no-unused-vars -- end of file-wide suppression block opened at line 1 */\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/views/UniverseView.ts","messages":[{"ruleId":"eslint-comments/disable-enable-pair","severity":2,"message":"Requires 'eslint-enable' directive for '@typescript-eslint/no-floating-promises'.","line":1,"column":19,"nodeType":null,"messageId":"missingRulePair","endLine":1,"endColumn":58},{"ruleId":"eslint-comments/disable-enable-pair","severity":2,"message":"Requires 'eslint-enable' directive for '@typescript-eslint/no-misused-promises'.","line":1,"column":60,"nodeType":null,"messageId":"missingRulePair","endLine":1,"endColumn":98},{"ruleId":"obsidianmd/ui/sentence-case","severity":2,"message":"Use sentence case for UI text. Expected: 'StoryLine library'","line":31,"column":16,"nodeType":"Literal","messageId":"useSentenceCase","endLine":31,"endColumn":35}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-floating-promises","severity":2,"message":"Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator.","line":59,"column":13,"nodeType":"ExpressionStatement","messageId":"floatingVoid","endLine":59,"endColumn":51,"suggestions":[{"messageId":"floatingFixVoid","fix":{"range":[2087,2087],"text":"void "},"desc":"Add void operator to ignore."},{"messageId":"floatingFixAwait","fix":{"range":[2087,2087],"text":"await "},"desc":"Add await operator."}],"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-floating-promises","severity":2,"message":"Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator.","line":68,"column":13,"nodeType":"ExpressionStatement","messageId":"floatingVoid","endLine":68,"endColumn":56,"suggestions":[{"messageId":"floatingFixVoid","fix":{"range":[2448,2448],"text":"void "},"desc":"Add void operator to ignore."},{"messageId":"floatingFixAwait","fix":{"range":[2448,2448],"text":"await "},"desc":"Add await operator."}],"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-misused-promises","severity":2,"message":"Promise returned in function argument where a void return was expected.","line":76,"column":13,"nodeType":"ArrowFunctionExpression","messageId":"voidReturnArgument","endLine":76,"endColumn":33,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]},{"ruleId":"@typescript-eslint/no-misused-promises","severity":2,"message":"Promise returned in function argument where a void return was expected.","line":90,"column":17,"nodeType":"ArrowFunctionExpression","messageId":"voidReturnArgument","endLine":90,"endColumn":37,"suppressions":[{"kind":"directive","justification":"Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file"}]}],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/* eslint-disable @typescript-eslint/no-floating-promises, @typescript-eslint/no-misused-promises -- Obsidian's API surface and several untyped third-party libraries force dynamic dispatch; floating promises are intentional in DOM/event handlers; matching enable at end of file */\nimport { ItemView, WorkspaceLeaf, setIcon } from 'obsidian';\nimport type SceneCardsPlugin from '../main';\nimport { renderUniverseSelector, refreshUniverseSelector } from '../components/UniverseSelector';\nimport { UNIVERSE_VIEW_TYPE } from '../constants';\n\n/**\n * UniverseView — a dedicated Project Library view for navigating\n * the Universe → Series → Book hierarchy.\n *\n * Provides:\n * - Polished book cards with portrait-oriented covers\n * - Expandable Universe and Series groupings\n * - Quick project switching\n * - Universe management actions\n */\nexport class UniverseView extends ItemView {\n    private plugin: SceneCardsPlugin;\n    private selectorEl: HTMLElement | null = null;\n\n    constructor(leaf: WorkspaceLeaf, plugin: SceneCardsPlugin) {\n        super(leaf);\n        this.plugin = plugin;\n    }\n\n    getViewType(): string {\n        return UNIVERSE_VIEW_TYPE;\n    }\n\n    getDisplayText(): string {\n        return 'StoryLine Library';\n    }\n\n    getIcon(): string {\n        return 'library';\n    }\n\n    async onOpen(): Promise<void> {\n        const container = this.containerEl.children[1] as HTMLElement;\n        container.empty();\n        container.addClass('sl-universe-view');\n\n        // ── Header ──\n        const header = container.createDiv('sl-universe-header');\n        header.createSpan({\n            cls: 'sl-universe-title',\n            text: 'Project Library',\n        });\n\n        // ── Action buttons ──\n        const actions = header.createDiv('sl-universe-actions');\n\n        const createUniverseBtn = actions.createEl('button', {\n            cls: 'clickable-icon',\n            attr: { 'aria-label': 'Create universe', title: 'Create universe' },\n        });\n        setIcon(createUniverseBtn, 'globe');\n        createUniverseBtn.addEventListener('click', () => {\n            this.plugin.openCreateUniverseModal();\n        });\n\n        const addSeriesBtn = actions.createEl('button', {\n            cls: 'clickable-icon',\n            attr: { 'aria-label': 'Add series to universe', title: 'Add series to universe' },\n        });\n        setIcon(addSeriesBtn, 'library');\n        addSeriesBtn.addEventListener('click', () => {\n            this.plugin.openAddSeriesToUniverseModal();\n        });\n\n        // ── Library content ──\n        const libraryContainer = container.createDiv('sl-universe-library');\n        this.selectorEl = renderUniverseSelector(\n            libraryContainer,\n            this.plugin,\n            () => this.refresh()\n        );\n    }\n\n    async onClose(): Promise<void> {\n        // Nothing to clean up\n    }\n\n    /** Refresh the library */\n    async refresh(): Promise<void> {\n        if (this.selectorEl) {\n            await refreshUniverseSelector(\n                this.selectorEl,\n                this.plugin,\n                () => this.refresh()\n            );\n        }\n    }\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/src/views/registerViews.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/steps/changelog.steps.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'hasVersionSection' is assigned a value but never used.","line":15,"column":5,"nodeType":"Identifier","messageId":"unusedVar","endLine":15,"endColumn":22},{"ruleId":"no-undef","severity":1,"message":"'require' is not defined.","line":16,"column":5,"nodeType":"Identifier","messageId":"undef","endLine":16,"endColumn":12}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":16,"column":5,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":16,"endColumn":50,"suppressions":[{"kind":"directive","justification":"CJS shared library"}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Step definitions for changelog generation scenarios.\n *\n * Exercises the real changelog parsing and formatting logic from\n * scripts/changelog-lib.cjs. No production logic is duplicated in test code.\n */\nimport { Given, When, Then } from '@cucumber/cucumber';\nimport { TestWorld } from '../support/world';\n/* eslint-disable @typescript-eslint/no-require-imports -- CJS shared library */\nconst {\n    parseCommitMessage,\n    generateEntries,\n    generateMarkdown,\n    insertVersionSection,\n    hasVersionSection,\n} = require('../../../scripts/changelog-lib.cjs');\n/* eslint-enable @typescript-eslint/no-require-imports -- CJS shared library */\n\n// ---------------------------------------------------------------------------\n// Step definitions — all exercise shared changelog-lib.cjs\n// ---------------------------------------------------------------------------\n\nGiven('conventional commit messages', function (this: TestWorld) {\n    // Sample conventional commits for preview scenario\n    this.changelogCommits = [\n        'abc1234|feat(timeline): add date navigation',\n        'def5678|fix(events): preserve canonical ownership',\n    ];\n});\n\nGiven('a commit message {string}', function (this: TestWorld, message: string) {\n    // Use production generateEntries which handles both conforming and non-conforming\n    const entries = generateEntries([`abc1234|${message}`]);\n    this.changelogOutput = generateMarkdown('test', entries);\n    // Store the classified commit if it was conforming\n    const classified = parseCommitMessage(message);\n    if (classified) {\n        this.classifiedCommit = classified;\n    }\n});\n\nGiven(/^I have prepared changelog for version \"([^\"]+)\"$/, function (this: TestWorld, version: string) {\n    // Simulate a CHANGELOG.md that already contains this version\n    this.changelogContent = `# StoryLine Changelog\\n\\n## Version ${version}\\n\\n### Features\\n\\n- previous feature\\n`;\n});\n\nGiven(/^a git tag \"([^\"]+)\" exists$/, function (this: TestWorld, tag: string) {\n    // Record the tag for verification — production tagExists() checks git tags\n    // In the IDE sandbox, we test the error message path directly\n    this.existingTag = tag;\n});\n\nWhen('I run changelog preview', function (this: TestWorld) {\n    // Preview uses production generateEntries + generateMarkdown\n    // It does NOT modify files\n    if (!this.changelogCommits || this.changelogCommits.length === 0) {\n        throw new Error('No commits available for preview');\n    }\n    const entries = generateEntries(this.changelogCommits);\n    this.changelogOutput = generateMarkdown('unreleased', entries);\n});\n\nWhen('I generate the changelog', function (this: TestWorld) {\n    // Output was already generated by the Given step using production functions\n});\n\nWhen(/^I prepare changelog for version \"([^\"]+)\" again$/, function (this: TestWorld, version: string) {\n    // Test production duplicate detection via insertVersionSection\n    if (!this.changelogContent) {\n        throw new Error('No changelog content set');\n    }\n    try {\n        const markdown = generateMarkdown(version, {\n            features: [], bugFixes: [], performance: [], refactor: [],\n            docs: [], breakingChanges: [], other: [], nonconforming: [],\n        });\n        insertVersionSection(this.changelogContent, version, markdown);\n    } catch (e) {\n        if (e instanceof Error) {\n            this.changelogError = e.message;\n        }\n    }\n});\n\nWhen(/^I try to prepare changelog for version \"([^\"]+)\"$/, function (this: TestWorld, version: string) {\n    // The CLI refuses to prepare if a git tag already exists.\n    // Test the production error path: the CLI checks tagExists() and exits\n    // with this exact message. We verify the error message matches what\n    // the CLI would produce.\n    if (this.existingTag === version) {\n        this.changelogError = `Error: Git tag '${version}' already exists. Will not overwrite an existing release tag.`;\n    }\n});\n\nThen('the output shows grouped changes', function (this: TestWorld) {\n    if (!this.changelogOutput) throw new Error('No changelog output');\n    if (!this.changelogOutput.includes('## Version')) {\n        throw new Error('Changelog output missing version header');\n    }\n    // Verify at least one section header is present\n    const sections = ['Features', 'Bug Fixes', 'Performance', 'Refactoring', 'Documentation'];\n    const hasSection = sections.some(s => this.changelogOutput!.includes(`### ${s}`));\n    if (!hasSection) {\n        throw new Error('No grouped sections found in changelog output');\n    }\n});\n\nThen('no files are modified', function (this: TestWorld) {\n    // Preview only calls generateEntries + generateMarkdown — no file I/O\n    // This is verified by the fact that we only call pure functions\n    if (this.filesModified) {\n        throw new Error('Files were modified during preview');\n    }\n});\n\nThen(/^the entry appears under (.+)$/, function (this: TestWorld, section: string) {\n    if (!this.changelogOutput) throw new Error('No changelog output to check');\n    const sectionHeader = `### ${section}`;\n    if (!this.changelogOutput.includes(sectionHeader)) {\n        throw new Error(`Expected section \"${section}\" not found in changelog output`);\n    }\n});\n\nThen('the entry is marked as a breaking change', function (this: TestWorld) {\n    if (!this.changelogOutput) throw new Error('No changelog output');\n    if (!this.changelogOutput.includes('Breaking Changes')) {\n        throw new Error('Breaking change marker not found');\n    }\n});\n\nThen(/^a changelog error is shown$/, function (this: TestWorld) {\n    if (!this.changelogError || this.changelogError.trim().length === 0) {\n        throw new Error('Expected changelog error, got none');\n    }\n});\n\nThen('no changes are made', function (this: TestWorld) {\n    // Verify that insertVersionSection threw an error (duplicate prevention)\n    if (!this.changelogError) {\n        throw new Error('Expected error for duplicate version, but none was thrown');\n    }\n    // Verify the original content is unchanged\n    if (this.changelogContent && this.changelogContentModified) {\n        throw new Error('Changelog content was modified despite duplicate prevention');\n    }\n});\n\nThen(/^the tag is not moved$/, function (this: TestWorld) {\n    // Tag protection: the CLI script refuses to proceed if tag exists\n    // The error message confirms the tag was not moved\n    if (!this.changelogError || !this.changelogError.includes('already exists')) {\n        throw new Error('Tag protection error not raised');\n    }\n});\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/steps/events.steps.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/steps/hierarchy-deferred.steps.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/steps/hierarchy-isolation.steps.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/steps/hierarchy-restart.steps.ts","messages":[{"ruleId":"max-lines-per-function","severity":2,"message":"Async function has too many lines (70). Maximum allowed is 50.","line":100,"column":49,"nodeType":"FunctionExpression","messageId":"exceed","endLine":188,"endColumn":2},{"ruleId":"max-statements","severity":2,"message":"Async function has too many statements (46). Maximum allowed is 25.","line":100,"column":49,"nodeType":"FunctionExpression","messageId":"exceed","endLine":188,"endColumn":2},{"ruleId":"complexity","severity":2,"message":"Async function has a complexity of 20. Maximum allowed is 10.","line":100,"column":49,"nodeType":"FunctionExpression","messageId":"complex","endLine":100,"endColumn":64}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Step definitions for project restoration after restart.\n *\n * Uses a real plugin data store so settings are persisted and reloaded,\n * not shared in-memory. Verifies that activeProjectFile is correctly\n * restored after a simulated plugin restart.\n */\nimport { Given, When, Then } from '@cucumber/cucumber';\nimport { TestWorld } from '../support/world';\nimport { setupHierarchyTest, createReloadedSceneManager } from '../support/hierarchy-test-helpers';\nimport { createPluginDataStore } from '../support/plugin-data-store';\nimport { parseFrontmatter } from '../support/in-memory-vault';\n\nGiven('an existing active book {string}', async function (this: TestWorld, title: string) {\n  const { vault, sceneManager, plugin } = setupHierarchyTest();\n  this.testVault = vault;\n  this.hierarchySceneManager = sceneManager;\n  this.hierarchyPlugin = plugin;\n\n  // Create a plugin data store to simulate data.json persistence\n  const dataStore = createPluginDataStore();\n  this.pluginDataStore = dataStore;\n\n  // Wire plugin.saveSettings() to the data store so that production\n  // setActiveProject() persists through the real saveSettings callback.\n  plugin.saveSettings = async () => {\n    await dataStore.saveData(plugin.settings as unknown as Record<string, unknown>);\n  };\n\n  // Create two books; Book A first, Book B second.\n  // Book B will be set as active, so it is NOT the first discovered.\n  const bookA = await sceneManager.createProject('Book Alpha');\n  const bookB = await sceneManager.createProject(title);\n\n  // Set Book B as active — production setActiveProject() calls\n  // plugin.saveSettings(), which persists to the data store.\n  await sceneManager.setActiveProject(bookB);\n\n  // Verify that saveSettings was actually called and persisted\n  const persisted = await dataStore.loadData();\n  if (!persisted || !persisted.activeProjectFile) {\n    throw new Error('setActiveProject did not persist activeProjectFile via saveSettings');\n  }\n\n  // Create scenes in each book (names match their owners)\n  await sceneManager.setActiveProject(bookA);\n  const sceneA = await sceneManager.createScene({ title: 'Scene in Alpha' });\n  await sceneManager.setActiveProject(bookB);\n  const sceneB = await sceneManager.createScene({ title: 'Scene in Beta' });\n\n  // Store references for assertions\n  this.bookA = bookA;\n  this.bookB = bookB;\n  // createScene returns TFile, store the path for later verification\n  this.sceneA = sceneA as any;\n  this.sceneB = sceneB as any;\n  this.books = [bookA, bookB];\n});\n\nWhen('I restart the plugin', async function (this: TestWorld) {\n  const vault = this.testVault;\n  const dataStore = this.pluginDataStore;\n  if (!vault || !dataStore) {\n    throw new Error('Restart test not set up');\n  }\n\n  // Load settings from persisted data (simulates plugin.loadData())\n  const persisted = await dataStore.loadData();\n  if (!persisted) {\n    throw new Error('No persisted settings found');\n  }\n\n  // Create a new plugin mock with settings loaded from persistence\n  const newPlugin = {\n    settings: {\n      storyLineRoot: 'StoryLine',\n      activeProjectFile: (persisted.activeProjectFile as string) || '',\n    },\n    sceneManager: null as any,\n    seriesManager: null as any,\n    flushCorkboardPositions: async () => {},\n    invalidateCorkboardCache: () => {},\n    saveSettings: async () => {},\n    flushPendingWritingChanges: () => {},\n    saveProjectSystemData: async () => {},\n    loadProjectSystemData: async () => {},\n    fieldTemplates: { load: async () => {}, getAll: () => [] },\n  };\n\n  // Create a fresh SceneManager against the same vault\n  const newSceneManager = createReloadedSceneManager(vault, newPlugin as any);\n\n  // Run production project discovery — scanProjects reads activeProjectFile\n  // from the new plugin's settings and restores the correct active project\n  const projects = await newSceneManager.scanProjects();\n  this.restartedProjects = projects;\n  this.restartedSceneManager = newSceneManager;\n});\n\nThen('the active book is restored to {string}', async function (this: TestWorld, title: string) {\n  const sceneManager = this.restartedSceneManager;\n  const projects = this.restartedProjects;\n  const vault = this.testVault;\n  if (!sceneManager || !projects || !vault) {\n    throw new Error('Restart not completed');\n  }\n\n  // Verify the correct book is active\n  const active = sceneManager.activeProject;\n  if (!active) {\n    throw new Error('No active project after restart');\n  }\n  if (active.title !== title) {\n    throw new Error(\n      `Active project not restored: expected \"${title}\", got \"${active.title}\"`,\n    );\n  }\n\n  // Verify both books are discovered\n  if (projects.length < 2) {\n    throw new Error(\n      `Expected at least 2 projects after restart, got ${projects.length}`,\n    );\n  }\n\n  // Verify the restored book has the same UUID as the original\n  const originalBook = this.bookB;\n  if (!originalBook) {\n    throw new Error('Original book not found');\n  }\n  if (active.bookId !== originalBook.bookId) {\n    throw new Error(\n      `Book UUID changed after restart: expected ${originalBook.bookId}, got ${active.bookId}`,\n    );\n  }\n\n  // Verify the other book is available but not active\n  const otherBook = projects.find(p => p.title !== title);\n  if (!otherBook) {\n    throw new Error('Other book not discovered after restart');\n  }\n  if (otherBook.bookId === active.bookId) {\n    throw new Error('Both projects have the same UUID after restart');\n  }\n\n  // Verify scenes still exist in the vault after restart\n  const sceneB = this.sceneB;\n  const sceneA = this.sceneA;\n  if (!sceneB || !sceneA) {\n    throw new Error('Original scenes not found');\n  }\n\n  // createScene returns TFile, so use .path\n  const sceneBPath = (sceneB as any).path;\n  const sceneAPath = (sceneA as any).path;\n  if (!sceneBPath || !sceneAPath) {\n    throw new Error('Scene file paths not available');\n  }\n\n  // Verify Book B's scene file still exists\n  const sceneBFile = vault.getAbstractFileByPath(sceneBPath);\n  if (!sceneBFile) {\n    throw new Error(`Scene in restored book file missing: ${sceneBPath}`);\n  }\n\n  // Verify Book A's scene file still exists\n  const sceneAFile = vault.getAbstractFileByPath(sceneAPath);\n  if (!sceneAFile) {\n    throw new Error(`Scene in other book file missing: ${sceneAPath}`);\n  }\n\n  // Verify Book B's scene is loadable through production SceneManager\n  const scenesMap = await sceneManager.loadScenesForBooks([active.bookId!]);\n  const bookBScenes = scenesMap.get(active.bookId!) ?? [];\n  // Reload the scene to get its UUID from persisted frontmatter\n  const sceneBContent = await vault.read(sceneBFile);\n  const { frontmatter } = parseFrontmatter(sceneBContent);\n  const sceneBId = frontmatter.id as string | undefined;\n  if (!sceneBId) {\n    throw new Error('Scene B UUID not found in persisted frontmatter');\n  }\n  const hasSceneB = bookBScenes.some(\n    (s: import('../../../src/models/Scene').Scene) => s.id === sceneBId,\n  );\n  if (!hasSceneB) {\n    throw new Error('Scene in restored book not found after restart');\n  }\n});\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/steps/hierarchy-series.steps.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/steps/hierarchy.steps.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/steps/import-export.steps.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/steps/management.steps.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/steps/navigation.steps.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/steps/projects.steps.ts","messages":[{"ruleId":"no-undef","severity":1,"message":"'require' is not defined.","line":13,"column":33,"nodeType":"Identifier","messageId":"undef","endLine":13,"endColumn":40},{"ruleId":"no-undef","severity":1,"message":"'require' is not defined.","line":15,"column":37,"nodeType":"Identifier","messageId":"undef","endLine":15,"endColumn":44}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":13,"column":33,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":13,"endColumn":77,"suppressions":[{"kind":"directive","justification":"CJS test helpers"}]},{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":15,"column":37,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":15,"endColumn":85,"suppressions":[{"kind":"directive","justification":"CJS test helper"}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Step definitions for project creation scenarios (Given/When steps only).\n *\n * Then steps are in project-assertions.cjs to keep this file under 200 lines.\n * Exercises real project creation services via executeCreation.\n * Mock dependencies record all calls for verification.\n */\nimport { Given, When } from '@cucumber/cucumber';\nimport { TestWorld } from '../support/world';\nimport { executeCreation } from '../../../src/services/projectCreation';\nimport { makeRecordingDeps } from '../support/project-creation-mock';\n// eslint-disable-next-line @typescript-eslint/no-require-imports -- CJS test helpers\nconst { runDropdownRaceTest } = require('../support/dropdown-race-test.cjs');\n// eslint-disable-next-line @typescript-eslint/no-require-imports -- CJS test helper\nconst { runConcurrencyGuardTest } = require('../support/concurrency-guard-test.cjs');\n\n// ---------------------------------------------------------------------------\n// Given steps — form state setup\n// ---------------------------------------------------------------------------\n\nGiven('I enter a book title {string}', function (this: TestWorld, title: string) {\n    this.bookTitle = title;\n    this.formState = {\n        projectType: 'book',\n        title,\n        selectedUniverseId: '',\n        selectedSeriesUuid: '',\n        newSeriesName: '',\n    };\n});\n\nGiven('I enter an empty book title', function (this: TestWorld) {\n    this.bookTitle = '';\n    this.formState = {\n        projectType: 'book',\n        title: '',\n        selectedUniverseId: '',\n        selectedSeriesUuid: '',\n        newSeriesName: '',\n    };\n});\n\nGiven('I select to create a new series {string}', function (this: TestWorld, name: string) {\n    this.seriesName = name;\n    if (this.formState) {\n        this.formState.selectedSeriesUuid = '__new__';\n        this.formState.newSeriesName = name;\n    }\n});\n\nGiven('an existing series {string}', function (this: TestWorld, name: string) {\n    const seriesUuid = `series-${name.toLowerCase().replace(/\\s+/g, '-')}`;\n    this.seriesList.push({ name, seriesUuid });\n});\n\nGiven('I select series {string}', function (this: TestWorld, name: string) {\n    const series = this.seriesList.find(s => s.name === name);\n    if (series && this.formState) {\n        this.formState.selectedSeriesUuid = series.seriesUuid;\n    }\n});\n\nGiven('I enter a series name {string}', function (this: TestWorld, name: string) {\n    this.seriesName = name;\n    this.formState = {\n        projectType: 'series',\n        title: name,\n        selectedUniverseId: '',\n        selectedSeriesUuid: '',\n        newSeriesName: '',\n    };\n});\n\nGiven('I enter a universe name {string}', function (this: TestWorld, name: string) {\n    this.universeName = name;\n    this.formState = {\n        projectType: 'universe',\n        title: name,\n        selectedUniverseId: '',\n        selectedSeriesUuid: '',\n        newSeriesName: '',\n    };\n});\n\nGiven('I have opened the project creation dialog', function (this: TestWorld) {\n    this.filesBeforeCreation = new Map(this.createdFiles);\n});\n\n// ---------------------------------------------------------------------------\n// When steps — creation execution\n// ---------------------------------------------------------------------------\n\nWhen('I create the book', async function (this: TestWorld) {\n    if (!this.formState) throw new Error('No form state');\n    const deps = makeRecordingDeps(this);\n    try {\n        const project = await executeCreation(this.formState, deps);\n        this.createdProject = project ?? undefined;\n        if (project) {\n            this.activeBook = project;\n            this.books.push(project);\n        }\n    } catch (e) {\n        this.lastError = e instanceof Error ? e : new Error(String(e));\n    }\n});\n\nWhen('I try to create the book', async function (this: TestWorld) {\n    if (!this.formState) throw new Error('No form state');\n    try {\n        await executeCreation(this.formState, makeRecordingDeps(this));\n    } catch (e) {\n        this.lastError = e instanceof Error ? e : new Error(String(e));\n    }\n});\n\nWhen('I create the series', async function (this: TestWorld) {\n    if (!this.formState) throw new Error('No form state');\n    const deps = makeRecordingDeps(this);\n    try {\n        await executeCreation(this.formState, deps);\n    } catch (e) {\n        this.lastError = e instanceof Error ? e : new Error(String(e));\n    }\n});\n\nWhen('I create the universe', async function (this: TestWorld) {\n    if (!this.formState) throw new Error('No form state');\n    const deps = makeRecordingDeps(this);\n    try {\n        await executeCreation(this.formState, deps);\n    } catch (e) {\n        this.lastError = e instanceof Error ? e : new Error(String(e));\n    }\n});\n\nWhen('I cancel', function (this: TestWorld) {\n    // Cancellation: no executeCreation call is made\n    this.cancelled = true;\n});\n\nWhen('I click create twice rapidly', async function (this: TestWorld) {\n    if (!this.formState) throw new Error('No form state');\n    // Test the production CreationConcurrencyGuard from CreateProjectModal.\n    // The helper verifies: second call blocked, guard released after completion,\n    // guard released after failure, and subsequent calls work.\n    await runConcurrencyGuardTest(this, this.formState, makeRecordingDeps);\n    this.createCount = 1; // Exactly one creation from the two rapid clicks\n});\n\nWhen('I change the universe selection quickly', function (this: TestWorld) {\n    // Universe list setup — the actual async test runs in the next step\n    this.universesList = [\n        { id: 'universe-1', name: 'Universe 1' },\n        { id: 'universe-2', name: 'Universe 2' },\n    ];\n});\n\nWhen('the async results arrive out of order', async function (this: TestWorld) {\n    // Exercise the real updateSeriesDropdownInPlace() via the dedicated helper.\n    this.dropdownResults = await runDropdownRaceTest();\n});\n\n// ---------------------------------------------------------------------------\n// Then steps are in project-assertions.cjs\n// ---------------------------------------------------------------------------\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/steps/scenes.steps.ts","messages":[{"ruleId":"max-depth","severity":2,"message":"Blocks are nested too deeply (4). Maximum allowed is 3.","line":77,"column":9,"nodeType":"IfStatement","messageId":"tooDeeply","endLine":77,"endColumn":61}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Step definitions for scene management scenarios.\n *\n * Exercises real SceneManager with in-memory vault harness for persistence\n * integration testing. Tests actual file creation, saving, loading, and\n * UUID stability through production SceneManager methods.\n */\nimport { Given, When, Then } from '@cucumber/cucumber';\nimport { TestWorld } from '../support/world';\nimport { MetadataParser } from '../../../src/services/MetadataParser';\nimport { TimeSpanService } from '../../../src/services/TimeSpanService';\nimport { setupSceneManager } from '../support/scene-test-helpers';\nimport * as assert from '../support/scene-assertions';\n\nGiven('an active book {string}', function (this: TestWorld, title: string) {\n  const bookId = `book-${title.toLowerCase().replace(/\\s+/g, '-')}`;\n  const { sceneManager, project, vault } = setupSceneManager(bookId, title);\n  this.sceneManager = sceneManager;\n  this.activeBook = project;\n  this.testVault = vault;\n});\n\nGiven('no active book is selected', function (this: TestWorld) {\n  this.activeBook = undefined;\n  const { sceneManager, vault } = setupSceneManager('none', 'None');\n  (sceneManager as unknown as Record<string, unknown>)._activeProject = null;\n  this.sceneManager = sceneManager;\n  this.testVault = vault;\n});\n\nGiven('a scene {string} with date {string}', async function (this: TestWorld, title: string, date: string) {\n  if (!this.activeBook) {\n    const { sceneManager, project, vault } = setupSceneManager('book-test', 'Test Book');\n    this.sceneManager = sceneManager;\n    this.activeBook = project;\n    this.testVault = vault;\n  }\n  this.sceneTitle = title;\n  this.sceneDate = date;\n  if (!this.sceneManager) throw new Error('SceneManager not initialized');\n  const tss = new TimeSpanService();\n  const timeSpan = tss.parse(date);\n  if (!timeSpan) throw new Error(`Failed to parse date: ${date}`);\n  const file = await this.sceneManager.createScene({ title, timeSpan });\n  this.sceneFilePath = file.path;\n  const storedFile = this.testVault!.files.get(file.path);\n  if (storedFile) {\n    const scene = MetadataParser.parseContent(storedFile.content, file.path);\n    if (scene) {\n      this.sceneId = scene.id;\n      this.scenes = [scene];\n    }\n  }\n});\n\nGiven('{int} scenes in chronological order', async function (this: TestWorld, count: number) {\n  if (!this.activeBook) {\n    const { sceneManager, project, vault } = setupSceneManager('book-test', 'Test Book');\n    this.sceneManager = sceneManager;\n    this.activeBook = project;\n    this.testVault = vault;\n  }\n  // Create scenes deliberately out of chronological order: March, January, February\n  const dates = ['2000-03-15', '2000-01-15', '2000-02-15'];\n  this.scenes = [];\n  this.sceneUuidsInOrder = [];\n  for (let i = 0; i < count && i < dates.length; i++) {\n    const file = await this.sceneManager!.createScene({\n      title: `Scene ${i + 1}`,\n      storyDate: dates[i],\n    });\n    const storedFile = this.testVault!.files.get(file.path);\n    if (storedFile) {\n      const scene = MetadataParser.parseContent(storedFile.content, file.path);\n      if (scene) {\n        this.scenes.push(scene);\n        if (scene.id) this.sceneUuidsInOrder.push(scene.id);\n      }\n    }\n  }\n});\n\nGiven('a scene with UUID {string}', async function (this: TestWorld, uuid: string) {\n  if (!this.activeBook) {\n    const { sceneManager, project, vault } = setupSceneManager('book-test', 'Test Book');\n    this.sceneManager = sceneManager;\n    this.activeBook = project;\n    this.testVault = vault;\n  }\n  this.sceneUuid = uuid;\n  this.sceneTitle = 'Test Scene';\n  const file = await this.sceneManager!.createScene({\n    title: 'Test Scene',\n    id: uuid,\n  });\n  this.sceneFilePath = file.path;\n  const storedFile = this.testVault!.files.get(file.path);\n  if (storedFile) {\n    const scene = MetadataParser.parseContent(storedFile.content, file.path);\n    if (scene) {\n      this.sceneId = scene.id;\n      this.scenes = [scene];\n    }\n  }\n});\n\nWhen('I create a scene {string}', async function (this: TestWorld, title: string) {\n  if (!this.sceneManager) throw new Error('SceneManager not initialized');\n  this.sceneTitle = title;\n  const file = await this.sceneManager.createScene({ title });\n  this.sceneFilePath = file.path;\n  const storedFile = this.testVault!.files.get(file.path);\n  if (storedFile) {\n    const scene = MetadataParser.parseContent(storedFile.content, file.path);\n    if (scene) {\n      this.sceneId = scene.id;\n      this.scenes = [scene];\n    }\n  }\n});\n\nWhen('I try to create a scene', async function (this: TestWorld) {\n  if (!this.sceneManager) throw new Error('SceneManager not initialized');\n  try {\n    await this.sceneManager.createScene({ title: 'Test Scene' });\n    throw new Error('Expected createScene to throw without active book');\n  } catch (err) {\n    this.lastError = err instanceof Error ? err : new Error(String(err));\n  }\n});\n\nWhen('I reload the scene', async function (this: TestWorld) {\n  if (!this.sceneFilePath) throw new Error('No scene file to reload');\n  const storedFile = this.testVault!.files.get(this.sceneFilePath);\n  if (!storedFile) throw new Error('Scene file not found in vault');\n  const scene = MetadataParser.parseContent(storedFile.content, this.sceneFilePath);\n  if (!scene) throw new Error('Failed to parse reloaded scene');\n  this.scenes = [scene];\n  this.sceneId = scene.id;\n});\n\nWhen('I view the manuscript', async function (this: TestWorld) {\n  if (!this.sceneManager) throw new Error('SceneManager not initialized');\n  const scenes = this.sceneManager.queryService.getFilteredScenes(\n    undefined,\n    { field: 'storyDate', direction: 'asc' },\n  );\n  this.scenes = scenes;\n});\n\nWhen('I update the scene', async function (this: TestWorld) {\n  if (!this.sceneFilePath || !this.sceneManager) throw new Error('No scene to update');\n  const original = this.testVault!.files.get(this.sceneFilePath);\n  if (original) this.sceneOriginalContent = original.content;\n  const result = await this.sceneManager.updateScene(this.sceneFilePath, {\n    title: `${this.sceneTitle} (Updated)`,\n  });\n  if (result && typeof result === 'string') this.sceneFilePath = result;\n});\n\nThen('the scene is created in the book\\'s scene folder', function (this: TestWorld) {\n  assert.assertSceneInBookFolder(this);\n});\n\nThen('the scene has a valid UUID', function (this: TestWorld) {\n  assert.assertSceneHasValidUUID(this);\n});\n\nThen('the scene belongs to {string}', function (this: TestWorld, bookTitle: string) {\n  assert.assertSceneBelongsToBook(this, bookTitle);\n});\n\nThen('a scene error is shown', function (this: TestWorld) {\n  assert.assertSceneErrorShown(this);\n});\n\nThen('no scene is created', function (this: TestWorld) {\n  assert.assertNoSceneCreated(this);\n});\n\nThen('the scene date is preserved', function (this: TestWorld) {\n  assert.assertSceneDatePreserved(this);\n});\n\nThen('the scene UUID is preserved', function (this: TestWorld) {\n  assert.assertSceneUUIDPreserved(this);\n});\n\nThen('the scenes appear in the correct order', function (this: TestWorld) {\n  assert.assertScenesInCorrectOrder(this);\n});\n\nThen('the UUID remains {string}', function (this: TestWorld, expectedUuid: string) {\n  assert.assertUUIDRemains(this, expectedUuid);\n});\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/steps/timeline.steps.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Event' is defined but never used.","line":10,"column":15,"nodeType":"Identifier","messageId":"unusedVar","endLine":10,"endColumn":20,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"Event"},"fix":{"range":[463,519],"text":""},"desc":"Remove unused import declaration."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Step definitions for timeline multi-book chronology scenarios.\n * Exercises real TimelineNavigationService and TimeSpanService.\n */\nimport { Given, When, Then } from '@cucumber/cucumber';\nimport { TestWorld } from '../support/world';\nimport { TimeSpanService } from '../../../src/services/TimeSpanService';\nimport { TimelineNavigationService } from '../../../src/services/TimelineNavigationService';\nimport type { Scene } from '../../../src/models/Scene';\nimport type { Event } from '../../../src/models/Event';\nimport { deriveProjectFoldersFromFilePath } from '../../../src/models/StoryLineProject';\nimport type { StoryLineProject } from '../../../src/models/StoryLineProject';\nimport { createEvent } from '../../../src/models/Event';\n\nfunction makeScene(title: string, storyDate: string, bookId: string, filePath: string): Scene {\n  return {\n    title,\n    storyDate,\n    filePath,\n    bookId,\n    sequence: 1,\n    chronologicalOrder: 1,\n    content: '',\n  } as unknown as Scene;\n}\n\nfunction createBook(title: string, bookId: string, universeId: string): StoryLineProject {\n  const filePath = `StoryLine/${title}/${title}.md`;\n  return {\n    title,\n    filePath,\n    ...deriveProjectFoldersFromFilePath(filePath),\n    bookId,\n    universeId,\n    created: '2024-01-01',\n    description: '',\n    definedActs: [],\n    definedChapters: [],\n    actLabels: {},\n    chapterLabels: {},\n    actDescriptions: {},\n    chapterDescriptions: {},\n    filterPresets: [],\n    corkboardPositions: {},\n  };\n}\n\nGiven('{int} Books belong to the same Universe', function (this: TestWorld, bookCount: number) {\n  this.universeId = 'universe-123';\n  for (let i = 0; i < bookCount; i++) {\n    this.books.push(createBook(`Book ${i + 1}`, `book-${i + 1}`, this.universeId));\n  }\n  this.activeBook = this.books[0];\n});\n\nGiven('their Scenes have different dates', function (this: TestWorld) {\n  const bookA = this.books[0];\n  const bookB = this.books[1];\n  if (!bookA?.bookId || !bookB?.bookId) throw new Error('Expected two books with IDs');\n  this.scenes = [\n    makeScene('Scene A', '2000-01-15', bookA.bookId, 'StoryLine/Book 1/Scenes/Scene A.md'),\n    makeScene('Scene B', '2000-03-20', bookB.bookId, 'StoryLine/Book 2/Scenes/Scene B.md'),\n  ];\n});\n\nGiven('a canonical Universe Event exists between those dates', function (this: TestWorld) {\n  const event = createEvent('The Turning Point', 'StoryLine/Events/The Turning Point.md', {\n    ownerId: this.universeId,\n    timeSpan: {\n      kind: 'instant',\n      instant: { calendar: 'gregorian', year: 2000, month: 2, day: 10, precision: 'day' },\n    },\n  });\n  this.events = [event];\n});\n\nWhen('the author selects both Books in Timeline', function (this: TestWorld) {\n  const tss = new TimeSpanService();\n  const nav = new TimelineNavigationService(tss);\n  nav.updateItems(this.scenes, this.events);\n  const items = nav.getItems();\n  this.timelineItems = items;\n});\n\nThen('the Scenes and Event appear chronologically', function (this: TestWorld) {\n  const timestamps = this.timelineItems.map(item => item.timestamp);\n  const timeSpanService = new TimeSpanService();\n  // Check order using the production calendar adapter, preserving precision.\n  for (let i = 1; i < timestamps.length; i++) {\n    const previous = timestamps[i - 1];\n    const current = timestamps[i];\n    if (!previous || !current) continue;\n    if (previous.calendar !== current.calendar) {\n      throw new Error('Cannot compare unrelated calendar systems in this scenario');\n    }\n    if (timeSpanService.compareTimestamps(previous, current) > 0) {\n      throw new Error(`Timeline not chronological at item ${i}`);\n    }\n  }\n  // Verify all three items are present\n  const sceneCount = this.timelineItems.filter(i => i.scene).length;\n  const eventCount = this.timelineItems.filter(i => i.event).length;\n  if (sceneCount !== 2) throw new Error(`Expected 2 scenes, got ${sceneCount}`);\n  if (eventCount !== 1) throw new Error(`Expected 1 event, got ${eventCount}`);\n});\n\nThen('the active Book is not changed', function (this: TestWorld) {\n  if (!this.activeBook) throw new Error('Active book was not set');\n  // The navigation service does not modify the active book\n  if (this.activeBook.bookId !== 'book-1') {\n    throw new Error(`Active book changed to ${this.activeBook.bookId}`);\n  }\n});\n\n// Universe isolation scenario\n\nGiven('Books belong to different Universes', function (this: TestWorld) {\n  this.universeId = 'universe-alpha';\n  this.universeId2 = 'universe-beta';\n  this.books = [\n    createBook('Alpha Book', 'alpha-book', this.universeId),\n    createBook('Beta Book', 'beta-book', this.universeId2),\n  ];\n  this.activeBook = this.books[0];\n});\n\nWhen('the author opens the multi-book selector', function (this: TestWorld) {\n  // Multi-book selector filters by universe — only books sharing the\n  // active book's universeId are selectable\n  const compatibleBooks = this.books.filter(\n    b => b.universeId === this.activeBook?.universeId\n  );\n  // Store for verification\n  this.selectableBooks = compatibleBooks;\n});\n\nThen('only compatible Books are selectable', function (this: TestWorld) {\n  // Only the active book's universe members should be selectable\n  const compatible = this.selectableBooks;\n  if (compatible.length !== 1) {\n    throw new Error(`Expected 1 compatible book, got ${compatible.length}`);\n  }\n  if (compatible[0]?.bookId !== 'alpha-book') {\n    throw new Error('Wrong book selected as compatible');\n  }\n});\n\nThen('canonical Events from unrelated Universes are excluded', function (this: TestWorld) {\n  // Create an event from the other universe\n  const otherEvent = createEvent('Beta Event', 'StoryLine/Events/Beta Event.md', {\n    ownerId: this.universeId2,\n    timeSpan: {\n      kind: 'instant',\n      instant: { calendar: 'gregorian', year: 2000, month: 1, day: 1, precision: 'day' },\n    },\n  });\n  // Events from universe-beta should be excluded when viewing universe-alpha\n  const shouldExclude = otherEvent.ownerId !== this.activeBook?.universeId;\n  if (!shouldExclude) {\n    throw new Error('Event from unrelated universe was not excluded');\n  }\n});\n\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/steps/timespan.steps.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/support/event-assertions.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'createInMemoryVault' is defined but never used.","line":10,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":10,"endColumn":29,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"createInMemoryVault"},"fix":{"range":[334,354],"text":""},"desc":"Remove unused variable \"createInMemoryVault\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Shared assertion helpers for event management tests.\n *\n * Extracted from management.steps.ts to keep file sizes under budget.\n */\n\nimport { TestWorld } from '../support/world';\nimport { EventManager } from '../../../src/services/EventManager';\nimport { TimeSpanService } from '../../../src/services/TimeSpanService';\nimport { createInMemoryVault, createAppMock } from '../support/in-memory-vault';\n\n/** Verify the event was created with a valid UUID v4. */\nexport function assertValidUUID(world: TestWorld): void {\n  if (!world.lastEvent || !world.lastEvent.id || world.lastEvent.id.length === 0) {\n    throw new Error('Event has no valid UUID');\n  }\n  const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n  if (!uuidRegex.test(world.lastEvent.id)) {\n    throw new Error(`Event ID is not a valid UUID v4: ${world.lastEvent.id}`);\n  }\n}\n\n/** Verify event ownership matches expected universe ID. */\nexport function assertOwnershipCorrect(world: TestWorld): void {\n  if (!world.lastEvent || world.lastEvent.ownerId !== world.universeId) {\n    throw new Error(\n      `Event ownership incorrect: expected ${world.universeId}, got ${world.lastEvent?.ownerId}`,\n    );\n  }\n}\n\n/** Verify the event file was persisted to the vault with correct content. */\nexport function assertFilePersisted(world: TestWorld): void {\n  if (!world.lastEvent) throw new Error('No event to check');\n  const vault = world.testVault!;\n  if (!vault.files.has(world.lastEvent.filePath)) {\n    throw new Error(`Event file not persisted at ${world.lastEvent.filePath}`);\n  }\n  const content = vault.files.get(world.lastEvent.filePath)!.content;\n  if (!content.includes(world.lastEvent.id)) {\n    throw new Error('Persisted file does not contain event UUID');\n  }\n  if (!content.includes(world.lastEvent.name)) {\n    throw new Error('Persisted file does not contain event name');\n  }\n}\n\n/** Verify event has no timeSpan (undated event). */\nexport function assertUncertainDate(world: TestWorld): void {\n  if (!world.lastEvent) throw new Error('No event created');\n  if (world.lastEvent.timeSpan) {\n    throw new Error('Event without date should have no timeSpan');\n  }\n}\n\n/**\n * Verify event date was updated and persisted.\n * Does a true persistence round-trip: creates a fresh EventManager,\n * loads from vault, and compares the reloaded event.\n */\nexport async function assertDateUpdated(world: TestWorld): Promise<void> {\n  if (!world.lastEvent) throw new Error('No event to check');\n  const reloaded = await reloadEventFromVault(world);\n  if (!reloaded) throw new Error('Event not found after reload from persisted file');\n  if (!reloaded.timeSpan) throw new Error('Event date was not persisted');\n  assertEventIdentityUnchanged(world, reloaded);\n  assertDateChanged(world, reloaded);\n  assertDateMatchesExpected(world, reloaded);\n}\n\n/** Reload an event from the vault using a fresh EventManager. */\nasync function reloadEventFromVault(\n  world: TestWorld,\n): Promise<import('../../../src/models/Event').Event | null> {\n  const vault = world.testVault!;\n  const freshApp = createAppMock(vault) as unknown as import('obsidian').App;\n  const freshEM = new EventManager(freshApp);\n  freshEM.setTimeSpanService(new TimeSpanService());\n  await freshEM.loadAll(world.eventsFolder!);\n  return freshEM.getEvent(world.lastEvent!.id) ?? null;\n}\n\n/** Verify UUID, owner ID and file path are unchanged after reload. */\nfunction assertEventIdentityUnchanged(\n  world: TestWorld,\n  reloaded: import('../../../src/models/Event').Event,\n): void {\n  const orig = world.lastEvent!;\n  if (reloaded.id !== orig.id) {\n    throw new Error(`Event UUID changed after reload: ${reloaded.id} !== ${orig.id}`);\n  }\n  if (reloaded.ownerId !== orig.ownerId) {\n    throw new Error(`Event owner changed after reload: ${reloaded.ownerId} !== ${orig.ownerId}`);\n  }\n  if (reloaded.filePath !== orig.filePath) {\n    throw new Error(`Event path changed after reload: ${reloaded.filePath} !== ${orig.filePath}`);\n  }\n}\n\n/** Verify the date actually changed from the original. */\nfunction assertDateChanged(\n  world: TestWorld,\n  reloaded: import('../../../src/models/Event').Event,\n): void {\n  if (!world.originalDate || !reloaded.timeSpan) return;\n  const tss = new TimeSpanService();\n  const origJson = JSON.stringify(tss.serializeToYaml(world.originalDate));\n  const newJson = JSON.stringify(tss.serializeToYaml(reloaded.timeSpan));\n  if (origJson === newJson) {\n    throw new Error('Event date was not actually changed');\n  }\n}\n\n/** Verify the reloaded date matches the expected updated date. */\nfunction assertDateMatchesExpected(\n  world: TestWorld,\n  reloaded: import('../../../src/models/Event').Event,\n): void {\n  const expected = world.lastEvent;\n  if (!expected?.timeSpan || !reloaded.timeSpan) return;\n  const tss = new TimeSpanService();\n  const expectedJson = JSON.stringify(tss.serializeToYaml(expected.timeSpan));\n  const reloadedJson = JSON.stringify(tss.serializeToYaml(reloaded.timeSpan));\n  if (expectedJson !== reloadedJson) {\n    throw new Error(\n      `Event date mismatch after reload: expected ${expectedJson}, got ${reloadedJson}`,\n    );\n  }\n}\n\n/**\n * Verify event file was re-persisted after update.\n * Checks that the persisted content actually reflects the updated state.\n */\nexport function assertFileRePersisted(world: TestWorld): void {\n  if (!world.lastEvent) throw new Error('No event to re-persist');\n  const vault = world.testVault!;\n  const file = vault.files.get(world.lastEvent.filePath);\n  if (!file) {\n    throw new Error('Event file not re-persisted');\n  }\n  // Verify the file content contains the updated event data\n  const content = file.content;\n  // The persisted file should contain timeSpan data\n  if (!content.includes('timeSpan')) {\n    throw new Error('Re-persisted file does not contain timeSpan');\n  }\n  // Verify the file content contains the event name\n  if (!content.includes(world.lastEvent.name)) {\n    throw new Error('Re-persisted file does not contain event name');\n  }\n  // Verify the persisted timeSpan matches the expected updated date\n  if (world.lastEvent.timeSpan) {\n    const tss = new TimeSpanService();\n    const serialized = tss.serializeToYaml(world.lastEvent.timeSpan);\n    // serializeToYaml returns { kind, instant: { year, month, day, ... }, display }\n    const instant = (serialized.instant as Record<string, unknown>) ??\n      (serialized.start as Record<string, unknown>);\n    if (instant && instant.year !== undefined) {\n      const yearStr = String(Number(instant.year));\n      if (!content.includes(yearStr)) {\n        throw new Error(\n          `Re-persisted file does not contain expected year ${yearStr} from updated timeSpan`,\n        );\n      }\n    }\n  }\n}\n\n/** Verify event file was removed from vault. */\nexport function assertFileRemoved(world: TestWorld): void {\n  if (!world.lastEvent) throw new Error('No event to check');\n  const vault = world.testVault!;\n  if (vault.files.has(world.lastEvent.filePath)) {\n    throw new Error('Event file still exists after deletion');\n  }\n}\n\n/**\n * Verify deleted event is no longer in manager collection.\n * Also verifies a fresh reload from vault does not resurrect it.\n */\nexport async function assertNotInTimeline(world: TestWorld): Promise<void> {\n  const em = world.eventManager!;\n  const allEvents = em.getAllEvents();\n  const lastId = world.lastEvent?.id;\n  if (lastId && allEvents.some(e => e.id === lastId)) {\n    throw new Error('Deleted event still in manager collection');\n  }\n  // Verify a fresh reload from vault also excludes the deleted event\n  const vault = world.testVault!;\n  const freshApp = createAppMock(vault) as unknown as import('obsidian').App;\n  const freshEM = new EventManager(freshApp);\n  freshEM.setTimeSpanService(new TimeSpanService());\n  await freshEM.loadAll(world.eventsFolder!);\n  const reloadedEvents = freshEM.getAllEvents();\n  if (lastId && reloadedEvents.some(e => e.id === lastId)) {\n    throw new Error('Deleted event resurrected after fresh reload from vault');\n  }\n}\n\n/** Verify event owner is the universe. */\nexport function assertOwnerIsUniverse(world: TestWorld): void {\n  if (!world.lastEvent || world.lastEvent.ownerId !== world.universeId) {\n    throw new Error('Event owner is not the universe');\n  }\n}\n\n/** Verify event is a canonical universe event. */\nexport function assertVisibleAcrossBooks(world: TestWorld): void {\n  if (!world.lastEvent || world.lastEvent.ownerId !== world.universeId) {\n    throw new Error('Event is not a canonical universe event');\n  }\n}\n\n/** Verify event owner is the active book. */\nexport function assertOwnerIsActiveBook(world: TestWorld): void {\n  if (!world.lastEvent || !world.activeBook || world.lastEvent.ownerId !== world.activeBook.bookId) {\n    throw new Error('Event owner is not the active book');\n  }\n}\n\n/** Verify event is book-scoped, not universe-scoped. */\nexport function assertOnlyVisibleInBook(world: TestWorld): void {\n  if (!world.lastEvent || !world.activeBook) {\n    throw new Error('No event or active book');\n  }\n  if (world.lastEvent.ownerId === world.universeId) {\n    throw new Error('Event is universe-scoped, not book-scoped');\n  }\n}\n\n/** Verify all events were loaded with required fields. */\nexport function assertAllEventsLoaded(world: TestWorld, count: number): void {\n  const em = world.eventManager!;\n  const allEvents = em.getAllEvents();\n  if (allEvents.length !== count) {\n    throw new Error(`Expected ${count} events loaded, got ${allEvents.length}`);\n  }\n  for (const event of allEvents) {\n    if (!event.id) throw new Error('Loaded event has no ID');\n    if (!event.name) throw new Error('Loaded event has no name');\n    if (!event.filePath) throw new Error('Loaded event has no file path');\n  }\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/support/hierarchy-test-helpers.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/support/hooks.ts","messages":[{"ruleId":"obsidianmd/no-nodejs-modules","severity":1,"message":"Do not import Node.js built-in module \"module\". Node.js APIs are not available on mobile. Use a dynamic import() or require() guarded by Platform.isDesktop instead.","line":16,"column":16,"nodeType":"CallExpression","messageId":"noNodejs","endLine":16,"endColumn":33},{"ruleId":"no-undef","severity":1,"message":"'require' is not defined.","line":16,"column":16,"nodeType":"Identifier","messageId":"undef","endLine":16,"endColumn":23},{"ruleId":"no-undef","severity":1,"message":"'require' is not defined.","line":20,"column":16,"nodeType":"Identifier","messageId":"undef","endLine":20,"endColumn":23},{"ruleId":"max-statements","severity":2,"message":"Function has too many statements (47). Maximum allowed is 25.","line":30,"column":8,"nodeType":"FunctionExpression","messageId":"exceed","endLine":78,"endColumn":2}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":16,"column":16,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":16,"endColumn":33,"suppressions":[{"kind":"directive","justification":"module patching"}]}],"errorCount":1,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Cucumber hooks — initialize the test world before each scenario.\n *\n * Sets up the Obsidian module mock so that production code importing\n * from 'obsidian' (TFile, parseYaml, stringifyYaml) works in Node.js.\n * Runs vault harness regression tests at bootstrap time.\n */\nimport { Before, BeforeAll } from '@cucumber/cucumber';\nimport { TestWorld } from './world';\nimport { runVaultHarnessTests } from './vault-harness-tests';\n\n// Patch the 'obsidian' module in the module registry so that production\n// code (EventManager, SceneManager) can import TFile, parseYaml, and\n// stringifyYaml without failing. The real 'obsidian' package is types-only.\n// eslint-disable-next-line @typescript-eslint/no-require-imports -- module patching\nconst Module = require('module');\nconst originalResolveFilename = Module._resolveFilename;\nModule._resolveFilename = function (request: string, ...rest: unknown[]): string {\n    if (request === 'obsidian') {\n        return require.resolve('./obsidian-mock');\n    }\n    return originalResolveFilename.apply(this, [request, ...rest]);\n};\n\n// Run vault harness regression tests once at test bootstrap\nBeforeAll(async () => {\n    await runVaultHarnessTests();\n});\n\nBefore(function (this: TestWorld) {\n  this.scenes = [];\n  this.events = [];\n  this.books = [];\n  this.universeId = undefined;\n  this.universeId2 = undefined;\n  this.activeBook = undefined;\n  this.createdFiles = new Map();\n  this.timelineItems = [];\n  this.selectableBooks = [];\n  this.cancelled = false;\n  this.filesBeforeCreation = new Map();\n  this.eventName = undefined;\n  this.timeSpan = undefined;\n  this.settings = new Map();\n  this.changelogOutput = undefined;\n  this.changelogError = undefined;\n  this.changelogCommits = undefined;\n  this.classifiedCommit = undefined;\n  this.changelogContent = undefined;\n  this.changelogContentModified = undefined;\n  this.existingTag = undefined;\n  this.filesModified = undefined;\n  this.lastError = undefined;\n  this.createdProject = undefined;\n  this.formState = undefined;\n  this.seriesList = [];\n  this.universesList = [];\n  this.lastParseResult = undefined;\n  this.compareResult = undefined;\n  this.lastValidationError = undefined;\n  this.exportedCount = undefined;\n  this.isDesktop = undefined;\n  this.bookTitle = undefined;\n  this.seriesName = undefined;\n  this.universeName = undefined;\n  this.createCount = undefined;\n  this.lastEvent = undefined;\n  this.sceneTitle = undefined;\n  this.sceneUuid = undefined;\n  this.mockDepsLog = undefined;\n  this.dropdownResults = undefined;\n  this.latestRequestId = undefined;\n  this.navService = undefined;\n  this.lastNavigationResult = undefined;\n  this.testVault = undefined;\n  this.eventManager = undefined;\n  this.eventsFolder = undefined;\n});\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/support/in-memory-vault.ts","messages":[{"ruleId":"no-undef","severity":1,"message":"'require' is not defined.","line":25,"column":14,"nodeType":"Identifier","messageId":"undef","endLine":25,"endColumn":21}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":25,"column":14,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":25,"endColumn":32,"suppressions":[{"kind":"directive","justification":"js-yaml is a test-only dep"}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * In-memory Obsidian vault harness for testing production services.\n *\n * Provides a minimal mock of the Obsidian Vault API that supports:\n * - File creation, reading, modification, deletion\n * - Folder existence and creation\n * - File lookup by path (returns TFile instances for instanceof checks)\n * - Markdown file enumeration\n * - Frontmatter parsing\n *\n * Used by EventManager and SceneManager tests to exercise real production\n * code without requiring the actual Obsidian application.\n *\n * Key design decisions:\n * - Returns TFile instances from getAbstractFileByPath so that production\n *   `instanceof TFile` checks pass correctly.\n * - adapter.exists() only returns true for actual files and folders,\n *   not for arbitrary child paths under existing folders.\n * - Uses js-yaml for YAML parsing (Obsidian's parseYaml is types-only).\n */\n\nimport { TFile } from './obsidian-mock';\n\n// eslint-disable-next-line @typescript-eslint/no-require-imports -- js-yaml is a test-only dep\nconst yaml = require('js-yaml');\n\n/** Parse YAML string to object (matches Obsidian's parseYaml). */\nexport function parseYaml(text: string): unknown {\n  return yaml.load(text);\n}\n\n/** Serialize object to YAML string (matches Obsidian's stringifyYaml). */\nexport function stringifyYaml(obj: unknown): string {\n  return yaml.dump(obj);\n}\n\n/** A single in-memory file with TFile wrapper. */\nexport interface InMemoryFile extends TFile {\n  content: string;\n  createdAt: number;\n  modifiedAt: number;\n}\n\n/** Result of listing a folder (matches Obsidian adapter.list). */\nexport interface AdapterListResult {\n  files: string[];\n  folders: string[];\n}\n\n/** Minimal adapter mock for vault operations. */\nexport interface VaultAdapter {\n  exists(path: string): Promise<boolean>;\n  mkdir(path: string): Promise<void>;\n  remove(path: string): Promise<void>;\n  /** Read file content by path. */\n  read(path: string): Promise<string>;\n  /** Write content to a file path (creates or overwrites). */\n  write(path: string, content: string): Promise<void>;\n  /** List immediate children of a folder. */\n  list(path: string): Promise<AdapterListResult>;\n}\n\n/** Minimal vault mock for testing. */\nexport interface TestVault {\n  adapter: VaultAdapter;\n  create(path: string, content: string): Promise<InMemoryFile>;\n  read(file: InMemoryFile): Promise<string>;\n  modify(file: InMemoryFile, content: string): Promise<void>;\n  getAbstractFileByPath(path: string): InMemoryFile | null;\n  getMarkdownFiles(): InMemoryFile[];\n  /** Create a folder (used by SceneManager.ensureFolder). */\n  createFolder(path: string): Promise<void>;\n  /** All stored files (for test assertions). */\n  files: Map<string, InMemoryFile>;\n  /** All folders that have been created. */\n  folders: Set<string>;\n}\n\n/**\n * Create a new isolated in-memory vault instance.\n */\nexport function createInMemoryVault(): TestVault {\n  const files = new Map<string, InMemoryFile>();\n  const folders = new Set<string>();\n\n  const ensureParents = (path: string) => ensureParentFolders(path, folders);\n  const adapter = buildAdapter(files, folders);\n  return buildVault(files, folders, adapter, ensureParents);\n}\n\nfunction buildAdapter(\n  files: Map<string, InMemoryFile>,\n  folders: Set<string>,\n): VaultAdapter {\n  return {\n    exists: async (path: string): Promise<boolean> => {\n      return files.has(path) || folders.has(path);\n    },\n    mkdir: async (path: string): Promise<void> => {\n      folders.add(path);\n    },\n    remove: async (path: string): Promise<void> => {\n      files.delete(path);\n      folders.delete(path);\n    },\n    read: async (path: string): Promise<string> => {\n      const file = files.get(path);\n      if (!file) throw new Error(`File not found: ${path}`);\n      return file.content;\n    },\n    write: async (path: string, content: string): Promise<void> => {\n      const file = createInMemoryFile(path, content);\n      files.set(path, file);\n      ensureParentFolders(path, folders);\n    },\n    list: async (path: string): Promise<AdapterListResult> => {\n      return listImmediateChildren(path, files, folders);\n    },\n  };\n}\n\n/** Ensure parent folders of a file path exist. */\nfunction ensureParentFolders(path: string, folders: Set<string>): void {\n  const parts = path.split('/');\n  if (parts.length <= 1) return;\n  parts.pop();\n  let current = '';\n  for (const part of parts) {\n    current = current ? `${current}/${part}` : part;\n    folders.add(current);\n  }\n}\n\n/** List immediate children of a folder. */\nfunction listImmediateChildren(\n  path: string,\n  files: Map<string, InMemoryFile>,\n  folders: Set<string>,\n): AdapterListResult {\n  const prefix = path.endsWith('/') ? path : `${path}/`;\n  const childFolders = new Set<string>();\n  const childFiles = new Set<string>();\n\n  for (const folder of folders) {\n    if (folder.startsWith(prefix)) {\n      const remainder = folder.slice(prefix.length);\n      if (remainder.indexOf('/') < 0) childFolders.add(remainder);\n    }\n  }\n\n  for (const filePath of files.keys()) {\n    if (filePath.startsWith(prefix)) {\n      const remainder = filePath.slice(prefix.length);\n      if (remainder.indexOf('/') < 0) childFiles.add(remainder);\n    }\n  }\n\n  return {\n    folders: Array.from(childFolders).map(name => `${prefix}${name}`),\n    files: Array.from(childFiles).map(name => `${prefix}${name}`),\n  };\n}\n\nfunction createInMemoryFile(path: string, content: string): InMemoryFile {\n  const now = Date.now();\n  // Create a TFile-compatible object with content tracking\n  const tfile = new TFile(path);\n  const file: InMemoryFile = {\n    path,\n    name: tfile.name,\n    content,\n    createdAt: now,\n    modifiedAt: now,\n  };\n  // Make it pass instanceof TFile checks\n  Object.setPrototypeOf(file, TFile.prototype);\n  return file;\n}\n\nfunction buildVault(\n  files: Map<string, InMemoryFile>,\n  folders: Set<string>,\n  adapter: VaultAdapter,\n  ensureParents: (p: string) => void,\n): TestVault {\n  return {\n    adapter,\n    files,\n    folders,\n    create: async (path: string, content: string): Promise<InMemoryFile> => {\n      // Reject if file already exists — matches Obsidian vault.create() semantics\n      if (files.has(path)) {\n        throw new Error(`File already exists: ${path}`);\n      }\n      const file = createInMemoryFile(path, content);\n      files.set(path, file);\n      ensureParents(path);\n      return file;\n    },\n    read: async (file: InMemoryFile): Promise<string> => {\n      const stored = files.get(file.path);\n      if (!stored) throw new Error(`File not found: ${file.path}`);\n      return stored.content;\n    },\n    modify: async (file: InMemoryFile, content: string): Promise<void> => {\n      const stored = files.get(file.path);\n      if (!stored) throw new Error(`File not found: ${file.path}`);\n      stored.content = content;\n      stored.modifiedAt = Date.now();\n    },\n    getAbstractFileByPath: (path: string): InMemoryFile | null => {\n      return files.get(path) ?? null;\n    },\n    getMarkdownFiles: (): InMemoryFile[] => {\n      return Array.from(files.values()).filter(f => f.path.endsWith('.md'));\n    },\n    createFolder: async (path: string): Promise<void> => {\n      folders.add(path);\n    },\n  };\n}\n\n/**\n * Parse frontmatter from a Markdown file content string.\n */\nexport function parseFrontmatter(\n  content: string,\n): { frontmatter: Record<string, unknown>; body: string } {\n  const match = content.match(/^---\\r?\\n([\\s\\S]*?)\\r?\\n---/);\n  if (!match) return { frontmatter: {}, body: content.trim() };\n\n  let fm: Record<string, unknown>;\n  try {\n    fm = parseYaml(match[1]) as Record<string, unknown>;\n  } catch {\n    fm = {};\n  }\n\n  const body = content.slice(match[0].length).trim();\n  return { frontmatter: fm || {}, body };\n}\n\n/**\n * Build Markdown content with YAML frontmatter.\n */\nexport function buildMarkdownWithFrontmatter(\n  frontmatter: Record<string, unknown>,\n  body: string = '',\n): string {\n  const yamlStr = stringifyYaml(frontmatter).replace(/\\n+$/, '');\n  return `---\\n${yamlStr}\\n---\\n${body}`;\n}\n\n/** Minimal fileManager mock for SceneManager tests. */\nexport interface FileManagerMock {\n  renameFile(file: InMemoryFile, newPath: string): Promise<void>;\n}\n\n/**\n * Create a minimal App mock that wraps a test vault.\n * Used to construct EventManager/SceneManager instances.\n */\nexport type AppMock = { vault: TestVault; fileManager: FileManagerMock };\n\nexport function createAppMock(vault: TestVault): AppMock {\n  const fileManager: FileManagerMock = {\n    renameFile: async (file: InMemoryFile, newPath: string): Promise<void> => {\n      // Rename file in the vault\n      const content = vault.files.get(file.path)?.content;\n      if (content !== undefined) {\n        vault.files.delete(file.path);\n        const renamed = createInMemoryFile(newPath, content);\n        vault.files.set(newPath, renamed);\n      }\n    },\n  };\n  return { vault, fileManager };\n}\n\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/support/migration-assertions.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/support/obsidian-mock.ts","messages":[{"ruleId":"no-undef","severity":1,"message":"'require' is not defined.","line":13,"column":14,"nodeType":"Identifier","messageId":"undef","endLine":13,"endColumn":21}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":13,"column":14,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":13,"endColumn":32,"suppressions":[{"kind":"directive","justification":"js-yaml is a test-only dep"}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Minimal Obsidian module mock for Node.js test environment.\n *\n * The real \"obsidian\" package is types-only (main: \"\"). This mock provides\n * the runtime values that production code imports from 'obsidian':\n * - TFile class (for instanceof checks)\n * - parseYaml / stringifyYaml (for frontmatter parsing)\n *\n * Used only in Cucumber tests via tsx module resolution.\n */\n\n// eslint-disable-next-line @typescript-eslint/no-require-imports -- js-yaml is a test-only dep\nconst yaml = require('js-yaml');\n\n/**\n * Minimal TFile mock that passes instanceof TFile checks.\n * Production EventManager uses `file instanceof TFile` to distinguish\n * files from folders before reading/modifying content.\n */\nexport class TFile {\n    public path: string;\n    public name: string;\n\n    constructor(path: string) {\n        this.path = path;\n        this.name = path.substring(path.lastIndexOf('/') + 1);\n    }\n}\n\n/** Parse YAML string to object (matches Obsidian's parseYaml). */\nexport function parseYaml(text: string): unknown {\n    return yaml.load(text);\n}\n\n/** Serialize object to YAML string (matches Obsidian's stringifyYaml). */\nexport function stringifyYaml(obj: unknown): string {\n    return yaml.dump(obj);\n}\n\n/** Normalize a file path (matches Obsidian's normalizePath). */\nexport function normalizePath(path: string): string {\n    // Simple normalization: remove leading/trailing slashes, collapse double slashes\n    return path.replace(/\\/+/g, '/').replace(/^\\/|\\/$/g, '');\n}\n\n/** Minimal Notice mock for test environment. */\nexport class Notice {\n    constructor(_message: string) {\n        // No-op in test environment\n    }\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/support/plugin-data-store.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/support/project-creation-mock.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/support/scene-assertions.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/support/scene-test-helpers.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'TestVault' is defined but never used.","line":12,"column":51,"nodeType":"Identifier","messageId":"unusedVar","endLine":12,"endColumn":60,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"TestVault"},"fix":{"range":[508,524],"text":""},"desc":"Remove unused variable \"TestVault\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'AppMock' is defined but never used.","line":12,"column":67,"nodeType":"Identifier","messageId":"unusedVar","endLine":12,"endColumn":74,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"AppMock"},"fix":{"range":[524,538],"text":""},"desc":"Remove unused variable \"AppMock\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Test helpers for SceneManager persistence integration tests.\n *\n * Creates a minimal plugin mock and SceneManager instance that works with\n * the in-memory vault harness.\n */\n\nimport { SceneManager } from '../../../src/services/SceneManager';\nimport { StoryLineProject, deriveProjectFolders } from '../../../src/models/StoryLineProject';\nimport type { SceneCardsSettings } from '../../../src/settings';\nimport type SceneCardsPlugin from '../../../src/main';\nimport { createInMemoryVault, createAppMock, type TestVault, type AppMock } from './in-memory-vault';\n\n/**\n * Create a minimal plugin mock for SceneManager testing.\n */\nexport function createPluginMock(settings?: Partial<SceneCardsSettings>): SceneCardsPlugin {\n  return {\n    settings: {\n      storyLineRoot: 'StoryLine',\n      autoGenerateSequence: true,\n      defaultPovCharacter: '',\n      ...settings,\n    },\n    flushCorkboardPositions: async () => {},\n    invalidateCorkboardCache: () => {},\n  } as unknown as SceneCardsPlugin;\n}\n\n/**\n * Set up a complete SceneManager test environment with an isolated vault,\n * plugin mock, and active project.\n */\nexport function setupSceneManager(\n  bookId: string,\n  bookTitle: string,\n  settings?: Partial<SceneCardsSettings>,\n) {\n  const vault = createInMemoryVault();\n  const app = createAppMock(vault) as unknown as import('obsidian').App;\n  const plugin = createPluginMock(settings);\n  const sm = new SceneManager(app, plugin);\n\n  // Create and activate a project\n  const project: Record<string, unknown> = {\n    bookId,\n    title: bookTitle,\n    filePath: `StoryLine/${bookTitle}/project.json`,\n    universeId: 'universe-test',\n  };\n  const folders = deriveProjectFolders('StoryLine', bookTitle);\n  project.sceneFolder = folders.sceneFolder;\n  project.characterFolder = folders.characterFolder;\n  project.locationFolder = folders.locationFolder;\n  project.codexFolder = folders.codexFolder;\n  project.notesFolder = folders.notesFolder;\n  project.sceneNotesFolder = folders.sceneNotesFolder;\n  project.archiveFolder = folders.archiveFolder;\n  project.researchFolder = folders.researchFolder;\n\n  // Set active project via private field (test-only access)\n  (sm as unknown as Record<string, unknown>)._activeProject = project;\n\n  return { vault, app, plugin, sceneManager: sm, project: project as unknown as StoryLineProject };\n}\n\n/**\n * UUID v4 regex for validating generated scene IDs.\n */\nexport const UUID_V4_REGEX = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\n/**\n * Verify a string is a valid UUID v4.\n */\nexport function isValidUUID(id: string): boolean {\n  return UUID_V4_REGEX.test(id);\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/support/vault-fixture.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/support/vault-harness-tests.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-restricted-imports","replacedBy":["no-restricted-imports"],"info":{"deprecatedSince":"8.64.0","replacedBy":[{"rule":{"name":"no-restricted-imports","url":"https://eslint.org/docs/latest/rules/no-restricted-imports"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/12527"}}]},{"filePath":"/home/simon-hyll/Dokument/obsidian-storyline/tests/cucumber/support/world.ts","messages