{
  "name": "obsidian-storyline",
  "version": "1.11.1",
  "description": "Transform your vault into a powerful book planning and writingtool with StoryLine",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "husky",
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "cucumber-js",
    "test:rerun": "cucumber-js -p rerun",
    "verify:feature-layout": "node scripts/verify-feature-layout.mjs",
    "lint": "eslint \"**/*.ts\"",
    "lint:obsidian": "eslint \"**/*.ts\"",
    "lint:changed": "node --max-old-space-size=512 scripts/lint-changed.mjs",
    "lint:staged": "node --max-old-space-size=512 scripts/lint-changed.mjs --staged",
    "lint:architecture": "node --max-old-space-size=512 scripts/architecture-gate.cjs",
    "changelog:preview": "node scripts/changelog.cjs preview",
    "changelog:prepare": "node scripts/changelog.cjs prepare",
    "vault:install": "node scripts/sync-vault.mjs",
    "vault:watch": "node scripts/sync-vault.mjs --watch"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "scene-cards",
    "writing",
    "novel",
    "plotting"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@cucumber/cucumber": "^13.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.0",
    "@typescript-eslint/parser": "^8.60.1",
    "css-tree": "^3.2.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "husky": "^9.1.7",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "obsidian": "^1.12.3",
    "sass": "^1.106.1",
    "ts-node": "^10.9.2",
    "tslib": "2.6.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "lucide": "^1.52.0",
    "markdown-it": "^14.3.2",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-mark": "^4.0.0",
    "pdf-lib": "^1.17.1"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
